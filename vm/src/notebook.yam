          if {0..list.length()}.contains(index) some(list.get(index)) none[A]()
      chapter More list constructors
        text
          Welcome to the ugly corners of the notebook. Because lists are not
          special syntax-wise, I just have a bunch of overloaded functions for
          creating lists of different lists. If there's a need for another one,
          I can just add that.
        code
          list[A](a: A) List[A] = list[A]().push(a)
        code
          list[A](a: A, b: A) List[A] = list(a).push(b)
        code
          list[A](a: A, b: A, c: A) List[A] = list(a, b).push(c)
        code
          list[A](a: A, b: A, c: A, d: A) List[A] = list(a, b, c).push(d)
        code
          list[A](a: A, b: A, c: A, d: A, e: A) List[A] = list(a, b, c, d).push(e)
        code
          list[A](a: A, b: A, c: A, d: A, e: A, f: A) List[A] =
            list(a, b, c, d, e).push(f)
        code
          list[A](a: A, b: A, c: A, d: A, e: A, f: A, g: A) List[A] =
            list(a, b, c, d, e, f).push(g)
        code
          list[A](a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A) List[A] =
            list(a, b, c, d, e, f, g).push(h)
        code
          list[A](a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A) List[A] =
            list(a, b, c, d, e, f, g, h).push(i)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A) List[A] =
            list(a, b, c, d, e, f, g, h, i).push(j)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j).push(k)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A, l: A
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k).push(l)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l).push(m)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m).push(n)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n).push(o)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o).push(p)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p).push(q)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q).push(r)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r).push(s)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A, t: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s).push(t)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A, t: A, u: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t)
              .push(u)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A, t: A, u: A, v: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u)
              .push(v)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A, t: A, u: A, v: A,
            w: A,
            ) List[A] =
            list(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v)
              .push(w)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A, t: A, u: A, v: A,
            w: A, x: A,
            ) List[A] =
            list(
              a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w)
              .push(x)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A, t: A, u: A, v: A,
            w: A, x: A, y: A,
            ) List[A] =
            list(
              a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w,
              x)
              .push(y)
        code
          list[A](
            a: A, b: A, c: A, d: A, e: A, f: A, g: A, h: A, i: A, j: A, k: A,
            l: A, m: A, n: A, o: A, p: A, q: A, r: A, s: A, t: A, u: A, v: A,
            w: A, x: A, y: A, z: A,
            ) List[A] =
            list(
              a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w,
              x, y)
              .push(z)
      code
        first[A](list: List[A]) A = list.get(0)
      code
        last[A](list: List[A]) A = list.get(list.length() - 1)
      code
        first[A](list: List[A], amount: Int) List[A] = list.slice(0..amount)
      code
        last[A](list: List[A], amount: Int) List[A] =
          _ = assert(
            amount >= 0 and amount <= list.length(),
            "List amount out of bounds.")
          list.slice({list.length() - amount}..list.length())
      code
        without_first[A](list: List[A], amount: Int) List[A] =
          list.slice(amount..list.length())
      code
        without_first[A](list: List[A]) List[A] = list.without_first(1)
      code
        without_last[A](list: List[A], amount: Int) List[A] =
          _ = assert(
            amount >= 0 and amount <= list.length(),
            "List amount out of bounds.")
          list.slice(0..{list.length() - amount})
      code
        without_last[A](list: List[A]) List[A] = list.without_last(1)
      code
        pop[A](list: List[A]) List[A] =
          _ = assert(list.is_not_empty(), "Cannot pop an empty list.")
          list.without_last()
      code
        first_maybe[A](list: List[A]) Maybe[A] = list.get_maybe(0)
      code
        last_maybe[A](list: List[A]) Maybe[A] =
          list.get_maybe(list.length() - 1)
      code
        insert[A](list: List[A], index: Int, item: A) List[A] =
          list.first(index).push(item).push_all(list.without_first(index))
      code
        remove[A](list: List[A], range: Range[Int]) List[A] =
          _ = assert(
            0 <= range.start
              and range.start <= range.end
              and range.end <= list.length(),
            "List range out of bounds.")
          list.first(range.start).push_all(list.without_first(range.end))
    chapter Converting between strings and bytes
      text
        Instead of eagerly constructing a giant array, make this return an
        iterator?
      code
        bytes(value: String) List[Byte] = ...
      code
        string(bytes: List[Byte]) String = ...
      code
        byte(string: String) Byte =
          bytes = string.bytes()
          _ = assert(bytes.length() == 1, "Expected a single-byte character")
          bytes.get(0)
      code
        parse_int(string: String, radix: Int) Int =
          string.bytes().parse_int(radix)
        parse_int(bytes: List[Byte], radix: Int) Int =
          digit = bytes.get(0).parse_digit()
          if bytes.length() == 1
            digit
            digit * radix.pow(bytes.length() - 1)
              + bytes.without_first(1).parse_int(radix)
        # TODO: throw an error if the string contains a digit above the radix
        parse_digit(char: Byte) Int =
          value = char.to_int()
          if value >= 48 and value <= 57
            value - 48
          if value >= 97 and value <= 102
            value - 97 + 10
          if value >= 65 and value <= 70
            value - 65 + 10
            crash("Invalid digit")
      text
        Integer formatting is available before iterators so their diagnostics
        can include an index.
      code
        format(int: Int) String = int.format(10)
        format(int: Int, radix: Int) String =
          _ = assert(
            radix >= 2 and radix <= 16,
            "Radix must be between 2 and 16.")
          if int < 0
            "-" + format_negative(int, radix)
            format_negative(0 - int, radix)
        # Keep the magnitude negative so min_int never needs to be negated.
        format_negative(int: Int, radix: Int) String =
          rest = int / radix
          digit_value = {rest * radix} - int
          digit = string(list("0123456789abcdef".bytes().get(digit_value)))
          if rest == 0 digit format_negative(rest, radix) + digit
      code
        format(byte: Byte) String = byte.to_int().format()
        format(byte: Byte, radix: Int) String = byte.to_int().format(radix)
    chapter Tuples
      code
        Tuple2[A, B] = struct { a: A, b: B }
      code
        Tuple3[A, B, C] = struct { a: A, b: B, c: C }
      code
        tuple[A, B](a: A, b: B) Tuple2[A, B] = Tuple2(a, b)
      code
        tuple[A, B, C](a: A, b: B, c: C) Tuple3[A, B, C] = Tuple3(a, b, c)
    chapter Loop
      code
        Loop[S, R] = enum { continue: S, break: R }
      code
        loop[S, R](state: S, step: fun(S) Loop[S, R]) R =
          step(state) %(continue(next) loop(next, step) break(result) result)
      code
        loop[A, B, R](a: A, b: B, step: fun(A, B) Loop[Tuple2[A, B], R]) R =
          loop(tuple(a, b), \ state: Tuple2[A, B] -> step(state.a, state.b))
    chapter Iterators
      text
        Iterators are defined by their behavior (you can get the next item)
        rather than their structure. That's why iterators (Iter for short) just
        contain a function pointer.
      code
        Iter[A] = struct { next: fun() Maybe[Next[A]] }
        Next[A] = struct { item: A, rest: Iter[A] }
      code
        iter_from_fun[A](next: fun() Maybe[Next[A]]) Iter[A] = Iter(next)
      code
        NextState[A, S] = struct { item: A, state: S }
        iter_from_state[A, S](
          state: S, next: fun(S) Maybe[NextState[A, S]]
        ) Iter[A] =
          iter_from_fun(\ ->
            next(state).map(\ stuff: NextState[A, S] ->
              Next(
                item = stuff.item,
                rest = iter_from_state(stuff.state, next))))
      code
        is_empty[A](iter: Iter[A]) Bool = iter.next() is none
      code
        filter_map[A, B](iter: Iter[A], mapper: fun(A) Maybe[B]) Iter[B] =
          iter_from_fun(\ ->
            iter.next().flat_map(\ next: Next[A] ->
              mapper(next.item) %(
                none next.rest.filter_map(mapper).next()
                some(b)
                  some(Next(item = b, rest = next.rest.filter_map(mapper))))))
      code
        map[A, B](iter: Iter[A], mapper: fun(A) B) Iter[B] =
          iter_from_fun(\ ->
            iter.next().map(\ next: Next[A] ->
              Next(item = mapper(next.item), rest = map(next.rest, mapper))))
      code
        map[A, B, C](iter: Iter[Tuple2[A, B]], mapper: fun(A, B) C) Iter[C] =
          iter.map(\ pair: Tuple2[A, B] -> mapper(pair.a, pair.b))
      code
        somes[A](iter: Iter[Maybe[A]]) Iter[A] =
          iter.filter_map(\ value: Maybe[A] -> value)
      code
        Indexed[A] = struct { index: Int, item: A }
        indexed[A](iter: Iter[A]) Iter[Indexed[A]] = iter.indexed_rec(0)
        indexed_rec[A](iter: Iter[A], start: Int) Iter[Indexed[A]] =
          iter_from_fun(\ ->
            iter.next().map(\ next: Next[A] ->
              Next(
                item = Indexed(index = start, item = next.item),
                rest = next.rest.indexed_rec(start + 1))))
      code
        map_indexed[A, B](iter: Iter[A], mapper: fun(Int, A) B) Iter[B] =
          iter.indexed().map(\ indexed: Indexed[A] ->
            mapper(indexed.index, indexed.item))
      code
        filter[A](iter: Iter[A], checker: fun(A) Bool) Iter[A] =
          iter_from_fun(\ ->
            iter.next() %(
              none none[Next[A]]()
              some(next)
                if checker(next.item)
                  some(Next(item = next.item, rest = next.rest.filter(checker)))
                  next.rest.filter(checker).next()))
      code
        fold[A, S](iter: Iter[A], state: S, folder: fun(S, A) S) S =
          iter.next() %(
            none state
            some(next) next.rest.fold(folder(state, next.item), folder))
      code
        fold[Item, A, B](
          iter: Iter[Item], a: A, b: B,
          folder: fun(A, B, Item) Tuple2[A, B],
        ) Tuple2[A, B] =
          iter.fold(tuple(a, b), \ state: Tuple2[A, B], item: Item ->
            folder(state.a, state.b, item))
      code
        fold[Item, A, B, C](
          iter: Iter[Item], a: A, b: B, c: C,
          folder: fun(A, B, C, Item) Tuple3[A, B, C],
        ) Tuple3[A, B, C] =
          iter.fold(tuple(a, b, c), \ state: Tuple3[A, B, C], item: Item ->
            folder(state.a, state.b, state.c, item))
      code
        reduce[A](iter: Iter[A], reducer: fun(A, A) A) Maybe[A] =
          iter.next() %(
            none none[A]()
            some(next) some(next.rest.fold(next.item, reducer)))
      code
        all[A](iter: Iter[A], check: fun(A) Bool) Bool =
          iter.next() %(
            none true
            some(next) check(next.item) and next.rest.all(check))
      code
        any[A](iter: Iter[A], check: fun(A) Bool) Bool =
          iter.next() %(
            none false
            some(next) check(next.item) or next.rest.any(check))
      code
        any(iter: Iter[Bool]) Bool = iter.any(\ value: Bool -> value)
      code
        skip[A](iter: Iter[A], amount: Int) Iter[A] =
          if amount <= 0
            iter
            iter_from_fun(\ ->
              iter.next().flat_map(\ next: Next[A] ->
                next.rest.skip(amount - 1).next()))
      code
        skip_while[A](iter: Iter[A], checker: fun(A) Bool) Iter[A] =
          iter_from_fun(\ ->
            iter.next() %(
              none none[Next[A]]()
              some(next)
                if checker(next.item)
                  next.rest.skip_while(checker).next()
                  some(next)))
      code
        take[A](iter: Iter[A], amount: Int) Iter[A] =
          iter_from_fun(\ ->
            if amount == 0
              none[Next[A]]()
              iter.next().map(\ next: Next[A] ->
                Next(item = next.item, rest = next.rest.take(amount - 1))))
      code
        take_while[A](iter: Iter[A], checker: fun(A) Bool) Iter[A] =
          iter_from_fun(\ ->
            iter.next() %(
              none none[Next[A]]()
              some(next)
                if checker(next.item)
                  some(Next(
                    item = next.item, rest = next.rest.take_while(checker)))
                  none[Next[A]]()))
      code
        # Zips two iters of equal length.
        zip[A, B](a: Iter[A], b: Iter[B]) Iter[Tuple2[A, B]] =
          iter_from_fun(\ ->
            a.next() %(
              none
                _ = assert(b.next() is none, "zip iters have different lengths")
                none[Next[Tuple2[A, B]]]()
              some(aa)
                b.next() %(
                  none crash("zip iters have different lengths")
                  some(bb)
                    some(Next(
                      item = tuple(aa.item, bb.item),
                      rest = zip(aa.rest, bb.rest))))))
      code
        zip_short[A, B](a: Iter[A], b: Iter[B]) Iter[Tuple2[A, B]] =
          iter_from_fun(\ ->
            a.next().flat_map(\ aa: Next[A] ->
              b.next().map(\ bb: Next[B] ->
                Next(
                  item = tuple(aa.item, bb.item),
                  rest = zip_short(aa.rest, bb.rest)))))
      code
        get_maybe[A](iter: Iter[A], index: Int) Maybe[A] =
          if index < 0
            none[A]()
            iter.skip(index).next().map(\ next: Next[A] -> next.item)
      code
        get[A](iter: Iter[A], index: Int) A =
          iter.get_maybe(index)
            or crash("Index " + index.format() + " is out of bounds.")
      code
        last[A](iter: Iter[A]) Maybe[A] =
          iter.next().map(\ next: Next[A] -> next.rest.last_rec(next.item))
        last_rec[A](iter: Iter[A], previous: A) A =
          iter.next() %(
            none previous
            some(next) next.rest.last_rec(next.item))
      code
        chain[A](a: Iter[A], b: Iter[A]) Iter[A] =
          iter_from_fun(\ ->
            a.next() %(
              none b.next()
              some(next)
                some(Next(item = next.item, rest = next.rest.chain(b)))))
      code
        flat_map[A, B](iter: Iter[A], mapper: fun(A) Iter[B]) Iter[B] =
          iter_from_fun(\ ->
            iter.next().flat_map(\ next: Next[A] ->
              mapper(next.item).chain(next.rest.flat_map(mapper)).next()))
      code
        flatten[A](iter: Iter[Iter[A]]) Iter[A] =
          iter.flat_map(\ it: Iter[A] -> it)
      code
        cycle[A](iter: Iter[A]) Iter[A] = iter.chain(iter.cycle())
      code
        length[A](iter: Iter[A]) Int =
          iter.fold(0, \ count: Int, item: A -> count + 1)
      code
        sum(iter: Iter[Float]) Float =
          iter.fold(0.0, \ a: Float, b: Float -> a + b)
      code
        sum(iter: Iter[Int]) Int =
          iter.fold(0, \ a: Int, b: Int -> a + b)
      code
        min(iter: Iter[Int]) Maybe[Int] =
          iter.reduce(\ a: Int, b: Int -> min(a, b))
      code
        max(iter: Iter[Int]) Maybe[Int] =
          iter.reduce(\ a: Int, b: Int -> max(a, b))
      code
        iter(range: Range[Int]) Iter[Int] =
          iter_from_state(range.start, \ next: Int ->
            if next == range.end
              none[NextState[Int, Int]]()
              some(NextState(item = next, state = next + 1)))
      code
        iter(range: OpenRange[Int]) Iter[Int] =
          iter_from_state(range.start, \ next: Int ->
            some(NextState(item = next, state = next + 1)))
      code
        iter[T](list: List[T]) Iter[T] =
          iter_from_state(0, \ index: Int ->
            if index == list.length()
              none[NextState[T, Int]]()
              some(NextState(item = list.get(index), state = index + 1)))
        to_list[T](iter: Iter[T]) List[T] =
          iter.fold(list[T](), \ list: List[T], item: T -> list.push(item))
    chapter Characters
      text
        A Char is one character of text. For now it contains a Unicode scalar
        value; later it can represent a whole grapheme cluster. Character lists
        let layout and editing share the same unit instead of indexing UTF-8
        bytes. char(codepoint) constructs a Char and checks its range.
      code
        Char = struct { codepoint: Int }
        char(codepoint: Int) Char =
          _ = assert(codepoint >= 0 and codepoint <= 1114111
            and not(codepoint >= 55296 and codepoint <= 57343),
            "Expected a Unicode scalar value.")
          Char(codepoint)
        ==(a: Char, b: Char) Bool = a.codepoint == b.codepoint
      text
        Character lists are equal when they have the same length and
        corresponding characters agree. This will let content updates reuse an
        existing cache.
      code
        ==(a: List[Char], b: List[Char]) Bool =
          a.length() == b.length() and
            zip(a.iter(), b.iter()).all(\ pair: Tuple2[Char, Char] -> pair.a == pair.b)
      text
        chars decodes a string into characters. Invalid UTF-8 bytes become
        replacement characters, advancing one byte at a time so decoding can
        continue. char(text) expects exactly one decoded character.
      code
        decode_char(bytes: List[Byte], index: Int) NextState[Char, Int] =
          first = bytes.get(index).to_int()
          length = if first < 128 1
            if first >= 194 and first <= 223 2
            if first >= 224 and first <= 239 3
            if first >= 240 and first <= 244 4 0
          invalid = NextState(item = char(65533), state = index + 1)
          if length == 1 NextState(item = char(first), state = index + 1)
          if length == 0 or {index + length} > bytes.length() invalid
            identity(
              continuation = bytes.slice({index + 1} .. {index + length})
              if
                not(continuation.iter().all(\ byte: Byte ->
                  byte.to_int() >= 128 and byte.to_int() <= 191))
                invalid
                identity(
                  header =
                    if length == 2 first - 192
                    if length == 3 first - 224
                    first - 240
                  value =
                    continuation.iter().fold(header, \ value: Int, byte: Byte ->
                      {value * 64} + {byte.to_int() - 128})
                  minimum =
                    if length == 2 128 if length == 3 2048 65536
                  if
                    value < minimum or value > 1114111
                      or {value >= 55296 and value <= 57343}
                    invalid
                    NextState(item = char(value), state = index + length)))
        chars(value: String) List[Char] =
          bytes = value.bytes()
          iter_from_state(0, \ index: Int ->
            if index == bytes.length() none[NextState[Char, Int]]()
              some(decode_char(bytes, index))).to_list()
        char(value: String) Char =
          chars = value.chars()
          _ = assert(chars.length() == 1, "Expected one character.")
          chars.get(0)
      text
        bytes encodes one character as UTF-8. string packs the encoded bytes of
        a character or a whole character list back into text.
      code
        bytes(character: Char) List[Byte] =
          code = character.codepoint
          if code < 128 list(code.to_byte())
          if code < 2048 list(
            {192 + {code / 64}}.to_byte(), {128 + mod(code, 64)}.to_byte())
          if code < 65536 list(
            {224 + {code / 4096}}.to_byte(),
            {128 + mod(code / 64, 64)}.to_byte(),
            {128 + mod(code, 64)}.to_byte())
          list(
            {240 + {code / 262144}}.to_byte(),
            {128 + mod(code / 4096, 64)}.to_byte(),
            {128 + mod(code / 64, 64)}.to_byte(),
            {128 + mod(code, 64)}.to_byte())
        string(character: Char) String = string(character.bytes())
        string(chars: List[Char]) String =
          string(chars.iter().flat_map(\ character: Char -> character.bytes().iter()).to_list())
    chapter String padding
      text
        pad_left adds padding before a string until it has the requested number
        of characters. The padding repeats and is shortened to fit. Strings
        which are already wide enough stay unchanged.
      code
        pad_left(value: String, width: Int, padding: String) String =
          length = value.chars().length()
          if width <= length
            value
            identity(
              amount = width - length
              fill = padding.chars()
              _ = assert(fill.is_not_empty(), "Padding must not be empty.")
              prefix = {0..amount}.iter().map(\ index: Int ->
                fill.get(mod(index, fill.length()))).to_list()
              string(prefix) + value)
    chapter Hashing
      code
        Hash = struct { value: Int }
      code
        combine(a: Hash, b: Hash) Hash = Hash(value = a.value * 33 + b.value)
        combine_commutative(a: Hash, b: Hash) Hash =
          Hash(value = xor(a.value, b.value))
      code
        hash(int: Int) Hash = Hash(value = int)
      code
        hash(bool: Bool) Hash = {if bool 1 0}.hash()
      code
        hash(byte: Byte) Hash = byte.to_int().hash()
      code
        hash(value: Float) Hash = value.to_bits().hash()
      code
        hash[A](iter: Iter[A], hash_item: fun(A) Hash) Hash =
          iter.fold(5381.hash(), \ hash: Hash, item: A ->
            combine(hash, hash_item(item)))
      code
        hash_commutative[A](iter: Iter[A], hash_item: fun(A) Hash) Hash =
          iter.fold(5381.hash(), \ hash: Hash, item: A ->
            combine_commutative(hash, hash_item(item)))
      code
        hash[A](maybe: Maybe[A], payload_hash: fun(A) Hash) Hash =
          maybe %(
            none 0.hash()
            some(value) combine(1.hash(), payload_hash(value)))
      code
        hash[O, E](
          result: Result[O, E],
          ok_hash: fun(O) Hash,
          error_hash: fun(E) Hash
          ) Hash =
          result %(
            ok(value) combine(0.hash(), ok_hash(value))
            error(value) combine(1.hash(), error_hash(value)))
      code
        hash[A](list: List[A], hash_item: fun(A) Hash) Hash =
          combine(list.length().hash(), list.iter().hash(hash_item))
    chapter Formatting
      chapter FloatFormatting
        text
          Well, turns out, writing floats is pretty complicated. This is a
          relatively easy algorithm from
          https://blog.benoitblanchon.fr/lightweight-float-to-string Ordinary
          values use decimal notation, magnitudes at least 10^7 or at most 10^-5
          use an exponent. It rounds to nine fractional digits after
          normalization and removes trailing zeros. It is a display format, not
          a shortest round-trip representation. Special values print as nan,
          inf, and -inf. both signs of zero print as 0.
        code
          float_format_1e8 = 100000000.0
          float_format_1e16 = float_format_1e8 * float_format_1e8
          float_format_1e32 = float_format_1e16 * float_format_1e16
          float_format_1e64 = float_format_1e32 * float_format_1e32
          float_format_1e128 = float_format_1e64 * float_format_1e64
          float_format_1e256 = float_format_1e128 * float_format_1e128
          float_format_scales = list(
            tuple(256, float_format_1e256), tuple(128, float_format_1e128),
            tuple(64, float_format_1e64), tuple(32, float_format_1e32),
            tuple(16, float_format_1e16), tuple(8, float_format_1e8),
            tuple(4, 10000.0), tuple(2, 100.0), tuple(1, 10.0))
        code
          normalize(value: Float) Tuple2[Int, Float] =
            if value >= 10000000.0
              float_format_scales.iter().fold(tuple(0, value),
                \ state: Tuple2[Int, Float], scale: Tuple2[Int, Float] ->
                  if state.b >= scale.b
                    tuple(state.a + scale.a, state.b / scale.b)
                    state)
              if value > 0.0 and value <= 0.00001
                float_format_scales.iter().fold(tuple(0, value),
                  \ state: Tuple2[Int, Float], scale: Tuple2[Int, Float] ->
                    if state.b < {10.0 / scale.b}
                      tuple(state.a - scale.a, state.b * scale.b) state)
                tuple(0, value)
        text
          Rounding can carry from the fractional part into the integer part, or
          into the exponent when the normalized mantissa reaches ten.
        code
          split_into_integer_decimal_and_exponent(
            value: Float) Tuple3[Int, Int, Int] =
            normalized = value.normalize()
            integral = normalized.b.to_int()
            scaled = {normalized.b - integral.to_float()} * 1000000000.0
            decimal = scaled.to_int()
            rounded = decimal + if {scaled - decimal.to_float()} >= 0.5 1 0
            carry = rounded >= 1000000000
            whole = integral + if carry 1 0
            fraction = if carry 0 rounded
            if normalized.a != 0 and whole >= 10
              tuple(1, 0, normalized.a + 1)
              tuple(whole, fraction, normalized.a)
          format_float_decimals(value: Int, place: Int) String =
            if value == 0 "" identity(
              digit = value / place
              rest = mod(value, place)
              digit.format() + format_float_decimals(rest, place / 10))
          format_float_finite(value: Float) String =
            parts = value.split_into_integer_decimal_and_exponent()
            decimals =
              if parts.b == 0 "" "." + format_float_decimals(parts.b, 100000000)
            exponent = if parts.c == 0 "" "e" + parts.c.format()
            parts.a.format() + decimals + exponent
          format(value: Float) String =
            if value.is_nan() "nan"
            if value.is_negative_infinity() "-inf"
            if value.is_infinity() "inf"
            if value < 0.0 "-" + format_float_finite(0.0 - value)
              format_float_finite(value)
      code
        format(bool: Bool) String = if bool "true" "false"
        format(o: Ordering) String =
          o %(less "less" equal "equal" greater "greater")
      code
        format[A](maybe: Maybe[A], payload_format: fun(A) String) String =
          maybe %(
            none "none"
            some(value) "some(" + payload_format(value) + ")")
      code
        format[O, E](
          result: Result[O, E],
          ok_format: fun(O) String,
          error_format: fun(E) String
          ) String =
          result %(
            ok(value) "ok(" + ok_format(value) + ")"
            error(value) "error(" + error_format(value) + ")")
    chapter Runtime types and functions
      text
        Using reflection, you can write code that looks at arbitrary values or
        looks at the type system. You can also create new types, values, and
        functions during runtime.
      chapter Type
        text
          A Type is an opaque snapshot of a type and its dependencies.
        code
          Type = ...
        text
          The type functions takes no value arguments, only a type argument. It
          returns you a runtime representation of thattype.
        code
          type[T]() Type = ...
        text
          Passing a value lets the compiler infer the type argument. This
          overload simply calls the parameterless builtin with that type.
        code
          type[T](value: T) Type = type[T]()
        text
          Type equality is a nuanced topic. Usually, programming languages use
          either of these forms of equality:
        text
          Nominal typing means that types have an identity. If you define two
          types with the same fields, they are still different and values of one
          type can't be assigned to variables of the other type.
        text
          Structural typing means types have no identity. They are entirely
          summarized by their structure definition. Essentially, every type
          definition is only an alias.
        text
          In Orchard, types are generally nominal. If you define multiple struct
          types with the same fields, they will be different. However, the code
          you write can evolve over time -- you might create a Point, then
          change the definition of the Point type, and then continue on. So,
          type equality checking compares the (nominal) name as well as the
          (structural) definition.
        code
          ==(left: Type, right: Type) Bool = ...
        text
          Every type has a name.
        code
          name(type: Type) String = ...
        text
          Field and variant order is part of a type's representation.
        code
          FunctionType = struct { arguments: List[Type], returns: Type }
        code
          TypeInfo = enum {
            int,
            float,
            byte,
            string,
            list: Type,
            dynamic,
            type,
            struct: StructType,
            enum: EnumType,
            function: FunctionType,
            opaque }
          StructType = struct { fields: List[FieldType] }
          FieldType = struct { name: String, type: Type }
          EnumType = struct { variants: List[FieldType] }
          # TODO: have a separate VariantType
        code
          info(type: Type) TypeInfo = ...
        text
          A named lookup reuses a snapshot too. If a function combines different
          versions of one name, lookup is ambiguous; traverse its argument or
          result Type directly to select the precise version.
        code
          lookup_type(snapshot: Type, name: String) Maybe[Type] = ...
        chapter Describing new types
          text
            A finite table can describe new types, including mutually recursive
            records and enums. Edges are type names. Construction validates
            names, field uniqueness, and every reference before returning an
            opaque Type. A description never relabels an existing value.
          code
            TypeFieldDefinition = struct { name: String, type: String }
          code
            FunctionTypeDefinition = struct { arguments: List[String], returns: String }
          code
            TypeShape = enum {
              int,
              float, byte, string, list: String, dynamic, type,
              struct: List[TypeFieldDefinition], enum: List[TypeFieldDefinition],
              function: FunctionTypeDefinition, opaque }
          code
            TypeDefinition = struct { name: String, shape: TypeShape }
          code
            type_snapshot(definitions: List[TypeDefinition], name: String) Type = ...
  chapter User interface
    text
      Orchard supports two-dimensional graphics. The coordinate system starts at
      the top left with (0, 0) and coordinates generally use Floats. All
      graphics are vector-based and use the sRGB color space.
    chapter Color
      text
        Orchard uses the sRGB color space.
      code
        Color = struct { r: Byte, g: Byte, b: Byte }
      code
        color(r: Byte, g: Byte, b: Byte) Color = Color(r, g, b)
      code
        color(hex: String) Color =
          digits = hex.bytes()
          _ = assert(digits.length() == 7, "Expected #RRGGBB")
          _ = assert(digits.get(0) == byte("#"), "Expected #RRGGBB")
          color(
            digits.slice(1..3).parse_int(16).to_byte(),
            digits.slice(3..5).parse_int(16).to_byte(),
            digits.slice(5..7).parse_int(16).to_byte())
      code
        format(color: Color) String =
          "#"
            + color.r.format(16).pad_left(2, "0")
            + color.g.format(16).pad_left(2, "0")
            + color.b.format(16).pad_left(2, "0")
    chapter Vec2
      text
        A mathematical two-dimensional vector with no meaning associated to the
        components.
      code
        Vec2[A] = struct { x: A, y: A }
      code
        vec[A](x: A, y: A) Vec2[A] = Vec2(x, y)
      text
        Operations specifically for vectors of floating-point numbers.
      code
        +(a: Vec2[Float], b: Vec2[Float]) Vec2[Float] =
          Vec2(x = a.x + b.x, y = a.y + b.y)
      code
        -(a: Vec2[Float], b: Vec2[Float]) Vec2[Float] =
          Vec2(x = a.x - b.x, y = a.y - b.y)
      code
        *(f: Float, a: Vec2[Float]) Vec2[Float] =
          Vec2(x = f * a.x, y = f * a.y)
      code
        *(a: Vec2[Float], f: Float) Vec2[Float] = f * a
      code
        /(a: Vec2[Float], f: Float) Vec2[Float] =
          Vec2(x = a.x / f, y = a.y / f)
    chapter Offset
      text
        An offset in a two-dimensional plane. TODO: Do I need Offset when I have
        position and size?
      code
        Offset = struct { x: Float, y: Float }
      code
        offset(x: Float, y: Float) Offset = Offset(x, y)
      code
        to_vec(offset: Offset) Vec2[Float] = vec(offset.x, offset.y)
      code
        to_offset(vec: Vec2[Float]) Offset = offset(vec.x, vec.y)
      code
        +(a: Offset, b: Offset) Offset = {a.to_vec() + b.to_vec()}.to_offset()
      code
        -(a: Offset, b: Offset) Offset = {a.to_vec() - b.to_vec()}.to_offset()
      text
        Negating an offset reverses its direction, for example when moving a
        drawing opposite to the scroll position.
      code
        negate(delta: Offset) Offset = offset(0.0 - delta.x, 0.0 - delta.y)
      code
        *(f: Float, a: Offset) Offset = {f * a.to_vec()}.to_offset()
      code
        *(a: Offset, f: Float) Offset = {a.to_vec() * f}.to_offset()
      code
        /(a: Offset, f: Float) Offset = {a.to_vec() / f}.to_offset()
    chapter Position
      text
        A position in a two-dimensional plane.
      code
        Position = struct { x: Float, y: Float }
      code
        position(x: Float, y: Float) Position = Position(x, y)
      code
        to_vec(pos: Position) Vec2[Float] = vec(pos.x, pos.y)
      code
        to_position(vec: Vec2[Float]) Position = position(vec.x, vec.y)
      code
        +(pos: Position, offset: Offset) Position =
          {pos.to_vec() + offset.to_vec()}.to_position()
      code
        -(pos: Position, offset: Offset) Position =
          {pos.to_vec() - offset.to_vec()}.to_position()
      text
        Squared distance compares proximity without computing a square root.
      code
        distance_squared(a: Position, b: Position) Float =
          dx = a.x - b.x
          dy = a.y - b.y
          dx * dx + {dy * dy}
    chapter Size
      text
        A two-dimensional size.
      code
        Size = struct { width: Float, height: Float }
      code
        size(width: Float, height: Float) Size = Size(width, height)
      code
        to_vec(size: Size) Vec2[Float] = vec(size.width, size.height)
      code
        to_size(vec: Vec2[Float]) Size = size(vec.x, vec.y)
      code
        *(f: Float, size: Size) Size = {f * size.to_vec()}.to_size()
      code
        *(size: Size, f: Float) Size = {size.to_vec() * f}.to_size()
      code
        /(size: Size, f: Float) Size = {size.to_vec() / f}.to_size()
    chapter Rectangle
      code
        Rectangle = struct {
          left: Float, top: Float, right: Float, bottom: Float}
      code
        rectangle(
          left: Float, top: Float, right: Float, bottom: Float
        ) Rectangle =
          Rectangle(left, top, right, bottom)
      code
        rectangle(top_left: Position, size: Size) Rectangle =
          rectangle(
            top_left.x,
            top_left.y,
            top_left.x + size.width,
            top_left.y + size.height)
      code
        top_left(rect: Rectangle) Position = position(rect.left, rect.top)
      code
        top_right(rect: Rectangle) Position = position(rect.right, rect.top)
      code
        bottom_left(rect: Rectangle) Position = position(rect.left, rect.bottom)
      code
        bottom_right(rect: Rectangle) Position =
          position(rect.right, rect.bottom)
      code
        center(rect: Rectangle) Position =
          position(
            {rect.left + rect.right} / 2.0, {rect.top + rect.bottom} / 2.0)
      code
        contains(rect: Rectangle, pos: Position) Bool =
          {rect.left .. rect.right}.contains(pos.x)
            and {rect.top .. rect.bottom}.contains(pos.y)
      code
        intersection(a: Rectangle, b: Rectangle) Maybe[Rectangle] =
          left = max(a.left, b.left)
          top = max(a.top, b.top)
          right = min(a.right, b.right)
          bottom = min(a.bottom, b.bottom)
          if left < right and top < bottom
            some(rectangle(left, top, right, bottom))
            none[Rectangle]()
      text
        Clamp a position to a rectangle, including its edges.
      code
        clamp(pos: Position, bounds: Rectangle) Position =
          position(max(bounds.left, min(pos.x, bounds.right)),
            max(bounds.top, min(pos.y, bounds.bottom)))
    chapter Drawings
      text
        When Orchard code is asked to render something for the outside world, it
        returns draw commands. Think of these similar to the elements you would
        find in SVGs.
      chapter Historical Note: Why not pixels?
        text
          Initially, I tried to communicate with the outside world using pixel
          graphics. However, I believe that's not the right move as pixels are
          more difficult to handle in code. Having pixels (or some concept of a
          texture) requires either:
        text
          - mutable values (which Orchard doesn't have), or
        text
          - lots of copying on every texture modification (meh), or
        text
          - a super-smart optimizing compiler (which is useful but it has the  
          sort of slow-by-default-and-you-have-to-trust-the-black-box-to-work  
          feeling I don't like), or
        text
          - inefficient storage of individual pixels in trees.
        text
          By communicating the intent on a quite high-level, we can instead use
          GPUs when turning the high-level draw commands into pixels. This is
          also similar to how Flutter works: The Dart VM is decently fast, but
          not super fast, so it just emits draw commands that the lower-level
          C++ engine takes and turns into pixels.
      chapter Transformation Matrices
        text
          Transformation matrices ... exist. TODO: better description
        code
          TransformationMatrix = struct {
            a: Float, b: Float, c: Float, d: Float, e: Float, f: Float}
        code
          transformation_matrix(
            a: Float, b: Float, c: Float, d: Float, e: Float, f: Float
            ) TransformationMatrix =
            TransformationMatrix(a, b, c, d, e, f)
        code
          transform_translate(offset: Offset) TransformationMatrix =
            transformation_matrix(1.0, 0.0, 0.0, 1.0, offset.x, offset.y)
        code
          transform_scale(factor: Float) TransformationMatrix =
            transformation_matrix(factor, 0.0, 0.0, factor, 0.0, 0.0)
      chapter Paths
        code
          BezierTo = struct { control1: Position, control2: Position, to: Position }
          PathSegment = enum { move_to: Position, line_to: Position, bezier_to: BezierTo }
          Path = struct { segments: List[PathSegment] }
        code
          path() Path = Path(segments = list[PathSegment]())
        code
          move_to(path: Path, pos: Position) Path =
            Path(segments = path.segments.push(PathSegment.move_to(pos)))
        code
          move_to(path: Path, x: Float, y: Float) Path =
            path.move_to(position(x, y))
        code
          line_to(path: Path, pos: Position) Path =
            Path(segments = path.segments.push(PathSegment.line_to(pos)))
        code
          line_to(path: Path, x: Float, y: Float) Path =
            path.line_to(position(x, y))
        code
          bezier_to(
            path: Path, control1: Position, control2: Position, to: Position
            ) Path =
            Path(
              segments =
                path.segments.push(
                  PathSegment.bezier_to(BezierTo(control1, control2, to))))
        code
          bezier_to(
            path: Path,
            c1x: Float, c1y: Float,
            c2x: Float, c2y: Float,
            x: Float, y: Float,
            ) Path =
            path.bezier_to(
              position(c1x, c1y), position(c2x, c2y), position(x, y))
        text
          Approximate a circle with four cubic Bezier curves.
        code
          circle_path(center: Position, radius: Float) Path =
            x = center.x
            y = center.y
            k = radius * 0.5522847498307936
            path().move_to(x + radius, y)
              .bezier_to(x + radius, y + k, x + k, y + radius, x, y + radius)
              .bezier_to(x - k, y + radius, x - radius, y + k, x - radius, y)
              .bezier_to(x - radius, y - k, x - k, y - radius, x, y - radius)
              .bezier_to(x + k, y - radius, x + radius, y - k, x + radius, y)
        code
          rectangle_path(extent: Size) Path =
            path().move_to(0.0, 0.0).line_to(extent.width, 0.0)
              .line_to(extent.width, extent.height).line_to(0.0, extent.height)
        code
          rounded_rect_path(radius: Float, extent: Size) Path =
            r = max(0.0, min(radius, min(extent.width, extent.height) / 2.0))
            c = r * 0.4477152501692064
            path().move_to(r, 0.0).line_to(extent.width - r, 0.0)
              .bezier_to(extent.width - c, 0.0, extent.width, c, extent.width, r)
              .line_to(extent.width, extent.height - r)
              .bezier_to(extent.width, extent.height - c,
                extent.width - c, extent.height, extent.width - r, extent.height)
              .line_to(r, extent.height)
              .bezier_to(c, extent.height, 0.0, extent.height - c, 0.0, extent.height - r)
              .line_to(0.0, r).bezier_to(0.0, c, c, 0.0, r, 0.0)
      code
        DrawCommand = enum {
          nothing,
          fill_path: FillPath,
          transform: Transform,
          all: List[DrawCommand],
          clip: Clip}
        FillPath = struct { path: Path, color: Color }
        Transform = struct {
          by: TransformationMatrix, what: DrawCommand }
        Clip = struct { path: Path, what: DrawCommand }
      code
        draw_nothing() DrawCommand = DrawCommand.nothing
      code
        draw_filled_path(path: Path, color: Color) DrawCommand =
          DrawCommand.fill_path(FillPath(path, color))
      code
        draw_transformed(
          by: TransformationMatrix, what: DrawCommand) DrawCommand =
          DrawCommand.transform(Transform(by, what))
      text
        Translation moves a drawing without changing its shape. An offset
        supplies the horizontal and vertical displacement together.
      code
        draw_translated(by: Offset, what: DrawCommand) DrawCommand =
          draw_transformed(transform_translate(by), what)
      text
        When the two coordinates are already available, pass them directly.
      code
        draw_translated(x: Float, y: Float, what: DrawCommand) DrawCommand =
          draw_translated(offset(x, y), what)
      code
        draw_clipped(path: Path, what: DrawCommand) DrawCommand =
          DrawCommand.clip(Clip(path, what))
      text
        A rectangular clip uses the rectangle's actual position, retaining only
        the part of the drawing inside its four edges.
      code
        draw_clipped(bounds: Rectangle, what: DrawCommand) DrawCommand =
          draw_clipped(path().move_to(bounds.top_left()).line_to(bounds.top_right())
            .line_to(bounds.bottom_right()).line_to(bounds.bottom_left()), what)
      text
        A size describes a rectangular viewport starting at the origin.
      code
        draw_clipped(extent: Size, what: DrawCommand) DrawCommand =
          draw_clipped(rectangle(position(0.0, 0.0), extent), what)
      code
        draw_all(commands: List[DrawCommand]) DrawCommand =
          DrawCommand.all(commands)
      code
        draw_colored_rect(size: Size, color: Color) DrawCommand =
          draw_filled_path(rectangle_path(size), color)
      code
        Drawing = struct { draw: DrawCommand, size: Size }
    chapter Text rendering
      text
        Text rendering starts with glyph shapes, looks them up in a pixel font,
        positions them into lines, and turns the resulting layout into drawing
        commands. The subchapters follow those steps.
      chapter Glyph shapes
        text
          A glyph records its width and the paths which draw its pixels.
          pixel_glyph reads M as a filled pixel, a space as an empty pixel, and
          | as the end of a row.
        code
          Glyph = struct { width: Float, paths: List[Path] }
        code
          pixel_glyph(width: Int, pixels: String) Glyph =
            parsed = pixels.bytes().iter().fold(
              0, 0, list[Path](),
              \ x: Int, y: Int, paths: List[Path], pixel: Byte ->
                if pixel == byte("|")
                  tuple(0, y + 1, paths)
                  identity(
                    _ = assert(x < width, "Pixel glyph row exceeds its width")
                    _ = assert(
                      pixel == byte(" ") or pixel == byte("M"),
                      "Invalid glyph pixel")
                    px = x.to_float()
                    py = y.to_float()
                    tuple(
                      x + 1,
                      y,
                      if pixel == byte(" ")
                        paths
                        paths.push(
                          path()
                            .move_to(px, py)
                            .line_to(px + 1.0, py)
                            .line_to(px + 1.0, py + 1.0)
                            .line_to(px, py + 1.0)))))
            _ = assert(parsed.a == 0, "Pixel glyph must end with a row separator")
            Glyph(width = width.to_float(), paths = parsed.c)
      chapter Pixel font
        text
          The font uses a line height of 13 units and a fallback shape for
          characters outside its supported range. The table contains the glyphs
          for ASCII codepoints 32 through 126, in that order.
        code
          text_line_height = 13.0
          fallback_glyph = pixel_glyph(5,
            "M M M| M M|M M M| M M|M M M| M M|M M M| M M|M M M| M M|")
        code
          # Entries correspond to codepoints 32 through 126, in ASCII order.
          text_glyphs = list[Glyph]()
            .push(pixel_glyph(2, "|"))
            .push(pixel_glyph(2, "|MM|MM|MM|MM|MM|MM||MM|MM|"))
            .push(pixel_glyph(3, "|M M|M M|M M|"))
            .push(pixel_glyph(6, "|| M  M|MMMMMM| M  M| M  M| M  M|MMMMMM| M  M|"))

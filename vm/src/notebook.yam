        zig build run -- --ui src/notebook.yam.objects
      code
        counter() Widget[Never] =
          stateful[Int, Never, Int](
            0,
            \ state: Int, change: Int -> new_state[Int, Never](state + change),
            \ state: Int ->
              row(list(
                button(-1, color("#e0b040"),
                  padding(6.0, text("decrement")).cast_message[Int]()),
                sized_box(40.0,
                  text_line_height + 12.0, center(text(state.format())))
                . cast_message[Int](),
                button(1, color("#30a080"),
                  padding(6.0, text("increment")).cast_message[Int]()))))
      code
        editable_text_example() Widget[Never] =
          stateful[String, Never, String](
            "Edit this text",
            \ value: String, message: String ->
              new_state[String, Never](message),
            \ value: String -> padding(8.0, editable_text(value)))

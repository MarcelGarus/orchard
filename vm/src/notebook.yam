      chapter Glyph lookup
        text
          Look up supported characters by their codepoint, and use the fallback
          glyph for every other character.
        code
          find_glyph(character: Char) Glyph =
            codepoint = character.codepoint
            if codepoint >= 32 and codepoint <= 126
              text_glyphs.get(codepoint - 32)
              fallback_glyph
      chapter Text layout
        text
          Layout wraps whole words at spaces and respects explicit newlines.
          Words wider than the available width overflow instead of being split.
          Each line is 13 units high, including a trailing empty line after a
          newline. Empty text has zero size. There is one unit between glyphs.
        chapter Layout data
          text
            The result stores positioned glyphs and the overall size. During
            layout, the state also tracks the current pen position and word
            boundaries.
          code
            PositionedGlyph = struct { glyph: Glyph, position: Position }
            TextLayout = struct { size: Size, glyphs: List[PositionedGlyph] }
            TextLayoutState = struct {
              x: Float,
              y: Float,
              width: Float,
              height: Float,
              word_start: Bool,
              glyphs: LinkedList[PositionedGlyph]}
        chapter Measuring words
          text
            Measure the next word before placing its first glyph, so wrapping
            can move the entire word to the next line.
          code
            text_word_width(chars: List[Char], index: Int) Float =
              if index == chars.length() 0.0 identity(
                char = chars.get(index)
                if char.codepoint == 32 or char.codepoint == 10 0.0
                  identity(
                    rest = text_word_width(chars, index + 1)
                    find_glyph(char).width + if rest > 0.0 1.0 + rest 0.0))
        chapter Positioning glyphs
          text
            Walk the characters in order. Newlines advance the pen to a fresh
            line; word boundaries decide whether to wrap. Each placed glyph
            extends the measured bounds.
          code
            layout_text(chars: List[Char], max_width: Maybe[Float]) TextLayout =
              layout = chars.iter().indexed().fold(
                TextLayoutState(
                  x = 0.0,
                  y = 0.0,
                  width = 0.0,
                  height = 0.0,
                  word_start = true,
                  glyphs = empty_linked_list[PositionedGlyph]()),
                \ state: TextLayoutState, item: Indexed[Char] ->
                  if item.item.codepoint == 10
                    TextLayoutState(
                      x = 0.0,
                      y = state.y + text_line_height,
                      width = state.width,
                      height = state.y + {2.0 * text_line_height},
                      word_start = true,
                      glyphs = state.glyphs)
                    identity(
                      wrap = state.word_start and item.item.codepoint != 32 and state.x > 0.0
                        and
                          {max_width %(
                            none false
                            some(limit)
                              state.x + text_word_width(chars, item.index) > limit)}
                      x = if wrap 0.0 state.x
                      y = if wrap state.y + text_line_height state.y
                      glyph = find_glyph(item.item)
                      TextLayoutState(
                        x = x + glyph.width + 1.0, y,
                        width = max(state.width, x + glyph.width),
                        height = max(state.height, y + text_line_height),
                        word_start = item.item.codepoint == 32,
                        glyphs =
                          cons(
                            PositionedGlyph(glyph, position = position(x, y)),
                            state.glyphs))))
              TextLayout(
                size = size(layout.width, layout.height),
                glyphs = layout.glyphs.iter().to_list().reversed())
          code
            layout_text(chars: List[Char], max_width: Float) TextLayout =
              layout_text(chars, some(max_width))
            layout_text(chars: List[Char]) TextLayout =
              layout_text(chars, none[Float]())
      chapter Drawing text
        text
          Draw each glyph in the requested color, then translate those paths to
          the positions computed by layout. The Drawing keeps the layout size.
        code
          draw_glyph(glyph: Glyph, color: Color) DrawCommand =
            draw_all(
              glyph.paths.iter()
                .map(\ path: Path -> draw_filled_path(path, color))
                .to_list())
        code
          draw_text(layout: TextLayout, color: Color) Drawing =
            Drawing(
              size = layout.size,
              draw =
                draw_all(
                  layout.glyphs.iter()
                    .map(\ glyph: PositionedGlyph ->
                      draw_translated(glyph.position.x, glyph.position.y,
                        draw_glyph(glyph.glyph, color)))
                    .to_list()))
  chapter Host interaction
    text
      The host supplies notebook documents and app events. Apps return drawing
      commands and explicit effects for the host to perform.
    chapter Notebook data
      text
        A notebook is a tree of chapters. Each chapter has a title and a list of
        cells. Text and code cells hold strings; a chapter cell holds another
        chapter, allowing notebooks to nest. An eval cell holds one expression
        whose result is displayed by the live notebook. Bootstrap compilation
        skips eval cells, including incomplete expressions while editing.
      text
        The host parses and saves notebook documents. These fields and variants
        form a fixed ABI shared with Zig; their names, types, and order matter.
      code
        Chapter = struct { title: String, children: List[Cell] }
        Cell = enum {
          text: String, code: String, chapter: Chapter, eval: String }
      code
        chapter(title: String, children: List[Cell]) Chapter =
          Chapter(title, children)
    chapter Notebook paths
      text
        A path locates a chapter through child-cell indices. Each index must
        select a chapter cell at that level.
      code
        NotebookPath = struct { indices: List[Int] }
      text
        An empty path refers to the notebook's root chapter.
      code
        notebook_path() NotebookPath = NotebookPath(indices = list[Int]())
      text
        Testing for the root needs only the path's length.
      code
        is_empty(path: NotebookPath) Bool = path.indices.is_empty()
      text
        Append a child index to descend one level into the document.
      code
        push(path: NotebookPath, index: Int) NotebookPath =
          NotebookPath(indices = path.indices.push(index))
      text
        Moving up removes the final index. The root has no parent.
      code
        parent(path: NotebookPath) Maybe[NotebookPath] =
          if path.is_empty() none[NotebookPath]()
            some(NotebookPath(indices = path.indices.without_last()))
      text
        Resolve a path one chapter at a time. Reaching a text or code cell means
        the path is invalid.
      code
        get(root: Chapter, path: NotebookPath) Chapter =
          if path.is_empty() root
            root.children.get(path.indices.first()) %(
              chapter(child)
                child.get(NotebookPath(indices = path.indices.without_first()))
              default crash("Expected a chapter at the notebook path."))
      text
        To replace a nested chapter, rebuild its ancestors along the path.
        Unchanged sibling cells remain shared with the original document.
      code
        replace_chapter(
          root: Chapter, path: NotebookPath, updated: Chapter) Chapter =
          if path.is_empty() updated
            identity(
              index = path.indices.first()
              child = root.children.get(index) %(
                chapter(child) child
                default crash("Expected a chapter at the notebook path."))
              Chapter(title = root.title, children = root.children.set(index,
                Cell.chapter(child.replace_chapter(
                  NotebookPath(indices = path.indices.without_first()),
                  updated)))))
    chapter Apps
      text
        Rendering receives the current window size. Handling an event returns
        the next app and explicit commands for the host. save_notebook carries a
        structured document; the host handles serialization and disk access.
      text
        Key presses identify a physical key and its modifier flags. Text input
        will arrive in a separate event.
      code
        KeyPressed = struct {
          keycode: Int, control: Bool, shift: Bool, alt: Bool}
      text
        A character event carries one Unicode scalar value, independent of the
        key that produced it.
      code
        CharEntered = struct { codepoint: Int }
      text
        Wheel events include the pointer position and a scroll delta in logical
        drawing units.
      code
        MouseScrolled = struct { position: Position, delta: Offset }
      text
        These are the inputs the host can deliver: window changes, keyboard and
        pointer input, and feedback from saving.
      code
        Event = enum {
          window_resized: Size,
          key_pressed: KeyPressed,
          char_entered: CharEntered,
          mouse_pressed: Position,
          mouse_moved: Position,
          mouse_scrolled: MouseScrolled,
          mouse_released: Position,
          mouse_left,
          save_completed,
          save_failed: String}
      text
        An app requests a save by returning the complete structured document.
        The host owns serialization and disk access.
      code
        AppCommand = enum { save_notebook: Chapter }
      text
        An event handler returns the next app together with its explicit
        effects. App and AppResult refer to one another, so their definitions
        share a code cell.
      code
        AppResult = struct { app: App, commands: List[AppCommand] }
        App = struct { render: fun(Size) DrawCommand, handle: fun(Event) AppResult }
  chapter Compiler
    text
      The compiler is ordinary notebook code. Parsing produces source trees;
      type checking resolves names and creates runtime expression trees. Cell
      caches retain those results and the exact names they depended on.
    chapter Resource budgets
      text
        Parsing and compilation have separate budgets from execution. Building
        concrete functions and their reflected types needs more work than a
        small eval expression. Global initializers get a larger execution
        budget too, so they can rebuild data such as the font table at startup.
        The trusted verifier also bounds expression depth.
      code
        compiler_parse_fuel = 10000000
      code
        compiler_compile_fuel = 50000000
      code
        compiler_eager_fuel = 2000000
      code
        compiler_eval_fuel = 100000
      code
        compiler_initializer_fuel = 10000000
    chapter Source trees
      text
        A type is a name with zero or more type arguments. Function types use
        the name fun and place their return type after their argument types.
      code
        SourceType = struct { name: String, arguments: List[SourceType] }
      text
        Construct an unparameterized type by supplying only its name.
      code
        source_type(name: String) SourceType = SourceType(name, arguments = list[SourceType]())
      text
        Name and argument equality also works for nested generic types.
      code
        ==(a: SourceType, b: SourceType) Bool =
          a.name == b.name and a.arguments.length() == b.arguments.length()
            and zip(a.arguments.iter(), b.arguments.iter()).all(
              \ pair: Tuple2[SourceType, SourceType] -> pair.a == pair.b)
    chapter Syntax data
      text
        Expressions and declarations share a type vocabulary. Recursive syntax
        nodes are values, so parsing never introduces mutable references into
        the notebook. A missing function body marks a builtin declaration.
      code
        SourceExpression = enum {
          integer: Int, floating: Float, string: String, name: String,
          call: SourceCall, lambda: SourceLambda, record: SourceRecord,
          variant: SourceVariant, field: SourceMember, binding: SourceNamed,
          match: SourceMatch, block: List[SourceExpression] }
        SourceCall = struct {
          callee: SourceExpression, types: Maybe[List[SourceType]], arguments: List[SourceExpression] }
        SourceLambda = struct { parameters: List[SourceField], body: SourceExpression }
        SourceRecord = struct { type: SourceType, fields: List[SourceNamed] }
        SourceVariant = struct { type: SourceType, name: String, value: SourceExpression }
        SourceMember = struct { value: SourceExpression, name: String }
        SourceNamed = struct { name: String, value: SourceExpression }
        SourceMatch = struct {
          value: SourceExpression, cases: List[SourceCase], otherwise: Maybe[SourceExpression] }
        SourceCase = struct {
          name: String, binding: Maybe[String], body: SourceExpression }
        SourceField = struct { name: String, type: SourceType }
        SourceTypeKind = enum {
          primitive, record: List[SourceField], variant: List[SourceField], alias: SourceType }
        SourceTypeDeclaration = struct {
          name: String, parameters: List[String], kind: SourceTypeKind }
        SourceSignature = struct {
          name: String, parameters: List[String], arguments: List[SourceField], returns: SourceType }
        SourceFunction = struct { signature: SourceSignature, body: Maybe[SourceExpression] }
        SourceDefinition = enum {
          type: SourceTypeDeclaration, function: SourceFunction, global: SourceNamed }
      text
        Calls without explicit type arguments leave inference to the checker.
      code
        source_call(callee: SourceExpression, arguments: List[SourceExpression]) SourceExpression =
          SourceExpression.call(SourceCall(callee, arguments, types = none[List[SourceType]]()))
    chapter Parser cursors
      text
        A cursor shares decoded characters with every later cursor. Parsing a
        construct returns its value and the remaining cursor together.
      code
        SourceParser = struct { characters: List[Char], index: Int }
      code
        SourceParsed[A] = struct { value: A, rest: SourceParser }
      text
        Start each cell independently. Empty and incomplete cells are valid
        documents, but parsing their code may report a diagnostic.
      code
        source_parser(source: String) SourceParser = SourceParser(characters = source.chars(), index = 0)
      code
        source_result[A](rest: SourceParser, value: A) SourceParsed[A] = SourceParsed(value, rest)
      text
        End of input has codepoint zero, which cannot occur in a notebook file.
      code
        source_current(p: SourceParser) Int =
          p.characters.get_maybe(p.index).map(\ c: Char -> c.codepoint) or 0
      code
        source_advance(p: SourceParser, amount: Int) SourceParser =
          SourceParser(characters = p.characters, index = p.index + amount)
      text
        Diagnostics identify the character at which parsing stopped. The live
        evaluator catches this message and displays it beneath the cell.
      code
        source_error(p: SourceParser, message: String) Never =
          crash(message + " (character " + p.index.format() + ")")
      text
        Identifier characters include letters, underscores, and digits after the
        first character. Names in the language are ASCII.
      code
        source_letter(code: Int) Bool =
          {code >= 65 and code <= 90} or {code >= 97 and code <= 122} or code == 95
      code
        source_digit(code: Int) Bool = code >= 48 and code <= 57
      code
        source_name_char(code: Int) Bool = source_letter(code) or source_digit(code)
      text
        Whitespace and comments have no grammatical meaning inside a code cell.
        A hash starts a comment through the next newline.
      code
        source_skip_comment(p: SourceParser) SourceParser =
          if p.source_current() == 0 or p.source_current() == 10 p
            source_skip_comment(p.source_advance(1))
      code
        source_skip(p: SourceParser) SourceParser =
          code = p.source_current()
          if code == 32 or code == 9 or code == 10 or code == 13
            source_skip(p.source_advance(1))
          if code == 35 source_skip(source_skip_comment(p.source_advance(1))) p
      text
        Prefix matching leaves the cursor untouched on failure. A separate
        keyword matcher will also check the following name boundary.
      code
        source_prefix(p: SourceParser, expected: List[Char], index: Int) Bool =
          if index == expected.length() true
          if {p.index + index} >= p.characters.length() false
            p.characters.get(p.index + index) == expected.get(index)
              and source_prefix(p, expected, index + 1)
      code
        source_take(p: SourceParser, token: String) Maybe[SourceParser] =
          start = p.source_skip()
          expected = token.chars()
          if source_prefix(start, expected, 0) some(start.source_advance(expected.length()))
            none[SourceParser]()
      code
        source_keyword(p: SourceParser, token: String) Maybe[SourceParser] =
          p.source_take(token).flat_map(\ rest: SourceParser ->
            if source_name_char(rest.source_current()) none[SourceParser]() some(rest))
      code
        source_expect(p: SourceParser, token: String) SourceParser =
          p.source_take(token) or source_error(p, "Expected " + token)
      text
        Extract a matched name without rebuilding the full source string.
      code
        source_name_end(p: SourceParser) SourceParser =
          if source_name_char(p.source_current()) source_name_end(p.source_advance(1)) p
      code
        source_name(p: SourceParser) Maybe[SourceParsed[String]] =
          start = p.source_skip()
          if not(source_letter(start.source_current())) none[SourceParsed[String]]()
            identity(
              end = source_name_end(start)
              some(source_result(end, string(start.characters.slice(start.index..end.index)))))
      code
        source_require_name(p: SourceParser) SourceParsed[String] =
          source_name(p) or source_error(p, "Expected a name")
      text
        Operators are names too. A single equals sign belongs to a binding,
        while a single dot belongs to member access.
      code
        source_operator_char(code: Int) Bool =
          "!~@^`/&|*+$-<>=.".chars().iter().any(\ c: Char -> c.codepoint == code)
      code
        source_operator_end(p: SourceParser) SourceParser =
          if source_operator_char(p.source_current()) source_operator_end(p.source_advance(1)) p
      code
        source_operator(p: SourceParser) Maybe[SourceParsed[String]] =
          start = p.source_skip()
          end = source_operator_end(start)
          value = string(start.characters.slice(start.index..end.index))
          if value == "" or value == "=" or value == "." none[SourceParsed[String]]()
            some(source_result(end, value))
      code
        source_binding_equals(p: SourceParser) Maybe[SourceParser] =
          if {p.source_take("==") is some} or {p.source_take("=>") is some} none[SourceParser]()
            p.source_take("=")
    chapter Parsing types
      text
        Types and their argument lists are recursive. Function type arguments
        may have names, but names do not contribute to the resulting type.
      code
        source_parse_type(p: SourceParser) SourceParsed[SourceType] =
          function = p.source_keyword("fun")
          function %(
            some(after)
              arguments = source_parse_types(after.source_expect("("), ")", true)
              returns = source_parse_type(arguments.rest)
              source_result(returns.rest, SourceType(name = "fun",
                arguments = arguments.value.push(returns.value)))
            none
              name = p.source_require_name()
              _ = if name.value == "_" nothing
                if {name.value.chars().first().codepoint >= 65}
                  and {name.value.chars().first().codepoint <= 90} nothing
                  source_error(p, "Expected an uppercase type name")
              arguments = name.rest.source_take("[") %(
                none source_result(name.rest, list[SourceType]())
                some(after) source_parse_types(after, "]", false))
              source_result(arguments.rest, SourceType(name = name.value, arguments = arguments.value)))
        source_parse_types(p: SourceParser, closing: String, named: Bool) SourceParsed[List[SourceType]] =
          p.source_take(closing) %(
            some(rest) source_result(rest, list[SourceType]())
            none
              start = if named
                p.source_name().flat_map(\ name: SourceParsed[String] -> name.rest.source_take(":")) or p
                p
              item = source_parse_type(start)
              item.rest.source_take(",") %(
                some(after)
                  rest = source_parse_types(after, closing, named)
                  source_result(rest.rest, list(item.value).push_all(rest.value))
                none source_result(item.rest.source_expect(closing), list(item.value))))
      text
        Type parameter declarations accept names rather than arbitrary types. An
        absent list and an empty list both declare no parameters.
      code
        source_parse_parameters(p: SourceParser) SourceParsed[List[String]] =
          p.source_take("[") %(
            none source_result(p, list[String]())
            some(after)
              types = source_parse_types(after, "]", false)
              _ = assert(types.value.iter().all(\ t: SourceType -> t.arguments.is_empty()),
                "Type parameters must be names.")
              source_result(types.rest, types.value.iter().map(\ t: SourceType -> t.name).to_list()))
    chapter Parsing expressions
      text
        Grammar helpers receive the expression parser as an ordinary function.
        This keeps their dependencies explicit and lets us introduce lists,
        constructors, and branches before tying the recursive grammar together.
      code
        SourceExpressionParser = fun(SourceParser, Int) SourceParsed[SourceExpression]
      text
        Digit scans keep a count for positioning decimal fractions. Underscores
        are separators and do not contribute to the number.
      code
        SourceDigits = struct { value: Int, count: Int, rest: SourceParser }
      code
        source_digits(p: SourceParser, value: Int, count: Int) SourceDigits =
          c = p.source_current()
          if source_digit(c) source_digits(p.source_advance(1), {value * 10} + c - 48, count + 1)
          if c == 95 source_digits(p.source_advance(1), value, count)
            SourceDigits(value, count, rest = p)
      text
        A dot followed by digits makes a float. Otherwise the dot remains for
        member access or a range operator, matching bootstrap parsing.
      code
        source_number(p: SourceParser) SourceParsed[SourceExpression] =
          start = p.source_skip()
          negative = start.source_current() == 45
          digits = source_digits(if negative start.source_advance(1) start, 0, 0)
          _ = assert(digits.count > 0, "Expected digits.")
          sign = if negative {0 - 1} 1
          fraction = digits.rest.source_take(".").map(\ after: SourceParser -> source_digits(after, 0, 0))
          fraction %(
            some(part)
              if part.count == 0 source_result(digits.rest, SourceExpression.integer(sign * digits.value))
                identity(
                  _ = assert(part.count <= 18, "Too many decimal places.")
                  value = digits.value.to_float() + {part.value.to_float() / {10.pow(part.count)}.to_float()}
                  source_result(part.rest, SourceExpression.floating(sign.to_float() * value)))
            none source_result(digits.rest, SourceExpression.integer(sign * digits.value)))
      text
        Strings support the same escapes and continued lines as the bootstrap
        parser. Interpolation is not part of the current language.
      code
        source_string(p: SourceParser, value: List[Char]) SourceParsed[SourceExpression] =
          c = p.source_current()
          if c == 0 source_error(p, "Unterminated string literal")
          if c == 34 source_result(p.source_advance(1), SourceExpression.string(string(value)))
          if c == 123 source_error(p, "String interpolation is not implemented")
          if c == 92
            identity(
              after = p.source_advance(1)
              escape = after.source_current()
              decoded = if escape == 110 10
                if escape == 92 or escape == 34 or escape == 123 or escape == 125 escape
                  source_error(after, "Unknown string escape")
              source_string(after.source_advance(1), value.push(char(decoded))))
          if c == 10
            identity(
              after = source_string_indent(p.source_advance(1))
              _ = assert(after.source_current() == 39, "A continued string line needs a single quote.")
              source_string(after.source_advance(1), value))
            source_string(p.source_advance(1), value.push(char(c)))
        source_string_indent(p: SourceParser) SourceParser =
          if p.source_current() == 32 source_string_indent(p.source_advance(1)) p
      text
        Argument lists require commas. Blocks instead contain adjacent
        expressions. Both stop before the closing delimiter is consumed twice.
      code
        source_expressions(p: SourceParser, closing: String, commas: Bool,
          parse: SourceExpressionParser) SourceParsed[List[SourceExpression]] =
          p.source_take(closing) %(
            some(rest) source_result(rest, list[SourceExpression]())
            none
              item = parse(p, 0 - 1)
              _ = assert(item.rest.index > p.index, "Expression parser made no progress.")
              more = if commas item.rest.source_take(",") some(item.rest)
              more %(
                none source_result(item.rest.source_expect(closing), list(item.value))
                some(after)
                  rest = source_expressions(after, closing, commas, parse)
                  source_result(rest.rest, list(item.value).push_all(rest.value))))
      text
        Record fields use names, with shorthand for a field whose value has the
        same name. Duplicate and missing fields are checked after parsing.
      code
        source_record_fields(p: SourceParser, parse: SourceExpressionParser) SourceParsed[List[SourceNamed]] =
          p.source_take(")") %(
            some(rest) source_result(rest, list[SourceNamed]())
            none
              name = p.source_require_name()
              value = name.rest.source_binding_equals() %(
                none source_result(name.rest, SourceExpression.name(name.value))
                some(after) parse(after, 0 - 1))
              field = SourceNamed(name = name.value, value = value.value)
              value.rest.source_take(",") %(
                none source_result(value.rest.source_expect(")"), list(field))
                some(after)
                  rest = source_record_fields(after, parse)
                  source_result(rest.rest, list(field).push_all(rest.value))))
      text
        A typed field appears in parameter lists and record declarations. Enum
        variants may omit their payload type and then carry Nothing.
      code
        source_fields(p: SourceParser, closing: String, optional: Bool) SourceParsed[List[SourceField]] =
          p.source_take(closing) %(
            some(rest) source_result(rest, list[SourceField]())
            none
              name = p.source_require_name()
              type = name.rest.source_take(":") %(
                some(after) source_parse_type(after)
                none
                  if optional source_result(name.rest, source_type("Nothing"))
                    source_error(name.rest, "Expected a parameter type"))
              field = SourceField(name = name.value, type = type.value)
              type.rest.source_take(",") %(
                none source_result(type.rest.source_expect(closing), list(field))
                some(after)
                  rest = source_fields(after, closing, optional)
                  source_result(rest.rest, list(field).push_all(rest.value))))
      text
        A case can bind its payload in parentheses. The same form is used for
        the alternative binding in an or expression.
      code
        source_optional_binding(p: SourceParser) SourceParsed[Maybe[String]] =
          p.source_take("(") %(
            none source_result(p, none[String]())
            some(after)
              name = after.source_require_name()
              source_result(name.rest.source_expect(")"), some(name.value)))
      code
        SourceCases = struct { cases: List[SourceCase], otherwise: Maybe[SourceExpression] }
      text
        Match arms are expressions and may themselves contain matches. A default
        arm must be last; exhaustiveness is a type-checking concern.
      code
        source_cases(p: SourceParser, parse: SourceExpressionParser) SourceParsed[SourceCases] =
          p.source_take(")") %(
            some(rest) source_result(rest, SourceCases(cases = list[SourceCase](), otherwise = none[SourceExpression]()))
            none
              p.source_keyword("default") %(
                some(after)
                  body = parse(after, 0 - 1)
                  source_result(body.rest.source_expect(")"),
                    SourceCases(cases = list[SourceCase](), otherwise = some(body.value)))
                none
                  name = p.source_require_name()
                  binding = source_optional_binding(name.rest)
                  body = parse(binding.rest, 0 - 1)
                  rest = source_cases(body.rest, parse)
                  source_result(rest.rest, SourceCases(otherwise = rest.value.otherwise,
                    cases = list(SourceCase(name = name.value, binding = binding.value, body = body.value))
                      .push_all(rest.value.cases)))))
      text
        An uppercase name starts a constructor. A record has named fields; an
        enum names one variant and optionally supplies its payload.
      code
        source_construct(p: SourceParser, parse: SourceExpressionParser) SourceParsed[SourceExpression] =
          type = source_parse_type(p)
          type.rest.source_take("(") %(
            some(after)
              fields = source_record_fields(after, parse)
              source_result(fields.rest, SourceExpression.record(SourceRecord(type = type.value, fields = fields.value)))
            none
              name = type.rest.source_expect(".").source_require_name()
              value = name.rest.source_take("(") %(
                none source_result(name.rest, SourceExpression.block(list[SourceExpression]()))
                some(after)
                  item = parse(after, 0 - 1)
                  source_result(item.rest.source_expect(")"), item.value))
              source_result(value.rest, SourceExpression.variant(
                SourceVariant(type = type.value, name = name.value, value = value.value))))
      text
        A lambda declares typed parameters before its arrow. Its body remains
        unevaluated source until type checking determines its result type.
      code
        source_lambda(p: SourceParser, parse: SourceExpressionParser) SourceParsed[SourceExpression] =
          parameters = source_fields(p, "->", false)
          body = parse(parameters.rest, 0 - 1)
          source_result(body.rest, SourceExpression.lambda(SourceLambda(parameters = parameters.value, body = body.value)))
      text
        If is syntactic sugar for matching Bool.true, with the false branch as
        the default. This also preserves lazy branch evaluation.
      code
        source_if(p: SourceParser, parse: SourceExpressionParser) SourceParsed[SourceExpression] =
          condition = parse(p, 0 - 1)
          yes = parse(condition.rest, 0 - 1)
          no = parse(yes.rest, 0 - 1)
          source_result(no.rest, SourceExpression.match(SourceMatch(value = condition.value,
            cases = list(SourceCase(name = "true", binding = none[String](), body = yes.value)),
            otherwise = some(no.value))))
      text
        Primary expressions introduce values. Suffixes such as calls and
        operators will be attached afterwards according to precedence.
      code
        source_primary(p: SourceParser, parse: SourceExpressionParser) SourceParsed[SourceExpression] =
          start = p.source_skip()
          c = start.source_current()
          if c == 34 source_string(start.source_advance(1), list[Char]())
          if source_digit(c) or {c == 45 and source_digit(start.source_advance(1).source_current())}
            source_number(start)
          if c == 123
            identity(
              block = source_expressions(start.source_advance(1), "}", false, parse)
              source_result(block.rest, SourceExpression.block(block.value)))
          if c == 92 source_lambda(start.source_advance(1), parse)
          if c >= 65 and c <= 90 source_construct(start, parse)
          start.source_keyword("if") %(
            some(after) source_if(after, parse)
            none
              name = start.source_require_name()
              _ = assert(name.value != "_", "The discard binding cannot be read.")
              source_result(name.rest, SourceExpression.name(name.value)))
      text
        Bindings preceding a value form a block. Parsing a binding's value stops
        before the next independent expression, just as in bootstrap.
      code
        source_bindings(p: SourceParser, parse: SourceExpressionParser) SourceParsed[List[SourceExpression]] =
          p.source_name().flat_map(\ name: SourceParsed[String] ->
            name.rest.source_binding_equals().map(\ after: SourceParser ->
              value = parse(after, 0 - 1)
              source_result(value.rest, SourceExpression.binding(SourceNamed(name = name.value, value = value.value))))) %(
            none source_result(p, list[SourceExpression]())
            some(item)
              rest = source_bindings(item.rest, parse)
              source_result(rest.rest, list(item.value).push_all(rest.value)))
      text
        and and or use the library's ControlFlow protocol. This makes the same
        syntax work for booleans, optional values, and fallible results.
      code
        source_alternative(left: SourceExpression, operation: String,
          binding: Maybe[String], right: SourceExpression) SourceExpression =
          value = source_call(SourceExpression.field(SourceMember(value = left, name = operation)), list[SourceExpression]())
          SourceExpression.match(SourceMatch(value,
            cases = list(
              SourceCase(name = "short_circuit", binding = some("$primary"), body = SourceExpression.name("$primary")),
              SourceCase(name = "evaluate_alternative", binding, body = right)),
            otherwise = none[SourceExpression]()))
      text
        A suffix parser returns none when the next token belongs to a later
        expression. Calls and members bind most tightly; binary operators share
        one left-associative level, followed by and, or, is, and matches.
      code
        source_suffix(p: SourceParser, left: SourceExpression, precedence: Int,
          parse: SourceExpressionParser) Maybe[SourceParsed[SourceExpression]] =
          start = p.source_skip()
          if precedence <= {0 - 1} and {start.source_take("%") is some}
            identity(
              arms = source_cases(start.source_expect("%").source_expect("("), parse)
              some(source_result(arms.rest, SourceExpression.match(SourceMatch(value = left,
                cases = arms.value.cases, otherwise = arms.value.otherwise)))))
          if precedence <= 0 and {start.source_keyword("is") is some}
            identity(
              name = start.source_expect("is").source_require_name()
              some(source_result(name.rest, SourceExpression.match(SourceMatch(value = left,
                cases = list(SourceCase(name = name.value, binding = none[String](), body = SourceExpression.name("true"))),
                otherwise = some(SourceExpression.name("false")))))))
          if precedence <= 1 and {start.source_keyword("or") is some}
            identity(
              binding = source_optional_binding(start.source_expect("or"))
              right = parse(binding.rest, 1)
              some(source_result(right.rest, source_alternative(left, "or", binding.value, right.value))))
          if precedence <= 2 and {start.source_keyword("and") is some}
            identity(
              right = parse(start.source_expect("and"), 2)
              some(source_result(right.rest, source_alternative(left, "and", none[String](), right.value))))
          operator = if precedence <= 3 source_operator(start) none[SourceParsed[String]]()
          operator %(
            some(op)
              after_parameters = source_parse_parameters(op.rest)
              if after_parameters.rest.source_take("(") is some none[SourceParsed[SourceExpression]]()
                identity(
                  right = parse(op.rest, 4)
                  some(source_result(right.rest, source_call(SourceExpression.name(op.value), list(left, right.value)))))
            none
              if start.source_take(".") is some
                identity(
                  name = start.source_expect(".").source_require_name()
                  some(source_result(name.rest, SourceExpression.field(SourceMember(value = left, name = name.value)))))
              types = start.source_take("[") %(
                none source_result(start, none[List[SourceType]]())
                some(after)
                  args = source_parse_types(after, "]", false)
                  source_result(args.rest, some(args.value)))
              types.rest.source_take("(") %(
                none
                  if types.value is some source_error(types.rest, "Expected a call after type arguments")
                    none[SourceParsed[SourceExpression]]()
                some(after)
                  args = source_expressions(after, ")", true, parse)
                  some(source_result(args.rest, SourceExpression.call(SourceCall(callee = left,
                    types = types.value, arguments = args.value))))))
      text
        The recursive entry point supplies itself to the grammar helpers. After
        collecting bindings, it keeps attaching suffixes until the next token
        belongs to an enclosing construct or another expression.
      code
        source_parse_expression(p: SourceParser, precedence: Int) SourceParsed[SourceExpression] =
          parse = \ cursor: SourceParser, level: Int -> source_parse_expression(cursor, level)
          bindings = source_bindings(p, parse)
          c = bindings.rest.source_skip().source_current()
          if bindings.value.is_not_empty() and {c == 0 or c == 125 or c == 41}
            source_result(bindings.rest, SourceExpression.block(bindings.value))
            identity(
              primary = source_primary(bindings.rest, parse)
              result = source_parse_suffixes(primary.rest, primary.value, precedence)
              if bindings.value.is_empty() result
                source_result(result.rest, SourceExpression.block(bindings.value.push(result.value))))
        source_parse_suffixes(p: SourceParser, value: SourceExpression, precedence: Int) SourceParsed[SourceExpression] =
          source_suffix(p, value, precedence,
            \ cursor: SourceParser, level: Int -> source_parse_expression(cursor, level)) %(
            none source_result(p, value)
            some(next) source_parse_suffixes(next.rest, next.value, precedence))
      text
        An eval cell must end after one expression. Bare declarations are
        rejected; local bindings remain available inside an explicit block.
      code
        parse_eval(source: String) SourceExpression =
          start = source_parser(source)
          binding = start.source_name().flat_map(\ name: SourceParsed[String] -> name.rest.source_binding_equals())
          _ = assert(binding is none, "Eval cells contain an expression, not a declaration.")
          parsed = source_parse_expression(start, 0 - 1)
          _ = if parsed.rest.source_skip().source_current() == 0 nothing
            source_error(parsed.rest, "Expected the end of the eval expression")
          parsed.value
    chapter Parsing declarations
      text
        A code cell is one declaration group. Type names and function signatures
        will be registered together before checking any bodies, so definitions
        in that cell can refer to each other recursively.
      code
        source_type_declaration(p: SourceParser) SourceParsed[SourceDefinition] =
          name = p.source_require_name()
          parameters = source_parse_parameters(name.rest)
          after = parameters.rest.source_expect("=")
          declaration = after.source_take("...") %(
            some(rest) source_result(rest, SourceTypeKind.primitive)
            none
              after.source_keyword("struct") %(
                some(rest)
                  fields = source_fields(rest.source_expect("\{"), "}", false)
                  source_result(fields.rest, SourceTypeKind.record(fields.value))
                none
                  after.source_keyword("enum") %(
                    some(rest)
                      fields = source_fields(rest.source_expect("\{"), "}", true)
                      source_result(fields.rest, SourceTypeKind.variant(fields.value))
                    none
                      alias = source_parse_type(after)
                      _ = assert(alias.value.name == "fun", "Only function type aliases are supported.")
                      _ = assert(parameters.value.is_empty(), "Function aliases cannot declare type parameters.")
                      source_result(alias.rest, SourceTypeKind.alias(alias.value)))))
          source_result(declaration.rest, SourceDefinition.type(SourceTypeDeclaration(
            name = name.value, parameters = parameters.value, kind = declaration.value)))
      text
        Lowercase names introduce globals or functions. A function's absent
        return annotation means Nothing; an ellipsis marks a builtin body.
      code
        source_declaration(p: SourceParser) SourceParsed[SourceDefinition] =
          start = p.source_skip()
          c = start.source_current()
          if c >= 65 and c <= 90 source_type_declaration(start)
            identity(
              name = start.source_name() or {start.source_operator() or source_error(start, "Expected a definition")}
              name.rest.source_binding_equals() %(
                some(after)
                  value = source_parse_expression(after, 0 - 1)
                  source_result(value.rest, SourceDefinition.global(SourceNamed(name = name.value, value = value.value)))
                none
                  parameters = source_parse_parameters(name.rest)
                  arguments = source_fields(parameters.rest.source_expect("("), ")", false)
                  returns = arguments.rest.source_take("=") %(
                    some(after) source_result(after, source_type("Nothing"))
                    none
                      type = source_parse_type(arguments.rest)
                      source_result(type.rest.source_expect("="), type.value))
                  body = returns.rest.source_take("...") %(
                    some(after) source_result(after, none[SourceExpression]())
                    none
                      value = source_parse_expression(returns.rest, 0 - 1)
                      source_result(value.rest, some(value.value)))
                  signature = SourceSignature(name = name.value, parameters = parameters.value,
                    arguments = arguments.value, returns = returns.value)
                  source_result(body.rest, SourceDefinition.function(SourceFunction(signature, body = body.value)))))
      text
        Parse until the cell ends. A malformed trailing declaration is an error
        rather than a successfully parsed prefix.
      code
        source_declarations(p: SourceParser) List[SourceDefinition] =
          if p.source_skip().source_current() == 0 list[SourceDefinition]()
            identity(
              next = source_declaration(p)
              _ = assert(next.rest.index > p.index, "Declaration parser made no progress.")
              list(next.value).push_all(source_declarations(next.rest)))
      code
        parse_code(source: String) List[SourceDefinition] = source_declarations(source_parser(source))
    chapter Immutable name maps
      text
        Compiler environments need many small name lookups. A persistent tree
        shares unchanged branches between environments. Equal hash codes use a
        bucket of full names, so a hash collision never changes the answer.
      code
        NameMap[A] = enum { empty, node: NameMapNode[A] }
        NameMapNode[A] = struct {
          hash: Int, entries: List[NameEntry[A]], left: NameMap[A], right: NameMap[A] }
        NameEntry[A] = struct { name: String, value: A }
      code
        name_map[A]() NameMap[A] = NameMap[A].empty
      code
        name_hash(name: String) Int =
          name.bytes().iter().fold(5381, \ value: Int, byte: Byte -> {value * 33} + byte.to_int())
      code
        lookup[A](map: NameMap[A], name: String, hash: Int) Maybe[A] =
          map %(
            empty none[A]()
            node(n)
              if hash < n.hash n.left.lookup(name, hash)
              if hash > n.hash n.right.lookup(name, hash)
                n.entries.iter().filter(\ entry: NameEntry[A] -> entry.name == name)
                  .get_maybe(0).map(\ entry: NameEntry[A] -> entry.value))
      code
        lookup[A](map: NameMap[A], name: String) Maybe[A] = map.lookup(name, name_hash(name))
      code
        put[A](map: NameMap[A], name: String, value: A, hash: Int) NameMap[A] =
          map %(
            empty NameMap.node(NameMapNode(hash, entries = list(NameEntry(name, value)),
              left = name_map[A](), right = name_map[A]()))
            node(n)
              if hash < n.hash NameMap.node(NameMapNode(hash = n.hash, entries = n.entries,
                left = n.left.put(name, value, hash), right = n.right))
              if hash > n.hash NameMap.node(NameMapNode(hash = n.hash, entries = n.entries,
                left = n.left, right = n.right.put(name, value, hash)))
                identity(
                  exists = n.entries.iter().any(\ entry: NameEntry[A] -> entry.name == name)
                  entries = if exists n.entries.iter().map(\ entry: NameEntry[A] ->
                    if entry.name == name NameEntry(name, value) entry).to_list()
                    n.entries.push(NameEntry(name, value))
                  NameMap.node(NameMapNode(hash, entries, left = n.left, right = n.right))))
      code
        put[A](map: NameMap[A], name: String, value: A) NameMap[A] = map.put(name, value, name_hash(name))
      code
        entries[A](map: NameMap[A]) List[NameEntry[A]] =
          map %(empty list[NameEntry[A]]() node(n)
            n.left.entries().push_all(n.entries).push_all(n.right.entries()))
    chapter Compiler environments
      text
        Every exported declaration carries the generation of the cell that
        produced it. Incremental dependency stamps use these generations rather
        than comparing executable functions or copying whole environments.
      code
        CompilerType = struct { declaration: SourceTypeDeclaration, generation: Int }
      text
        A function retains its declaration group and the earlier scope it saw.
        Concrete executables are ordinary Dynamic function values. Generic
        declarations remain templates until a call supplies concrete types.
      code
        CompilerFunction = struct {
          signature: SourceSignature, executable: Maybe[Dynamic], definitions: List[SourceFunction],
          scope: Maybe[CompilerEnvironment], generation: Int, slot: Int }
        CompilerGlobal = struct { name: String, type: SourceType, value: Dynamic, generation: Int }
        CompilerEnvironment = struct {
          types: NameMap[CompilerType], functions: NameMap[List[CompilerFunction]],
          globals: NameMap[CompilerGlobal] }
      code
        compiler_environment() CompilerEnvironment = CompilerEnvironment(
          types = name_map[CompilerType](), functions = name_map[List[CompilerFunction]](),
          globals = name_map[CompilerGlobal]())
      code
        source_has(names: List[String], name: String) Bool = names.iter().any(\ item: String -> item == name)
      text
        Types are displayed structurally. Eval results use this description
        whenever the resulting value is neither a string nor a drawing.
      code
        source_types_text(types: List[SourceType]) String =
          if types.is_empty() ""
            types.first().format() + if types.length() == 1 "" ", " + source_types_text(types.without_first())
        format(type: SourceType) String =
          if type.name == "fun"
            "fun(" + source_types_text(type.arguments.without_last()) + ") " + type.arguments.last().format()
            type.name + if type.arguments.is_empty() "" "[" + source_types_text(type.arguments) + "]"
      text
        Substitution replaces declared type parameters without changing the
        structure of unrelated types.
      code
        source_substitute(type: SourceType, substitutions: NameMap[SourceType]) SourceType =
          substitutions.lookup(type.name) %(
            some(value)
              _ = assert(type.arguments.is_empty(), "A type parameter cannot have arguments.")
              value
            none SourceType(name = type.name, arguments = type.arguments.iter().map(
              \ argument: SourceType -> source_substitute(argument, substitutions)).to_list()))
      code
        source_substitutions(parameters: List[String], types: List[SourceType]) NameMap[SourceType] =
          _ = assert(parameters.length() == types.length(), "Wrong number of type arguments.")
          zip(parameters.iter(), types.iter()).fold(name_map[SourceType](),
            \ map: NameMap[SourceType], pair: Tuple2[String, SourceType] -> map.put(pair.a, pair.b))
      text
        Resolve aliases and validate arity before checking values. Alias cycles
        are diagnosed explicitly instead of recursing until fuel is exhausted.
      code
        source_resolve(type: SourceType, environment: CompilerEnvironment,
          parameters: List[String], aliases: List[String]) SourceType =
          if source_has(parameters, type.name)
            identity(
              _ = assert(type.arguments.is_empty(), "Type parameters cannot have arguments.")
              type)
          if type.name == "fun"
            identity(
              _ = assert(type.arguments.is_not_empty(), "A function type needs a return type.")
              SourceType(name = type.name, arguments = type.arguments.iter().map(
                \ argument: SourceType -> source_resolve(argument, environment, parameters, aliases)).to_list()))
            identity(
              declared = environment.types.lookup(type.name) or crash("Unknown type " + type.name + ".")
              definition = declared.declaration
              _ = assert(type.arguments.length() == definition.parameters.length(),
                "Wrong number of type arguments for " + type.name + ".")
              definition.kind %(
                alias(target)
                  _ = assert(not(source_has(aliases, type.name)), "Cyclic type alias " + type.name + ".")
                  concrete = source_substitute(target, source_substitutions(definition.parameters, type.arguments))
                  source_resolve(concrete, environment, parameters, aliases.push(type.name))
                default SourceType(name = type.name, arguments = type.arguments.iter().map(
                  \ argument: SourceType -> source_resolve(argument, environment, parameters, aliases)).to_list())))
      code
        source_resolve(type: SourceType, environment: CompilerEnvironment, parameters: List[String]) SourceType =
          source_resolve(type, environment, parameters, list[String]())
      text
        Never can stand in for any required value because it cannot return.
        Matching branches otherwise have to agree on one structural type.
      code
        source_accepts(expected: SourceType, actual: SourceType) Bool = actual.name == "Never" or expected == actual
      code
        source_join(a: SourceType, b: SourceType) SourceType =
          if a.name == "Never" b
          if b.name == "Never" a
          if a == b a crash("Incompatible branch types: " + a.format() + " and " + b.format() + ".")
      text
        Generic inference unifies a signature pattern with an actual argument.
        Conflicting substitutions reject that overload instead of mutating a
        shared inference environment.
      code
        source_infer(pattern: SourceType, actual: SourceType, parameters: List[String],
          substitutions: NameMap[SourceType]) Maybe[NameMap[SourceType]] =
          if source_has(parameters, pattern.name)
            identity(
              if pattern.arguments.is_not_empty() none[NameMap[SourceType]]()
                substitutions.lookup(pattern.name) %(
                  none some(substitutions.put(pattern.name, actual))
                  some(previous) if source_accepts(previous, actual) some(substitutions) none[NameMap[SourceType]]()))
          if actual.name == "Never" some(substitutions)
          if pattern.name != actual.name or pattern.arguments.length() != actual.arguments.length()
            none[NameMap[SourceType]]()
            zip(pattern.arguments.iter(), actual.arguments.iter()).fold(some(substitutions),
              \ state: Maybe[NameMap[SourceType]], pair: Tuple2[SourceType, SourceType] ->
                state.flat_map(\ map: NameMap[SourceType] -> source_infer(pair.a, pair.b, parameters, map)))
    chapter Building checked expressions
      text
        Source checking keeps type parameters symbolic. These builders become
        concrete Expr trees only after a call has selected its type arguments.
        Bindings remain explicit so a block can extend the following scope.
      code
        CompilerExpansion = struct { generation: Int, slot: Int, types: List[SourceType], name: String, type: Type }
        CompilerLowering = struct { substitutions: NameMap[SourceType], expanding: List[CompilerExpansion],
          environment: Maybe[CompilerEnvironment], snapshots: List[Type],
          instantiate: fun(CompilerFunction, NameMap[SourceType], CompilerLowering) Expr }
        CompilerExpression = enum { ready: fun(CompilerLowering) Expr, binding: CompilerBinding }
        CompilerBinding = struct { name: String, value: CompilerExpression }
      text
        Reflection follows only reachable concrete definitions, registering a
        name before visiting its fields. The host validates the finished table.
      code
        CompilerReflected = struct { entries: NameMap[TypeDefinition], key: String }
      code
        compiler_reflection(environment: CompilerEnvironment, source: SourceType,
          entries: NameMap[TypeDefinition], depth: Int) CompilerReflected =
          _ = assert(depth < 128, "Type reflection expansion limit exceeded.")
          type = source_resolve(source, environment, list[String]())
          key = type.format()
          if entries.lookup(key) is some CompilerReflected(entries, key)
            identity(
              initial = entries.put(key, TypeDefinition(name = key, shape = TypeShape.opaque))
              if type.name == "fun"
                identity(
                  fields = type.arguments.iter().fold(CompilerReflected(entries = initial, key),
                    \ state: CompilerReflected, argument: SourceType ->
                      next = compiler_reflection(environment, argument, state.entries, depth + 1)
                      CompilerReflected(entries = next.entries, key))
                  shape = TypeShape.function(FunctionTypeDefinition(
                    arguments = type.arguments.without_last().iter().map(\ argument: SourceType -> argument.format()).to_list(),
                    returns = type.arguments.last().format()))
                  CompilerReflected(entries = fields.entries.put(key, TypeDefinition(name = key, shape)), key))
                identity(
                  declaration = environment.types.lookup(type.name).unwrap().declaration
                  substitutions = source_substitutions(declaration.parameters, type.arguments)
                  fields = declaration.kind %(record(fields) fields variant(fields) fields default list[SourceField]())
                  concrete = fields.iter().map(\ field: SourceField -> SourceField(name = field.name,
                    type = source_resolve(source_substitute(field.type, substitutions), environment, list[String]()))).to_list()
                  dependencies = if type.name == "List" type.arguments concrete.iter().map(\ field: SourceField -> field.type).to_list()
                  updated = dependencies.iter().fold(initial, \ current: NameMap[TypeDefinition], dependency: SourceType ->
                    compiler_reflection(environment, dependency, current, depth + 1).entries)
                  reflected = concrete.iter().map(\ field: SourceField -> TypeFieldDefinition(name = field.name, type = field.type.format())).to_list()
                  shape = declaration.kind %(
                    record TypeShape.struct(reflected)
                    variant TypeShape.enum(reflected)
                    primitive
                      if type.name == "Int" TypeShape.int
                      if type.name == "Float" TypeShape.float
                      if type.name == "Byte" TypeShape.byte
                      if type.name == "String" TypeShape.string
                      if type.name == "List" TypeShape.list(type.arguments.first().format())
                      if type.name == "Dynamic" TypeShape.dynamic
                      if type.name == "Type" TypeShape.type
                        TypeShape.opaque
                    alias crash("Unresolved reflected alias."))
                  CompilerReflected(entries = updated.put(key, TypeDefinition(name = key, shape)), key)))
      code
        compiler_reflect(environment: CompilerEnvironment, source: SourceType) Type =
          garbage_collect(\ ->
            reflected = compiler_reflection(environment, source, name_map[TypeDefinition](), 0)
            type_snapshot(reflected.entries.entries().iter().map(\ entry: NameEntry[TypeDefinition] -> entry.value).to_list(), reflected.key))
      text
        Function signatures provide a shared snapshot for their argument and
        result types. Most names and fields can reuse those handles directly.
      code
        compiler_reflect_cached(environment: CompilerEnvironment, source: SourceType, lowering: CompilerLowering) Type =
          scope = lowering.environment or environment
          type = source_resolve(source, scope, list[String]())
          lowering.snapshots.iter().filter_map(\ snapshot: Type -> lookup_type(snapshot, type.format())).get_maybe(0)
            or garbage_collect(\ -> compiler_reflect(scope, type))
      code
        compiler_build(expression: CompilerExpression, lowering: CompilerLowering) Expr = expression %(
          ready(build) build(lowering)
          binding(binding) Expr.binding(BindingExpr(name = binding.name,
            value = compiler_build(binding.value, lowering), body = Expr.value(nothing.to_dynamic()))))
      code
        runtime_value[A](value: A) CompilerExpression = CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.value(value.to_dynamic()))
      code
        runtime_dynamic(value: Dynamic) CompilerExpression = CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.value(value))
      code
        runtime_name(name: String, type: SourceType, environment: CompilerEnvironment) CompilerExpression =
          CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.name(FieldType(name,
            type = compiler_reflect_cached(environment, source_substitute(type, lowering.substitutions), lowering))))
      code
        runtime_binding(name: String, value: CompilerExpression, body: CompilerExpression) CompilerExpression =
          CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.binding(BindingExpr(name,
            value = compiler_build(value, lowering), body = compiler_build(body, lowering))))
      code
        runtime_sequence(first: CompilerExpression, second: CompilerExpression) CompilerExpression =
          CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.block(list(
            compiler_build(first, lowering), compiler_build(second, lowering))))
      code
        runtime_call(function: CompilerExpression, arguments: List[CompilerExpression]) CompilerExpression =
          CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.call(CallExpr(
            function = compiler_build(function, lowering), arguments = arguments.iter().map(
              \ argument: CompilerExpression -> compiler_build(argument, lowering)).to_list())))
      code
        runtime_field(value: CompilerExpression, name: String) CompilerExpression =
          CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.field(FieldExpr(value = compiler_build(value, lowering), name)))
      code
        runtime_struct(type: SourceType, fields: List[CompilerExpression], environment: CompilerEnvironment) CompilerExpression =
          CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.struct(StructExpr(
            type = compiler_reflect_cached(environment, source_substitute(type, lowering.substitutions), lowering),
            fields = fields.iter().map(\ field: CompilerExpression -> compiler_build(field, lowering)).to_list())))
      code
        runtime_variant(type: SourceType, name: String, value: CompilerExpression, environment: CompilerEnvironment) CompilerExpression =
          CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.enum(EnumExpr(
            type = compiler_reflect_cached(environment, source_substitute(type, lowering.substitutions), lowering), variant = name,
            value = compiler_build(value, lowering))))
    chapter Checking expressions
      text
        A checker combines visible declarations with local variable types and
        the current declaration group. Checked expressions carry runtime code
        and the local scope after checking, so bindings require no mutation.
      code
        CompilerChecker = struct {
          environment: CompilerEnvironment, locals: NameMap[SourceType],
          parameters: List[String], generation: Int }
      code
        CompilerChecked = struct {
          type: SourceType, expression: CompilerExpression, locals: NameMap[SourceType] }
      code
        CompilerCheck = fun(CompilerChecker, SourceExpression) CompilerChecked
      code
        compiler_checker(environment: CompilerEnvironment, generation: Int) CompilerChecker =
          CompilerChecker(environment, generation, locals = name_map[SourceType](), parameters = list[String]())
      code
        with_locals(checker: CompilerChecker, locals: NameMap[SourceType]) CompilerChecker =
          CompilerChecker(environment = checker.environment, parameters = checker.parameters,
            generation = checker.generation, locals)
      code
        checked(checker: CompilerChecker, type: SourceType, expression: CompilerExpression) CompilerChecked =
          CompilerChecked(type, expression, locals = checker.locals)
      text
        Check argument expressions in order, passing along bindings introduced
        by each argument. Their types and code remain paired throughout.
      code
        CompilerCheckedList = struct { values: List[CompilerChecked], locals: NameMap[SourceType] }
      code
        compiler_check_list(checker: CompilerChecker, expressions: List[SourceExpression],
          check: CompilerCheck) CompilerCheckedList =
          expressions.iter().fold(CompilerCheckedList(values = list[CompilerChecked](), locals = checker.locals),
            \ state: CompilerCheckedList, expression: SourceExpression ->
              value = check(checker.with_locals(state.locals), expression)
              CompilerCheckedList(values = state.values.push(value), locals = value.locals))
      text
        A concrete record or enum substitutes its type arguments into the
        declared fields. Aliases are resolved before a field is used.
      code
        compiler_fields(checker: CompilerChecker, type: SourceType, variants: Bool) List[SourceField] =
          definition = checker.environment.types.lookup(type.name) or crash("Unknown type " + type.name + ".")
          fields = definition.declaration.kind %(
            record(fields) if variants crash("Expected an enum, got " + type.format() + ".") fields
            variant(fields) if variants fields crash("Expected a record, got " + type.format() + ".")
            default crash("Cannot access fields of " + type.format() + "."))
          substitutions = source_substitutions(definition.declaration.parameters, type.arguments)
          fields.iter().map(\ field: SourceField -> SourceField(name = field.name,
            type = source_resolve(source_substitute(field.type, substitutions),
              checker.environment, checker.parameters))).to_list()
      code
        compiler_field_index(fields: List[SourceField], name: String) Int =
          fields.iter().indexed().filter(\ item: Indexed[SourceField] -> item.item.name == name)
            .get_maybe(0).map(\ item: Indexed[SourceField] -> item.index)
            or crash("Unknown field or variant " + name + ".")
      code
        compiler_check_field(checker: CompilerChecker, value: CompilerChecked, name: String) CompilerChecked =
          if value.type.name == "Never" value
            identity(
              fields = compiler_fields(checker, value.type, false)
              index = compiler_field_index(fields, name)
              CompilerChecked(type = fields.get(index).type,
                expression = runtime_field(value.expression, name), locals = value.locals))
      text
        A block keeps its bindings local. Each binding becomes a runtime let;
        other preceding expressions are evaluated for their effects.
      code
        compiler_check_block(checker: CompilerChecker, expressions: List[SourceExpression],
          check: CompilerCheck) CompilerChecked =
          if expressions.is_empty() checker.checked(source_type("Nothing"), runtime_value(nothing))
            identity(
              first = check(checker, expressions.first())
              if expressions.length() == 1 first
                identity(
                  rest = compiler_check_block(checker.with_locals(first.locals), expressions.without_first(), check)
                  code = first.expression %(
                    binding(binding) runtime_binding(binding.name, binding.value, rest.expression)
                    default runtime_sequence(first.expression, rest.expression))
                  checker.checked(if first.type.name == "Never" first.type rest.type, code)))
      text
        Function values have a runtime closure consisting of a function and its
        captures. Evaluate the callee once before supplying arguments.
      code
        compiler_check_invoke(checker: CompilerChecker, callee: CompilerChecked,
          arguments: List[SourceExpression], types: Maybe[List[SourceType]], check: CompilerCheck) CompilerChecked =
          _ = assert(types is none, "Function values cannot take type arguments.")
          _ = assert(callee.type.name == "fun", "Cannot call " + callee.type.format() + ".")
          expected = callee.type.arguments.without_last()
          _ = assert(expected.length() == arguments.length(), "Wrong number of function arguments.")
          values = compiler_check_list(checker.with_locals(callee.locals), arguments, check)
          _ = zip(expected.iter(), values.values.iter()).fold(nothing,
            \ ignored: Nothing, pair: Tuple2[SourceType, CompilerChecked] ->
              assert(source_accepts(pair.a, pair.b.type),
                "Function argument expects " + pair.a.format() + ", got " + pair.b.type.format() + "."))
          returns = if values.values.iter().any(\ value: CompilerChecked -> value.type.name == "Never")
            source_type("Never") callee.type.arguments.last()
          code = runtime_call(callee.expression, values.values.iter().map(
            \ value: CompilerChecked -> value.expression).to_list())
          CompilerChecked(type = returns, expression = code, locals = values.locals)
      text
        An overload candidate keeps the inferred type substitutions alongside
        the chosen function. More than one matching candidate is an error.
      code
        CompilerOverload = struct { function: CompilerFunction, substitutions: NameMap[SourceType] }
      code
        compiler_match_overload(checker: CompilerChecker, function: CompilerFunction,
          values: List[CompilerChecked], explicit: Maybe[List[SourceType]]) Maybe[CompilerOverload] =
          signature = function.signature
          if signature.parameters.length() == 1 and {signature.name == "name" or signature.name == "code" or signature.name == "arguments"}
            and values.iter().any(\ value: CompilerChecked -> value.type.name != "fun" and value.type.name != "Dynamic") none[CompilerOverload]()
          if signature.arguments.length() != values.length() none[CompilerOverload]()
          if explicit.map(\ types: List[SourceType] -> types.length() != signature.parameters.length()) or false
            none[CompilerOverload]()
            identity(
              initial = explicit.map(\ types: List[SourceType] -> source_substitutions(signature.parameters,
                types.iter().map(\ type: SourceType -> source_resolve(type,
                  checker.environment, checker.parameters)).to_list())) or name_map[SourceType]()
              inferred = zip(signature.arguments.iter(), values.iter()).fold(some(initial),
                \ current: Maybe[NameMap[SourceType]], pair: Tuple2[SourceField, CompilerChecked] ->
                  current.flat_map(\ map: NameMap[SourceType] ->
                    source_infer(pair.a.type, pair.b.type, signature.parameters, map)))
              inferred.flat_map(\ substitutions: NameMap[SourceType] ->
                if signature.parameters.iter().all(\ name: String -> substitutions.lookup(name) is some)
                  some(CompilerOverload(function, substitutions)) none[CompilerOverload]()))
      code
        compiler_select_overload(checker: CompilerChecker, name: String,
          values: List[CompilerChecked], explicit: Maybe[List[SourceType]]) CompilerOverload =
          candidates = checker.environment.functions.lookup(name) or list[CompilerFunction]()
          matches = candidates.iter().filter_map(\ candidate: CompilerFunction ->
            compiler_match_overload(checker, candidate, values, explicit)).take(2).to_list()
          if matches.is_empty() crash("No matching function " + name + "(" + source_types_text(
            values.iter().map(\ value: CompilerChecked -> value.type).to_list()) + ").")
          if matches.length() > 1 crash("Ambiguous function call " + name + ".") matches.first()
      text
        Calls select a concrete specialization. Previously compiled functions
        are embedded as typed values; recursive source functions use typed
        lexical names while building their checked expression trees.
      code
        compiler_call_overload(checker: CompilerChecker, selected: CompilerOverload,
          values: CompilerCheckedList) CompilerChecked =
          function = selected.function
          returns = source_resolve(source_substitute(function.signature.returns, selected.substitutions),
            checker.environment, checker.parameters)
          result = if values.values.iter().any(\ value: CompilerChecked -> value.type.name == "Never")
            source_type("Never") returns
          callee = CompilerExpression.ready(\ lowering: CompilerLowering ->
            context = CompilerLowering(substitutions = lowering.substitutions, expanding = lowering.expanding,
              environment = some(lowering.environment or checker.environment), snapshots = lowering.snapshots, instantiate = lowering.instantiate)
            lowering.instantiate(selected.function, selected.substitutions, context))
          CompilerChecked(type = result, locals = values.locals, expression = runtime_call(callee,
            values.values.iter().map(\ value: CompilerChecked -> value.expression).to_list()))
      text
        A member call first looks for a function-valued record field. Otherwise
        it becomes a named call with the receiver as its first argument.
      code
        compiler_check_call(checker: CompilerChecker, call: SourceCall, check: CompilerCheck) CompilerChecked =
          call.callee %(
            name(name)
              if {checker.locals.lookup(name) is some} or {checker.environment.globals.lookup(name) is some}
                compiler_check_invoke(checker, check(checker, call.callee), call.arguments, call.types, check)
                identity(
                  values = compiler_check_list(checker, call.arguments, check)
                  compiler_call_overload(checker,
                    compiler_select_overload(checker, name, values.values, call.types), values))
            field(member)
              receiver = check(checker, member.value)
              declared = checker.environment.types.lookup(receiver.type.name)
              has_field = declared.map(\ type: CompilerType -> type.declaration.kind %(
                record(fields) fields.iter().any(\ field: SourceField -> field.name == member.name)
                default false)) or false
              if has_field compiler_check_invoke(checker,
                compiler_check_field(checker, receiver, member.name), call.arguments, call.types, check)
                identity(
                  values = compiler_check_list(checker.with_locals(receiver.locals), call.arguments, check)
                  all = CompilerCheckedList(values = list(receiver).push_all(values.values), locals = values.locals)
                  compiler_call_overload(checker,
                    compiler_select_overload(checker, member.name, all.values, call.types), all))
            default compiler_check_invoke(checker, check(checker, call.callee), call.arguments, call.types, check))
    chapter Constructors and closures
      text
        Check record arguments once, preserving their source order for scope
        checking. Their runtime order follows the declared field layout.
      code
        CompilerCheckedFields = struct { values: NameMap[CompilerChecked], locals: NameMap[SourceType] }
      code
        compiler_check_named(checker: CompilerChecker, fields: List[SourceNamed], allowed: List[SourceField],
          check: CompilerCheck) CompilerCheckedFields =
          fields.iter().fold(CompilerCheckedFields(values = name_map[CompilerChecked](), locals = checker.locals),
            \ state: CompilerCheckedFields, field: SourceNamed ->
              _ = compiler_field_index(allowed, field.name)
              _ = assert(state.values.lookup(field.name) is none, "Duplicate field " + field.name + ".")
              value = check(checker.with_locals(state.locals), field.value)
              CompilerCheckedFields(values = state.values.put(field.name, value), locals = value.locals))
      text
        Omitted generic arguments can be inferred from constructor fields. Every
        parameter must receive one consistent substitution.
      code
        compiler_constructor_type(checker: CompilerChecker, type: SourceType,
          declaration: SourceTypeDeclaration, fields: List[SourceField],
          values: NameMap[CompilerChecked]) SourceType =
          if type.arguments.is_not_empty() or declaration.parameters.is_empty()
            source_resolve(type, checker.environment, checker.parameters)
            identity(
              inferred = fields.iter().fold(some(name_map[SourceType]()),
                \ state: Maybe[NameMap[SourceType]], field: SourceField ->
                  value = values.lookup(field.name) or crash("Missing field " + field.name + ".")
                  pattern = source_resolve(field.type, checker.environment, declaration.parameters)
                  state.flat_map(\ map: NameMap[SourceType] ->
                    source_infer(pattern, value.type, declaration.parameters, map)))
                or crash("Cannot infer type arguments for " + type.name + ".")
              arguments = declaration.parameters.iter().map(\ name: String ->
                inferred.lookup(name) or crash("Cannot infer " + name + " for " + type.name + ".")).to_list()
              source_resolve(SourceType(name = type.name, arguments), checker.environment, checker.parameters))
      code
        compiler_check_record(checker: CompilerChecker, make: SourceRecord, check: CompilerCheck) CompilerChecked =
          definition = checker.environment.types.lookup(make.type.name) or crash("Unknown type " + make.type.name + ".")
          fields = definition.declaration.kind %(record(fields) fields default crash("Expected a record type."))
          values = compiler_check_named(checker, make.fields, fields, check)
          concrete = compiler_constructor_type(checker, make.type, definition.declaration, fields, values.values)
          expected = compiler_fields(checker, concrete, false)
          ordered = expected.iter().map(\ field: SourceField ->
            value = values.values.lookup(field.name) or crash("Missing field " + field.name + ".")
            _ = assert(source_accepts(field.type, value.type),
              "Field " + field.name + " expects " + field.type.format() + ", got " + value.type.format() + ".")
            value).to_list()
          result = if ordered.iter().any(\ value: CompilerChecked -> value.type.name == "Never")
            source_type("Never") concrete
          CompilerChecked(type = result, locals = values.locals, expression = runtime_struct(concrete,
            ordered.iter().map(\ value: CompilerChecked -> value.expression).to_list(), checker.environment))
      text
        An enum value stores its variant index and one payload, using the same
        layout as values produced by bootstrap compilation.
      code
        compiler_check_variant(checker: CompilerChecker, make: SourceVariant, check: CompilerCheck) CompilerChecked =
          definition = checker.environment.types.lookup(make.type.name) or crash("Unknown type " + make.type.name + ".")
          fields = definition.declaration.kind %(variant(fields) fields default crash("Expected an enum type."))
          index = compiler_field_index(fields, make.name)
          value = check(checker, make.value)
          field = fields.get(index)
          concrete = compiler_constructor_type(checker, make.type, definition.declaration,
            list(field), name_map[CompilerChecked]().put(field.name, value))
          expected = compiler_fields(checker, concrete, true).get(index).type
          _ = assert(source_accepts(expected, value.type),
            "Variant " + make.name + " expects " + expected.format() + ", got " + value.type.format() + ".")
          CompilerChecked(type = if value.type.name == "Never" source_type("Never") concrete,
            locals = value.locals, expression = runtime_variant(concrete, make.name, value.expression, checker.environment))
      text
        Lambda parameters shadow outer locals. Capture the remaining outer
        values and the current function group in a concrete closure array.
      code
        compiler_check_lambda(checker: CompilerChecker, lambda: SourceLambda, check: CompilerCheck) CompilerChecked =
          arguments = lambda.parameters.iter().map(\ field: SourceField -> SourceField(name = field.name,
            type = source_resolve(field.type, checker.environment, checker.parameters))).to_list()
          names = arguments.iter().map(\ field: SourceField -> field.name).to_list()
          _ = names.iter().fold(list[String](), \ previous: List[String], name: String ->
            _ = assert(not(source_has(previous, name)), "Duplicate lambda parameter " + name + ".")
            previous.push(name))
          locals = arguments.iter().fold(checker.locals,
            \ scope: NameMap[SourceType], field: SourceField -> scope.put(field.name, field.type))
          body = check(checker.with_locals(locals), lambda.body)
          type = SourceType(name = "fun", arguments = arguments.iter().map(
            \ field: SourceField -> field.type).to_list().push(body.type))
          code = CompilerExpression.ready(\ lowering: CompilerLowering ->
            environment = lowering.environment or checker.environment
            signature = compiler_reflect(environment, source_substitute(type, lowering.substitutions))
            nested = CompilerLowering(substitutions = lowering.substitutions, expanding = lowering.expanding,
              environment = some(environment), snapshots = lowering.snapshots.push(signature), instantiate = lowering.instantiate)
            Expr.function(Function(
              arguments = arguments.iter().map(\ field: SourceField -> FieldType(name = field.name,
                type = compiler_reflect_cached(environment, source_substitute(field.type, lowering.substitutions), nested))).to_list(),
              body = compiler_build(body.expression, nested))))
          checker.checked(type, code)
    chapter Checking matches
      text
        Each arm receives its own local scope. Its payload type comes from the
        concrete enum variant; the arm's bindings never escape the match.
      code
        CompilerCase = struct { index: Int, binding: Maybe[String], body: CompilerChecked }
      code
        CompilerCases = struct { values: List[CompilerCase], type: SourceType }
      code
        compiler_check_cases(checker: CompilerChecker, arms: List[SourceCase], fields: List[SourceField],
          check: CompilerCheck) CompilerCases =
          arms.iter().fold(CompilerCases(values = list[CompilerCase](), type = source_type("Never")),
            \ state: CompilerCases, arm: SourceCase ->
              index = compiler_field_index(fields, arm.name)
              _ = assert(not(state.values.iter().any(\ item: CompilerCase -> item.index == index)),
                "Duplicate case " + arm.name + ".")
              scope = arm.binding.map(\ name: String -> checker.locals.put(name, fields.get(index).type)) or checker.locals
              body = check(checker.with_locals(scope), arm.body)
              CompilerCases(values = state.values.push(CompilerCase(index, binding = arm.binding, body)),
                type = source_join(state.type, body.type)))
      text
        Lower a checked match into branches over one cached scrutinee. With no
        default arm, all variants must be covered before any code is executable.
      code
        compiler_check_match(checker: CompilerChecker, match: SourceMatch, check: CompilerCheck) CompilerChecked =
          value = check(checker, match.value)
          if value.type.name == "Never"
            identity(
              _ = match.cases.iter().fold(source_type("Never"),
                \ previous: SourceType, arm: SourceCase ->
                  scope = arm.binding.map(\ name: String -> checker.locals.put(name, source_type("Never"))) or checker.locals
                  source_join(previous, check(checker.with_locals(scope), arm.body).type))
              _ = match.otherwise.map(\ expression: SourceExpression -> check(checker, expression).type)
              value)
            identity(
              fields = compiler_fields(checker, value.type, true)
              scope = checker.with_locals(value.locals)
              arms = compiler_check_cases(scope, match.cases, fields, check)
              alternative = match.otherwise.map(\ expression: SourceExpression -> check(scope, expression))
              _ = assert({alternative is some} or arms.values.length() == fields.length(),
                "Non-exhaustive match on " + value.type.format() + ".")
              result = alternative.map(\ other: CompilerChecked -> source_join(arms.type, other.type)) or arms.type
              code = CompilerExpression.ready(\ lowering: CompilerLowering -> Expr.switch(Switch(
                value = compiler_build(value.expression, lowering),
                cases = arms.values.iter().map(\ arm: CompilerCase -> CaseExpr(
                  variant = fields.get(arm.index).name, binding = arm.binding,
                  body = compiler_build(arm.body.expression, lowering))).to_list(),
                otherwise = alternative.map(\ other: CompilerChecked -> compiler_build(other.expression, lowering)))))
              CompilerChecked(type = result, locals = value.locals, expression = code))
    chapter Expression checking entry point
      text
        Literals require their primitive type to be in scope. Local names
        resolve before globals; global values are embedded by reference in the
        generated code. Helpers above handle all compound forms.
      code
        compiler_literal(checker: CompilerChecker, type: String, expression: CompilerExpression) CompilerChecked =
          definition = checker.environment.types.lookup(type) or crash("Unknown primitive type " + type + ".")
          _ = assert(definition.declaration.kind is primitive, "Literal requires primitive " + type + ".")
          checker.checked(source_type(type), expression)
      code
        compiler_check(checker: CompilerChecker, expression: SourceExpression) CompilerChecked =
          check = \ current: CompilerChecker, value: SourceExpression -> compiler_check(current, value)
          expression %(
            integer(value) compiler_literal(checker, "Int", runtime_value(value))
            floating(value) compiler_literal(checker, "Float", runtime_value(value))
            string(value) compiler_literal(checker, "String", runtime_value(value))
            name(name)
              checker.locals.lookup(name) %(
                some(type) checker.checked(type, runtime_name(name, type, checker.environment))
                none
                  checker.environment.globals.lookup(name) %(
                    some(value) checker.checked(value.type, runtime_dynamic(value.value))
                    none
                      functions = checker.environment.functions.lookup(name) or crash("Unknown name " + name + ".")
                      _ = assert(functions.length() == 1, "Ambiguous function value " + name + ".")
                      function = functions.first()
                      signature = function.signature
                      _ = assert(signature.parameters.is_empty(), "Function value needs concrete type arguments.")
                      type = SourceType(name = "fun", arguments = signature.arguments.iter().map(
                        \ field: SourceField -> field.type).to_list().push(signature.returns))
                      checker.checked(type, CompilerExpression.ready(\ lowering: CompilerLowering ->
                        lowering.instantiate(function, name_map[SourceType](), lowering)))))
            call(call) compiler_check_call(checker, call, check)
            lambda(lambda) compiler_check_lambda(checker, lambda, check)
            record(make) compiler_check_record(checker, make, check)
            variant(make) compiler_check_variant(checker, make, check)
            field(member) compiler_check_field(checker, check(checker, member.value), member.name)
            binding(binding)
              value = check(checker, binding.value)
              locals = if binding.name == "_" value.locals value.locals.put(binding.name, value.type)
              CompilerChecked(type = if value.type.name == "Never" source_type("Never") source_type("Nothing"),
                expression = CompilerExpression.binding(CompilerBinding(name = binding.name, value = value.expression)), locals)
            match(match) compiler_check_match(checker, match, check)
            block(expressions)
              value = compiler_check_block(checker, expressions, check)
              checker.checked(value.type, value.expression))
    chapter Checking declaration groups
      text
        A successful code cell exports concrete types, functions, and globals.
        All function signatures are registered before bodies are checked. This
        preserves recursion within a cell without making later cells visible.
      code
        CompilerExports = struct {
          types: List[CompilerType], functions: List[CompilerFunction], globals: List[CompilerGlobal] }
      code
        compiler_exports() CompilerExports = CompilerExports(types = list[CompilerType](),
          functions = list[CompilerFunction](), globals = list[CompilerGlobal]())
      code
        compiler_extend(environment: CompilerEnvironment, exports: CompilerExports) CompilerEnvironment =
          types = exports.types.iter().fold(environment.types,
            \ map: NameMap[CompilerType], item: CompilerType -> map.put(item.declaration.name, item))
          functions = exports.functions.iter().fold(environment.functions,
            \ map: NameMap[List[CompilerFunction]], item: CompilerFunction ->
              previous = map.lookup(item.signature.name) or list[CompilerFunction]()
              map.put(item.signature.name, previous.push(item)))
          globals = exports.globals.iter().fold(environment.globals,
            \ map: NameMap[CompilerGlobal], item: CompilerGlobal -> map.put(item.name, item))
          CompilerEnvironment(types, functions, globals)
      text
        Repeated field, parameter, and type-parameter names are diagnosed before
        they can affect inference or runtime layout.
      code
        source_unique_names(names: List[String]) Nothing =
          _ = names.iter().fold(list[String](), \ seen: List[String], name: String ->
            _ = assert(not(source_has(seen, name)), "Duplicate name " + name + ".")
            seen.push(name))
          nothing
      code
        compiler_validate_parameters(environment: CompilerEnvironment, parameters: List[String]) Nothing =
          _ = source_unique_names(parameters)
          _ = parameters.iter().fold(nothing, \ ignored: Nothing, name: String ->
            assert(environment.types.lookup(name) is none, "Type parameter conflicts with type " + name + "."))
          nothing
      code
        compiler_validate_type(environment: CompilerEnvironment, declaration: SourceTypeDeclaration) Nothing =
          _ = compiler_validate_parameters(environment, declaration.parameters)
          declaration.kind %(
            primitive
              allowed = list("Int", "Float", "Byte", "String", "List", "Dynamic", "Type")
              _ = assert(source_has(allowed, declaration.name), "Unknown builtin type " + declaration.name + ".")
              assert(declaration.parameters.length() == {if declaration.name == "List" 1 0},
                "Wrong builtin type arity.")
            alias(type)
              _ = assert(declaration.parameters.is_empty(), "Function aliases cannot have parameters.")
              ignore(source_resolve(type, environment, list[String](), list(declaration.name)))
            record(fields)
              _ = source_unique_names(fields.iter().map(\ field: SourceField -> field.name).to_list())
              fields.iter().fold(nothing, \ ignored: Nothing, field: SourceField ->
                ignore(source_resolve(field.type, environment, declaration.parameters)))
            variant(fields)
              _ = source_unique_names(fields.iter().map(\ field: SourceField -> field.name).to_list())
              fields.iter().fold(nothing, \ ignored: Nothing, field: SourceField ->
                ignore(source_resolve(field.type, environment, declaration.parameters))))
      text
        Normalize type-parameter spelling when comparing overload signatures.
        Return types do not distinguish overloads, matching bootstrap behavior.
      code
        compiler_signature_arguments(signature: SourceSignature) List[SourceType] =
          substitutions = signature.parameters.iter().indexed().fold(name_map[SourceType](),
            \ map: NameMap[SourceType], item: Indexed[String] ->
              map.put(item.item, source_type("$" + item.index.format())))
          signature.arguments.iter().map(\ field: SourceField -> source_substitute(field.type, substitutions)).to_list()
      code
        compiler_same_signature(a: SourceSignature, b: SourceSignature) Bool =
          a.name == b.name and a.parameters.length() == b.parameters.length()
            and compiler_signature_arguments(a).length() == compiler_signature_arguments(b).length()
            and zip(compiler_signature_arguments(a).iter(), compiler_signature_arguments(b).iter())
              .all(\ pair: Tuple2[SourceType, SourceType] -> pair.a == pair.b)
      code
        compiler_signature_at(environment: CompilerEnvironment, signature: SourceSignature) SourceSignature =
          SourceSignature(name = signature.name, parameters = signature.parameters,
            arguments = signature.arguments.iter().map(\ field: SourceField -> SourceField(name = field.name,
              type = source_resolve(field.type, environment, signature.parameters))).to_list(),
            returns = source_resolve(signature.returns, environment, signature.parameters))
      code
        compiler_resolve_signature(environment: CompilerEnvironment, signature: SourceSignature) SourceSignature =
          _ = compiler_validate_parameters(environment, signature.parameters)
          _ = source_unique_names(signature.arguments.iter().map(\ field: SourceField -> field.name).to_list())
          compiler_signature_at(environment, signature)
      text
        Builtins are recognized by their complete source signatures. Their
        bodies are ordinary expressions containing one concrete primitive
        operation. No function handles need to be supplied by bootstrap or
        retained in a cell.
      code
        compiler_builtin_signature(signature: SourceSignature) String =
          normalized = source_substitutions(signature.parameters,
            signature.parameters.iter().map(\ ignored: String -> source_type("T")).to_list())
          signature.name + {if signature.parameters.is_empty() "(" "[T]("}
            + source_types_text(signature.arguments.iter().map(\ field: SourceField -> source_substitute(field.type, normalized)).to_list()) + ")"
      code
        compiler_builtin_return(signature: SourceSignature) String =
          key = compiler_builtin_signature(signature)
          if key == "equals[T](T, T)" "Bool"
          if key == "info(Type)" "TypeInfo"
          if key == "lookup_type(Type, String)" "Maybe[Type]"
          if key == "==(Type, Type)" "Bool"
          if key == "name(Type)" "String"
          if key == "dynamic_type(Dynamic)" "Type"
          if key == "type_snapshot(List[TypeDefinition], String)" "Type"
          if key == "run(Dynamic, List[Dynamic], Int)" "Execution[Dynamic]"
          if key == "garbage_collect[T](fun() T)" "T"
          if key == "try[T](fun() T, Int)" "Execution[T]"
          if key == "to_list[T](Iter[T])" "List[T]"
          if key == "==(String, String)" "Bool"
          if key == "bytes(String)" "List[Byte]"
          if key == "string(List[Byte])" "String"
          if key == "concat(String, String)" "String"
          if key == "crash(String)" "Never"
          if key == "bitcast_int_to_float(Int)" "Float"
          if key == "bitcast_float_to_int(Float)" "Int"
          if key == "to_float(Int)" "Float"
          if key == "to_int(Float)" "Int"
          if key == "+(Float, Float)" "Float"
          if key == "-(Float, Float)" "Float"
          if key == "*(Float, Float)" "Float"
          if key == "/(Float, Float)" "Float"
          if key == "==(Float, Float)" "Bool"
          if key == "<(Float, Float)" "Bool"
          if key == ">(Float, Float)" "Bool"
          if key == "<=(Float, Float)" "Bool"
          if key == ">=(Float, Float)" "Bool"
          if key == "<=>(Float, Float)" "Ordering"
          if key == "lower_byte(Int)" "Byte"
          if key == "to_int(Byte)" "Int"
          if key == "+(Int, Int)" "Int"
          if key == "-(Int, Int)" "Int"
          if key == "*(Int, Int)" "Int"
          if key == "/(Int, Int)" "Int"
          if key == "mod(Int, Int)" "Int"
          if key == "rem(Int, Int)" "Int"
          if key == "rem(Byte, Byte)" "Byte"
          if key == "&(Int, Int)" "Int"
          if key == "|(Int, Int)" "Int"
          if key == "xor(Int, Int)" "Int"
          if key == "<=>(Int, Int)" "Ordering"
          if key == "+(Byte, Byte)" "Byte"
          if key == "-(Byte, Byte)" "Byte"
          if key == "*(Byte, Byte)" "Byte"
          if key == "/(Byte, Byte)" "Byte"
          if key == "mod(Byte, Byte)" "Byte"
          if key == "&(Byte, Byte)" "Byte"
          if key == "|(Byte, Byte)" "Byte"
          if key == "xor(Byte, Byte)" "Byte"
          if key == "<=>(Byte, Byte)" "Ordering"
          if key == "list[T]()" "List[T]"
          if key == "length[T](List[T])" "Int"
          if key == "get[T](List[T], Int)" "T"
          if key == "filled_list[T](Int, T)" "List[T]"
          if key == "push[T](List[T], T)" "List[T]"
          if key == "push_all[T](List[T], List[T])" "List[T]"
          if key == "slice[T](List[T], Range[Int])" "List[T]"
          if key == "set[T](List[T], Int, T)" "List[T]"
          if key == "reversed[T](List[T])" "List[T]"
          if key == "sum(List[Int])" "Int"
          if key == "type[T]()" "Type"
          if key == "to_dynamic[T](T)" "Dynamic"
          if key == "to_static[T](Dynamic)" "T"
          if key == "compile(String, List[FieldType], Expr)" "Dynamic"
          if key == "code[T](T)" "Expr"
          if key == "name[T](T)" "String"
          if key == "arguments[T](T)" "List[FieldType]"
          crash("Unknown builtin " + key + ".")
      code
        compiler_validate_builtin(signature: SourceSignature) Nothing =
          normalized = source_substitutions(signature.parameters,
            signature.parameters.iter().map(\ ignored: String -> source_type("T")).to_list())
          _ = assert(source_substitute(signature.returns, normalized).format() == compiler_builtin_return(signature),
            "Incorrect builtin return type for " + signature.name + ".")
          nothing
      code
        compiler_builtin_op(signature: SourceSignature) Op =
          key = compiler_builtin_signature(signature)
          if key == "equals[T](T, T)" Op.equals
          if key == "info(Type)" Op.type_info
          if key == "lookup_type(Type, String)" Op.type_lookup
          if key == "==(Type, Type)" Op.type_equals
          if key == "name(Type)" Op.type_name
          if key == "dynamic_type(Dynamic)" Op.dynamic_type
          if key == "type_snapshot(List[TypeDefinition], String)" Op.type_snapshot
          if key == "run(Dynamic, List[Dynamic], Int)" Op.run
          if key == "garbage_collect[T](fun() T)" Op.garbage_collect
          if key == "try[T](fun() T, Int)" Op.try
          if key == "to_list[T](Iter[T])" Op.iterator_to_list
          if key == "==(String, String)" Op.string_equals
          if key == "bytes(String)" Op.string_bytes
          if key == "string(List[Byte])" Op.string_from_bytes
          if key == "concat(String, String)" Op.string_concat
          if key == "crash(String)" Op.crash
          if key == "bitcast_int_to_float(Int)" Op.bitcast_int_to_float
          if key == "bitcast_float_to_int(Float)" Op.bitcast_float_to_int
          if key == "to_float(Int)" Op.int_to_float
          if key == "to_int(Float)" Op.float_to_int
          if key == "+(Float, Float)" Op.float_add
          if key == "-(Float, Float)" Op.float_subtract
          if key == "*(Float, Float)" Op.float_multiply
          if key == "/(Float, Float)" Op.float_divide
          if key == "==(Float, Float)" Op.float_equals
          if key == "<(Float, Float)" Op.float_less
          if key == ">(Float, Float)" Op.float_greater
          if key == "<=(Float, Float)" Op.float_less_equal
          if key == ">=(Float, Float)" Op.float_greater_equal
          if key == "<=>(Float, Float)" Op.float_compare
          if key == "lower_byte(Int)" Op.int_to_byte
          if key == "to_int(Byte)" Op.byte_to_int
          if key == "+(Int, Int)" Op.int_add
          if key == "-(Int, Int)" Op.int_subtract
          if key == "*(Int, Int)" Op.int_multiply
          if key == "/(Int, Int)" Op.int_divide
          if key == "mod(Int, Int)" Op.int_modulo
          if key == "rem(Int, Int)" Op.int_remainder
          if key == "rem(Byte, Byte)" Op.byte_remainder
          if key == "&(Int, Int)" Op.int_and
          if key == "|(Int, Int)" Op.int_or
          if key == "xor(Int, Int)" Op.int_xor
          if key == "<=>(Int, Int)" Op.int_compare
          if key == "+(Byte, Byte)" Op.byte_add
          if key == "-(Byte, Byte)" Op.byte_subtract
          if key == "*(Byte, Byte)" Op.byte_multiply
          if key == "/(Byte, Byte)" Op.byte_divide
          if key == "mod(Byte, Byte)" Op.byte_modulo
          if key == "&(Byte, Byte)" Op.byte_and
          if key == "|(Byte, Byte)" Op.byte_or
          if key == "xor(Byte, Byte)" Op.byte_xor
          if key == "<=>(Byte, Byte)" Op.byte_compare
          if key == "length[T](List[T])" Op.list_length
          if key == "get[T](List[T], Int)" Op.list_get
          if key == "filled_list[T](Int, T)" Op.list_filled
          if key == "push[T](List[T], T)" Op.list_push
          if key == "push_all[T](List[T], List[T])" Op.list_push_all
          if key == "slice[T](List[T], Range[Int])" Op.list_slice
          if key == "set[T](List[T], Int, T)" Op.list_set
          if key == "reversed[T](List[T])" Op.list_reversed
          if key == "sum(List[Int])" Op.list_sum
          if key == "to_dynamic[T](T)" Op.to_dynamic
          if key == "compile(String, List[FieldType], Expr)" Op.compile
          if key == "code[T](T)" Op.function_code
          if key == "name[T](T)" Op.function_name
          if key == "arguments[T](T)" Op.function_arguments
          crash("Unknown operation " + key + ".")
      code
        compiler_builtin_expression(signature: SourceSignature, parameters: List[Type], values: List[Expr]) Expr =
          key = compiler_builtin_signature(signature)
          if key == "list[T]()" Expr.list(parameters.get(0))
          if key == "type[T]()" Expr.type(parameters.get(0))
          if key == "to_static[T](Dynamic)" Expr.to_static(TypedUnaryExpr(type = parameters.get(0), value = values.get(0)))
          Expr.op(OpExpr(op = compiler_builtin_op(signature), args = values))
      text
        Register a complete declaration group before checking its bodies. Each
        prototype keeps the earlier scope, making recursive groups finite data.
      code
        compiler_group(environment: CompilerEnvironment, definitions: List[SourceFunction],
          generation: Int, validate: Bool) CompilerEnvironment =
          definitions.iter().indexed().fold(environment,
            \ current: CompilerEnvironment, item: Indexed[SourceFunction] ->
              signature = if validate compiler_resolve_signature(environment, item.item.signature) compiler_signature_at(environment, item.item.signature)
              previous = current.functions.lookup(signature.name) or list[CompilerFunction]()
              _ = assert(not(previous.iter().any(\ function: CompilerFunction -> compiler_same_signature(function.signature, signature))),
                "Duplicate function signature " + signature.name + ".")
              function = CompilerFunction(signature, executable = none[Dynamic](), definitions,
                scope = some(environment), generation, slot = item.index)
              CompilerEnvironment(types = current.types, globals = current.globals,
                functions = current.functions.put(signature.name, previous.push(function))))
      text
        A specialization substitutes concrete types before producing Expr.
        Recursive calls refer to an enclosing typed function name; other calls
        embed actual function values or nested monomorphized functions.
      code
        compiler_function_expression_uncached(function: CompilerFunction, substitutions: NameMap[SourceType],
          lowering: CompilerLowering) Expr =
          concrete = substitutions.entries().iter().fold(name_map[SourceType](),
            \ map: NameMap[SourceType], entry: NameEntry[SourceType] ->
              map.put(entry.name, source_substitute(entry.value, lowering.substitutions)))
          signature = function.signature
          parameters = signature.parameters.iter().map(\ name: String -> concrete.lookup(name).unwrap()).to_list()
          original = function.scope or crash("Missing function declaration scope.")
          caller = lowering.environment or original
          types = caller.types.entries().iter().fold(original.types,
            \ map: NameMap[CompilerType], entry: NameEntry[CompilerType] -> map.put(entry.name, entry.value))
          scope = CompilerEnvironment(types, functions = original.functions, globals = original.globals)
          arguments = signature.arguments.iter().map(\ field: SourceField -> SourceField(name = field.name,
            type = source_resolve(source_substitute(field.type, concrete), scope, list[String]()))).to_list()
          returns = source_resolve(source_substitute(signature.returns, concrete), scope, list[String]())
          function_type = SourceType(name = "fun", arguments = arguments.iter().map(\ field: SourceField -> field.type).to_list().push(returns))
          previous = lowering.expanding.iter().filter(\ entry: CompilerExpansion ->
            entry.generation == function.generation and entry.slot == function.slot and entry.types.length() == parameters.length()
              and zip(entry.types.iter(), parameters.iter()).all(\ pair: Tuple2[SourceType, SourceType] -> pair.a == pair.b)).get_maybe(0)
          previous %(
            some(entry) Expr.name(FieldType(name = entry.name, type = entry.type))
            none
              function.executable %(
                some(value) Expr.value(value)
                none
                  definition = function.definitions.get(function.slot)
                  definition.body %(
                    none
                      fields = arguments.iter().map(\ field: SourceField -> FieldType(name = field.name,
                        type = compiler_reflect_cached(scope, field.type, lowering))).to_list()
                      lambda = Function(arguments = fields, body = compiler_builtin_expression(signature,
                        parameters.iter().map(\ type: SourceType -> compiler_reflect_cached(scope, type, lowering)).to_list(),
                        fields.iter().map(\ field: FieldType -> Expr.name(field)).to_list()))
                      Expr.functions(FunctionsExpr(bindings = list(FunctionBinding(name = signature.name, type = compiler_reflect(scope, function_type), function = lambda)),
                        body = Expr.name(FieldType(name = signature.name, type = compiler_reflect(scope, function_type)))))
                    some(source)
                      _ = assert(lowering.expanding.length() < 128, "Monomorphization limit exceeded.")
                      environment = compiler_group(original, function.definitions, function.generation, false)
                      locals = signature.arguments.iter().fold(name_map[SourceType](),
                        \ map: NameMap[SourceType], field: SourceField -> map.put(field.name, field.type))
                      checker = CompilerChecker(environment, locals, parameters = signature.parameters, generation = function.generation)
                      body = compiler_check(checker, source)
                      _ = assert(source_accepts(signature.returns, body.type), "Function return type mismatch.")
                      name = signature.name + {if parameters.is_empty() "" "[" + source_types_text(parameters) + "]"}
                        + "(" + source_types_text(arguments.iter().map(\ field: SourceField -> field.type).to_list()) + ")"
                      signature_type = compiler_reflect(scope, function_type)
                      nested = CompilerLowering(substitutions = concrete, environment = some(scope), snapshots = list(signature_type),
                        expanding = lowering.expanding.push(CompilerExpansion(generation = function.generation,
                          slot = function.slot, types = parameters, name, type = signature_type)), instantiate = lowering.instantiate)
                      lambda = Function(arguments = arguments.iter().map(\ field: SourceField -> FieldType(name = field.name,
                          type = compiler_reflect_cached(scope, field.type, nested))).to_list(),
                        body = Expr.expected(ExpectedExpr(type = compiler_reflect_cached(scope, returns, nested),
                          value = compiler_build(body.expression, nested))))
                      Expr.functions(FunctionsExpr(bindings = list(FunctionBinding(name, type = signature_type, function = lambda)),
                        body = Expr.name(FieldType(name, type = signature_type)))))))
      text
        A compiled function already carries its precise type. Reuse it before
        doing any environment merging or specialization work.
      code
        compiler_function_reference(function: CompilerFunction, substitutions: NameMap[SourceType], lowering: CompilerLowering) Expr =
          types = function.signature.parameters.iter().map(\ name: String ->
            source_substitute(substitutions.lookup(name).unwrap(), lowering.substitutions)).to_list()
          previous = lowering.expanding.iter().filter(\ entry: CompilerExpansion ->
            entry.generation == function.generation and entry.slot == function.slot and entry.types.length() == types.length()
              and zip(entry.types.iter(), types.iter()).all(\ pair: Tuple2[SourceType, SourceType] -> pair.a == pair.b)).get_maybe(0)
          previous %(
            some(entry) Expr.name(FieldType(name = entry.name, type = entry.type))
            none compiler_function_expression_uncached(function, substitutions, lowering))
      code
        compiler_function_expression(function: CompilerFunction, substitutions: NameMap[SourceType], lowering: CompilerLowering) Expr =
          function.executable %(
            some(value) Expr.value(value)
            none compiler_function_reference(function, substitutions, lowering))
      code
        compiler_lowering() CompilerLowering = CompilerLowering(substitutions = name_map[SourceType](),
          expanding = list[CompilerExpansion](), environment = none[CompilerEnvironment](), snapshots = list[Type](), instantiate = \ function: CompilerFunction, substitutions: NameMap[SourceType], lowering: CompilerLowering ->
            compiler_function_expression(function, substitutions, lowering))
      text
        The bootstrap-generated verifier checks the completed expression tree
        again. It infers the result type and seals the ordinary closure in
        Dynamic before execution.
      code
        compiler_execute_checked(value: CompilerChecked, fuel: Int) Execution[Dynamic] =
          function = compile("$eval", list[FieldType](), compiler_build(value.expression, compiler_lowering()))
          run(function, list[Dynamic](), fuel)
      code
        CompilerGlobals = struct { values: List[CompilerGlobal], environment: CompilerEnvironment }
      code
        compiler_compile_globals(environment: CompilerEnvironment, definitions: List[SourceDefinition], generation: Int) CompilerGlobals =
          definitions.iter().fold(CompilerGlobals(values = list[CompilerGlobal](), environment),
            \ state: CompilerGlobals, definition: SourceDefinition -> definition %(
              global(binding)
                value = compiler_check(compiler_checker(state.environment, generation), binding.value)
                _ = source_resolve(value.type, state.environment, list[String]())
                runtime = compiler_execute_checked(value, compiler_initializer_fuel) %(
                  returned(value) value
                  crashed(message) crash("Initializer " + binding.name + ": " + message)
                  out_of_fuel crash("Initializer " + binding.name + " ran out of fuel."))
                if binding.name == "_" state
                  identity(
                    exported = CompilerGlobal(name = binding.name, type = value.type, value = runtime, generation)
                    next = CompilerEnvironment(types = state.environment.types, functions = state.environment.functions,
                      globals = state.environment.globals.put(binding.name, exported))
                    CompilerGlobals(values = state.values.push(exported), environment = next))
              default state))
      text
        Small concrete functions are materialized eagerly for reuse. A larger
        function keeps its checked source template when that optional step runs
        out of fuel or reaches a specialization limit; its caller can
        materialize it when it is actually needed. This optional cache must not
        make a checked declaration fail to load.
      code
        compiler_eager(function: CompilerFunction) Maybe[Dynamic] =
          if function.signature.parameters.is_not_empty() none[Dynamic]()
            garbage_collect(\ -> try(\ ->
              expression = compiler_function_expression(function, name_map[SourceType](), compiler_lowering())
              expression %(
                value(value) value
                default compile(function.signature.name, list[FieldType](), expression).run(list[Dynamic](), compiler_eager_fuel) %(
                  returned(value) value
                  crashed(message) crash(message)
                  out_of_fuel crash("Function specialization ran out of fuel."))), compiler_eager_fuel)) %(
                  returned(value) some(value)
                  out_of_fuel none[Dynamic]()
                  crashed none[Dynamic]())
      text
        Check every body and evaluate initializers transactionally. Concrete
        functions can reuse an eager executable; the remaining declarations keep
        their templates for specialization on demand.
      code
        compiler_compile_code(environment: CompilerEnvironment, definitions: List[SourceDefinition],
          generation: Int) CompilerExports =
          types = definitions.iter().filter_map(\ definition: SourceDefinition -> definition %(
            type(declaration) some(CompilerType(declaration, generation)) default none[CompilerType]())).to_list()
          type_environment = types.iter().fold(environment,
            \ current: CompilerEnvironment, type: CompilerType ->
              _ = assert(current.types.lookup(type.declaration.name) is none, "Duplicate type " + type.declaration.name + ".")
              CompilerEnvironment(types = current.types.put(type.declaration.name, type), functions = current.functions, globals = current.globals))
          _ = types.iter().fold(nothing, \ ignored: Nothing, type: CompilerType -> compiler_validate_type(type_environment, type.declaration))
          functions = definitions.iter().filter_map(\ definition: SourceDefinition -> definition %(
            function(function) some(function) default none[SourceFunction]())).to_list()
          ready = compiler_group(type_environment, functions, generation, true)
          prototypes = functions.iter().indexed().map(\ item: Indexed[SourceFunction] ->
            signature = compiler_resolve_signature(type_environment, item.item.signature)
            _ = item.item.body %(
              none compiler_validate_builtin(signature)
              some(source)
                locals = signature.arguments.iter().fold(name_map[SourceType](),
                  \ map: NameMap[SourceType], field: SourceField -> map.put(field.name, field.type))
                body = compiler_check(CompilerChecker(environment = ready, locals, parameters = signature.parameters, generation), source)
                assert(source_accepts(signature.returns, body.type), "Function " + signature.name + " returns " + body.type.format() + ", expected " + signature.returns.format() + "."))
            prototype = CompilerFunction(signature, executable = none[Dynamic](),
              definitions = functions, scope = some(type_environment), generation, slot = item.index)
            executable = compiler_eager(prototype)
            CompilerFunction(signature, executable, definitions = functions, scope = some(type_environment), generation, slot = item.index)).to_list()
          exports = CompilerExports(types, functions = prototypes, globals = list[CompilerGlobal]())
          globals = compiler_compile_globals(compiler_extend(environment, exports), definitions, generation)
          CompilerExports(types, functions = prototypes, globals = globals.values)
    chapter Dependency requests
      text
        A dependency is a name lookup, including a lookup that found nothing.
        Remembering absent names lets a new declaration invalidate an earlier
        error or change overload resolution. Local variables are not globals.
      code
        CompilerRequestKind = enum { type, function, global }
      code
        CompilerRequest = struct { kind: CompilerRequestKind, name: String }
      code
        CompilerStamp = struct { request: CompilerRequest, versions: List[Int] }
      code
        compiler_request(kind: CompilerRequestKind, name: String) List[CompilerRequest] =
          list(CompilerRequest(kind, name))
      code
        compiler_type_requests(type: SourceType) List[CompilerRequest] =
          own = if type.name == "fun" list[CompilerRequest]() compiler_request(CompilerRequestKind.type, type.name)
          own.push_all(type.arguments.iter().flat_map(\ argument: SourceType -> compiler_type_requests(argument).iter()).to_list())
      code
        CompilerReads = struct { requests: List[CompilerRequest], locals: List[String] }
      code
        CompilerRead = fun(SourceExpression, List[String]) CompilerReads
      text
        Expression sequences pass their local bindings forward. The expression
        walker below resets that scope at explicit block and lambda boundaries.
      code
        compiler_read_many(expressions: List[SourceExpression], locals: List[String], read: CompilerRead) CompilerReads =
          expressions.iter().fold(CompilerReads(requests = list[CompilerRequest](), locals),
            \ state: CompilerReads, expression: SourceExpression ->
              next = read(expression, state.locals)
              CompilerReads(requests = state.requests.push_all(next.requests), locals = next.locals))
      text
        Calls depend on the visible overload set, not only the selected
        overload. Member names are also recorded so changes in method lookup
        cannot leave stale diagnostics. Globals and constructors contribute
        their own declaration generations transitively.
      code
        compiler_read_expression(environment: CompilerEnvironment, expression: SourceExpression,
          locals: List[String]) CompilerReads =
          read = \ value: SourceExpression, scope: List[String] -> compiler_read_expression(environment, value, scope)
          requests = expression %(
            integer compiler_request(CompilerRequestKind.type, "Int")
            floating compiler_request(CompilerRequestKind.type, "Float")
            string compiler_request(CompilerRequestKind.type, "String")
            name(name) if source_has(locals, name) list[CompilerRequest]()
              compiler_request(CompilerRequestKind.global, name).push_all(
                if environment.globals.lookup(name) is some list[CompilerRequest]() compiler_request(CompilerRequestKind.function, name))
            call(call)
              callee = call.callee %(
                name(name)
                  if source_has(locals, name) CompilerReads(requests = list[CompilerRequest](), locals)
                    CompilerReads(locals, requests = compiler_request(CompilerRequestKind.global, name)
                      .push_all(if environment.globals.lookup(name) is some list[CompilerRequest]()
                        compiler_request(CompilerRequestKind.function, name)))
                field(member)
                  receiver = read(member.value, locals)
                  CompilerReads(locals = receiver.locals, requests = receiver.requests
                    .push_all(compiler_request(CompilerRequestKind.function, member.name)))
                default read(call.callee, locals))
              arguments = compiler_read_many(call.arguments, callee.locals, read)
              types = call.types.map(\ types: List[SourceType] ->
                types.iter().flat_map(\ type: SourceType -> compiler_type_requests(type).iter()).to_list())
                or list[CompilerRequest]()
              callee.requests.push_all(arguments.requests).push_all(types)
            field(member) read(member.value, locals).requests
            record(make)
              values = compiler_read_many(make.fields.iter().map(\ field: SourceNamed -> field.value).to_list(), locals, read)
              compiler_type_requests(make.type).push_all(values.requests)
            variant(make) compiler_type_requests(make.type).push_all(read(make.value, locals).requests)
            lambda(lambda)
              parameters = lambda.parameters.iter().map(\ parameter: SourceField -> parameter.name).to_list()
              types = lambda.parameters.iter().flat_map(\ parameter: SourceField -> compiler_type_requests(parameter.type).iter()).to_list()
              types.push_all(read(lambda.body, locals.push_all(parameters)).requests)
            binding(binding) read(binding.value, locals).requests
            block(expressions)
              body = compiler_read_many(expressions, locals, read)
              if expressions.is_empty() body.requests.push_all(compiler_request(CompilerRequestKind.type, "Nothing")) body.requests
            match(match)
              value = read(match.value, locals)
              cases = match.cases.iter().flat_map(\ arm: SourceCase ->
                read(arm.body, arm.binding.map(\ name: String -> value.locals.push(name)) or value.locals).requests.iter()).to_list()
              other = match.otherwise.map(\ expression: SourceExpression -> read(expression, value.locals).requests) or list[CompilerRequest]()
              value.requests.push_all(cases).push_all(other))
          scope = expression %(
            binding(binding) if binding.name == "_" locals locals.push(binding.name)
            default locals)
          CompilerReads(requests, locals = scope)
      text
        Declaration dependencies include their names, annotations, and bodies.
        Initializers can use preceding globals from the same cell; function
        bodies see the environment before those initializers run.
      code
        compiler_definition_requests(environment: CompilerEnvironment, definitions: List[SourceDefinition]) List[CompilerRequest] =
          definitions.iter().fold(CompilerReads(requests = list[CompilerRequest](), locals = list[String]()),
            \ state: CompilerReads, definition: SourceDefinition ->
              own = definition %(
                type(declaration)
                  fields = declaration.kind %(
                    primitive list[CompilerRequest]()
                    alias(type) compiler_type_requests(type)
                    record(fields) fields.iter().flat_map(\ field: SourceField -> compiler_type_requests(field.type).iter()).to_list()
                    variant(fields) fields.iter().flat_map(\ field: SourceField -> compiler_type_requests(field.type).iter()).to_list())
                  fields.push_all(compiler_request(CompilerRequestKind.type, declaration.name))
                    .push_all(declaration.parameters.iter().map(\ name: String -> CompilerRequest(kind = CompilerRequestKind.type, name)).to_list())
                function(function)
                  signature = function.signature
                  types = signature.arguments.iter().flat_map(\ field: SourceField -> compiler_type_requests(field.type).iter()).to_list()
                    .push_all(compiler_type_requests(signature.returns))
                    .push_all(signature.parameters.iter().map(\ name: String -> CompilerRequest(kind = CompilerRequestKind.type, name)).to_list())
                  body = function.body.map(\ expression: SourceExpression -> compiler_read_expression(environment, expression,
                    signature.arguments.iter().map(\ field: SourceField -> field.name).to_list()).requests) or list[CompilerRequest]()
                  compiler_request(CompilerRequestKind.function, signature.name).push_all(types).push_all(body)
                global(binding) compiler_read_expression(environment, binding.value, state.locals).requests)
              locals = definition %(global(binding) state.locals.push(binding.name) default state.locals)
              CompilerReads(requests = state.requests.push_all(own), locals)).requests
      text
        Deduplicate requests by both namespace and name. The namespaces remain
        separate because a global can shadow a named function.
      code
        compiler_request_key(request: CompilerRequest) String =
          {request.kind %(type "t:" function "f:" global "g:")} + request.name
      code
        compiler_unique_requests(requests: List[CompilerRequest]) List[CompilerRequest] =
          requests.iter().fold(name_map[CompilerRequest](),
            \ map: NameMap[CompilerRequest], request: CompilerRequest -> map.put(compiler_request_key(request), request))
            .entries().iter().map(\ entry: NameEntry[CompilerRequest] -> entry.value).to_list()
      text
        Function templates retain the names they actually read, including
        complete overload sets. Unrelated globals and function histories do not
        need to stay alive through an old declaration scope.
      code
        compiler_scope(environment: CompilerEnvironment, requests: List[CompilerRequest]) CompilerEnvironment =
          compiler_unique_requests(requests).iter().fold(CompilerEnvironment(types = environment.types,
            functions = name_map[List[CompilerFunction]](), globals = name_map[CompilerGlobal]()),
            \ scope: CompilerEnvironment, request: CompilerRequest -> request.kind %(
              type scope
              function environment.functions.lookup(request.name).map(\ functions: List[CompilerFunction] ->
                CompilerEnvironment(types = scope.types, functions = scope.functions.put(request.name, functions), globals = scope.globals)) or scope
              global environment.globals.lookup(request.name).map(\ value: CompilerGlobal ->
                CompilerEnvironment(types = scope.types, functions = scope.functions, globals = scope.globals.put(request.name, value))) or scope))
      code
        compiler_scoped_exports(exports: CompilerExports, requests: List[CompilerRequest]) CompilerExports =
          functions = exports.functions.iter().map(\ function: CompilerFunction -> CompilerFunction(
            signature = function.signature, executable = function.executable, definitions = function.definitions, scope = function.scope.map(\ scope: CompilerEnvironment -> compiler_scope(scope, requests)),
            generation = function.generation, slot = function.slot)).to_list()
          CompilerExports(types = exports.types, functions, globals = exports.globals)
      code
        compiler_versions(environment: CompilerEnvironment, request: CompilerRequest) List[Int] =
          request.kind %(
            type environment.types.lookup(request.name).map(\ item: CompilerType -> list(item.generation)) or list[Int]()
            global environment.globals.lookup(request.name).map(\ item: CompilerGlobal -> list(item.generation)) or list[Int]()
            function {environment.functions.lookup(request.name) or list[CompilerFunction]()}
              .iter().map(\ item: CompilerFunction -> item.generation).to_list())
      code
        compiler_stamps(environment: CompilerEnvironment, requests: List[CompilerRequest]) List[CompilerStamp] =
          compiler_unique_requests(requests).iter().map(\ request: CompilerRequest ->
            CompilerStamp(request, versions = compiler_versions(environment, request))).to_list()
      code
        compiler_dependencies_valid(environment: CompilerEnvironment, stamps: List[CompilerStamp]) Bool =
          stamps.iter().all(\ stamp: CompilerStamp ->
            actual = compiler_versions(environment, stamp.request)
            actual.length() == stamp.versions.length() and
              zip(actual.iter(), stamp.versions.iter()).all(\ pair: Tuple2[Int, Int] -> pair.a == pair.b))
    chapter Runtime ABI checks
      text
        Some names have a fixed representation because the host and the checked
        compiler read their values. Their contracts are ordinary reflected types,
        compiled into this compiler. A generic contract uses a marker parameter;
        comparing declarations normalizes that marker and the user's parameter
        name to the same source type. No startup context supplies these layouts.
      code
        CompilerAbiParameter = struct {}
      code
        compiler_abi_type(name: String) Maybe[Type] =
          if name == "Int" some(type[Int]())
          if name == "Float" some(type[Float]())
          if name == "Byte" some(type[Byte]())
          if name == "String" some(type[String]())
          if name == "List" some(type[List[CompilerAbiParameter]]())
          if name == "Type" some(type[Type]())
          if name == "Dynamic" some(type[Dynamic]())
          if name == "Nothing" some(type[Nothing]())
          if name == "Never" some(type[Never]())
          if name == "Maybe" some(type[Maybe[CompilerAbiParameter]]())
          if name == "Execution" some(type[Execution[CompilerAbiParameter]]())
          if name == "Range" some(type[Range[CompilerAbiParameter]]())
          if name == "Iter" some(type[Iter[CompilerAbiParameter]]())
          if name == "Next" some(type[Next[CompilerAbiParameter]]())
          if name == "Ordering" some(type[Ordering]())
          if name == "Bool" some(type[Bool]())
          if name == "FieldType" some(type[FieldType]())
          if name == "StructType" some(type[StructType]())
          if name == "EnumType" some(type[EnumType]())
          if name == "FunctionType" some(type[FunctionType]())
          if name == "TypeInfo" some(type[TypeInfo]())
          if name == "TypeFieldDefinition" some(type[TypeFieldDefinition]())
          if name == "FunctionTypeDefinition" some(type[FunctionTypeDefinition]())
          if name == "TypeDefinition" some(type[TypeDefinition]())
          if name == "TypeShape" some(type[TypeShape]())
          if name == "Function" some(type[Function]())
          if name == "Op" some(type[Op]())
          if name == "OpExpr" some(type[OpExpr]())
          if name == "Expr" some(type[Expr]())
          if name == "FunctionBinding" some(type[FunctionBinding]())
          if name == "FunctionsExpr" some(type[FunctionsExpr]())
          if name == "TypedUnaryExpr" some(type[TypedUnaryExpr]())
          if name == "BindingExpr" some(type[BindingExpr]())
          if name == "If" some(type[If]())
          if name == "CallExpr" some(type[CallExpr]())
          if name == "StructExpr" some(type[StructExpr]())
          if name == "EnumExpr" some(type[EnumExpr]())
          if name == "FieldExpr" some(type[FieldExpr]())
          if name == "Switch" some(type[Switch]())
          if name == "ExpectedExpr" some(type[ExpectedExpr]())
          if name == "CaseExpr" some(type[CaseExpr]())
          if name == "Chapter" some(type[Chapter]())
          if name == "Cell" some(type[Cell]())
          if name == "Color" some(type[Color]())
          if name == "Position" some(type[Position]())
          if name == "Offset" some(type[Offset]())
          if name == "Size" some(type[Size]())
          if name == "Rectangle" some(type[Rectangle]())
          if name == "TransformationMatrix" some(type[TransformationMatrix]())
          if name == "BezierTo" some(type[BezierTo]())
          if name == "PathSegment" some(type[PathSegment]())
          if name == "Path" some(type[Path]())
          if name == "FillPath" some(type[FillPath]())
          if name == "Transform" some(type[Transform]())
          if name == "Clip" some(type[Clip]())
          if name == "DrawCommand" some(type[DrawCommand]())
          if name == "Drawing" some(type[Drawing]())
          if name == "KeyPressed" some(type[KeyPressed]())
          if name == "CharEntered" some(type[CharEntered]())
          if name == "MouseScrolled" some(type[MouseScrolled]())
          if name == "Event" some(type[Event]())
          if name == "AppCommand" some(type[AppCommand]())
          if name == "AppResult" some(type[AppResult]())
          if name == "App" some(type[App]())
          none[Type]()
      code
        compiler_abi_source(type: Type) SourceType =
          parsed = source_parse_type(source_parser(type.name())).value
          source_substitute(parsed, name_map[SourceType]().put("CompilerAbiParameter", source_type("$0")))
      code
        compiler_abi_fields(actual: List[SourceField], expected: List[FieldType], parameters: NameMap[SourceType]) Bool =
          actual.length() == expected.length() and zip(actual.iter(), expected.iter()).all(
            \ pair: Tuple2[SourceField, FieldType] -> pair.a.name == pair.b.name
              and source_substitute(pair.a.type, parameters) == compiler_abi_source(pair.b.type))
      code
        compiler_matches_abi(declaration: SourceTypeDeclaration, expected: Type) Bool =
          type = compiler_abi_source(expected)
          if declaration.parameters.length() != type.arguments.length() false
            identity(
              parameters = source_substitutions(declaration.parameters, type.arguments)
              shape = expected.info()
              declaration.kind %(
                primitive shape %(struct false enum false function false default true)
                alias false
                record(fields) shape %(struct(record) compiler_abi_fields(fields, record.fields, parameters) default false)
                variant(fields) shape %(enum(record) compiler_abi_fields(fields, record.variants, parameters) default false)))
      code
        compiler_validate_abi(definitions: List[SourceDefinition]) Nothing =
          definitions.iter().fold(nothing, \ ignored: Nothing, definition: SourceDefinition -> definition %(
            type(declaration)
              compiler_abi_type(declaration.name) %(none nothing some(expected)
                assert(compiler_matches_abi(declaration, expected),
                  "The runtime ABI of " + declaration.name + " changed."))
            default nothing))
    chapter Cached cell artifacts
      text
        A cache entry keeps source syntax, resolved exports, dependencies, and
        the displayed result. The cache distinguishes code from eval even when
        their source strings happen to match.
      code
        CompilerCellKind = enum { code, eval }
      code
        ==(a: CompilerCellKind, b: CompilerCellKind) Bool = a %(code b is code eval b is eval)
      code
        CompilerSyntax = enum { code: List[SourceDefinition], eval: SourceExpression }
      code
        CompilerOutput = enum {
          none, diagnostic: String, warning: String, string: String, drawing: Drawing, type: SourceType }
      code
        CompilerCachedCell = struct {
          kind: CompilerCellKind, source: String, hash: Int, syntax: Maybe[CompilerSyntax],
          dependencies: List[CompilerStamp], exports: CompilerExports,
          output: CompilerOutput, generation: Int, evaluated: Bool }
      text
        Only whitespace outside the cell's expression or declarations is
        normalized. Full string equality still checks hash collisions.
      code
        compiler_whitespace(c: Char) Bool =
          c.codepoint == 32 or c.codepoint == 9 or c.codepoint == 10 or c.codepoint == 13
      code
        compiler_source_key(source: String) String =
          characters = source.chars().iter().skip_while(\ c: Char -> compiler_whitespace(c)).to_list()
          string(characters.reversed().iter().skip_while(\ c: Char -> compiler_whitespace(c)).to_list().reversed())
      text
        Type checking and execution are separate. Only eval runs an expression
        for display; code evaluates its declared global initializers and exports
        checked declarations for subsequent cells.
      code
        CompilerCompiledCell = struct { exports: CompilerExports, output: CompilerOutput, evaluated: Bool }
      code
        compiler_compile_syntax(environment: CompilerEnvironment, syntax: CompilerSyntax,
          generation: Int) CompilerCompiledCell =
          syntax %(
            code(definitions)
              _ = compiler_validate_abi(definitions)
              exports = compiler_scoped_exports(compiler_compile_code(environment, definitions, generation),
                compiler_definition_requests(environment, definitions))
              CompilerCompiledCell(exports, output = CompilerOutput.none, evaluated = false)
            eval(expression)
              value = compiler_check(compiler_checker(environment, generation), expression)
              result_type = source_resolve(value.type, environment, list[String]())
              output = compiler_execute_checked(value, compiler_eval_fuel) %(
                crashed(message) CompilerOutput.diagnostic(message)
                out_of_fuel CompilerOutput.warning("Evaluation ran out of fuel.")
                returned(result)
                  if result_type == source_type("String") CompilerOutput.string(result.to_static[String]())
                  if result_type == source_type("Drawing") CompilerOutput.drawing(result.to_static[Drawing]())
                    CompilerOutput.type(value.type))
              CompilerCompiledCell(exports = compiler_exports(), output, evaluated = true))
      text
        Failures are cached too. A parse failure has no environment dependency;
        a type error records the lookups that could make the code valid later.
      code
        compiler_new_cell(environment: CompilerEnvironment, kind: CompilerCellKind, source: String,
          hash: Int, generation: Int) CompilerCachedCell =
          parsed = try(\ -> kind %(
            code CompilerSyntax.code(parse_code(source))
            eval CompilerSyntax.eval(parse_eval(source))), compiler_parse_fuel)
          parsed %(
            crashed(message) CompilerCachedCell(kind, source, hash, generation,
              syntax = none[CompilerSyntax](), dependencies = list[CompilerStamp](), exports = compiler_exports(),
              output = CompilerOutput.diagnostic(message), evaluated = false)
            out_of_fuel CompilerCachedCell(kind, source, hash, generation,
              syntax = none[CompilerSyntax](), dependencies = list[CompilerStamp](), exports = compiler_exports(),
              output = if kind is code CompilerOutput.diagnostic("Parser ran out of fuel.")
                CompilerOutput.warning("Parser ran out of fuel."), evaluated = false)
            returned(syntax)
              requests = syntax %(
                code(definitions) compiler_definition_requests(environment, definitions)
                eval(expression) compiler_read_expression(environment, expression, list[String]()).requests)
              dependencies = compiler_stamps(environment, requests)
              compiled = try(\ -> compiler_compile_syntax(environment, syntax, generation), compiler_compile_fuel) %(
                returned(value) value
                crashed(message) CompilerCompiledCell(exports = compiler_exports(), output = CompilerOutput.diagnostic(message), evaluated = false)
                out_of_fuel CompilerCompiledCell(exports = compiler_exports(),
                  output = if kind is code CompilerOutput.diagnostic("Compiler ran out of fuel.")
                    CompilerOutput.warning("Compiler ran out of fuel."), evaluated = false))
              CompilerCachedCell(kind, source, hash, generation, syntax = some(syntax), dependencies,
                exports = compiled.exports, output = compiled.output, evaluated = compiled.evaluated))
    chapter Incremental notebook evaluation
      text
        The cache mirrors the chapter tree. Each chapter keeps its input and
        output environments, exported declarations, and the external names it
        read. An unchanged chapter can reuse that whole result without visiting
        its cells or rebuilding their result maps.
      chapter Cached chapter trees
        code
          CompilerLocation = struct { source: String, kind: CompilerCellKind, cell: CompilerCachedCell }
        text
          Dependency summaries form a tree too. A parent can retain a cached
          group's reads without scanning and deduplicating them again.
        code
          CompilerDependencies = enum { stamps: List[CompilerStamp], groups: List[CompilerDependencies] }
        text
          Cached children retain their own relative positions. Results therefore
          move with a chapter rather than carrying obsolete absolute paths.
          Children after active are retained for recovery from a blocking error,
          but are not exposed as current results.
        code
          CompilerCachedNode = enum { text, cell: CompilerLocation, chapter: CompilerCachedChapter }
          CompilerCachedChapter = struct {
            source: Chapter, input: CompilerEnvironment, output: CompilerEnvironment,
            dependencies: CompilerDependencies, exports: CompilerExports,
            children: List[CompilerCachedNode], active: Int, count: Int, stopped: Bool }
        code
          CompilerResults = struct { root: Maybe[CompilerCachedChapter] }
      chapter Looking up results
        code
          compiler_result_at(chapter: CompilerCachedChapter, indices: List[Int], depth: Int) Maybe[CompilerCachedCell] =
            if depth == indices.length() none[CompilerCachedCell]()
              identity(
                index = indices.get(depth)
                if index < 0 or index >= chapter.active none[CompilerCachedCell]()
                  chapter.children.get(index) %(
                    text none[CompilerCachedCell]()
                    cell(location) if {depth + 1} == indices.length() some(location.cell) none[CompilerCachedCell]()
                    chapter(child) compiler_result_at(child, indices, depth + 1)))
        code
          lookup(results: CompilerResults, path: NotebookPath) Maybe[CompilerCachedCell] =
            results.root.flat_map(\ root: CompilerCachedChapter -> compiler_result_at(root, path.indices, 0))
        text
          String keys remain useful for diagnostics and inspection. The editor
          already has a NotebookPath and can look up results directly.
        code
          compiler_result_path(key: String) NotebookPath =
            parts = key.bytes().without_first().iter().fold(tuple(list[Int](), 0),
              \ state: Tuple2[List[Int], Int], byte: Byte ->
                if byte.to_int() == 47 tuple(state.a.push(state.b), 0)
                  tuple(state.a, {state.b * 10} + byte.to_int() - 48))
            NotebookPath(indices = parts.a.push(parts.b))
        code
          lookup(results: CompilerResults, key: String) Maybe[CompilerCachedCell] =
            if key == "" none[CompilerCachedCell]() results.lookup(compiler_result_path(key))
        code
          compiler_result_entries(chapter: CompilerCachedChapter, prefix: String) List[NameEntry[CompilerCachedCell]] =
            chapter.children.first(chapter.active).iter().indexed().flat_map(\ item: Indexed[CompilerCachedNode] ->
              path = prefix + "/" + item.index.format()
              item.item %(
                text list[NameEntry[CompilerCachedCell]]().iter()
                cell(location) list(NameEntry(name = path, value = location.cell)).iter()
                chapter(child) compiler_result_entries(child, path).iter())).to_list()
        code
          entries(results: CompilerResults) List[NameEntry[CompilerCachedCell]] =
            results.root.map(\ root: CompilerCachedChapter -> compiler_result_entries(root, "")) or list[NameEntry[CompilerCachedCell]]()
      chapter Evaluation state
        text
          Count cell visits separately from compilation. A chapter cache hit
          adds its cell count to reused, while visited stays unchanged.
        code
          CompilerStatistics = struct { compiled: Int, evaluated: Int, reused: Int, visited: Int, chapters_reused: Int }
        code
          compiler_statistics() CompilerStatistics = CompilerStatistics(compiled = 0, evaluated = 0, reused = 0,
            visited = 0, chapters_reused = 0)
        code
          CompilerEvaluation = struct {
            recent: List[CompilerCachedCell], results: CompilerResults,
            environment: CompilerEnvironment,
            next_generation: Int, statistics: CompilerStatistics }
        code
          CompilerPass = struct {
            previous: CompilerEvaluation, recent: List[CompilerCachedCell], environment: CompilerEnvironment,
            next_generation: Int, statistics: CompilerStatistics, stopped: Bool }
        code
          compiler_path_key(path: NotebookPath) String =
            path.indices.iter().fold("", \ prefix: String, index: Int -> prefix + "/" + index.format())
      chapter Recent sources and initial state
        text
          The chapter tree owns current artifacts. A bounded recent-source list
          also reuses cells after small structural edits, without keeping an
          entire history of intermediate strings. Startup begins with no cached
          declarations: the first pass reads and evaluates the document itself.
        code
          compiler_recent_put(recent: List[CompilerCachedCell], cell: CompilerCachedCell) List[CompilerCachedCell] =
            added = recent.iter().filter(\ old: CompilerCachedCell -> old.generation != cell.generation).to_list().push(cell)
            added.without_first(max(0, added.length() - 64))
        code
          compiler_evaluation() CompilerEvaluation =
            CompilerEvaluation(recent = list[CompilerCachedCell](),
              results = CompilerResults(root = none[CompilerCachedChapter]()), environment = compiler_environment(),
              next_generation = 1, statistics = compiler_statistics())
      chapter Cell reuse
        text
          Cell checks are the fallback inside changed chapters. Reuse a location
          first, then a matching recent artifact, before compiling.
        code
          CompilerCellResult = struct { state: CompilerPass, location: CompilerLocation }
        code
          compiler_process_cell(state: CompilerPass, located: Maybe[CompilerLocation],
            kind: CompilerCellKind, source: String) CompilerCellResult =
            garbage_collect(\ ->
              direct = located.flat_map(\ old: CompilerLocation ->
                if old.kind == kind and old.source == source and compiler_dependencies_valid(state.environment, old.cell.dependencies)
                  some(old.cell) none[CompilerCachedCell]())
              normalized = direct.map(\ cell: CompilerCachedCell -> cell.source) or compiler_source_key(source)
              hash = direct.map(\ cell: CompilerCachedCell -> cell.hash) or name_hash(normalized)
              recent = direct %(some(cell) some(cell)
                none state.previous.recent.iter().filter(\ cell: CompilerCachedCell ->
                  cell.hash == hash and cell.kind == kind and cell.source == normalized
                    and compiler_dependencies_valid(state.environment, cell.dependencies)).get_maybe(0))
              reused = recent
              cell = reused or garbage_collect(\ -> compiler_new_cell(state.environment, kind, normalized,
                hash, state.next_generation))
              fresh = reused is none
              stopped = {kind is code} and {cell.output is diagnostic}
              environment = if stopped state.environment compiler_extend(state.environment, cell.exports)
              stats = state.statistics
              statistics = CompilerStatistics(compiled = stats.compiled + if fresh 1 0,
                evaluated = stats.evaluated + if fresh and cell.evaluated 1 0, reused = stats.reused + if fresh 0 1,
                visited = stats.visited + 1, chapters_reused = stats.chapters_reused)
              CompilerCellResult(location = CompilerLocation(source, kind, cell),
                state = CompilerPass(previous = state.previous,
                  recent = if direct is some state.recent compiler_recent_put(state.recent, cell),
                  environment, next_generation = state.next_generation + if fresh 1 0, statistics, stopped)))
      chapter External chapter dependencies
        text
          A chapter depends on names read from its incoming environment. Reads
          of types and globals defined earlier inside it are internal. Overload
          sets stay external even after local overloads are added, and absent
          names are kept so adding a declaration can invalidate a previous
          result.
        code
          compiler_chapter_dependencies(input: CompilerEnvironment, dependencies: NameMap[CompilerStamp],
            stamps: List[CompilerStamp]) NameMap[CompilerStamp] =
            stamps.iter().fold(dependencies, \ map: NameMap[CompilerStamp], stamp: CompilerStamp ->
              versions = compiler_versions(input, stamp.request)
              if {stamp.request.kind is function} or equals(versions, stamp.versions)
                map.put(compiler_request_key(stamp.request), CompilerStamp(request = stamp.request, versions)) map)
        text
          Keep dependency groups shared while editing. Flatten and deduplicate
          them only when an unchanged chapter receives a different environment.
          Cache that external summary after validation, so later unrelated
          upstream edits can check it directly. The notebook root never needs to
          flatten the dependencies of the entire standard library.
        code
          compiler_dependency_groups(input: CompilerEnvironment, dependencies: NameMap[CompilerStamp],
            group: CompilerDependencies) NameMap[CompilerStamp] =
            group %(
              stamps(values) compiler_chapter_dependencies(input, dependencies, values)
              groups(children) children.iter().fold(dependencies,
                \ map: NameMap[CompilerStamp], child: CompilerDependencies -> compiler_dependency_groups(input, map, child)))
        code
          compiler_external_dependencies(chapter: CompilerCachedChapter) List[CompilerStamp] =
            chapter.dependencies %(
              stamps(values) values
              groups compiler_dependency_groups(chapter.input, name_map[CompilerStamp](), chapter.dependencies)
                .entries().iter().map(\ entry: NameEntry[CompilerStamp] -> entry.value).to_list())
        code
          compiler_join_exports(left: CompilerExports, right: CompilerExports) CompilerExports =
            CompilerExports(types = left.types.push_all(right.types), functions = left.functions.push_all(right.functions),
              globals = left.globals.push_all(right.globals))
      chapter Chapter reuse
        text
          The common case has exactly the same incoming environment. Return the
          cached output directly. If unrelated definitions changed, validate
          only the chapter's external stamps and apply its cached exports to the
          new environment, preserving the unrelated bindings.
        code
          compiler_reuse_chapter(state: CompilerPass, old: CompilerCachedChapter) CompilerPass =
            stats = state.statistics
            CompilerPass(previous = state.previous, recent = state.recent,
              environment = if equals(state.environment, old.input) old.output compiler_extend(state.environment, old.exports),
              next_generation = state.next_generation, stopped = old.stopped,
              statistics = CompilerStatistics(compiled = stats.compiled, evaluated = stats.evaluated,
                reused = stats.reused + old.count, visited = stats.visited, chapters_reused = stats.chapters_reused + 1))
        text
          Prefer the chapter at the same position. When chapters move, a sibling
          with identical contents can carry its cache along to the new position.
        code
          compiler_old_chapter(children: List[CompilerCachedNode], index: Int, source: Chapter) Maybe[CompilerCachedChapter] =
            direct = children.get_maybe(index).flat_map(\ node: CompilerCachedNode -> node %(
              chapter(child) some(child) default none[CompilerCachedChapter]()))
            if direct.map(\ old: CompilerCachedChapter -> equals(old.source.children, source.children)) or false direct
              identity(
                moved = children.iter().filter_map(\ node: CompilerCachedNode -> node %(
                  chapter(child) if equals(child.source.children, source.children) some(child) none[CompilerCachedChapter]()
                  default none[CompilerCachedChapter]())).get_maybe(0)
                moved %(some(child) some(child) none direct))
        code
          CompilerChapterBuild = struct {
            state: CompilerPass, children: List[CompilerCachedNode], dependencies: List[CompilerDependencies],
            exports: CompilerExports, count: Int }
        code
          CompilerChapterResult = struct { state: CompilerPass, chapter: CompilerCachedChapter }
      chapter Walking changed chapters
        text
          Walk only a changed chapter's immediate children. A nested cache hit
          contributes its dependencies and exports as a unit. After a blocking
          error, keep old children for recovery without evaluating or exposing
          them as current results.
        code
          compiler_process_chapter(state: CompilerPass, source: Chapter,
            previous: Maybe[CompilerCachedChapter]) CompilerChapterResult =
            reusable = previous.flat_map(\ old: CompilerCachedChapter ->
              if not(equals(old.source.children, source.children)) none[CompilerCachedChapter]()
              if equals(state.environment, old.input) some(old)
                identity(
                  dependencies = compiler_external_dependencies(old)
                  if compiler_dependencies_valid(state.environment, dependencies)
                    some(CompilerCachedChapter(source = old.source, input = old.input, output = old.output,
                      dependencies = CompilerDependencies.stamps(dependencies), exports = old.exports,
                      children = old.children, active = old.active, count = old.count, stopped = old.stopped))
                    none[CompilerCachedChapter]()))
            reusable %(
              some(old)
                reused = compiler_reuse_chapter(state, old)
                cached = if equals(state.environment, old.input) old
                  CompilerCachedChapter(source = old.source, input = state.environment, output = reused.environment,
                    dependencies = old.dependencies, exports = old.exports, children = old.children,
                    active = old.active, count = old.count, stopped = old.stopped)
                CompilerChapterResult(state = reused, chapter = cached)
              none
                old_children = previous.map(\ old: CompilerCachedChapter -> old.children) or list[CompilerCachedNode]()
                initial = CompilerChapterBuild(state, children = list[CompilerCachedNode](),
                  dependencies = list[CompilerDependencies](), exports = compiler_exports(), count = 0)
                built = source.children.iter().indexed().fold(initial,
                  \ current: CompilerChapterBuild, item: Indexed[Cell] ->
                    if current.state.stopped current
                      item.item %(
                        text CompilerChapterBuild(state = current.state, children = current.children.push(CompilerCachedNode.text),
                          dependencies = current.dependencies, exports = current.exports, count = current.count)
                        chapter(child)
                          result = compiler_process_chapter(current.state, child, compiler_old_chapter(old_children, item.index, child))
                          CompilerChapterBuild(state = result.state, children = current.children.push(CompilerCachedNode.chapter(result.chapter)),
                            dependencies = current.dependencies.push(result.chapter.dependencies),
                            exports = compiler_join_exports(current.exports, result.chapter.exports), count = current.count + result.chapter.count)
                        default
                          kind = item.item %(code CompilerCellKind.code default CompilerCellKind.eval)
                          text = item.item %(code(text) text eval(text) text default "")
                          located = old_children.get_maybe(item.index).flat_map(\ node: CompilerCachedNode -> node %(
                            cell(location) some(location) default none[CompilerLocation]()))
                          result = compiler_process_cell(current.state, located, kind, text)
                          CompilerChapterBuild(state = result.state, children = current.children.push(CompilerCachedNode.cell(result.location)),
                            dependencies = current.dependencies.push(CompilerDependencies.stamps(result.location.cell.dependencies)),
                            exports = compiler_join_exports(current.exports, result.location.cell.exports), count = current.count + 1)))
                active = built.children.length()
                children = if built.state.stopped and active < old_children.length()
                  built.children.push_all(old_children.without_first(active)) built.children
                cached = CompilerCachedChapter(source, input = state.environment, output = built.state.environment,
                  dependencies = CompilerDependencies.groups(built.dependencies),
                  exports = built.exports, children, active, count = built.count, stopped = built.state.stopped)
                CompilerChapterResult(state = built.state, chapter = cached))
        code
          evaluate_notebook(previous: CompilerEvaluation, notebook: Chapter) CompilerEvaluation =
            initial = CompilerPass(previous, recent = previous.recent, environment = compiler_environment(),
              next_generation = previous.next_generation, statistics = compiler_statistics(), stopped = false)
            result = garbage_collect(\ -> compiler_process_chapter(initial, notebook, previous.results.root))
            CompilerEvaluation(recent = result.state.recent,
              results = CompilerResults(root = some(result.chapter)), environment = result.state.environment,
              next_generation = result.state.next_generation, statistics = result.state.statistics)
  chapter Components
    text
      Components are ordinary values with concrete state. Their functions return
      updated values; the app owns those values and decides where events go.
      There is no element lifecycle or shared dynamic widget interface.
    chapter Cached text
      text
        Text eagerly decodes, lays out, and draws its string. render only
        returns the cached Drawing. Updates with unchanged content or
        constraints reuse the existing value. Widths are in the font's native
        drawing units.
      text
        A width limit controls word wrapping. An absent limit lets text keep its
        natural width. For a bounded width, the limit has to be positive.
      code
        TextConstraints = struct { max_width: Maybe[Float] }
      code
        text_constraints(width: Float) TextConstraints =
          TextConstraints(max_width = some(max(1.0, width)))
      code
        ==(a: TextConstraints, b: TextConstraints) Bool =
          a.max_width %(
            none b.max_width is none
            some(aa) b.max_width %(none false some(bb) aa == bb))
      text
        Keep the source string and decoded characters alongside the layout and
        drawing. Every cache describes the same version of the text.
      code
        Text = struct {
          value: String,
          chars: List[Char],
          constraints: TextConstraints,
          layout: TextLayout,
          drawing: Drawing }
      text
        There are several constructors you can choose from, depending on how
        much of the text layouting you want you want to constrain. Whatever you
        provide, the text will eagerly map the characters to glyphs, position
        the glyphs, then turn that layout into drawing commands.
      code
        text(value: String, chars: List[Char], constraints: TextConstraints) Text =
          layout = layout_text(chars, constraints.max_width)
          Text(value, chars, constraints, layout,
            drawing = layout.draw_text(color("#18212b")))
      code
        text(value: String, constraints: TextConstraints) Text =
          text(value, value.chars(), constraints)
      code
        text(value: String, width: Float) Text = text(value, text_constraints(width))
      code
        text(value: String) Text = text(value, TextConstraints(max_width = none[Float]()))
      text
        Updates compute only the changed parts of the text.
      code
        update(t: Text, value: String) Text =
          chars = value.chars()
          if t.chars == chars t text(value, chars, t.constraints)
      code
        update(t: Text, constraints: TextConstraints) Text =
          if t.constraints == constraints
            t
            text(t.value, t.chars, constraints)
      text
        Rendering is now just a field lookup; the expensive work happened during
        construction or update.
      code
        render(t: Text) Drawing = t.drawing
    chapter Editable text
      text
        EditableText is similar to Text, but with a character cursor and
        selection. Focus belongs to the parent, which chooses whether to draw
        the selection.
      chapter Cursor and selection
        text
          A cursor has two character offsets: the selection anchor and its
          moving end. desired_x remembers a horizontal target when moving
          through lines of different lengths.
        code
          TextCursor = struct { anchor: Int, active: Int, desired_x: Float }
        text
          Selections can run backwards. The smaller character offset is the
          start, the bigger one is the end.
        code
          start(cursor: TextCursor) Int = min(cursor.anchor, cursor.active)
        code
          end(cursor: TextCursor) Int = max(cursor.anchor, cursor.active)
      chapter Editor state
        text
          Combine cached Text with a list of all possible cursor positions and a
          cursor. A revision counts content changes, letting the parent
          recognize an edit without comparing strings.
        code
          EditableText = struct {
            text: Text,
            positions: List[Position],
            cursor: TextCursor,
            revision: Int }
      chapter Insertion positions
        text
          While finding insertion positions, track the next glyph and the pen
          position. Newlines consume characters but do not consume glyphs.
        code
          TextCursorLayout = struct {
            glyph_index: Int,
            position: Position,
            positions: LinkedList[Position] }
        text
          Record the position before every character and one final position
          after the text. At a soft wrap, use the next glyph's new line so
          clicking and cursor drawing agree.
        code
          text_cursor_positions(chars: List[Char], layout: TextLayout) List[Position] =
            glyphs = layout.glyphs
            result = chars.iter().fold(
              TextCursorLayout(
                glyph_index = 0,
                position = position(0.0, 0.0),
                positions = empty_linked_list[Position]()),
              \ state: TextCursorLayout, character: Char ->
                is_newline = character.codepoint == 10
                before =
                  if is_newline
                    state.position
                    glyphs.get(state.glyph_index).position
                next =
                  if is_newline
                    position(0.0, before.y + text_line_height)
                    identity(
                      glyph = glyphs.get(state.glyph_index)
                      position(before.x + glyph.glyph.width + 1.0, before.y))
                TextCursorLayout(
                  glyph_index = state.glyph_index + if is_newline 0 1,
                  position = next,
                  positions = cons(before, state.positions)))
            cons(result.position, result.positions).iter().to_list().reversed()
        text
          A click first chooses the nearest line, then the nearest horizontal
          insertion position on that line.
        code
          text_cursor_pick(positions: List[Position], target: Position) Int =
            positions.iter().indexed()
            . fold(
                0,
                \ best: Int, item: Indexed[Position] ->
                  previous = positions.get(best)
                  dy = abs(item.item.y - target.y)
                  best_dy = abs(previous.y - target.y)
                  if
                    dy < best_dy
                      or {dy == best_dy
                        and abs(item.item.x - target.x)
                          < abs(previous.x - target.x)}
                    item.index
                    best)
      chapter Creating and updating text
        text
          Start with cached text, its insertion positions, and a collapsed
          cursor at the beginning.
        code
          editable_text(value: String, constraints: TextConstraints) EditableText =
            t = text(value, constraints)
            EditableText(
              text = t,
              positions = text_cursor_positions(t.chars, t.layout),
              cursor = TextCursor(anchor = 0, active = 0, desired_x = 0.0),
              revision = 0)
        text
          A new width can move insertion positions even though the characters
          stay the same. Rebuild that geometry only when the constraints change.
        code
          update(e: EditableText, constraints: TextConstraints) EditableText =
            if e.text.constraints == constraints
              e
              identity(
                t = e.text.update(constraints)
                EditableText(
                  text = t,
                  positions = text_cursor_positions(t.chars, t.layout),
                  cursor = e.cursor,
                  revision = e.revision))
        text
          Moving a cursor shares all text caches and leaves the content revision
          unchanged.
        code
          update(e: EditableText, cursor: TextCursor) EditableText =
            EditableText(text = e.text, positions = e.positions, cursor, revision = e.revision)
        text
          Clamp a requested character offset and remember its horizontal
          position. Extending preserves the anchor; an ordinary move collapses
          the selection.
        code
          text_cursor_at(e: EditableText, offset: Int, extend: Bool) EditableText =
            active = max(0, min(offset, e.text.chars.length()))
            e.update(TextCursor(
              anchor = if extend e.cursor.anchor active,
              active,
              desired_x = e.positions.get(active).x))
        text
          Convert a mouse click into a cursor move. Comparing against line
          centers gives each rendered line a natural clickable area.
        code
          pick(e: EditableText, pos: Position, extend: Bool) EditableText =
            e.text_cursor_at(
              text_cursor_pick(
                e.positions,
                position(pos.x, max(0.0, pos.y - {text_line_height / 2.0}))),
              extend)
        text
          Every content edit replaces a character range. Rebuild the text caches
          together, increment the revision, and place the cursor after the
          inserted characters.
        code
          replace(e: EditableText, start: Int, end: Int, inserted: List[Char]) EditableText =
            chars =
              e.text.chars.first(start).push_all(inserted)
              . push_all(e.text.chars.without_first(end))
            if chars == e.text.chars
              e
              identity(
                t = text(string(chars), chars, e.text.constraints)
                next = EditableText(
                  text = t,
                  positions = text_cursor_positions(chars, t.layout),
                  cursor = e.cursor,
                  revision = e.revision + 1)
                next.text_cursor_at(start + inserted.length(), false))
      chapter Word and line boundaries
        text
          Word movement groups letters, digits, underscores, and non-ASCII
          characters separately from spaces and punctuation.
        code
          is_text_word_char(character: Char) Bool =
            code = character.codepoint
            {code >= 65 and code <= 90} or {code >= 97 and code <= 122}
              or {code >= 48 and code <= 57} or code == 95 or code >= 128
        text
          Count a run of one character category while walking forwards or
          backwards. The ends of the string stop the scan.
        code
          text_word_skip(chars: List[Char], index: Int, direction: Int, kind: Int) Int =
            if index < 0 or index >= chars.length()
              0
              identity(
                code = chars.get(index).codepoint
                current =
                  if code == 32 0 if chars.get(index).is_text_word_char() 1 2
                if current != kind
                  0
                  1 + text_word_skip(chars, index + direction, direction, kind))
        text
          Control-modified movement first skips spaces, then crosses a word or
          punctuation group.
        code
          text_word_distance(chars: List[Char], index: Int, direction: Int) Int =
            if index < 0 or index >= chars.length() 0
              identity(
                code = chars.get(index).codepoint
                if code == 32
                  1 + text_word_distance(chars, index + direction, direction)
                  if chars.get(index).is_text_word_char()
                    text_word_skip(chars, index, direction, 1)
                    identity(
                      punctuation = text_word_skip(chars, index, direction, 2)
                      if punctuation > 1
                        punctuation
                        1 + text_word_skip(chars, index + direction, direction, 1)))
        text
          Home and End follow explicit newline boundaries, independently of
          visual wrapping.
        code
          text_line_boundary(chars: List[Char], offset: Int, direction: Int) Int =
            index = if direction < 0 offset - 1 offset
            if index < 0 or index >= chars.length() offset
              if chars.get(index).codepoint == 10 offset
                text_line_boundary(chars, offset + direction, direction)
      chapter Key codes
        code
          key_a = 65
        code
          key_escape = 256
        code
          key_tab = 258
        code
          key_enter = 257
        code
          key_backspace = 259
        code
          key_delete = 261
        code
          key_arrow_right = 262
        code
          key_arrow_left = 263
        code
          key_arrow_down = 264
        code
          key_arrow_up = 265
        code
          key_home = 268
        code
          key_end = 269
      chapter Keyboard editing
        text
          Keyboard editing combines range replacement with cursor movement.
          Shift extends a selection, Control moves by words, and vertical
          movement preserves the desired horizontal position.
        code
          editable_key(e: EditableText, key: KeyPressed
            ) EditableText =
            chars = e.text.chars
            start = e.cursor.start()
            end = e.cursor.end()
            selected = start != end
            code = key.keycode
            if key.alt e
            if key.control and code == key_a
              identity(
                text_cursor_at(text_cursor_at(e, 0, false), chars.length(), true))
            if code == key_enter and not(key.shift)
              identity(
                offset = text_line_boundary(chars, e.cursor.active, 1)
                if key.control replace(e, offset, offset, list(char(10)))
                  replace(e, start, end, list(char(10))))
            if {code == key_backspace or code == key_delete} and not(key.shift)
              identity(
                from = if selected start
                  if code == key_backspace
                    if key.control
                      e.cursor.active
                        - text_word_distance(chars, e.cursor.active - 1, -1)
                      max(0, e.cursor.active - 1)
                    e.cursor.active
                to = if selected end
                  if code == key_delete
                    if key.control
                      e.cursor.active
                        + text_word_distance(chars, e.cursor.active, 1)
                      min(chars.length(), e.cursor.active + 1)
                    e.cursor.active
                if from == to identity(e)
                  replace(e, from, to, list[Char]()))
            if code == key_arrow_right or code == key_arrow_left
              identity(
                right = code == key_arrow_right
                offset =
                  if key.control
                    if right
                      e.cursor.active
                        + text_word_distance(chars, e.cursor.active, 1)
                      e.cursor.active
                        - text_word_distance(chars, e.cursor.active - 1, -1)
                    if selected and not(key.shift) {if right end start}
                      e.cursor.active + if right 1 {0 - 1}
                identity(
                  text_cursor_at(e, offset, key.shift)))
            if code == key_home or code == key_end
              identity(
                offset = if key.control {if code == key_home 0 chars.length()}
                  text_line_boundary(
                    chars, e.cursor.active, if code == key_home {0 - 1} 1)
                identity(
                  text_cursor_at(e, offset, key.shift)))
            if {code == key_arrow_down or code == key_arrow_up}
                and not(key.control)
              identity(
                positions = e.positions
                current = positions.get(e.cursor.active)
                y =
                  current.y
                    + if code == key_arrow_down
                        text_line_height
                        0.0 - text_line_height
                offset = if y < 0.0 0
                  if y > positions.get(positions.length() - 1).y chars.length()
                    text_cursor_pick(positions, position(e.cursor.desired_x, y))
                next = text_cursor_at(e, offset, key.shift)
                identity(
                  e.update(TextCursor(
                    anchor = next.cursor.anchor,
                    active = next.cursor.active,
                    desired_x = e.cursor.desired_x))))
            e
        text
          Character input arrives separately from key presses. Accept printable
          Unicode scalar values and replace the current selection with the
          entered character.
        code
          editable_character(e: EditableText, code: Int) EditableText =
            if code < 32 or code == 127 or code > 1114111
              or {code >= 55296 and code <= 57343} e
              replace(e, e.cursor.start(), e.cursor.end(), list(char(code)))
      chapter Drawing the selection
        text
          A small colored rectangle can represent either a caret or one piece of
          a selection.
        code
          selection_rect(pos: Position, width: Float) DrawCommand =
            draw_translated(pos.x, pos.y,
              draw_colored_rect(size(max(1.0, width), text_line_height), color("#a9d0ff")))
        text
          A collapsed selection draws a thin caret. Otherwise, highlight each
          selected character span, filling to the available width when the span
          crosses a line.
        code
          render_selection(e: EditableText) DrawCommand =
            from = e.cursor.start()
            to = e.cursor.end()
            width = e.text.constraints.max_width or {e.text.layout.size.width + 2.0}
            if from == to selection_rect(e.positions.get(from), 1.0)
              draw_all({from..to}.iter().map(\ index: Int ->
                before = e.positions.get(index)
                after = e.positions.get(index + 1)
                selection_rect(before,
                  if after.y > before.y width - before.x after.x - before.x)).to_list())
        text
          The parent decides whether this editor is focused. Add its selection
          behind the cached text only while focused, and reserve a line of space
          even for empty input.
        code
          render(e: EditableText, focused: Bool) Drawing =
            cached = e.text.render()
            Drawing(
              size =
                size(
                  max(2.0, cached.size.width + 2.0),
                  max(text_line_height, cached.size.height)),
              draw = draw_all(list(if focused e.render_selection() draw_nothing(), cached.draw)))
    chapter Column layout
      text
        Column layout computes bounds independently of rendering and input.
        Callers use the same bounds for drawing, picking, and focus visibility.
        A per-item gap allows breadcrumbs to touch while cells have breathing
        room.
      text
        Each column item supplies its measured size and the gap that should
        follow it.
      code
        ColumnItem = struct { size: Size, gap: Float }
      text
        The result stores one rectangle per item and the overall extent. Drawing
        and hit testing will share these rectangles.
      code
        ColumnLayout = struct { bounds: List[Rectangle], size: Size }
      text
        Place each item below the previous one, accumulating height and
        retaining the widest item.
      code
        column_layout(items: List[ColumnItem]) ColumnLayout =
          items.iter().fold(
            ColumnLayout(bounds = list[Rectangle](), size = size(0.0, 0.0)),
            \ layout: ColumnLayout, item: ColumnItem ->
              ColumnLayout(
                bounds = layout.bounds.push(rectangle(position(0.0, layout.size.height), item.size)),
                size =
                  size(
                    max(layout.size.width, item.size.width),
                    layout.size.height + item.size.height + item.gap)))
      text
        Hit testing returns the first item whose rectangle contains the pointer.
        Gaps belong to no item.
      code
        pick(layout: ColumnLayout, pos: Position) Maybe[Int] =
          layout.bounds.iter().indexed()
          . filter(\ item: Indexed[Rectangle] -> item.item.contains(pos))
          . get_maybe(0)
          . map(\ item: Indexed[Rectangle] -> item.index)
    chapter Scrolling
      text
        Scroll stores only geometry and offsets. Scrolling translates and clips
        cached commands. reveal makes keyboard focus visible without scrolling a
        tall cell past its beginning.
      text
        Scrolling needs the current offset, the visible viewport, and the size
        of the content.
      code
        Scroll = struct { viewport: Size, content: Size, offset: Offset }
      text
        Constrain offsets to the part of the content outside the viewport.
        Content smaller than the viewport stays at zero.
      code
        clamp_scroll(delta: Offset, viewport: Size, content: Size) Offset =
          offset(
            max(0.0, min(delta.x, content.width - viewport.width)),
            max(0.0, min(delta.y, content.height - viewport.height)))
      text
        Construct a scroll state with an already valid offset.
      code
        scroll(viewport: Size, content: Size, offset: Offset) Scroll =
          Scroll(
            viewport,
            content,
            offset = offset.clamp_scroll(viewport, content))
      text
        When the viewport or content changes size, retain the old offset
        wherever it still fits.
      code
        update(s: Scroll, viewport: Size, content: Size) Scroll =
          scroll(viewport, content, s.offset)
      text
        Wheel movement adds a delta and clamps the result at the content edges.
      code
        move(s: Scroll, delta: Offset) Scroll = scroll(s.viewport, s.content, s.offset + delta)
      text
        Keyboard focus can request that a rectangle become visible. If it is
        taller or wider than the viewport, reveal its beginning.
      code
        reveal(s: Scroll, bounds: Rectangle) Scroll =
          y = if bounds.top < s.offset.y bounds.top
            if bounds.bottom > {s.offset.y + s.viewport.height}
              min(bounds.top, bounds.bottom - s.viewport.height) s.offset.y
          x = if bounds.left < s.offset.x bounds.left
            if bounds.right > {s.offset.x + s.viewport.width}
              min(bounds.left, bounds.right - s.viewport.width) s.offset.x
          scroll(s.viewport, s.content, offset(x, y))
      text
        Translate the supplied drawing by the negative scroll offset and clip it
        to the viewport.
      code
        render(s: Scroll, content: DrawCommand) DrawCommand =
          draw_clipped(s.viewport,
            draw_translated(s.offset.negate(), content))
  chapter Path Editor
    text
      A small canvas experiment using plain drawing and event-handling
      functions. Drag any of the three points freely over the grid. All state,
      including the grabbed point and the pointer offset, belongs to the app.
    chapter State and canvas bounds
      text
        Remember which point was grabbed and the pointer's offset from its
        center. Dragging should preserve that offset instead of making the point
        jump.
      code
        KnobDrag = struct { index: Int, grab: Offset }
      text
        The app owns its three points, an optional drag, and the last known
        canvas size.
      code
        PathEditor = struct {
          knobs: List[Position], dragging: Maybe[KnobDrag], window: Maybe[Size] }
      text
        Use a 24-unit grid as a visual reference; points remain free to move
        between grid lines.
      code
        path_grid_spacing = 24.0
      text
        The visible blue dot has a radius of six units.
      code
        path_knob_radius = 6.0
      text
        Leave room around each dot for its white border and active halo.
      code
        path_knob_margin = 14.0
      text
        A larger picking radius makes the small visible dots easier to grab.
      code
        path_knob_hit_radius = 12.0
      text
        Keep each point inside the canvas with room for its halo. In a very
        small window, reduce the margin to half the available dimension.
      code
        clamp_knob(pos: Position, window: Size) Position =
          mx = min(path_knob_margin, max(0.0, window.width) / 2.0)
          my = min(path_knob_margin, max(0.0, window.height) / 2.0)
          pos.clamp(rectangle(mx, my, window.width - mx, window.height - my))
      text
        Place three initial points relative to the canvas size so the experiment
        starts near the center of any window.
      code
        path_editor_state(window: Size) PathEditor =
          PathEditor(
            knobs = list(
              clamp_knob(position(window.width * 0.25, window.height * 0.4), window),
              clamp_knob(position(window.width * 0.5, window.height * 0.6), window),
              clamp_knob(position(window.width * 0.75, window.height * 0.4), window)),
            dragging = none[KnobDrag](), window = some(window))
      text
        The first usable window size establishes the initial positions. Later
        resizes clamp existing points and cancel any active drag.
      code
        resize(editor: PathEditor, window: Size) PathEditor =
          if window.width <= 0.0 or window.height <= 0.0
            PathEditor(knobs = editor.knobs, dragging = none[KnobDrag](), window = editor.window)
            editor.window %(
              none path_editor_state(window)
              some
                PathEditor(knobs = editor.knobs.iter().map(
                  \ point: Position -> clamp_knob(point, window)).to_list(),
                  dragging = none[KnobDrag](), window = some(window)))
    chapter Drawing the grid
      text
        Draw a light grid with a stronger line every five intervals.
      text
        Build vertical and horizontal lines over a pale background. Every fifth
        line is stronger to make distances easier to judge.
      code
        draw_grid(extent: Size, grid: Float) Drawing =
          _ = assert(grid > 0.0, "Grid spacing must be positive")
          columns = {max(0.0, extent.width) / grid}.to_int() + 1
          rows = {max(0.0, extent.height) / grid}.to_int() + 1
          vertical = {0..columns}.iter().map(\ index: Int ->
            major = mod(index, 5) == 0
            draw_translated(index.to_float() * grid, 0.0,
              draw_colored_rect(size(if major 1.0 0.5, extent.height),
                color(if major "#d5dde7" "#e8edf3")))).to_list()
          horizontal = {0..rows}.iter().map(\ index: Int ->
            major = mod(index, 5) == 0
            draw_translated(0.0, index.to_float() * grid,
              draw_colored_rect(size(extent.width, if major 1.0 0.5),
                color(if major "#d5dde7" "#e8edf3")))).to_list()
          Drawing(size = extent, draw = draw_all(list(
            draw_colored_rect(extent, color("#f9fbfd")),
            draw_all(vertical), draw_all(horizontal))))
    chapter Drawing the points
      text
        Draw a white rim and blue center, with a larger halo while the point is
        being dragged.
      code
        draw_knob(active: Bool) Drawing =
          center = position(path_knob_margin, path_knob_margin)
          Drawing(size = size(2.0 * path_knob_margin, 2.0 * path_knob_margin),
            draw = draw_all(list(
              if active
                draw_filled_path(circle_path(center, path_knob_margin), color("#cbdfff"))
                draw_nothing(),
              draw_filled_path(circle_path(center, path_knob_radius + 3.0), color("#ffffff")),
              draw_filled_path(circle_path(center, path_knob_radius),
                color(if active "#174dc9" "#2563eb")))))
      text
        The default dot drawing is the inactive version.
      code
        draw_knob() Drawing = draw_knob(false)
      text
        Translate each dot to its app-owned position, compose it over the grid,
        and clip the result to the canvas.
      code
        draw(editor: PathEditor, extent: Size) Drawing =
          knobs = editor.knobs.iter().map_indexed(\ index: Int, point: Position ->
            active = editor.dragging %(none false some(drag) drag.index == index)
            draw_translated(
              point.x - path_knob_margin, point.y - path_knob_margin,
              draw_knob(active).draw)).to_list()
          Drawing(size = extent,
            draw = draw_clipped(extent,
              draw_all(list(draw_grid(extent, path_grid_spacing).draw, draw_all(knobs)))))
    chapter Picking and dragging
      text
        Picking uses a slightly larger circle than the visible dot. The nearest
        point wins; ties prefer the last-painted point. Keeping the grab offset
        prevents the point from jumping when it is picked up near its edge.
      text
        Among points within the picking radius, choose the nearest. Ties favor
        the last-painted point so overlapping dots remain predictable.
      code
        pick_knob(editor: PathEditor, pos: Position) Maybe[Int] =
          editor.knobs.iter().indexed().fold(none[Int](),
            \ best: Maybe[Int], item: Indexed[Position] ->
              distance = distance_squared(item.item, pos)
              if distance > {path_knob_hit_radius * path_knob_hit_radius} best
                best %(
                  none some(item.index)
                  some(previous)
                    if distance <= distance_squared(editor.knobs.get(previous), pos)
                      some(item.index) best))
      text
        Ending a drag keeps the points and window size and clears only the grab
        state.
      code
        release(editor: PathEditor) PathEditor =
          PathEditor(knobs = editor.knobs, dragging = none[KnobDrag](), window = editor.window)
      text
        Pressing near a point records the grab without moving the point yet.
        Pressing elsewhere clears any drag.
      code
        mouse_pressed(editor: PathEditor, pos: Position) PathEditor =
          selected = editor.pick_knob(pos)
          dragging = selected.map(\ index: Int ->
            point = editor.knobs.get(index)
            KnobDrag(index, grab = offset(pos.x - point.x, pos.y - point.y)))
          PathEditor(knobs = editor.knobs, dragging, window = editor.window)
      text
        Only a grabbed point follows the pointer. Subtract the original grab
        offset, then clamp the resulting center to the canvas.
      code
        mouse_moved(editor: PathEditor, pos: Position) PathEditor =
          editor.dragging %(
            none editor
            some(drag)
              point = pos - drag.grab
              bounded = editor.window %(none point some(window) clamp_knob(point, window))
              PathEditor(knobs = editor.knobs.set(drag.index, bounded),
                dragging = editor.dragging, window = editor.window))
      text
        Apply the final pointer position before ending the drag, even when
        release happens away from the dot.
      code
        mouse_released(editor: PathEditor, pos: Position) PathEditor =
          editor.mouse_moved(pos).release()
    chapter Run app
      text
        The host sees a plain App. It renders from the current state and returns
        a new app after each event. Releasing outside a dot still ends the drag;
        leaving the window or resizing also cancels it. No widget framework or
        internal element state is involved.
      text
        Route canvas events to the corresponding state functions. Leaving the
        window also ends a drag.
      code
        handle(editor: PathEditor, event: Event) PathEditor =
          event %(
            window_resized(window) editor.resize(window)
            mouse_pressed(pos) editor.mouse_pressed(pos)
            mouse_moved(pos) editor.mouse_moved(pos)
            mouse_released(pos) editor.mouse_released(pos)
            mouse_left editor.release()
            default editor)
      text
        Adapt the concrete state to the host App interface with two closures:
        one for drawing and one for returning the next app.
      code
        path_editor(editor: PathEditor) App =
          App(render = \ extent: Size -> editor.draw(extent).draw,
            handle = \ event: Event ->
              AppResult(app = path_editor(editor.handle(event)), commands = list[AppCommand]()))
      text
        Before the first resize event, supply three fallback positions and no
        active drag.
      code
        path_editor() App =
          path_editor(PathEditor(
            knobs = list(position(96.0, 96.0), position(192.0, 168.0), position(288.0, 96.0)),
            dragging = none[KnobDrag](), window = none[Size]()))
    text
      To run this experiment, change main to return path_editor(). From vm,
      compile with soil src/yam.soil src/notebook.yam src/notebook.yam.objects
      and run zig build run -- --ui src/notebook.yam.objects.
  chapter Notebook
    text
      The host supplies the document to main. NotebookEditor owns that document,
      the current path, and a concrete ChapterView. Only the visible chapter has
      text caches. Editing one row keeps every other row's cached Text intact.
    chapter Cell feedback
      text
        Evaluation outputs are converted into cached drawings only for the
        visible chapter. Their generation and width let unchanged results reuse
        their drawing through ordinary edits, hover, and scrolling.
      code
        NotebookFeedback = struct {
          output: CompilerOutput, generation: Int, width: Float, drawing: Drawing }
      text
        Strings are printed directly. Other ordinary values display just their
        type; diagnostics and resource warnings get explicit labels.
      code
        notebook_output_text(output: CompilerOutput) String = output %(
          string(value) value
          type(type) type.format()
          diagnostic(message) "Error: " + message
          warning(message) "Warning: " + message
          default "")
      text
        Feedback caches its content with eight units of padding. The row draws
        the panel background and clips both halves to one rounded outline. A
        drawing keeps its aspect ratio and fits the content column.
      code
        notebook_feedback(output: CompilerOutput, generation: Int, width: Float) NotebookFeedback =
          available = max(1.0, width - 16.0)
          checked = output %(
            drawing(image)
              valid = image.size.width.is_finite() and image.size.height.is_finite()
                and image.size.width >= 0.0 and image.size.height >= 0.0
              if valid output CompilerOutput.diagnostic("Drawing dimensions must be finite and non-negative.")
            default output)
          content = checked %(
            drawing(image)
              scale = if image.size.width > available available / image.size.width 1.0
              extent = image.size * scale
              Drawing(size = extent, draw = draw_clipped(extent,
                draw_transformed(transform_scale(scale), image.draw)))
            default text(notebook_output_text(checked), available).render())
          extent = size(max(width, content.size.width + 16.0), content.size.height + 16.0)
          drawing = Drawing(size = extent, draw = draw_translated(8.0, 8.0, content.draw))
          NotebookFeedback(output = checked, generation, width, drawing)
    chapter Rows and chapter layout
      text
        A row is a breadcrumb, the chapter title, or one cell. All rows use the
        same concrete editable-text cache, even when the row is only a link.
        Breadcrumbs contain ancestors only and have no spacing between them.
      chapter Representing a row
        text
          A visible row can be an ancestor link, the current title, or a cell.
          Links carry the path they should open.
        code
          NotebookRowKind = enum {
            breadcrumb: NotebookPath, title, text, code, chapter: NotebookPath, eval }
        text
          Every row keeps a concrete editable-text cache and a display scale.
          The parent decides whether that cache is currently editable.
        code
          NotebookRow = struct { kind: NotebookRowKind, editor: EditableText, scale: Float,
            feedback: Maybe[NotebookFeedback] }
      chapter Measuring rows
        text
          Keep a margin around the content and cap its width so prose remains
          readable in a wide window.
        code
          notebook_width(window: Size) Float = max(32.0, min(400.0, window.width - 48.0))
        text
          Center the content column in wide windows. Narrow windows retain at
          least 24 units of padding on each side.
        code
          notebook_left(window: Size) Float =
            max(24.0, {window.width - notebook_width(window)} / 2.0)
        text
          Include the centered margins in the scrollable extent. Long unbroken
          text can still extend the horizontal scroll range.
        code
          notebook_content_size(layout: ColumnLayout, window: Size) Size =
            size(layout.size.width + {2.0 * notebook_left(window)},
              layout.size.height + 48.0)
        text
          All row contents start eight units from the left edge. Text cells have
          four units of vertical padding; breadcrumbs have two, and the other
          rows have eight.
        code
          row_padding(kind: NotebookRowKind) Offset =
            offset(8.0, kind %(breadcrumb 2.0 text 4.0 default 8.0))
        text
          A row uses the padding associated with its kind.
        code
          row_padding(row: NotebookRow) Offset = row.kind.row_padding()
        text
          Text cells request half the usual space around them. Neighboring rows
          share the gap between them, while breadcrumbs stay together.
        code
          row_gap(row: NotebookRow) Float = row.kind %(breadcrumb 0.0 text 5.0 default 10.0)
        text
          Subtract padding and divide by the display scale to express the
          available width in the text layout's native units.
        code
          row_constraints(row: NotebookRow, width: Float) TextConstraints =
            text_constraints({width - {2.0 * row.row_padding().x}} / row.scale)
        text
          A missing result also clears feedback after a blocking code error.
          Otherwise, retain an existing drawing for the same generation and
          width.
        code
          with_feedback(row: NotebookRow, result: Maybe[CompilerCachedCell], width: Float) NotebookRow =
            feedback = result.flat_map(\ cell: CompilerCachedCell ->
              if cell.output is none none[NotebookFeedback]()
                row.feedback %(
                  some(old)
                    if old.generation == cell.generation and old.width == width some(old)
                      some(notebook_feedback(cell.output, cell.generation, width))
                  none some(notebook_feedback(cell.output, cell.generation, width))))
            NotebookRow(kind = row.kind, editor = row.editor, scale = row.scale, feedback)
        text
          Construct the text cache at the row's final width immediately,
          avoiding a second layout just to apply its padding.
        code
          notebook_row(kind: NotebookRowKind, value: String, scale: Float, width: Float) NotebookRow =
            padding = kind.row_padding()
            NotebookRow(kind, scale, editor = editable_text(value,
              text_constraints({width - {2.0 * padding.x}} / scale)), feedback = none[NotebookFeedback]())
        text
          Measure the scaled text and include its padding. An empty row still
          has a line of height, while long unbroken text can extend the
          scrollable width.
        code
          notebook_body_size(row: NotebookRow, width: Float) Size =
            measured = row.editor.text.render().size
            padding = 2.0 * row.row_padding()
            size(max(width, {measured.width + 2.0} * row.scale + padding.x),
              max(text_line_height, measured.height) * row.scale + padding.y)
        text
          Input and feedback meet without a gap. Their combined size defines the
          single rounded outline used when drawing the two-part cell.
        code
          column_item(row: NotebookRow, width: Float) ColumnItem =
            body = row.notebook_body_size(width)
            extent = row.feedback.map(\ feedback: NotebookFeedback ->
              size(max(body.width, feedback.drawing.size.width),
                body.height + feedback.drawing.size.height)) or body
            ColumnItem(size = extent, gap = row.row_gap())
        text
          Turn the measured rows into a column, averaging the spacing requested
          by neighboring rows. Breadcrumbs have no following gap. This reads
          cached text sizes and does not lay out glyphs again.
        code
          notebook_layout(rows: List[NotebookRow], width: Float) ColumnLayout =
            column_layout(rows.iter().map_indexed(\ index: Int, row: NotebookRow ->
              item = row.column_item(width)
              next_gap = rows.get_maybe(index + 1)
                .map(\ next: NotebookRow -> next.row_gap()) or row.row_gap()
              gap = if row.kind is breadcrumb 0.0 {row.row_gap() + next_gap} / 2.0
              ColumnItem(size = item.size, gap)).to_list())
      chapter Building chapter rows
        text
          Walk towards the visible chapter, adding each ancestor as a link. Stop
          before adding the current chapter, whose name will appear in the large
          title.
        code
          breadcrumb_rows(root: Chapter, remaining: NotebookPath, prefix: NotebookPath,
            width: Float) List[NotebookRow] =
            if remaining.is_empty() list[NotebookRow]()
              identity(
                index = remaining.indices.first()
                child = root.children.get(index) %(chapter(child) child
                  default crash("Expected a breadcrumb chapter."))
                list(notebook_row(NotebookRowKind.breadcrumb(prefix), root.title, 1.0, width))
                  .push_all(breadcrumb_rows(child, NotebookPath(indices = remaining.indices.without_first()),
                    prefix.push(index), width)))
        text
          Text and code cells display their contents at the same scale. A
          chapter cell displays only its title and remembers the path to its
          subtree.
        code
          cell_row(cell: Cell, path: NotebookPath, width: Float) NotebookRow =
            cell %(
              text(value) notebook_row(NotebookRowKind.text, value, 1.0, width)
              code(value) notebook_row(NotebookRowKind.code, value, 1.0, width)
              eval(value) notebook_row(NotebookRowKind.eval, value, 1.0, width)
              chapter(child) notebook_row(NotebookRowKind.chapter(path), child.title, 1.0, width))
        text
          After inserting, deleting, or moving cells, chapter-link indices may
          change. Refresh those paths while preserving every row's text cache.
        code
          retarget_rows(rows: List[NotebookRow], path: NotebookPath) List[NotebookRow] =
            rows.iter().map_indexed(\ index: Int, row: NotebookRow ->
              NotebookRow(editor = row.editor, scale = row.scale, kind = row.kind %(
                chapter NotebookRowKind.chapter(path.push(index - path.indices.length() - 1))
                default row.kind), feedback = row.feedback)).to_list()
        text
          Assemble a chapter in reading order: ancestor breadcrumbs, its own
          title, then its child cells.
        code
          chapter_rows(root: Chapter, path: NotebookPath, width: Float) List[NotebookRow] =
            current = root.get(path)
            breadcrumb_rows(root, path, notebook_path(), width)
              .push(notebook_row(NotebookRowKind.title, current.title, 2.0, width))
              .push_all(current.children.iter().map_indexed(\ index: Int, cell: Cell ->
                cell_row(cell, path.push(index), width)).to_list())
      chapter Chapter view state
        text
          A chapter view combines its rows and layout with scrolling, selected
          row, editing mode, and pointer-drag state.
        code
          ChapterView = struct {
            rows: List[NotebookRow], layout: ColumnLayout, scroll: Scroll,
            focus: Int, editing: Bool, dragging: Bool }
        text
          Build caches for the visible chapter, measure its rows, and select its
          title. Content margins are included in the scrollable extent.
        code
          chapter_view(root: Chapter, path: NotebookPath, window: Size) ChapterView =
            width = notebook_width(window)
            rows = chapter_rows(root, path, width)
            layout = notebook_layout(rows, width)
            ChapterView(rows, layout, scroll = scroll(window, notebook_content_size(layout, window), offset(0.0, 0.0)),
              focus = path.indices.length(), editing = false, dragging = false)
    chapter Attaching evaluation results
      text
        Results use document paths rather than visible row numbers. Titles and
        breadcrumbs have no evaluation output. Recompute only column bounds
        after attaching the cached result drawings.
      code
        notebook_enrich_view(view: ChapterView, path: NotebookPath, evaluation: CompilerEvaluation) ChapterView =
          width = notebook_width(view.scroll.viewport)
          rows = view.rows.iter().map_indexed(\ index: Int, row: NotebookRow ->
            cell = index - path.indices.length() - 1
            result = if cell < 0 none[CompilerCachedCell]()
              evaluation.results.lookup(path.push(cell))
            row.with_feedback(result, width)).to_list()
          layout = notebook_layout(rows, width)
          ChapterView(rows, layout, scroll = view.scroll.update(view.scroll.viewport,
            notebook_content_size(layout, view.scroll.viewport)),
            focus = view.focus, editing = view.editing, dragging = view.dragging)
    chapter Editor state
      text
        The complete editor adds the host-supplied document, its current path, a
        cached status message, and the latest pointer position to the chapter
        view. Hover is derived from that position and the current layout.
      code
        NotebookEditor = struct {
          notebook: Chapter, path: NotebookPath, view: ChapterView, status: Text,
          pointer: Maybe[Position], evaluation: Maybe[CompilerEvaluation] }
    chapter Updating view state
      text
        Focus and scroll changes share the row caches. A changed row recomputes
        column bounds but leaves other text layouts and drawings untouched.
        Resizing updates widths eagerly; equal widths reuse the caches.
      text
        A view-only change keeps the document, path, and status message
        untouched.
      code
        with_view(e: NotebookEditor, view: ChapterView) NotebookEditor =
          NotebookEditor(notebook = e.notebook, path = e.path, view, status = e.status, pointer = e.pointer, evaluation = e.evaluation)
      text
        Pointer updates share the document and every text cache. Keeping the
        position instead of a row index lets hover follow scrolling and edits.
      code
        with_pointer(e: NotebookEditor, pointer: Maybe[Position]) NotebookEditor =
          NotebookEditor(notebook = e.notebook, path = e.path, view = e.view,
            status = e.status, pointer, evaluation = e.evaluation)
      text
        Select a valid row and reveal it. Entering editing mode is an explicit
        choice, and changing focus ends a pointer selection drag.
      code
        with_focus(view: ChapterView, index: Int, editing: Bool) ChapterView =
          focus = max(0, min(index, view.rows.length() - 1))
          bounds = view.layout.bounds.get(focus)
          left = notebook_left(view.scroll.viewport)
          ChapterView(rows = view.rows, layout = view.layout,
            scroll = view.scroll.reveal(rectangle(bounds.left + left, bounds.top + 24.0,
              bounds.right + left, bounds.bottom + 48.0)),
            focus, editing, dragging = false)
      text
        Changing scroll state shares all row caches, bounds, and focus
        information.
      code
        with_scroll(view: ChapterView, scroll: Scroll) ChapterView =
          ChapterView(rows = view.rows, layout = view.layout, scroll,
            focus = view.focus, editing = view.editing, dragging = view.dragging)
      text
        Track whether pointer movement should extend the current text selection.
      code
        with_dragging(view: ChapterView, dragging: Bool) ChapterView =
          ChapterView(rows = view.rows, layout = view.layout, scroll = view.scroll,
            focus = view.focus, editing = view.editing, dragging)
      text
        Replace one cached row. Cursor movement retains the existing column
        bounds; a content revision triggers fresh measurements from cached text
        sizes.
      code
        update_row(view: ChapterView, index: Int, row: NotebookRow) ChapterView =
          rows = view.rows.set(index, row)
          layout = if row.editor.revision == view.rows.get(index).editor.revision
            view.layout notebook_layout(rows, notebook_width(view.scroll.viewport))
          ChapterView(rows, layout,
            scroll = view.scroll.update(view.scroll.viewport,
              notebook_content_size(layout, view.scroll.viewport)),
            focus = view.focus, editing = view.editing, dragging = view.dragging)
      text
        A changed width updates each row's text constraints eagerly. Height-
        only changes reuse the text caches and clamp the scroll offset.
      code
        resize(view: ChapterView, window: Size) ChapterView =
          if window.width == view.scroll.viewport.width and window.height == view.scroll.viewport.height view
            identity(
              width = notebook_width(window)
              rows = view.rows.iter().map(\ row: NotebookRow ->
                NotebookRow(kind = row.kind, scale = row.scale,
                  editor = row.editor.update(row.row_constraints(width)), feedback = row.feedback.map(
                    \ old: NotebookFeedback -> if old.width == width old
                      notebook_feedback(old.output, old.generation, width)))).to_list()
              layout = notebook_layout(rows, width)
              ChapterView(rows, layout, scroll = view.scroll.update(window,
                notebook_content_size(layout, window)),
                focus = view.focus, editing = view.editing, dragging = false))
      text
        Reveal the active insertion point rather than the whole cell. This lets
        editing continue through a tall cell and leaves room above the status
        line.
      code
        reveal_cursor(view: ChapterView) ChapterView =
          row = view.rows.get(view.focus)
          bounds = view.layout.bounds.get(view.focus)
          pos = row.editor.positions.get(row.editor.cursor.active)
          x = bounds.left + notebook_left(view.scroll.viewport) + row.row_padding().x + {pos.x * row.scale}
          y = bounds.top + 24.0 + row.row_padding().y + {pos.y * row.scale}
          view.with_scroll(view.scroll.reveal(rectangle(position(x, y),
            size(2.0 * row.scale, {text_line_height * row.scale} + 24.0))))
      text
        Apply existing results when navigating, without running the compiler.
        Keyboard focus is revealed against the resulting row heights.
      code
        apply_feedback(e: NotebookEditor) NotebookEditor =
          e.evaluation %(
            none e
            some(evaluation)
              view = notebook_enrich_view(e.view, e.path, evaluation)
              visible = if view.editing view.reveal_cursor() view.with_focus(view.focus, false)
              e.with_view(visible))
      text
        Code and eval edits run an incremental pass. Ordinary text and title
        edits skip this work entirely because they cannot change code scope.
      code
        refresh_evaluation(e: NotebookEditor) NotebookEditor =
          e.evaluation %(
            none e
            some(previous)
              evaluation = garbage_collect(\ -> evaluate_notebook(previous, e.notebook))
              NotebookEditor(notebook = e.notebook, path = e.path, view = e.view,
                status = e.status, pointer = e.pointer, evaluation = some(evaluation)).apply_feedback())
      text
        Opening a chapter constructs its view from the current document. The
        caller chooses whether to start editing its title.
      code
        navigate(e: NotebookEditor, path: NotebookPath, editing: Bool) NotebookEditor =
          view = chapter_view(e.notebook, path, e.view.scroll.viewport)
          NotebookEditor(notebook = e.notebook, path,
            view = view.with_focus(path.indices.length(), editing), status = e.status, pointer = e.pointer, evaluation = e.evaluation).apply_feedback()
      text
        On returning to a parent, select the chapter cell that was just left. At
        the root, there is nowhere further to go.
      code
        parent_chapter(e: NotebookEditor) NotebookEditor =
          e.path.parent() %(none e some(path)
            identity(
              next = e.navigate(path, false)
              next.with_view(next.view.with_focus(
                path.indices.length() + 1 + e.path.indices.last(), false))))
      text
        Status updates reuse the document and chapter view and update only their
        own Text cache.
      code
        set_status(e: NotebookEditor, value: String) NotebookEditor =
          NotebookEditor(notebook = e.notebook, path = e.path, view = e.view,
            status = e.status.update(value), pointer = e.pointer, evaluation = e.evaluation)
    chapter Editing the document
      text
        The document and visible text cache change together. Chapter titles
        remain single-line. Cursor-only edits replace only that row's state.
      text
        Commit the updated row and inspect its revision. Cursor-only changes
        stop there; content changes also replace the corresponding title or cell
        in the document tree.
      code
        commit_editor(e: NotebookEditor, editor: EditableText) NotebookEditor =
          row = e.view.rows.get(e.view.focus)
          next_view = e.view.update_row(e.view.focus,
            NotebookRow(kind = row.kind, scale = row.scale, editor, feedback = row.feedback))
          if editor.revision == row.editor.revision e.with_view(next_view.reveal_cursor())
            identity(
              current = e.notebook.get(e.path)
              value = editor.text.value
              index = e.view.focus - e.path.indices.length() - 1
              updated = row.kind %(
                title Chapter(title = value, children = current.children)
                text Chapter(title = current.title, children = current.children.set(index, Cell.text(value)))
                code Chapter(title = current.title, children = current.children.set(index, Cell.code(value)))
                eval Chapter(title = current.title, children = current.children.set(index, Cell.eval(value)))
                default current)
              next = NotebookEditor(notebook = e.notebook.replace_chapter(e.path, updated), path = e.path,
                view = next_view.reveal_cursor(), status = e.status.update("Unsaved changes"), pointer = e.pointer, evaluation = e.evaluation)
              row.kind %(code next.refresh_evaluation() eval next.refresh_evaluation() default next))
      text
        Character events affect only an active text editor. Whole-cell selection
        alone does not insert text.
      code
        edit_character(e: NotebookEditor, code: Int) NotebookEditor =
          if not(e.view.editing) e
            e.commit_editor(e.view.rows.get(e.view.focus).editor.editable_character(code))
      text
        Activating a link navigates to its chapter. Activating an editable row
        instead places it in text-editing mode.
      code
        activate(e: NotebookEditor) NotebookEditor =
          e.view.rows.get(e.view.focus).kind %(
            breadcrumb(path) e.navigate(path, false)
            chapter(path) e.navigate(path, false)
            default e.with_view(e.view.with_focus(e.view.focus, true).reveal_cursor()))
    chapter Inserting, deleting, and moving cells
      text
        Ctrl+T inserts text, Ctrl+N inserts code, and Ctrl+E inserts an eval
        expression, directly in editing mode. Ctrl+K creates a chapter and opens
        its title editor. Insertions follow the current cell, or go first when
        the title or breadcrumbs are selected. Delete removes a selected cell,
        including a chapter's entire subtree. Alt+Up/Down swaps cells and keeps
        the moved cell selected.
      text
        Insert after the selected cell, or at the beginning from a title or
        breadcrumb. New text and code cells enter editing immediately; a new
        chapter opens its title editor.
      code
        insert_cell(e: NotebookEditor, cell: Cell) NotebookEditor =
          current = e.notebook.get(e.path)
          index = max(0, e.view.focus - e.path.indices.length())
          updated = Chapter(title = current.title, children = current.children.insert(index, cell))
          root = e.notebook.replace_chapter(e.path, updated)
          width = notebook_width(e.view.scroll.viewport)
          rows = e.view.rows.insert(e.path.indices.length() + 1 + index,
            cell_row(cell, e.path.push(index), width)).retarget_rows(e.path)
          layout = notebook_layout(rows, width)
          view = ChapterView(rows, layout, scroll = e.view.scroll.update(e.view.scroll.viewport,
            notebook_content_size(layout, e.view.scroll.viewport)),
            focus = e.view.focus, editing = false, dragging = false)
          next = NotebookEditor(notebook = root, path = e.path, view,
            status = e.status.update("Unsaved changes"), pointer = e.pointer, evaluation = e.evaluation)
          cell %(
            chapter next.navigate(e.path.push(index), true)
            default next.with_view(next.view.with_focus(e.path.indices.length() + 1 + index, true))).refresh_evaluation()
      text
        Delete only child-cell rows, preserving the title and breadcrumbs.
        Removing a chapter cell drops its subtree and repairs the remaining
        chapter-link paths.
      code
        delete_cell(e: NotebookEditor) NotebookEditor =
          index = e.view.focus - e.path.indices.length() - 1
          if index < 0 e
            identity(
              current = e.notebook.get(e.path)
              updated = Chapter(title = current.title,
                children = current.children.remove(index..{index + 1}))
              root = e.notebook.replace_chapter(e.path, updated)
              rows = e.view.rows.remove(e.view.focus..{e.view.focus + 1}).retarget_rows(e.path)
              layout = notebook_layout(rows, notebook_width(e.view.scroll.viewport))
              view = ChapterView(rows, layout, scroll = e.view.scroll.update(e.view.scroll.viewport,
                notebook_content_size(layout, e.view.scroll.viewport)),
                focus = min(e.view.focus, rows.length() - 1), editing = false, dragging = false)
              NotebookEditor(notebook = root, path = e.path,
                view = view.with_focus(view.focus, false), status = e.status.update("Unsaved changes"), pointer = e.pointer, evaluation = e.evaluation).refresh_evaluation())
      text
        Swap a cell with a valid neighbor, carry its text state along, and keep
        the moved row selected. Titles and breadcrumbs cannot move.
      code
        move_cell(e: NotebookEditor, direction: Int) NotebookEditor =
          index = e.view.focus - e.path.indices.length() - 1
          other = index + direction
          current = e.notebook.get(e.path)
          if index < 0 or other < 0 or other >= current.children.length() e
            identity(
              updated = Chapter(title = current.title, children = current.children.swap(index, other))
              root = e.notebook.replace_chapter(e.path, updated)
              rows = e.view.rows.swap(e.view.focus, e.view.focus + direction).retarget_rows(e.path)
              layout = notebook_layout(rows, notebook_width(e.view.scroll.viewport))
              view = ChapterView(rows, layout, scroll = e.view.scroll.update(e.view.scroll.viewport,
                notebook_content_size(layout, e.view.scroll.viewport)),
                focus = e.view.focus + direction, editing = false, dragging = false)
              NotebookEditor(notebook = root, path = e.path,
                view = view.with_focus(view.focus, false), status = e.status.update("Unsaved changes"), pointer = e.pointer, evaluation = e.evaluation).refresh_evaluation())
    chapter Pointer and keyboard input
      text
        Undo scrolling, the outer margin, the row position, padding, and scale
        to convert a window coordinate into text-layout coordinates.
      code
        row_local(view: ChapterView, index: Int, pos: Position) Position =
          row = view.rows.get(index)
          bounds = view.layout.bounds.get(index)
          position({pos.x + view.scroll.offset.x - notebook_left(view.scroll.viewport) - bounds.left - row.row_padding().x} / row.scale,
            {pos.y + view.scroll.offset.y - 24.0 - bounds.top - row.row_padding().y} / row.scale)
      text
        Use column bounds to pick a row. Links navigate immediately; clicking
        text enters editing and establishes the start of a pointer selection.
      code
        mouse_pressed(e: NotebookEditor, pos: Position) NotebookEditor =
          point = pos + e.view.scroll.offset - offset(notebook_left(e.view.scroll.viewport), 24.0)
          e.view.layout.pick(point) %(none e some(index)
            identity(
              row = e.view.rows.get(index)
              selected = e.with_view(e.view.with_focus(index, false))
              bounds = e.view.layout.bounds.get(index)
              y = pos.y + e.view.scroll.offset.y - 24.0 - bounds.top
              if y >= row.notebook_body_size(notebook_width(e.view.scroll.viewport)).height selected
                row.kind %(
                breadcrumb(path) selected.navigate(path, false)
                chapter(path) selected.navigate(path, false)
                default
                  identity(
                    editor = row.editor.pick(e.view.row_local(index, pos), false)
                    view = e.view.update_row(index, NotebookRow(kind = row.kind, scale = row.scale, editor, feedback = row.feedback))
                    selected.with_view(ChapterView(rows = view.rows, layout = view.layout,
                      scroll = view.scroll, focus = index, editing = true, dragging = true))))))
      text
        Remember the pointer for hover without touching text caches. During an
        active drag, the same motion also extends the text selection.
      code
        mouse_moved(e: NotebookEditor, pos: Position) NotebookEditor =
          next = e.with_pointer(some(pos))
          if not(next.view.dragging) next
            identity(
              row = next.view.rows.get(next.view.focus)
              next.commit_editor(row.editor.pick(next.view.row_local(next.view.focus, pos), true)))
      text
        Escape leaves editing before navigating to a parent. Tab changes rows;
        arrows either move a text cursor or select a neighbor, depending on
        editing mode.
      code
        notebook_edit_key(e: NotebookEditor, key: KeyPressed) NotebookEditor =
          code = key.keycode
          if code == key_escape
            if e.view.editing e.with_view(e.view.with_focus(e.view.focus, false))
              e.parent_chapter()
          if code == key_tab and not(key.control) and not(key.alt)
            e.with_view(e.view.with_focus(e.view.focus + if key.shift {0 - 1} 1, false))
          if e.view.editing
            identity(
              row = e.view.rows.get(e.view.focus)
              if code == key_enter and {row.kind is title}
                e.with_view(e.view.with_focus(e.view.focus, false))
                e.commit_editor(row.editor.editable_key(key)))
          if key.alt and {code == key_arrow_up or code == key_arrow_down}
            e.move_cell(if code == key_arrow_up {0 - 1} 1)
          if code == key_arrow_down or code == key_arrow_up
            e.with_view(e.view.with_focus(e.view.focus + if code == key_arrow_up {0 - 1} 1, false))
          if code == key_enter e.activate()
          if code == key_delete e.delete_cell()
          e
      text
        Handle notebook-wide creation shortcuts first, then delegate ordinary
        navigation and editing keys.
      code
        notebook_key(e: NotebookEditor, key: KeyPressed) NotebookEditor =
          code = key.keycode
          if key.control and not(key.alt) and not(key.shift)
            identity(
              if code == 84 e.insert_cell(Cell.text(""))
              if code == 78 e.insert_cell(Cell.code(""))
              if code == 69 e.insert_cell(Cell.eval(""))
              if code == 75 e.insert_cell(Cell.chapter(chapter("", list[Cell]())))
              notebook_edit_key(e, key))
            notebook_edit_key(e, key)
    chapter Drawing the visible chapter
      text
        Drawing walks only visible rows. Text commands are already cached; focus
        adds a background and editing adds a selection overlay. A scroll event
        updates only Scroll. Hover changes the background while reusing the text
        drawing.
      text
        Find the row under the pointer using the same bounds as clicking.
        Recomputing this from the current scroll offset avoids stale hover when
        content moves beneath a stationary pointer. The status line is excluded.
      code
        hovered_row(e: NotebookEditor) Maybe[Int] =
          e.pointer.flat_map(\ pos: Position ->
            window = e.view.scroll.viewport
            if pos.x < 0.0 or pos.x >= window.width or pos.y < 0.0
              or pos.y >= {window.height - 20.0} none[Int]()
              e.view.layout.pick(pos + e.view.scroll.offset
                - offset(notebook_left(window), 24.0)))
      text
        Draw a row background to show its kind and selection, then place and
        scale its cached text. Only the active editor adds a text-selection
        overlay.
      code
        render(row: NotebookRow, width: Float, focused: Bool, hovered: Bool, editing: Bool) DrawCommand =
          extent = row.notebook_body_size(width)
          background = row.kind %(
            chapter color(if focused or hovered "#b8dcb2" "#d9efd3")
            code color(if focused "#f5e6a8" "#fff6cf")
            eval color(if focused "#f5e6a8" "#fff6cf")
            default color(if focused "#e6edf5" "#ffffff"))
          padding = row.row_padding()
          input = draw_translated(padding,
            draw_transformed(transform_scale(row.scale), row.editor.render(editing).draw))
          row.feedback %(
            none draw_all(list(draw_filled_path(rounded_rect_path(6.0, extent), background), input))
            some(feedback)
              combined = row.column_item(width).size
              lower = feedback.output %(
                diagnostic color("#ffe4df") warning color("#ffe4df") default color("#faf9f3"))
              draw_clipped(rounded_rect_path(6.0, combined), draw_all(list(
                draw_colored_rect(combined, lower),
                draw_colored_rect(size(combined.width, extent.height), background),
                input,
                draw_translated(0.0, extent.height, feedback.drawing.draw)))))
      text
        Cull rows outside the viewport, translate the visible ones into place,
        and apply scrolling. Finally, draw the status line over the bottom of
        the window.
      code
        render(e: NotebookEditor, extent: Size) DrawCommand =
          view = e.view
          width = notebook_width(view.scroll.viewport)
          hovered = e.hovered_row()
          commands = view.rows.iter().indexed().filter(\ item: Indexed[NotebookRow] ->
            bounds = view.layout.bounds.get(item.index)
            bounds.bottom + 24.0 >= view.scroll.offset.y
              and bounds.top + 24.0 <= {view.scroll.offset.y + extent.height})
            .map(\ item: Indexed[NotebookRow] ->
              bounds = view.layout.bounds.get(item.index)
              draw_translated(notebook_left(view.scroll.viewport), bounds.top + 24.0,
                item.item.render(width, item.index == view.focus,
                  hovered %(none false some(index) index == item.index),
                  view.editing and item.index == view.focus))).to_list()
          draw_all(list(draw_colored_rect(extent, color("#ffffff")),
            view.scroll.render(draw_all(commands)),
            draw_translated(12.0, max(0.0, extent.height - 20.0),
              draw_all(list(draw_colored_rect(size(extent.width, 20.0), color("#ffffff")),
                e.status.render().draw)))))
    chapter Running and saving
      text
        Ctrl+S sends the current structured notebook to the host. Saving never
        happens on keystrokes. Success and failure events update the status
        line. The path editor remains available by changing main to
        path_editor().
      text
        Start at the root chapter with its title selected and a short guide to
        the main keyboard shortcuts.
      code
        notebook_editor(root: Chapter, window: Size) NotebookEditor =
          NotebookEditor(notebook = root, path = notebook_path(),
            view = chapter_view(root, notebook_path(), window),
            status = text("Ctrl+S save  |  Ctrl+T text  Ctrl+N code  Ctrl+E eval  Ctrl+K chapter  |  Esc select / parent"), pointer = none[Position](), evaluation = some(compiler_evaluation())).refresh_evaluation()
      text
        Dispatch host events to the concrete editor functions. Wheel events
        change only scroll state, and save feedback updates only the status
        message.
      code
        handle(e: NotebookEditor, event: Event) NotebookEditor =
          event %(
            window_resized(window) e.with_view(e.view.resize(window))
            mouse_pressed(pos) e.mouse_pressed(pos).with_pointer(some(pos))
            mouse_moved(pos) e.mouse_moved(pos)
            mouse_released(pos)
              next = e.mouse_moved(pos)
              next.with_view(next.view.with_dragging(false))
            mouse_left e.with_view(e.view.with_dragging(false)).with_pointer(none[Position]())
            mouse_scrolled(scroll) e.with_view(e.view.with_scroll(e.view.scroll.move(scroll.delta))).with_pointer(some(scroll.position))
            key_pressed(key) e.notebook_key(key)
            char_entered(character) e.edit_character(character.codepoint)
            save_completed e.set_status("Saved")
            save_failed(error) e.set_status("Save failed: " + error))
      text
        Connect editor state to the host. Ctrl+S emits the current structured
        document as an explicit save command; other events return the next app
        without saving.
      code
        notebook_app(e: NotebookEditor) App =
          App(render = \ window: Size -> e.render(window),
            handle = \ event: Event ->
              save = event %(key_pressed(key) key.control and not(key.alt) and key.keycode == 83 default false)
              if save
                AppResult(app = notebook_app(e.set_status("Saving...")),
                  commands = list(AppCommand.save_notebook(e.notebook)))
                AppResult(app = notebook_app(e.handle(event)), commands = list[AppCommand]()))
      text
        The entry point receives the live document from the host and opens the
        notebook editor. Returning path_editor() here runs the smaller canvas
        experiment instead.
      code
        main(notebook: Chapter) App =
          notebook_app(notebook_editor(notebook, size(800.0, 600.0)))
  chapter Live examples
    text
      This is an example.
    eval
      format(16.pow(8))
    code
      foo = 14326

      chapter Glyph lookup
        text
          Look up supported characters by their codepoint, and use the fallback
          glyph for every other character.
        code
          find_glyph(character: Char) Glyph =
            codepoint = character.codepoint
            if codepoint >= 32 and codepoint <= 126
              text_glyphs.get(codepoint - 32)
              fallback_glyph
      chapter Text layout
        text
          Layout wraps whole words at spaces and respects explicit newlines.
          Words wider than the available width overflow instead of being split.
          Each line is 13 units high, including a trailing empty line after a
          newline. Empty text has zero size. There is one unit between glyphs.
        chapter Layout data
          text
            The result stores positioned glyphs and the overall size. During
            layout, the state also tracks the current pen position and word
            boundaries.
          code
            PositionedGlyph = struct { glyph: Glyph, position: Position }
            TextLayout = struct { size: Size, glyphs: List[PositionedGlyph] }
            TextLayoutState = struct {
              x: Float,
              y: Float,
              width: Float,
              height: Float,
              word_start: Bool,
              glyphs: List[PositionedGlyph]}
        chapter Measuring words
          text
            Measure the next word before placing its first glyph, so wrapping
            can move the entire word to the next line.
          code
            text_word_width(chars: List[Char], index: Int) Float =
              if index == chars.length() 0.0 identity(
                char = chars.get(index)
                if char.codepoint == 32 or char.codepoint == 10 0.0
                  identity(
                    rest = text_word_width(chars, index + 1)
                    find_glyph(char).width + if rest > 0.0 1.0 + rest 0.0))
        chapter Positioning glyphs
          text
            Walk the characters in order. Newlines advance the pen to a fresh
            line; word boundaries decide whether to wrap. Each placed glyph
            extends the measured bounds.
          code
            layout_text(chars: List[Char], max_width: Maybe[Float]) TextLayout =
              layout = chars.iter().indexed().fold(
                TextLayoutState(
                  x = 0.0,
                  y = 0.0,
                  width = 0.0,
                  height = 0.0,
                  word_start = true,
                  glyphs = list[PositionedGlyph]()),
                \ state: TextLayoutState, item: Indexed[Char] ->
                  if item.item.codepoint == 10
                    TextLayoutState(
                      x = 0.0, y = state.y + text_line_height,
                      width = state.width, height = state.y + {2.0 * text_line_height},
                      word_start = true, glyphs = state.glyphs)
                    identity(
                      wrap = state.word_start and item.item.codepoint != 32 and state.x > 0.0
                        and
                          {max_width %(
                            none false
                            some(limit)
                              state.x + text_word_width(chars, item.index) > limit)}
                      x = if wrap 0.0 state.x
                      y = if wrap state.y + text_line_height state.y
                      glyph = find_glyph(item.item)
                      TextLayoutState(
                        x = x + glyph.width + 1.0, y,
                        width = max(state.width, x + glyph.width),
                        height = max(state.height, y + text_line_height),
                        word_start = item.item.codepoint == 32,
                        glyphs = state.glyphs.push(PositionedGlyph(
                            glyph, position = position(x, y))))))
              TextLayout(
                size = size(layout.width, layout.height), glyphs = layout.glyphs)
          code
            layout_text(chars: List[Char], max_width: Float) TextLayout =
              layout_text(chars, some(max_width))
            layout_text(chars: List[Char]) TextLayout = layout_text(chars, none[Float]())
      chapter Drawing text
        text
          Draw each glyph in the requested color, then translate those paths to
          the positions computed by layout. The Drawing keeps the layout size.
        code
          draw_glyph(glyph: Glyph, color: Color) DrawCommand =
            draw_all(
              glyph.paths.iter()
                .map(\ path: Path -> draw_filled_path(path, color))
                .to_list())
        code
          draw_text(layout: TextLayout, color: Color) Drawing =
            Drawing(
              size = layout.size,
              draw =
                draw_all(
                  layout.glyphs.iter()
                    .map(\ glyph: PositionedGlyph ->
                      draw_transformed(
                        transform_translate(glyph.position.to_vec().to_offset()),
                        draw_glyph(glyph.glyph, color)))
                    .to_list()))
  chapter Host interaction
    text
      The host supplies notebook documents and app events. Apps return drawing
      commands and explicit effects for the host to perform.
    chapter Notebook data
      text
        A notebook is a tree of chapters. Each chapter has a title and a list of
        cells. Text and code cells hold strings; a chapter cell holds another
        chapter, allowing notebooks to nest.
      text
        The host parses and saves notebook documents. These fields and variants
        form a fixed ABI shared with Zig; their names, types, and order matter.
      code
        Chapter = struct { title: String, children: List[Cell] }
        Cell = enum { text: String, code: String, chapter: Chapter }
      code
        chapter(title: String, children: List[Cell]) Chapter =
          Chapter(title, children)
    chapter Apps
      text
        Rendering receives the current window size. Handling an event returns
        the next app and explicit commands for the host. save_notebook carries a
        structured document; the host handles serialization and disk access.
      code
        KeyPressed = struct {
          keycode: Int, control: Bool, shift: Bool, alt: Bool}
        CharEntered = struct { codepoint: Int }
        MouseScrolled = struct { position: Position, delta: Offset }
        Event = enum {
          window_resized: Size,
          key_pressed: KeyPressed,
          char_entered: CharEntered,
          mouse_pressed: Position,
          mouse_moved: Position,
          mouse_scrolled: MouseScrolled,
          mouse_released: Position,
          mouse_left,
          save_completed,
          save_failed: String}
        AppCommand = enum { save_notebook: Chapter }
        AppResult = struct { app: App, commands: List[AppCommand] }
        App = struct { render: fun(Size) DrawCommand, handle: fun(Event) AppResult }
  chapter Widget framework
    text
      The widget framework works similar to Flutter: You describe your user
      interface by nesting widgets in a declarative way. The framework turns
      this widget tree into an element tree. Elements are persistent nodes with
      internal state. On the next frame, you rebuild a widget tree and the
      framework updates the element tree accordingly.
    text
      Previously, I just had functions that return Drawings, for example a row
      takes some drawings and returns a drawing that show them next to each
      other. However, having internal state is generally useful and can improve
      performance significantly. For example, if you have a text in a scroll
      view, you don't want to re-layout the text every frame, but cache its draw
      commands. So, I implemented a widget framework.
    text
      Each element in the widget tree represents a visual "thing". It has a
      concrete size and concrete draw commands so you can render it. You only
      communicate with the element using a fixed set of functions -- for
      example, to tell it "here are new size constraints" or "the mouse clicked
      here". This will cause the element to update itself.
    chapter How layouting works
      text
        Constraints (min/max width/height) flow down the tree and concrete sizes
        flow up the tree. Parent widgets determine how/if/where to render the
        child widgets, so child widgets never know their absolute position, they
        only provide draw commands. Constraints always have a min size (it may
        be 0), but they might omit the max sizes to give children an unlimited
        amount of space. This communicates to the children "just be your natural
        size". Example: In a vertical scroll view, you might have a text and a
        colored sized box that wants to be 300 x 300 in size. Let's say we want
        to display these widgets in a window of size 200 x 200. After creating
        the element tree, we can give the scroll view element tight constraints
        (width 200 to 200, height 200 to 200), which forces the scroll view to
        be exactly 200 x 200. The scroll view propagates constraints to its
        children, but loosens the constraints -- for example, because it layouts
        children toward the left and can scroll, it can provide the constraints
        (width 0 to 200, height 0 to infinity). The text will layout itself to a
        width of 200 and return a concrete size (like 200 x 140). The sized box
        will be forced down to 200 in width, so it may decide to be 200 x 300.
        Because the scroll view only renders part of that 200 x 440 drawing, it
        can report 200 x 200 as its size.
    chapter How mouse events work
      text
        Mouse presses and releases carry a position in the element. Containers
        translate that position into their children's coordinates and route the
        events independently; a release may reach a different child than the
        original press.
    chapter How focus works
      text
        Every element knows whether the focus is inside itself. Every element
        has a focus function, which can accept or reject the focus (reject if
        there's nothing focusable inside), and an unfocus function, which moves
        the focus outside. Mouse and keyboard interactions can cause the focus
        to change: Widget can request the focus. The parent widget can then
        unfocus other sibling widgets and move the focus into the element.
        Events can return a request_focus result, which carries an updated,
        focused subtree. Containers must unfocus its siblings before forwarding
        the request to their parent. focus_next and focus_previous ask
        containers to find an accepting sibling, propagating outward when no
        sibling accepts focus.
    chapter How hovering works
      text
        Every element knows whether it is hovered. Every element has a hover
        function and an unhover function.
    chapter How keyboard events work
      text
        Keyboard events are routed toward the focus.
    text
      For now, Element.update requires a widget made by the same implementation,
      including the implementations of corresponding children in the tree.
    chapter Constraints
      code
        AxisConstraints = struct { min: Float, max: Maybe[Float] }
        Constraints = struct {
          width: AxisConstraints, height: AxisConstraints}
        axis_constraints(min: Float, max: Maybe[Float]) AxisConstraints =
          AxisConstraints(min, max)
        axis_constraints(min: Float, max: Float) AxisConstraints =
          AxisConstraints(min, max = some(max))
        axis_constraints(range: OpenRange[Float]) AxisConstraints =
          axis_constraints(range.start, none[Float]())
        constraints(
          width: AxisConstraints, height: AxisConstraints) Constraints =
          Constraints(width, height)
      text
        Tight constraints mean constraints where the minimum is the maximum, so
        the parent forces the child to be a specific size.
      code
        tight_axis_constraints(value: Float) AxisConstraints =
          axis_constraints(value, value)
        tight_constraints(size: Size) Constraints =
          Constraints(
            width = tight_axis_constraints(size.width),
            height = tight_axis_constraints(size.height))
        ==(a: AxisConstraints, b: AxisConstraints) Bool =
          a.min == b.min
            and {a.max %(
              none b.max is none
              some(value) b.max %(none false some(other) value == other))}
        ==(a: Constraints, b: Constraints) Bool =
          a.width == b.width and a.height == b.height
        is_tight(c: AxisConstraints) Bool =
          c.max %(some(max) c.min == max none false)
        is_tight(c: Constraints) Bool =
          c.width.is_tight() and c.height.is_tight()
      code
        fits(value: Float, constraints: AxisConstraints) Bool =
          value >= constraints.min and {constraints.max %(
            none true
            some(maximum) value <= maximum)}
        fits(value: Size, constraints: Constraints) Bool =
          value.width.fits(constraints.width)
            and value.height.fits(constraints.height)
      code
        overflows(value: Float, constraints: AxisConstraints) Bool =
          not(value.fits(constraints))
        overflows(value: Size, constraints: Constraints) Bool =
          not(value.fits(constraints))
      code
        loosen_min(axis: AxisConstraints) AxisConstraints =
          AxisConstraints(min = 0.0, max = axis.max)
        loosen_min(constraints: Constraints) Constraints =
          Constraints(
            width = constraints.width.loosen_min(),
            height = constraints.height.loosen_min())
      code
        min(constraints: Constraints) Size =
          size(constraints.width.min, constraints.height.min)
        max(constraints: Constraints) Maybe[Size] =
          constraints.width.max.flat_map(\ width: Float ->
            constraints.height.max.map(\ height: Float ->
              size(width, height)))
      code
        clamp(number: Float, low: Float, high: Float) Float =
          min(high, max(low, number))
        clamp(number: Float, constraints: AxisConstraints) Float =
          constraints.max %(
            none max(number, constraints.min)
            some(maximum) number.clamp(constraints.min, maximum))
        clamp(s: Size, constraints: Constraints) Size =
          size(
            s.width.clamp(constraints.width),
            s.height.clamp(constraints.height))
    chapter Widget
      text
        Widgets describe configuration; elements attach state, layout, and
        drawing to that configuration. The subchapters introduce their types,
        then construction, updates, and input handling.
      chapter Configuration and results
        text
          A Widget stores its concrete configuration and implementation as
          Dynamic. Results describe whether an update or event changed the
          attached state.
        code
          Widget[M] = struct { value: Dynamic, impl: Dynamic }
        text
          An unchanged update preserves the complete existing element, including
          its cached drawing.
        code
          UpdateResult[E] = enum { not_handled, handled: E }
        text
          An event can update state, request focus, traverse to another focus
          target, or emit a message together with its updated state.
        code
          ElementMessage[M, E] = struct { element: E, message: M }
        code
          EventResult[M, E] = enum {
            not_handled,
            handled: E,
            request_focus: E,
            focus_next: E,
            focus_previous: E,
            message: ElementMessage[M, E]}
      chapter Implementations and elements
        text
          WidgetImpl describes behavior for concrete configuration W and state
          E. The framework adapts those types to Dynamic when constructing a
          widget.
        code
          WidgetImpl[M, W, E] = struct {
            new: fun(W, Constraints) E,
            update: fun(E, W) UpdateResult[E],
            new_constraints: fun(E, Constraints) E,
            hover: fun(E, Position) EventResult[M, E],
            unhover: fun(E) EventResult[M, E],
            mouse_pressed: fun(E, Position) EventResult[M, E],
            mouse_released: fun(E, Position) EventResult[M, E],
            mouse_scrolled: fun(E, Position, Offset) EventResult[M, E],
            focus: fun(E) Maybe[E],
            unfocus: fun(E) E,
            key_pressed: fun(E, KeyPressed) EventResult[M, E],
            char_entered: fun(E, CharEntered) EventResult[M, E],
            render: fun(E) Drawing}
        text
          An Element keeps the current state and shared implementation beside
          its layout, drawing, and interaction flags.
        code
          Element[M] = struct {
            constraints: Constraints,
            size: Size,
            drawing: Drawing,
            focused: Bool,
            hovered: Bool,
            state: Dynamic,
            impl: WidgetImpl[M, Dynamic, Dynamic] }
      chapter Mapping results
        text
          Containers map the updated state in a result into their own state.
          Messages and focus requests keep their meaning while crossing that
          boundary.
        code
          map[A, B](result: UpdateResult[A], mapper: fun(A) B) UpdateResult[B] =
            result %(
              not_handled UpdateResult[B].not_handled
              handled(value) UpdateResult[B].handled(mapper(value)))
        code
          map[M, A, B](
            result: EventResult[M, A], mapper: fun(A) B) EventResult[M, B] =
            result %(
              not_handled EventResult[M, B].not_handled
              handled(value) EventResult[M, B].handled(mapper(value))
              request_focus(value)
                EventResult[M, B].request_focus(mapper(value))
              focus_next(value) EventResult[M, B].focus_next(mapper(value))
              focus_previous(value) EventResult[M, B].focus_previous(mapper(value))
              message(event)
                EventResult[M, B].message(ElementMessage(
                  message = event.message, element = mapper(event.element))))
      chapter Construction
        text
          Typed adapters keep the Dynamic casts in one place. The implementation
          callbacks receive state explicitly, so they can be shared as elements
          change.
        code
          erase_widget_impl[M, W, E](impl: WidgetImpl[M, W, E]
            ) WidgetImpl[M, Dynamic, Dynamic] =
            WidgetImpl(
              new = \ value: Dynamic, c: Constraints ->
                impl.new(value.to_static[W](), c).to_dynamic(),
              update = \ state: Dynamic, value: Dynamic ->
                impl.update(state.to_static[E](), value.to_static[W]())
                  .map(\ next: E -> next.to_dynamic()),
              new_constraints = \ state: Dynamic, c: Constraints ->
                impl.new_constraints(state.to_static[E](), c).to_dynamic(),
              hover = \ state: Dynamic, pos: Position ->
                impl.hover(state.to_static[E](), pos).map(\ next: E -> next.to_dynamic()),
              unhover = \ state: Dynamic ->
                impl.unhover(state.to_static[E]()).map(\ next: E -> next.to_dynamic()),
              mouse_pressed = \ state: Dynamic, pos: Position ->
                impl.mouse_pressed(state.to_static[E](), pos).map(\ next: E -> next.to_dynamic()),
              mouse_released = \ state: Dynamic, pos: Position ->
                impl.mouse_released(state.to_static[E](), pos).map(\ next: E -> next.to_dynamic()),
              mouse_scrolled = \ state: Dynamic, pos: Position, delta: Offset ->
                impl.mouse_scrolled(state.to_static[E](), pos, delta).map(\ next: E -> next.to_dynamic()),
              focus = \ state: Dynamic ->
                impl.focus(state.to_static[E]()).map(\ next: E -> next.to_dynamic()),
              unfocus = \ state: Dynamic -> impl.unfocus(state.to_static[E]()).to_dynamic(),
              key_pressed = \ state: Dynamic, key: KeyPressed ->
                impl.key_pressed(state.to_static[E](), key).map(\ next: E -> next.to_dynamic()),
              char_entered = \ state: Dynamic, char: CharEntered ->
                impl.char_entered(state.to_static[E](), char).map(\ next: E -> next.to_dynamic()),
              render = \ state: Dynamic -> impl.render(state.to_static[E]()))
        text
          widget packages a concrete configuration with its adapted
          implementation.
        code
          widget[M, W, E](impl: WidgetImpl[M, W, E], current: W) Widget[M] =
            Widget[M](value = current.to_dynamic(), impl = erase_widget_impl(impl).to_dynamic())
        text
          widget_element renders the attached state and caches the resulting
          drawing and size. create_element first constructs that state from a
          widget.
        code
          widget_element[M](impl: WidgetImpl[M, Dynamic, Dynamic], state: Dynamic, constraints: Constraints,
            focused: Bool, hovered: Bool) Element[M] =
            drawing = impl.render(state)
            Element[M](constraints, size = drawing.size, drawing, focused, hovered,
              state, impl)
        code
          create_element[M](widget: Widget[M], constraints: Constraints) Element[M] =
            impl = widget.impl.to_static[WidgetImpl[M, Dynamic, Dynamic]]()
            state = impl.new(widget.value, constraints)
            widget_element[M](impl, state, constraints, false, false)
      chapter Updates and constraints
        text
          Updating requires the same implementation and configuration type. Use
          key_widget around branches whose types or semantic identities differ,
          or whose state should reset.
        text
          Refreshing keeps focus only when the updated state can still accept
          it.
        code
          refreshed_widget_element[M](
            impl: WidgetImpl[M, Dynamic, Dynamic], state: Dynamic, constraints: Constraints,
            focused: Bool, hovered: Bool) Element[M] =
            if focused
              impl.focus(state) %(
                some(next) widget_element[M](impl, next, constraints, true, hovered)
                none widget_element[M](impl, state, constraints, false, hovered))
              widget_element[M](impl, state, constraints, false, hovered)
        text
          update exposes whether anything changed. updated resolves that result
          for compositions which need the current child, preserving the old
          element when the update is not handled.
        code
          update[M](element: Element[M], next: Widget[M]) UpdateResult[Element[M]] =
            element.impl.update(element.state, next.value)
              .map(\ state: Dynamic -> refreshed_widget_element[M](
                element.impl, state, element.constraints,
                element.focused, element.hovered))
        code
          updated[M](element: Element[M], next: Widget[M]) Element[M] =
            element.update(next) %(
              not_handled element
              handled(value) value)
        text
          Equal constraints skip layout updates.
        code
          new_constraints[M](element: Element[M], next: Constraints) Element[M] =
            if element.constraints == next element
              refreshed_widget_element[M](element.impl,
                element.impl.new_constraints(element.state, next),
                next, element.focused, element.hovered)
      chapter Applying event results
        text
          Implementation callbacks return concrete state changes. The framework
          turns those changes into elements, refreshing their drawing only when
          the event was handled. A focus request carries a focused subtree;
          containers must unfocus its siblings before forwarding it.
        code
          widget_event[M](
            impl: WidgetImpl[M, Dynamic, Dynamic], result: EventResult[M, Dynamic],
            constraints: Constraints, focused: Bool, hovered: Bool
            ) EventResult[M, Element[M]] =
            result %(
              not_handled EventResult[M, Element[M]].not_handled
              handled(next)
                EventResult[M, Element[M]].handled(
                  refreshed_widget_element[M](impl, next, constraints, focused, hovered))
              focus_next(next)
                EventResult[M, Element[M]].focus_next(
                  refreshed_widget_element[M](impl, next, constraints, focused, hovered))
              focus_previous(next)
                EventResult[M, Element[M]].focus_previous(
                  refreshed_widget_element[M](impl, next, constraints, focused, hovered))
              request_focus(next)
                impl.focus(next) %(
                  some(accepted)
                    EventResult[M, Element[M]].request_focus(
                      widget_element[M](impl, accepted, constraints, true, hovered))
                  none
                    EventResult[M, Element[M]].handled(
                      widget_element[M](impl, next, constraints, false, hovered)))
              message(event)
                EventResult[M, Element[M]].message(ElementMessage(
                  message = event.message,
                  element = refreshed_widget_element[M](
                    impl, event.element, constraints, focused, hovered))))
        code
          widget_event[M](element: Element[M], result: EventResult[M, Dynamic],
            hovered: Bool) EventResult[M, Element[M]] =
            widget_event(element.impl, result,
              element.constraints, element.focused, hovered)
      chapter Pointer events
        text
          Pointer positions are local to each element. Bounds checks, hover
          refreshes, and event forwarding are shared by all implementations.
        chapter Bounds and hover
          text
            hover updates the hovered subtree; unhover clears it recursively.
            The app tracks the pointer and refreshes hover after events and
            layout changes. Element.hovered identifies subtrees which may need
            unhover.
          code
            bounds[M](element: Element[M]) Rectangle =
              rectangle(0.0, 0.0, element.size.width, element.size.height)
          code
            unhover[M](element: Element[M]) EventResult[M, Element[M]] =
              if element.hovered
                widget_event(element, element.impl.unhover(element.state), false)
                EventResult[M, Element[M]].not_handled
          code
            hover[M](element: Element[M], pos: Position) EventResult[M, Element[M]] =
              if element.bounds().contains(pos)
                widget_event(element,
                  element.impl.hover(element.state, pos), true)
                element.unhover()
        chapter Mouse buttons and scrolling
          text
            Button events refresh hover before reaching the implementation.
            Events outside the element bounds are not forwarded.
          code
            after_hover[M](
              result: EventResult[M, Element[M]], previous: Element[M],
              handle: fun(Element[M]) EventResult[M, Element[M]]
              ) EventResult[M, Element[M]] =
              result %(
                not_handled handle(previous)
                handled(next)
                  result = handle(next)
                  result %(
                    not_handled EventResult[M, Element[M]].handled(next)
                    default result)
                default result)
            # Erase configuration and state types once when making a widget.
            # The shared callbacks take state explicitly instead of capturing it
            # afresh whenever an element changes.
          code
            mouse_pressed[M](element: Element[M], pos: Position
              ) EventResult[M, Element[M]] =
              if element.bounds().contains(pos)
                after_hover(element.hover(pos), element, \ next: Element[M] ->
                  widget_event(next,
                    next.impl.mouse_pressed(next.state, pos), next.hovered))
                EventResult[M, Element[M]].not_handled
          code
            mouse_released[M](element: Element[M], pos: Position
              ) EventResult[M, Element[M]] =
              if element.bounds().contains(pos)
                after_hover(element.hover(pos), element, \ next: Element[M] ->
                  widget_event(next,
                    next.impl.mouse_released(next.state, pos), next.hovered))
                EventResult[M, Element[M]].not_handled
          code
            mouse_scrolled[M](element: Element[M], pos: Position, delta: Offset
              ) EventResult[M, Element[M]] =
              if element.bounds().contains(pos)
                widget_event(element,
                  element.impl.mouse_scrolled(element.state, pos, delta), element.hovered)
                EventResult[M, Element[M]].not_handled
      chapter Focus and keyboard input
        text
          focus may decline a request. Keyboard and character events only reach
          focused subtrees; unfocus clears focus recursively through the
          implementation.
        code
          focus[M](element: Element[M]) Maybe[Element[M]] =
            if element.focused some(element)
              element.impl.focus(element.state).map(\ state: Dynamic ->
                widget_element[M](element.impl, state, element.constraints, true, element.hovered))
        code
          unfocus[M](element: Element[M]) Element[M] =
            if element.focused
              widget_element[M](element.impl,
                element.impl.unfocus(element.state),
                element.constraints, false, element.hovered)
              element
        code
          key_pressed[M](element: Element[M], key: KeyPressed
            ) EventResult[M, Element[M]] =
            if element.focused
              widget_event(element,
                element.impl.key_pressed(element.state, key), element.hovered)
              EventResult[M, Element[M]].not_handled
        code
          char_entered[M](element: Element[M], char: CharEntered
            ) EventResult[M, Element[M]] =
            if element.focused
              widget_event(element,
                element.impl.char_entered(element.state, char), element.hovered)
              EventResult[M, Element[M]].not_handled
    chapter Key widget
      text
        key_widget(key, equals, child) preserves the child's element while the
        key stays the same. A different key creates a fresh element. Use
        different keys for children with different implementations or semantic
        identities. The key type and comparison function must stay the same
        across updates. The original comparison function is retained by the
        element.
      code
        KeyWidget[K, M] = struct { key: K, child: Widget[M] }
        KeyElement[K, M] = struct { key: K, child: Element[M] }
        key_widget_child[K, M](
          e: KeyElement[K, M], child: Element[M]) KeyElement[K, M] =
          KeyElement(key = e.key, child)
        key_widget_impl[K, M](equals: fun(K, K) Bool
          ) WidgetImpl[M, KeyWidget[K, M], KeyElement[K, M]] =
          WidgetImpl(
            new = \ w: KeyWidget[K, M], constraints: Constraints ->
              KeyElement(
                key = w.key, child = w.child.create_element(constraints)),
            update = \ e: KeyElement[K, M], w: KeyWidget[K, M] ->
              if equals(e.key, w.key)
                e.child.update(w.child).map(\ child: Element[M] -> key_widget_child(e, child))
                UpdateResult[KeyElement[K, M]].handled(KeyElement(
                  key = w.key, child = w.child.create_element(e.child.constraints))),
            new_constraints =
              \ e: KeyElement[K, M], constraints: Constraints ->
                key_widget_child(e, e.child.new_constraints(constraints)),
            hover = \ e: KeyElement[K, M], pos: Position ->
              e.child.hover(pos)
              . map(\ child: Element[M] -> key_widget_child(e, child)),
            unhover = \ e: KeyElement[K, M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> key_widget_child(e, child)),
            mouse_pressed = \ e: KeyElement[K, M], pos: Position ->
              e.child.mouse_pressed(pos)
              . map(\ child: Element[M] -> key_widget_child(e, child)),
            mouse_released = \ e: KeyElement[K, M], pos: Position ->
              e.child.mouse_released(pos)
              . map(\ child: Element[M] -> key_widget_child(e, child)),
            mouse_scrolled =
              \ e: KeyElement[K, M], pos: Position, delta: Offset ->
                e.child.mouse_scrolled(pos, delta)
                . map(\ child: Element[M] -> key_widget_child(e, child)),
            focus = \ e: KeyElement[K, M] ->
              e.child.focus()
              . map(\ child: Element[M] -> key_widget_child(e, child)),
            unfocus = \ e: KeyElement[K, M] ->
              key_widget_child(e, e.child.unfocus()),
            key_pressed = \ e: KeyElement[K, M], key: KeyPressed ->
              e.child.key_pressed(key)
              . map(\ child: Element[M] -> key_widget_child(e, child)),
            char_entered = \ e: KeyElement[K, M], char: CharEntered ->
              e.child.char_entered(char)
              . map(\ child: Element[M] -> key_widget_child(e, child)),
            render = \ e: KeyElement[K, M] -> e.child.drawing)
        key_widget[K, M](
          key: K, equals: fun(K, K) Bool, child: Widget[M]) Widget[M] =
          widget(key_widget_impl[K, M](equals), KeyWidget(key, child))
        key_widget[M](key: Int, child: Widget[M]) Widget[M] =
          key_widget(key, \ a: Int, b: Int -> a == b, child)
    chapter Map message
      text
        map_message adapts a child's messages while preserving its element,
        layout, focus, and hover state. Updating the widget replaces the mapper
        and updates the existing child. cast_message adapts a Widget[Never]
        using the same wrapper.
      code
        MapMessageWidget[A, B] = struct {
          child: Widget[A], mapper: fun(A) B }
        MapMessageElement[A, B] = struct {
          child: Element[A], mapper: fun(A) B }
        map_message_child[A, B](
          e: MapMessageElement[A, B], child: Element[A]
          ) MapMessageElement[A, B] =
          MapMessageElement(child, mapper = e.mapper)
        map_message_event[A, B](
          e: MapMessageElement[A, B], result: EventResult[A, Element[A]]
          ) EventResult[B, MapMessageElement[A, B]] =
          result %(
            not_handled EventResult[B, MapMessageElement[A, B]].not_handled
            handled(child)
              EventResult[B, MapMessageElement[A, B]].handled(
                map_message_child(e, child))
            focus_next(child)
              EventResult[B, MapMessageElement[A, B]].focus_next(map_message_child(e, child))
            focus_previous(child)
              EventResult[B, MapMessageElement[A, B]].focus_previous(map_message_child(e, child))
            request_focus(child)
              EventResult[B, MapMessageElement[A, B]].request_focus(
                map_message_child(e, child))
            message(event)
              EventResult[B, MapMessageElement[A, B]].message(
                ElementMessage(
                  element = map_message_child(e, event.element),
                  message = e.mapper(event.message))))
        map_message_impl[A, B](
          ) WidgetImpl[B, MapMessageWidget[A, B], MapMessageElement[A, B]] =
          WidgetImpl(
            new = \ w: MapMessageWidget[A, B], constraints: Constraints ->
              MapMessageElement(
                child = w.child.create_element(constraints),
                mapper = w.mapper),
            update =
              \ e: MapMessageElement[A, B], w: MapMessageWidget[A, B] ->
                UpdateResult[MapMessageElement[A, B]].handled(
                  MapMessageElement(
                    child = e.child.updated(w.child), mapper = w.mapper)),
            new_constraints =
              \ e: MapMessageElement[A, B], constraints: Constraints ->
                map_message_child(e, e.child.new_constraints(constraints)),
            hover = \ e: MapMessageElement[A, B], pos: Position ->
              map_message_event(e, e.child.hover(pos)),
            unhover = \ e: MapMessageElement[A, B] ->
              map_message_event(e, e.child.unhover()),
            mouse_pressed = \ e: MapMessageElement[A, B], pos: Position ->
              map_message_event(e, e.child.mouse_pressed(pos)),
            mouse_released = \ e: MapMessageElement[A, B], pos: Position ->
              map_message_event(e, e.child.mouse_released(pos)),
            mouse_scrolled =
              \ e: MapMessageElement[A, B], pos: Position, delta: Offset ->
                map_message_event(e, e.child.mouse_scrolled(pos, delta)),
            focus = \ e: MapMessageElement[A, B] ->
              e.child.focus()
              . map(\ child: Element[A] -> map_message_child(e, child)),
            unfocus = \ e: MapMessageElement[A, B] ->
              map_message_child(e, e.child.unfocus()),
            key_pressed = \ e: MapMessageElement[A, B], key: KeyPressed ->
              map_message_event(e, e.child.key_pressed(key)),
            char_entered = \ e: MapMessageElement[A, B], char: CharEntered ->
              map_message_event(e, e.child.char_entered(char)),
            render = \ e: MapMessageElement[A, B] -> e.child.drawing)
        map_message[A, B](child: Widget[A], mapper: fun(A) B) Widget[B] =
          widget(map_message_impl[A, B](), MapMessageWidget(child, mapper))
        cast_message[M](child: Widget[Never]) Widget[M] =
          map_message[Never, M](child, \ message: Never -> unreachable())
    chapter Run app
      text
        An app driver handles widget messages and global keyboard shortcuts. The
        document owner supplies a driver which can save the latest state.
        Shortcuts run before focused text input. The app refreshes hover after
        events and layout changes, reusing unchanged drawings.
      code
        AppDriver[M] = struct {
          message: fun(M, Element[M], Maybe[Position]) AppResult,
          shortcut: fun(KeyPressed) Maybe[AppCommand] }
        app_frame[M](element: Element[M], pointer: Maybe[Position],
          driver: AppDriver[M]) AppResult =
          AppResult(app = run_app(element, pointer, driver),
            commands = list[AppCommand]())
        app_hover_result[M](result: EventResult[M, Element[M]],
          previous: Element[M], pointer: Maybe[Position], driver: AppDriver[M]
          ) AppResult =
          result %(
            not_handled app_frame(previous, pointer, driver)
            handled(next) app_frame(next, pointer, driver)
            request_focus(next) app_frame(next, pointer, driver)
            focus_next(next) app_frame(next, pointer, driver)
            focus_previous(next) app_frame(next, pointer, driver)
            message(event) driver.message(event.message, event.element, pointer))
        refresh_app[M](element: Element[M], pointer: Maybe[Position],
          driver: AppDriver[M]) AppResult =
          app_hover_result(
            pointer %(none element.unhover() some(pos) element.hover(pos)),
            element, pointer, driver)
        run_app_result[M](previous: Element[M],
          result: EventResult[M, Element[M]], pointer: Maybe[Position],
          driver: AppDriver[M]) AppResult =
          result %(
            not_handled refresh_app(previous, pointer, driver)
            handled(next) refresh_app(next, pointer, driver)
            request_focus(next) refresh_app(next, pointer, driver)
            focus_next(next) refresh_app(next, pointer, driver)
            focus_previous(next) refresh_app(next, pointer, driver)
            message(event) driver.message(event.message, event.element, pointer))
        run_app[M](current: Element[M], pointer: Maybe[Position],
          driver: AppDriver[M]) App =
          App(
            render = \ window: Size -> current.drawing.draw,
            handle = \ event: Event ->
              event %(
                window_resized(window)
                  refresh_app(current.new_constraints(tight_constraints(window)),
                    pointer, driver)
                mouse_moved(pos)
                  app_hover_result(current.hover(pos), current, some(pos), driver)
                mouse_left
                  app_hover_result(current.unhover(), current, none[Position](), driver)
                mouse_pressed(pos)
                  run_app_result(current, current.mouse_pressed(pos), some(pos), driver)
                mouse_released(pos)
                  run_app_result(current, current.mouse_released(pos), some(pos), driver)
                mouse_scrolled(event)
                  run_app_result(current,
                    after_hover(current.hover(event.position), current,
                      \ next: Element[M] ->
                        next.mouse_scrolled(event.position, event.delta)),
                    some(event.position), driver)
                key_pressed(key)
                  driver.shortcut(key) %(
                    some(command) AppResult(
                      app = run_app(current, pointer, driver), commands = list(command))
                    none run_app_result(current, current.key_pressed(key), pointer, driver))
                char_entered(char)
                  run_app_result(current, current.char_entered(char), pointer, driver)
                save_completed app_frame(current, pointer, driver)
                save_failed app_frame(current, pointer, driver)))
        unreachable_app_result() AppResult = unreachable()
        run_app(element: Element[Never]) App =
          run_app(element, none[Position](), AppDriver[Never](
            message = \ message: Never, element: Element[Never], pointer: Maybe[Position] ->
              unreachable_app_result(),
            shortcut = \ key: KeyPressed -> none[AppCommand]()))
        run_app(root: Widget[Never]) App =
          run_app(root.create_element(tight_constraints(size(0.0, 0.0))))
  chapter Basic widgets
    chapter EmptyWidget
      code
        empty_impl() WidgetImpl[Never, Nothing, Size] =
          WidgetImpl(
            new = \ w: Nothing, constraints: Constraints -> constraints.min(),
            update = \ state: Size, w: Nothing ->
              UpdateResult[Size].not_handled,
            new_constraints = \ state: Size, constraints: Constraints ->
              constraints.min(),
            hover = \ state: Size, pos: Position ->
              EventResult[Never, Size].not_handled,
            unhover = \ state: Size ->
              EventResult[Never, Size].not_handled,
            mouse_pressed = \ state: Size, position: Position ->
              EventResult[Never, Size].not_handled,
            mouse_released = \ state: Size, pos: Position ->
              EventResult[Never, Size].not_handled,
            mouse_scrolled =
              \ state: Size, position: Position, delta: Offset ->
                EventResult[Never, Size].not_handled,
            focus = \ state: Size -> none[Size](),
            unfocus = \ state: Size -> state,
            key_pressed = \ state: Size, key: KeyPressed ->
              EventResult[Never, Size].not_handled,
            char_entered = \ state: Size, char: CharEntered ->
              EventResult[Never, Size].not_handled,
            render = \ size: Size -> Drawing(draw = draw_nothing(), size))
        empty() Widget[Never] = widget(empty_impl(), Nothing())
        empty_widget = empty()
    chapter Draw proxy
      text
        draw_proxy receives its child's size and draw commands and wraps those
        commands however it likes. It preserves layout, hit testing, focus, and
        message routing. Drawing transforms affect painting only; use a
        geometry-aware widget when pointer coordinates should transform too.
      code
        DrawProxyWidget[M] = struct {
          child: Widget[M], draw: fun(Size, DrawCommand) DrawCommand }
        DrawProxyElement[M] = struct {
          child: Element[M], draw: fun(Size, DrawCommand) DrawCommand }
        draw_proxy_child[M](e: DrawProxyElement[M], child: Element[M]
          ) DrawProxyElement[M] =
          DrawProxyElement(child, draw = e.draw)
        draw_proxy_impl[M](
          ) WidgetImpl[M, DrawProxyWidget[M], DrawProxyElement[M]] =
          WidgetImpl(
            new = \ w: DrawProxyWidget[M], constraints: Constraints ->
              DrawProxyElement(child = w.child.create_element(constraints), draw = w.draw),
            update = \ e: DrawProxyElement[M], w: DrawProxyWidget[M] ->
              UpdateResult[DrawProxyElement[M]].handled(
                DrawProxyElement(child = e.child.updated(w.child), draw = w.draw)),
            new_constraints = \ e: DrawProxyElement[M], constraints: Constraints ->
              draw_proxy_child(e, e.child.new_constraints(constraints)),
            hover = \ e: DrawProxyElement[M], pos: Position ->
              e.child.hover(pos).map(\ child: Element[M] -> draw_proxy_child(e, child)),
            unhover = \ e: DrawProxyElement[M] ->
              e.child.unhover().map(\ child: Element[M] -> draw_proxy_child(e, child)),
            mouse_pressed = \ e: DrawProxyElement[M], pos: Position ->
              e.child.mouse_pressed(pos).map(\ child: Element[M] -> draw_proxy_child(e, child)),
            mouse_released = \ e: DrawProxyElement[M], pos: Position ->
              e.child.mouse_released(pos).map(\ child: Element[M] -> draw_proxy_child(e, child)),
            mouse_scrolled = \ e: DrawProxyElement[M], pos: Position, delta: Offset ->
              e.child.mouse_scrolled(pos, delta).map(\ child: Element[M] -> draw_proxy_child(e, child)),
            focus = \ e: DrawProxyElement[M] ->
              e.child.focus().map(\ child: Element[M] -> draw_proxy_child(e, child)),
            unfocus = \ e: DrawProxyElement[M] -> draw_proxy_child(e, e.child.unfocus()),
            key_pressed = \ e: DrawProxyElement[M], key: KeyPressed ->
              e.child.key_pressed(key).map(\ child: Element[M] -> draw_proxy_child(e, child)),
            char_entered = \ e: DrawProxyElement[M], char: CharEntered ->
              e.child.char_entered(char).map(\ child: Element[M] -> draw_proxy_child(e, child)),
            render = \ e: DrawProxyElement[M] ->
              Drawing(size = e.child.size, draw = e.draw(e.child.size, e.child.drawing.draw)))
        draw_proxy[M](child: Widget[M], draw: fun(Size, DrawCommand) DrawCommand) Widget[M] =
          widget(draw_proxy_impl[M](), DrawProxyWidget(child, draw))
    chapter ColoredWidget
      code
        colored[M](color: Color, child: Widget[M]) Widget[M] =
          draw_proxy(child, \ size: Size, drawing: DrawCommand ->
            draw_all(list(draw_colored_rect(size, color), drawing)))
    chapter RoundedRect
      text
        The rounded rect widget clips its child to have circular corners. The
        radius must be non-negative and is capped at half the smaller dimension.
        Events at positions cut off by the corners are ignored.
      code
        RoundedRectWidget[M] = struct { radius: Float, child: Widget[M] }
        RoundedRectElement[M] = struct { radius: Float, child: Element[M] }
        rounded_radius(radius: Float, size: Size) Float =
          radius.clamp(0.0, min(size.width, size.height) / 2.0)
        rounded_rect_path(radius: Float, size: Size) Path =
          r = rounded_radius(radius, size)
          c = r * 0.4477152501692064 # 1 - 4/3 * tan(pi/8)
          if r == 0.0
            path().move_to(0.0, 0.0)
              .line_to(size.width, 0.0)
              .line_to(size.width, size.height)
              .line_to(0.0, size.height)
            path().move_to(r, 0.0)
              .line_to(size.width - r, 0.0)
              .bezier_to(size.width - c, 0.0, size.width, c, size.width, r)
              .line_to(size.width, size.height - r)
              .bezier_to(
                size.width, size.height - c,
                size.width - c, size.height,
                size.width - r, size.height)
              .line_to(r, size.height)
              .bezier_to(
                c, size.height, 0.0, size.height - c, 0.0, size.height - r)
              .line_to(0.0, r)
              .bezier_to(0.0, c, c, 0.0, r, 0.0)
        rounded_rect_contains(radius: Float, size: Size, pos: Position) Bool =
          r = rounded_radius(radius, size)
          dx = pos.x - pos.x.clamp(r, size.width - r)
          dy = pos.y - pos.y.clamp(r, size.height - r)
          {dx * dx} + {dy * dy} <= {r * r}
        rounded_rect_child[M](
          e: RoundedRectElement[M], child: Element[M]) RoundedRectElement[M] =
          RoundedRectElement(radius = e.radius, child)
        rounded_rect_impl[M](
          ) WidgetImpl[M, RoundedRectWidget[M], RoundedRectElement[M]] =
          WidgetImpl(
            new = \ w: RoundedRectWidget[M], constraints: Constraints ->
              RoundedRectElement(
                radius = w.radius,
                child = w.child.create_element(constraints)),
            update = \ e: RoundedRectElement[M], w: RoundedRectWidget[M] ->
              UpdateResult[RoundedRectElement[M]].handled(
                RoundedRectElement(
                  radius = w.radius, child = e.child.updated(w.child))),
            new_constraints =
              \ e: RoundedRectElement[M], constraints: Constraints ->
                RoundedRectElement(
                  radius = e.radius,
                  child = e.child.new_constraints(constraints)),
            hover = \ e: RoundedRectElement[M], pos: Position ->
              result = if rounded_rect_contains(e.radius, e.child.size, pos)
                e.child.hover(pos)
                e.child.unhover()
              result.map(\ child: Element[M] -> rounded_rect_child(e, child)),
            unhover = \ e: RoundedRectElement[M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> rounded_rect_child(e, child)),
            mouse_pressed = \ e: RoundedRectElement[M], pos: Position ->
              if rounded_rect_contains(e.radius, e.child.size, pos)
                e.child.mouse_pressed(pos)
                  .map(\ child: Element[M] -> rounded_rect_child(e, child))
                EventResult[M, RoundedRectElement[M]].not_handled,
            mouse_released = \ e: RoundedRectElement[M], pos: Position ->
              if rounded_rect_contains(e.radius, e.child.size, pos)
                e.child.mouse_released(pos)
                . map(\ child: Element[M] -> rounded_rect_child(e, child))
                EventResult[M, RoundedRectElement[M]].not_handled,
            mouse_scrolled =
              \ e: RoundedRectElement[M], pos: Position, delta: Offset ->
                if rounded_rect_contains(e.radius, e.child.size, pos)
                  e.child.mouse_scrolled(pos, delta)
                  . map(\ child: Element[M] -> rounded_rect_child(e, child))
                  EventResult[M, RoundedRectElement[M]].not_handled,
            focus = \ e: RoundedRectElement[M] ->
              e.child.focus()
              . map(\ child: Element[M] -> rounded_rect_child(e, child)),
            unfocus = \ e: RoundedRectElement[M] ->
              rounded_rect_child(e, e.child.unfocus()),
            key_pressed = \ e: RoundedRectElement[M], key: KeyPressed ->
              e.child.key_pressed(key)
              . map(\ child: Element[M] -> rounded_rect_child(e, child)),
            char_entered = \ e: RoundedRectElement[M], char: CharEntered ->
              e.child.char_entered(char)
              . map(\ child: Element[M] -> rounded_rect_child(e, child)),
            render = \ e: RoundedRectElement[M] ->
              Drawing(
                draw =
                  draw_clipped(
                    rounded_rect_path(e.radius, e.child.size),
                    e.child.drawing.draw),
                size = e.child.size))
        rounded_rect[M](radius: Float, child: Widget[M]) Widget[M] =
          _ = assert(
            radius >= 0.0, "Rounded rectangle radius must be non-negative.")
          widget(rounded_rect_impl[M](), RoundedRectWidget(radius, child))
    chapter SizedBox
      text
        A sized box can have a preferred width and height that it tries to
        respect as much as possible given the parent constraints. For axis where
        it has a preferred extent, it presents its child with a tight
        constraint.
      code
        SizedBoxWidget[M] = struct {
          width: Maybe[Float], height: Maybe[Float], child: Widget[M]}
        SizedBoxElement[M] = struct {
          width: Maybe[Float],
          height: Maybe[Float],
          constraints: Constraints,
          child: Element[M]}
        sized_box_child_constraints(
          width: Maybe[Float], height: Maybe[Float], outer: Constraints
        ) Constraints =
          constraints(
            width
            . map(\ w: Float -> tight_axis_constraints(w.clamp(outer.width)))
              or outer.width,
            height
            . map(\ h: Float ->
                tight_axis_constraints(h.clamp(outer.height)))
              or outer.height)
        sized_box_child[M](
          e: SizedBoxElement[M], child: Element[M]) SizedBoxElement[M] =
          SizedBoxElement(
            width = e.width,
            height = e.height,
            constraints = e.constraints,
            child)
        sized_box_impl[M](
          ) WidgetImpl[M, SizedBoxWidget[M], SizedBoxElement[M]] =
          WidgetImpl(
            new = \ w: SizedBoxWidget[M], constraints: Constraints ->
              SizedBoxElement(
                width = w.width,
                height = w.height,
                constraints,
                child = w.child.create_element(
                  sized_box_child_constraints(
                    w.width, w.height, constraints))),
            update = \ e: SizedBoxElement[M], w: SizedBoxWidget[M] ->
              UpdateResult[SizedBoxElement[M]].handled(
                SizedBoxElement(
                  width = w.width,
                  height = w.height,
                  constraints = e.constraints,
                  child =
                    e.child.updated(w.child)
                      .new_constraints(
                        sized_box_child_constraints(
                          w.width, w.height, e.constraints)))),
            new_constraints = \ e: SizedBoxElement[M], next: Constraints ->
              SizedBoxElement(
                width = e.width,
                height = e.height,
                constraints = next,
                child = e.child.new_constraints(
                  sized_box_child_constraints(e.width, e.height, next))),
            hover = \ e: SizedBoxElement[M], pos: Position ->
              e.child.hover(pos)
              . map(\ child: Element[M] -> sized_box_child(e, child)),
            unhover = \ e: SizedBoxElement[M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> sized_box_child(e, child)),
            mouse_pressed = \ e: SizedBoxElement[M], pos: Position ->
              e.child.mouse_pressed(pos)
                .map(\ child: Element[M] -> sized_box_child(e, child)),
            mouse_released = \ e: SizedBoxElement[M], pos: Position ->
              e.child.mouse_released(pos)
                .map(\ child: Element[M] -> sized_box_child(e, child)),
            mouse_scrolled =
              \ e: SizedBoxElement[M], pos: Position, delta: Offset ->
                e.child.mouse_scrolled(pos, delta)
                  .map(\ child: Element[M] -> sized_box_child(e, child)),
            focus = \ e: SizedBoxElement[M] ->
              e.child.focus()
                .map(\ child: Element[M] -> sized_box_child(e, child)),
            unfocus = \ e: SizedBoxElement[M] ->
              sized_box_child(e, e.child.unfocus()),
            key_pressed = \ e: SizedBoxElement[M], key: KeyPressed ->
              e.child.key_pressed(key)
                .map(\ child: Element[M] -> sized_box_child(e, child)),
            char_entered = \ e: SizedBoxElement[M], char: CharEntered ->
              e.child.char_entered(char)
                .map(\ child: Element[M] -> sized_box_child(e, child)),
            render = \ e: SizedBoxElement[M] -> e.child.drawing)
        sized_box[M](
          width: Maybe[Float], height: Maybe[Float], child: Widget[M]
          ) Widget[M] =
          widget(
            sized_box_impl[M](),
            SizedBoxWidget(width, height, child))
        sized_box[M](
          width: Float, height: Float, child: Widget[M]) Widget[M] =
          sized_box(some(width), some(height), child)
        width_box[M](width: Float, child: Widget[M]) Widget[M] =
          sized_box(some(width), none[Float](), child)
        height_box[M](height: Float, child: Widget[M]) Widget[M] =
          sized_box(none[Float](), some(height), child)
        # Constructors with no child widget.
        sized_box(
          width: Maybe[Float], height: Maybe[Float]
        ) Widget[Never] =
          sized_box(width, height, empty_widget)
        sized_box(width: Float, height: Float) Widget[Never] =
          sized_box(width, height, empty_widget)
        width_box(width: Float) Widget[Never] =
          width_box(width, empty_widget)
        height_box(height: Float) Widget[Never] =
          height_box(height, empty_widget)
    chapter OverflowStripes
      text
        When widgets don't fit in the constraints they are given, crashing has
        some downsides – maybe the widget is only temporarily small. Also,
        who's at fault? If I resize the window to be really small, that needs to
        be handled *somehow*. That's why the contract is that widgets should
        never crash because they are given insufficient space. They need to
        handle this gracefully. To signal their unhappiness, they can add yellow
        and black diagonal stripes, which are visually very obvious.
      code
        # The yellow part is the background, black stripes are painted in
        # front of it.
        draw_overflow_stripe(extent: Size, start: Float) DrawCommand =
          end = min(start + 8.0, extent.width + extent.height)
          if start >= end
            draw_nothing()
            # The stripe may be cut of by the extent bounding box, so the
            # resulting path can have up to six corners:
            #           0 . 1
            #         .     .
            #       .       .
            #     .         2
            #   .         .
            # 5         .
            # .       .
            # .     .
            # 4 . 3
            draw_filled_path(
              path()
                .move_to(
                  start.clamp(0.0, extent.width),
                  {start - extent.width}.clamp(0.0, extent.height))
                .do(\ path: Path ->
                  if start < extent.width and end > extent.width
                    path.line_to(extent.width, 0.0)
                    path)
                .line_to(
                  end.clamp(0.0, extent.width),
                  {end - extent.width}.clamp(0.0, extent.height))
                .line_to(
                  {end - extent.height}.clamp(0.0, extent.width),
                  end.clamp(0.0, extent.height))
                .do(\ path: Path ->
                  if start < extent.height and end > extent.height
                    path.line_to(0.0, extent.height)
                    path)
                .line_to(
                  {start - extent.height}.clamp(0.0, extent.width),
                  start.clamp(0.0, extent.height)),
              color("#000000"))
        draw_overflow_stripes(extent: Size) DrawCommand =
          if extent.width <= 0.0 or extent.height <= 0.0
            draw_nothing()
          identity(
            count = {{extent.width + extent.height} / 16.0}.to_int() + 1
            stripes = {0..count}.iter()
              .map(\ index: Int ->
                draw_overflow_stripe(extent, index.to_float() * 16.0))
              .to_list()
            draw_all(list(
              draw_colored_rect(extent, color("#ffeb00")),
              draw_all(stripes))))
        overflow_drawing(
          left: Bool, top: Bool, right: Bool, bottom: Bool, child: Drawing
        ) Drawing =
          if left or top or right or bottom identity(
            width = min(8.0, child.size.width)
            height = min(8.0, child.size.height)
            Drawing(
              size = child.size,
              draw = draw_all(list(
                child.draw,
                if left
                  draw_overflow_stripes(size(width, child.size.height))
                  draw_nothing(),
                if top
                  draw_overflow_stripes(size(child.size.width, height))
                  draw_nothing(),
                if right
                  draw_transformed(
                    transform_translate(
                      offset(child.size.width - width, 0.0)),
                    draw_overflow_stripes(size(width, child.size.height)))
                  draw_nothing(),
                if bottom
                  draw_transformed(
                    transform_translate(
                      offset(0.0, child.size.height - height)),
                    draw_overflow_stripes(size(child.size.width, height)))
                draw_nothing())))
          ) child
    chapter ScaleWidget
      text
        The scale widget scales its child.
      code
        ScaleWidget[M] = struct { factor: Float, child: Widget[M] }
        ScaleElement[M] = struct {
          factor: Float, child: Element[M], constraints: Constraints}
        scale_child_constraints(
          factor: Float, outer: Constraints) Constraints =
          Constraints(
            width =
              axis_constraints(
                outer.width.min / factor,
                outer.width.max.map(\ maximum: Float -> maximum / factor)),
            height =
              axis_constraints(
                outer.height.min / factor,
                outer.height.max.map(\ maximum: Float -> maximum / factor)))
        scale_child[M](e: ScaleElement[M], child: Element[M]) ScaleElement[M] =
          ScaleElement(factor = e.factor, constraints = e.constraints, child)
        scale_widget_impl[M](
          ) WidgetImpl[M, ScaleWidget[M], ScaleElement[M]] =
          WidgetImpl(
            new = \ w: ScaleWidget[M], constraints: Constraints ->
              ScaleElement(
                factor = w.factor,
                child =
                  w.child.create_element(
                    scale_child_constraints(w.factor, constraints)),
                constraints),
            update = \ e: ScaleElement[M], w: ScaleWidget[M] ->
              UpdateResult[ScaleElement[M]].handled(
                ScaleElement(
                  factor = w.factor,
                  child =
                    e.child.new_constraints(
                      scale_child_constraints(w.factor, e.constraints))
                      .updated(w.child),
                  constraints = e.constraints)),
            new_constraints =
              \ e: ScaleElement[M], constraints: Constraints ->
                ScaleElement(
                  factor = e.factor,
                  child =
                    e.child.new_constraints(
                      scale_child_constraints(e.factor, constraints)),
                  constraints),
            hover = \ e: ScaleElement[M], pos: Position ->
              e.child.hover(position(pos.x / e.factor, pos.y / e.factor))
              . map(\ child: Element[M] -> scale_child(e, child)),
            unhover = \ e: ScaleElement[M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> scale_child(e, child)),
            mouse_pressed = \ e: ScaleElement[M], pos: Position ->
              e.child
              . mouse_pressed(position(pos.x / e.factor, pos.y / e.factor))
              . map(\ child: Element[M] -> scale_child(e, child)),
            mouse_released = \ e: ScaleElement[M], pos: Position ->
              e.child
              . mouse_released(position(pos.x / e.factor, pos.y / e.factor))
              . map(\ child: Element[M] -> scale_child(e, child)),
            mouse_scrolled =
              \ e: ScaleElement[M], pos: Position, delta: Offset ->
                e.child
                . mouse_scrolled(
                    position(pos.x / e.factor, pos.y / e.factor),
                    delta / e.factor)
                . map(\ child: Element[M] -> scale_child(e, child)),
            focus = \ e: ScaleElement[M] ->
              e.child.focus()
              . map(\ child: Element[M] -> scale_child(e, child)),
            unfocus =
              \ e: ScaleElement[M] -> scale_child(e, e.child.unfocus()),
            key_pressed = \ e: ScaleElement[M], key: KeyPressed ->
              e.child.key_pressed(key)
              . map(\ child: Element[M] -> scale_child(e, child)),
            char_entered = \ e: ScaleElement[M], char: CharEntered ->
              e.child.char_entered(char)
              . map(\ child: Element[M] -> scale_child(e, child)),
            render = \ e: ScaleElement[M] ->
              Drawing(
                draw =
                  draw_transformed(
                    transform_scale(e.factor), e.child.drawing.draw),
                size = {e.child.size * e.factor}.clamp(e.constraints)))
        scale_widget[M](factor: Float, child: Widget[M]) Widget[M] =
          # Subtracting a finite number from itself is zero; infinities yield
          # NaN.
          _ = assert(factor > 0.0 and {{factor - factor} == 0.0},
            "Scale factor must be finite and positive.")
          widget(scale_widget_impl[M](), ScaleWidget(factor, child))
    chapter Text
      text
        Text stores its value, color, and constraints in its element. The
        framework calls render and caches the drawing when created, updated, or
        given new constraints. It wraps to the maximum width and marks text that
        exceeds the available width or height with overflow stripes. Text does
        not handle clicks. Its default color is black. The optional font_scale
        is the requested line height. At the native text_line_height it uses the
        text widget directly; other sizes use scale_widget with font_scale /
        text_line_height.
      code
        TextWidget = struct { value: String, color: Color }
        TextElement = struct {
          value: String, color: Color, constraints: Constraints}
        text_impl() WidgetImpl[Never, TextWidget, TextElement] =
          WidgetImpl(
            new = \ w: TextWidget, constraints: Constraints ->
              TextElement(value = w.value, color = w.color, constraints),
            update = \ e: TextElement, w: TextWidget ->
              same = e.color.r == w.color.r and e.color.g == w.color.g and e.color.b == w.color.b
                and e.value.bytes().length() == w.value.bytes().length()
                and zip(e.value.bytes().iter(), w.value.bytes().iter()).all(
                  \ pair: Tuple2[Byte, Byte] -> pair.a == pair.b)
              if same UpdateResult[TextElement].not_handled
                UpdateResult[TextElement].handled(TextElement(
                  value = w.value, color = w.color, constraints = e.constraints)),
            new_constraints = \ e: TextElement, next: Constraints ->
              TextElement(
                value = e.value, color = e.color, constraints = next),
            hover = \ e: TextElement, pos: Position ->
              EventResult[Never, TextElement].not_handled,
            unhover = \ e: TextElement ->
              EventResult[Never, TextElement].not_handled,
            mouse_pressed = \ e: TextElement, pos: Position ->
              EventResult[Never, TextElement].not_handled,
            mouse_released = \ e: TextElement, pos: Position ->
              EventResult[Never, TextElement].not_handled,
            mouse_scrolled = \ e: TextElement, pos: Position, delta: Offset ->
              EventResult[Never, TextElement].not_handled,
            focus = \ e: TextElement -> none[TextElement](),
            unfocus = \ e: TextElement -> e,
            key_pressed =
              \ e: TextElement, key: KeyPressed ->
                EventResult[Never, TextElement].not_handled,
            char_entered =
              \ e: TextElement, char: CharEntered ->
                EventResult[Never, TextElement].not_handled,
            render = \ e: TextElement ->
              drawing =
                layout_text(e.value.chars(), e.constraints.width.max)
                  .draw_text(e.color)
              overflow_drawing(
                false,
                false,
                drawing.size.width.overflows(
                  e.constraints.width.loosen_min()),
                drawing.size.height.overflows(
                  e.constraints.height.loosen_min()),
                Drawing(
                  size = drawing.size.clamp(e.constraints),
                  draw = drawing.draw)),)
        text(value: String, color: Color) Widget[Never] =
          widget(text_impl(), TextWidget(value, color))
        text(value: String) Widget[Never] =
          text(value, color("#000000"))
        text(value: String, color: Color, font_scale: Float) Widget[Never] =
          child = text(value, color)
          if font_scale == text_line_height
            child
            scale_widget(font_scale / text_line_height, child)
        text(value: String, font_scale: Float) Widget[Never] =
          text(value, color("#000000"), font_scale)
    chapter Padding
      text
        Padding removes its insets from the child's constraints, then adds them
        back to the child's size within the parent constraints. Drawing and
        clicks are translated by the left and top insets.
      code
        Insets = struct {
          left: Float, top: Float, right: Float, bottom: Float}
        deflate(axis: AxisConstraints, amount: Float) AxisConstraints =
          axis_constraints(
            max(0.0, axis.min - amount),
            axis.max.map(\ value: Float -> max(0.0, value - amount)))
        deflate(constraints: Constraints, insets: Insets) Constraints =
          Constraints(
            width = constraints.width.deflate(insets.left + insets.right),
            height = constraints.height.deflate(insets.top + insets.bottom))
        PaddingWidget[M] = struct { insets: Insets, child: Widget[M] }
        PaddingElement[M] = struct {
          insets: Insets, constraints: Constraints, child: Element[M]}
        padding_child[M](
          e: PaddingElement[M], child: Element[M]) PaddingElement[M] =
          PaddingElement(
            insets = e.insets, constraints = e.constraints, child)
        padding_impl[M](
          ) WidgetImpl[M, PaddingWidget[M], PaddingElement[M]] =
          WidgetImpl(
            new = \ w: PaddingWidget[M], constraints: Constraints ->
              PaddingElement(
                insets = w.insets,
                constraints,
                child = w.child.create_element(constraints.deflate(w.insets))),
            update = \ e: PaddingElement[M], w: PaddingWidget[M] ->
              UpdateResult[PaddingElement[M]].handled(
                PaddingElement(
                  insets = w.insets,
                  constraints = e.constraints,
                  child = e.child.updated(w.child).new_constraints(
                      e.constraints.deflate(w.insets)))),
            new_constraints = \ e: PaddingElement[M], next: Constraints ->
              PaddingElement(
                insets = e.insets,
                constraints = next,
                child = e.child.new_constraints(next.deflate(e.insets))),
            hover = \ e: PaddingElement[M], pos: Position ->
              e.child.hover(pos - offset(e.insets.left, e.insets.top))
              . map(\ child: Element[M] -> padding_child(e, child)),
            unhover = \ e: PaddingElement[M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> padding_child(e, child)),
            mouse_pressed = \ e: PaddingElement[M], pos: Position ->
              local = pos - offset(e.insets.left, e.insets.top)
              e.child.mouse_pressed(local)
              . map(\ child: Element[M] -> padding_child(e, child)),
            mouse_released = \ e: PaddingElement[M], pos: Position ->
              local = pos - offset(e.insets.left, e.insets.top)
              e.child.mouse_released(local)
              . map(\ child: Element[M] -> padding_child(e, child)),
            mouse_scrolled =
              \ e: PaddingElement[M], pos: Position, delta: Offset ->
                local = pos - offset(e.insets.left, e.insets.top)
                e.child.mouse_scrolled(local, delta)
                . map(\ child: Element[M] -> padding_child(e, child)),
            focus =
              \ e: PaddingElement[M] ->
                e.child.focus()
                . map(\ child: Element[M] -> padding_child(e, child)),
            unfocus =
              \ e: PaddingElement[M] -> padding_child(e, e.child.unfocus()),
            key_pressed =
              \ e: PaddingElement[M], key: KeyPressed ->
                e.child.key_pressed(key)
                . map(\ child: Element[M] -> padding_child(e, child)),
            char_entered =
              \ e: PaddingElement[M], char: CharEntered ->
                e.child.char_entered(char)
                . map(\ child: Element[M] -> padding_child(e, child)),
            render = \ e: PaddingElement[M] ->
              overflow_drawing(
                false,
                false,
                {e.insets.left + e.insets.right}
                . overflows(e.constraints.width.loosen_min()),
                {e.insets.top + e.insets.bottom}
                . overflows(e.constraints.height.loosen_min()),
                Drawing(
                  draw = draw_transformed(
                    transform_translate(offset(e.insets.left, e.insets.top)),
                    e.child.drawing.draw),
                  size =
                    size(
                      e.child.size.width + e.insets.left + e.insets.right,
                      e.child.size.height + e.insets.top + e.insets.bottom)
                      .clamp(e.constraints))))
        padding[M](
          left: Float,
          top: Float,
          right: Float,
          bottom: Float,
          child: Widget[M],
          ) Widget[M] =
          _ = assert(
            left >= 0.0 and top >= 0.0 and right >= 0.0 and bottom >= 0.0)
          widget(
            padding_impl[M](),
            PaddingWidget(insets = Insets(left, top, right, bottom), child))
        padding[M](amount: Float, child: Widget[M]) Widget[M] =
          padding(amount, amount, amount, amount, child)
    chapter Flex
      text
        A flex shows multiple children next to or above each other. The axis on
        which they are lined up is called the main axis, the other one the cross
        axis. Intrinsic children receive unbounded main-axis space. Expanded
        children divide the remaining space according to their positive flex
        factors and receive tight main-axis constraints. Expanded children
        require a bounded main axis; an unbounded main axis is an error. Without
        expanded children, the flex wraps its children. With expanded children,
        it fills the main axis. The cross axis wraps the largest child, within
        the parent's constraints. Children start at the leading edge of the
        cross axis. Updates preserve child state by index, including when the
        axis or flex factors change.
      code
        Axis = enum { horizontal, vertical }
        FlexWidget[M] = struct {axis: Axis, children: List[FlexChild[M]]}
        FlexChild[M] = enum {intrinsic: Widget[M], expanded: Expanded[M]}
        Expanded[M] = struct { factor: Float, child: Widget[M] }

        FlexElement[M] = struct {
          axis: Axis,
          constraints: Constraints,
          factors: List[Maybe[Float]], # none = intrinsic, some = expanded
          children: List[Element[M]], # same length as factors
          }

        main(size: Size, axis: Axis) Float =
          axis %(horizontal size.width vertical size.height)
        cross(size: Size, axis: Axis) Float =
          axis %(horizontal size.height vertical size.width)
        constraints(
          axis: Axis, main: AxisConstraints, cross: AxisConstraints
          ) Constraints =
          axis %(
            horizontal constraints(main, cross)
            vertical constraints(cross, main))
        flex_size(axis: Axis, main: Float, cross: Float) Size =
          axis %(
            horizontal size(main, cross)
            vertical size(cross, main))
        offset(axis: Axis, main: Float, cross: Float) Offset =
          axis %(
            horizontal offset(main, 0.0)
            vertical offset(0.0, main))
        main(c: Constraints, axis: Axis) AxisConstraints =
          axis %(horizontal c.width vertical c.height)
        cross(c: Constraints, axis: Axis) AxisConstraints =
          axis %(horizontal c.height vertical c.width)

        widget[M](child: FlexChild[M]) Widget[M] =
          child %(intrinsic(value) value expanded(value) value.child)
        factors[M](children: List[FlexChild[M]]) List[Maybe[Float]] =
          children.iter()
            .map(\ child: FlexChild[M] ->
              child %(
                intrinsic none[Float]()
                expanded(e)
                  _ = assert(e.factor > 0.0, "Flex factors must be positive")
                  some(e.factor)))
            .to_list()

        # Accepts children and their corresponding factors.
        # 1. Layouts the children with no factor (those where we want to use
        #    the intrinsic size).
        # 2. Are there only intrinsic children? If so, we are done.
        # 3. Otherwise, partition the remaining space among the expanded
        #    children, weighted by their factors.
        # The function calls the layouter every time it wants to layout a
        # child with the index of the child it wants layouted. The layouter is
        # called exactly once per child.
        layout_flex[M](
          axis: Axis,
          outer: Constraints,
          factors: List[Maybe[Float]],
          layouter: fun(Int, Constraints) Element[M],
        ) List[Element[M]] =
          _ = assert(
            factors.iter().somes().all(\ factor: Float -> factor > 0.0),
            "Flex factors must be positive")
          cross = outer.cross(axis).loosen_min()
          intrinsic_layouted = factors.iter()
            .map_indexed(\ index: Int, factor: Maybe[Float] ->
              if factor is some
                none[Element[M]]()
                some(
                  layouter(
                    index,
                    constraints(
                      axis, axis_constraints(0.0 .. unbounded), cross))))
            .to_list()
          if
            not(
              factors.iter()
                .map(\ factor: Maybe[Float] -> factor is some)
                .any())
            intrinsic_layouted.iter().somes().to_list()
          identity(
            intrinsic_sum = intrinsic_layouted.iter().somes()
              .map(\ child: Element[M] -> child.size.main(axis)).sum()
            factors_sum = factors.iter().somes().sum()
            limit = outer.main(axis).max
              or crash("Expanded children require a bounded main axis")
            available = max(0.0, limit - intrinsic_sum)
            intrinsic_layouted.iter()
              .map_indexed(\ index: Int, layouted: Maybe[Element[M]] ->
                factors.get(index) %(
                  some(f)
                    layouter(
                      index,
                      constraints(
                        axis,
                        tight_axis_constraints(available * {f / factors_sum}),
                        cross))
                  none layouted.unwrap()))
              .to_list())
        flex_event[M](
          e: FlexElement[M], mouse: Position,
          handler: fun(Element[M], Position) EventResult[M, Element[M]],
        ) EventResult[M, FlexElement[M]] =
          loop(0, mouse, \ index: Int, pos: Position ->
            if index == e.children.length()
              Loop[Tuple2[Int, Position], EventResult[M, FlexElement[M]]]
              . break(EventResult[M, FlexElement[M]].not_handled)
            identity(
              child = e.children.get(index)
              handler(child, pos) %(
                not_handled
                  Loop[Tuple2[Int, Position], EventResult[M, FlexElement[M]]]
                  . continue(
                      tuple(
                        index + 1,
                        pos - offset(e.axis, child.size.main(e.axis), 0.0)))
                handled(next)
                  Loop[Tuple2[Int, Position], EventResult[M, FlexElement[M]]]
                  . break(
                      EventResult[M, FlexElement[M]].handled(FlexElement(
                        axis = e.axis,
                        constraints = e.constraints,
                        factors = e.factors,
                        children = layout_flex(
                          e.axis,
                          e.constraints,
                          e.factors,
                          \ child_index: Int, c: Constraints ->
                            child = if child_index == index next
                              e.children.get(child_index)
                            child.new_constraints(c)))))
                focus_next(next)
                  Loop[Tuple2[Int, Position], EventResult[M, FlexElement[M]]]
                  . break(flex_focus_step(
                      flex_children(e, e.children.set(index, next)), index, 1))
                focus_previous(next)
                  Loop[Tuple2[Int, Position], EventResult[M, FlexElement[M]]]
                  . break(flex_focus_step(
                      flex_children(e, e.children.set(index, next)), index, 0 - 1))
                request_focus(next)
                  Loop[Tuple2[Int, Position], EventResult[M, FlexElement[M]]]
                  . break(
                      EventResult[M, FlexElement[M]].request_focus(FlexElement(
                        axis = e.axis,
                        constraints = e.constraints,
                        factors = e.factors,
                        children =
                          layout_flex(
                            e.axis,
                            e.constraints,
                            e.factors,
                            \ child_index: Int, c: Constraints ->
                              child =
                                if child_index == index
                                  next
                                  e.children.get(child_index).unfocus()
                              child.new_constraints(c)))))
                message(event)
                  Loop[Tuple2[Int, Position], EventResult[M, FlexElement[M]]]
                  . break(EventResult[M, FlexElement[M]].message(
                      ElementMessage(
                        message = event.message,
                        element =
                          flex_children(
                            e, e.children.set(index, event.element))))))))
        flex_children[M](
          e: FlexElement[M], children: List[Element[M]]) FlexElement[M] =
          FlexElement(
            axis = e.axis,
            constraints = e.constraints,
            factors = e.factors,
            children =
              layout_flex(
                e.axis,
                e.constraints,
                e.factors,
                \ index: Int, c: Constraints ->
                  children.get(index).new_constraints(c)))
        flex_hover_children[M](
          e: FlexElement[M], pos: Maybe[Position], index: Int, along: Float,
          changed: Bool) EventResult[M, FlexElement[M]] =
          if index == e.children.length()
            if changed
              EventResult[M, FlexElement[M]].handled(e)
              EventResult[M, FlexElement[M]].not_handled
            identity(
              child = e.children.get(index)
              result = pos %(
                some(point) child.hover(point - offset(e.axis, along, 0.0))
                none child.unhover())
              result %(
                not_handled
                  flex_hover_children(e, pos, index + 1,
                    along + child.size.main(e.axis), changed)
                handled(next)
                  flex_hover_children(
                    flex_children(e, e.children.set(index, next)), pos,
                    index + 1, along + next.size.main(e.axis), true)
                focus_next(next)
                  flex_focus_step(
                    flex_children(e, e.children.set(index, next)), index, 1)
                focus_previous(next)
                  flex_focus_step(
                    flex_children(e, e.children.set(index, next)), index, 0 - 1)
                request_focus(next)
                  EventResult[M, FlexElement[M]].request_focus(
                    flex_children(e, e.children.iter().map_indexed(
                      \ i: Int, child: Element[M] ->
                        if i == index next child.unfocus()).to_list()))
                message(event)
                  EventResult[M, FlexElement[M]].message(ElementMessage(
                    message = event.message,
                    element = flex_children(
                      e, e.children.set(index, event.element))))))
        flex_hover[M](e: FlexElement[M], pos: Position
          ) EventResult[M, FlexElement[M]] =
          flex_hover_children(e, some(pos), 0, 0.0, false)
        # A traversal request can cross nested containers. At a boundary it
        # bubbles outward with the current focus intact; an accepting parent
        # unfocuses the old subtree only after finding a new focus target.
        flex_focus_step[M](e: FlexElement[M], from: Int, step: Int
          ) EventResult[M, FlexElement[M]] =
          loop(from + step, \ index: Int ->
            if index < 0 or index >= e.children.length()
              Loop[Int, EventResult[M, FlexElement[M]]].break(
                if step > 0 EventResult[M, FlexElement[M]].focus_next(e)
                  EventResult[M, FlexElement[M]].focus_previous(e))
              e.children.get(index).focus() %(
                none
                  Loop[Int, EventResult[M, FlexElement[M]]].continue(index + step)
                some(next)
                  Loop[Int, EventResult[M, FlexElement[M]]].break(
                    EventResult[M, FlexElement[M]].request_focus(
                      flex_children(e, e.children.iter().map_indexed(
                        \ i: Int, child: Element[M] ->
                          if i == index next child.unfocus()).to_list())))))
        flex_focus[M](e: FlexElement[M]) Maybe[FlexElement[M]] =
          focused =
            e.children.iter().map(\ child: Element[M] -> child.focused).any()
          if focused some(e)
            loop(0, \ index: Int ->
              if index == e.children.length()
                Loop[Int, Maybe[FlexElement[M]]].break(none[FlexElement[M]]())
                e.children.get(index).focus() %(
                  none Loop[Int, Maybe[FlexElement[M]]].continue(index + 1)
                  some(focused) Loop[Int, Maybe[FlexElement[M]]].break(some(
                    flex_children(
                      e,
                      e.children.iter()
                      . map_indexed(
                        \ i: Int, child: Element[M] ->
                          if i == index
                            focused
                            child.unfocus()).to_list())))))
        flex_impl[M]() WidgetImpl[M, FlexWidget[M], FlexElement[M]] =
          WidgetImpl(
            new = \ w: FlexWidget[M], constraints: Constraints ->
              factors = w.children.factors()
              children = layout_flex(
                w.axis,
                constraints,
                factors,
                \ index: Int, c: Constraints ->
                  w.children.get(index).widget().create_element(c))
              FlexElement(axis = w.axis, constraints, factors, children),
            update = \ e: FlexElement[M], w: FlexWidget[M] ->
              UpdateResult[FlexElement[M]].handled(
                factors = w.children.factors()
                children = layout_flex(
                  w.axis,
                  e.constraints,
                  factors,
                  \ index: Int, c: Constraints ->
                    widget = w.children.get(index).widget()
                    if index < e.children.length()
                      e.children.get(index).new_constraints(c).updated(widget)
                      widget.create_element(c))
                FlexElement(
                  axis = w.axis,
                  constraints = e.constraints,
                  factors,
                  children)),
            new_constraints = \ e: FlexElement[M], next: Constraints ->
              children = layout_flex(
                e.axis,
                next,
                e.factors,
                \ index: Int, c: Constraints ->
                  e.children.get(index).new_constraints(c))
              FlexElement(
                axis = e.axis,
                constraints = next,
                factors = e.factors,
                children),
            hover = \ e: FlexElement[M], pos: Position -> flex_hover(e, pos),
            unhover = \ e: FlexElement[M] ->
              flex_hover_children(e, none[Position](), 0, 0.0, false),
            mouse_pressed = \ e: FlexElement[M], mouse: Position ->
              flex_event(e, mouse, \ child: Element[M], pos: Position ->
                child.mouse_pressed(pos)),
            mouse_released = \ e: FlexElement[M], mouse: Position ->
              flex_event(e, mouse, \ child: Element[M], pos: Position ->
                child.mouse_released(pos)),
            mouse_scrolled =
              \ e: FlexElement[M], mouse: Position, delta: Offset ->
                flex_event(
                  e,
                  mouse,
                  \ child: Element[M], pos: Position ->
                    child.mouse_scrolled(pos, delta)),
            focus = \ e: FlexElement[M] -> flex_focus(e),
            unfocus =
              \ e: FlexElement[M] ->
                flex_children(
                  e,
                  e.children.iter()
                  . map(\ child: Element[M] -> child.unfocus()).to_list()),
            key_pressed =
              \ e: FlexElement[M], key: KeyPressed ->
                flex_event(
                  e,
                  position(0.0, 0.0),
                  \ child: Element[M], pos: Position ->
                    child.key_pressed(key)),
            char_entered = \ e: FlexElement[M], char: CharEntered ->
              flex_event(
                e,
                position(0.0, 0.0),
                \ child: Element[M], pos: Position ->
                  child.char_entered(char)),
            render = \ e: FlexElement[M] ->
              axis = e.axis
              layout = e.children.iter().fold(
                size(0.0, 0.0), list[DrawCommand](),
                \ size: Size, draw: List[DrawCommand], child: Element[M] ->
                  tuple(
                    flex_size(
                      axis,
                      size.main(axis) + child.size.main(axis),
                      max(size.cross(axis), child.size.cross(axis)),),
                    draw.push(draw_transformed(
                      transform_translate(offset(axis, size.main(axis), 0.0)),
                      child.drawing.draw))))
              size = layout.a
              draw = layout.b
              overflows = {
                # Expanded layouts fill the limit exactly. Summing fractional
                # child extents can round slightly above or below that limit.
                # So, instead of just comparing the size to the limit, I
                # explicitly add up all intrinsically sized children.
                intrinsic_size =
                  zip(e.factors.iter(), e.children.iter())
                  . map(\ a: Maybe[Float], b: Element[M] ->
                      if a is none b.size.main(axis) 0.0)
                  . sum()
                intrinsic_size
                  .overflows(e.constraints.main(axis).loosen_min())
              }
              main =
                if
                  e.factors.iter()
                  . map(\ factor: Maybe[Float] -> factor is some)
                  . any()
                  e.constraints.main(axis).max.unwrap()
                  size.main(axis)
              overflow_drawing(
                false,
                false,
                overflows and {e.axis is horizontal},
                overflows and {e.axis is vertical},
                Drawing(
                  draw = draw_all(draw),
                  size = flex_size(axis, main, size.cross(axis))
                    .clamp(e.constraints))))
        flex[M](axis: Axis, children: List[FlexChild[M]]) Widget[M] =
          widget(flex_impl[M](), FlexWidget(axis, children))
        intrinsic[M](child: Widget[M]) FlexChild[M] =
          FlexChild[M].intrinsic(child)
        expanded[M](factor: Float, child: Widget[M]) FlexChild[M] =
          _ = assert(factor > 0.0, "Flex factors must be positive")
          FlexChild[M].expanded(Expanded(factor, child))
        expanded[M](child: Widget[M]) FlexChild[M] = expanded(1.0, child)
        spacer = expanded(empty_widget)
        flex[M](axis: Axis, children: List[Widget[M]]) Widget[M] =
          flex(
            axis,
            children.iter()
              .map(\ child: Widget[M] -> intrinsic(child)).to_list())
    chapter Row
      text
        A row is a horizontal flex. Intrinsic children receive unbounded width
        and the parent's maximum height. Expanded children share the remaining
        width and require a bounded width.
      code
        row[M](children: List[Widget[M]]) Widget[M] =
          flex(Axis.horizontal, children)
        row[M](children: List[FlexChild[M]]) Widget[M] =
          flex(Axis.horizontal, children)
    chapter Column
      text
        A column is a vertical flex. Intrinsic children receive unbounded height
        and the parent's maximum width. Expanded children share the remaining
        height and require a bounded height.
      code
        column[M](children: List[Widget[M]]) Widget[M] =
          flex(Axis.vertical, children)
        column[M](children: List[FlexChild[M]]) Widget[M] =
          flex(Axis.vertical, children)
    chapter ScrollView
      text
        A scroll view makes its single child scrollable, removing the maximum
        constraint on the main-axis. Scrolling propagates to the child first, so
        that inner scroll views scroll first.
      code
        ScrollViewWidget[M] = struct { axis: Axis, child: Widget[M] }
        ScrollViewElement[M] = struct {
          axis: Axis,
          constraints: Constraints,
          child: Element[M],
          scroll: Float}
        scroll_child_constraints(axis: Axis, outer: Constraints) Constraints =
          constraints(
            axis,
            axis_constraints(outer.main(axis).min .. unbounded),
            outer.cross(axis))
        scroll_element[M](
          axis: Axis,
          constraints: Constraints,
          child: Element[M],
          scroll: Float,
          ) ScrollViewElement[M] =
          viewport = child.size.clamp(constraints)
          ScrollViewElement(
            axis,
            constraints,
            child,
            scroll =
              scroll.clamp(
                0.0,
                max(0.0, child.size.main(axis) - viewport.main(axis))))
        scroll_view_child[M](
          e: ScrollViewElement[M], child: Element[M]) ScrollViewElement[M] =
          scroll_element(e.axis, e.constraints, child, e.scroll)
        scroll_view_impl[M](
        ) WidgetImpl[M, ScrollViewWidget[M], ScrollViewElement[M]] =
          WidgetImpl(
            new = \ w: ScrollViewWidget[M], constraints: Constraints ->
              scroll_element(
                w.axis,
                constraints,
                w.child.create_element(
                  scroll_child_constraints(w.axis, constraints)),
                0.0),
            update = \ e: ScrollViewElement[M], w: ScrollViewWidget[M] ->
              UpdateResult[ScrollViewElement[M]].handled(
                scroll_element(
                  w.axis,
                  e.constraints,
                  e.child
                    .new_constraints(
                      scroll_child_constraints(w.axis, e.constraints))
                    .updated(w.child),
                  if e.axis is horizontal
                    if w.axis is horizontal e.scroll 0.0
                    if w.axis is vertical e.scroll 0.0)),
            new_constraints = \ e: ScrollViewElement[M], next: Constraints ->
              scroll_element(
                e.axis,
                next,
                e.child
                  .new_constraints(scroll_child_constraints(e.axis, next)),
                e.scroll),
            hover = \ e: ScrollViewElement[M], pos: Position ->
              e.child.hover(pos + offset(e.axis, e.scroll, 0.0))
              . map(\ child: Element[M] -> scroll_view_child(e, child)),
            unhover = \ e: ScrollViewElement[M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> scroll_view_child(e, child)),
            mouse_pressed = \ e: ScrollViewElement[M], pos: Position ->
              e.child.mouse_pressed(pos + offset(e.axis, e.scroll, 0.0))
              . map(\ child: Element[M] -> scroll_view_child(e, child)),
            mouse_released = \ e: ScrollViewElement[M], pos: Position ->
              e.child.mouse_released(pos + offset(e.axis, e.scroll, 0.0))
              . map(\ child: Element[M] -> scroll_view_child(e, child)),
            mouse_scrolled = \
              e: ScrollViewElement[M], pos: Position, delta: Offset
             ->
              e.child
                .mouse_scrolled(pos + offset(e.axis, e.scroll, 0.0), delta)
                %(
                  handled(child)
                    EventResult[M, ScrollViewElement[M]].handled(
                      scroll_element(e.axis, e.constraints, child, e.scroll))
                  focus_next(child)
                    EventResult[M, ScrollViewElement[M]].focus_next(
                      scroll_view_child(e, child))
                  focus_previous(child)
                    EventResult[M, ScrollViewElement[M]].focus_previous(
                      scroll_view_child(e, child))
                  request_focus(child)
                    EventResult[M, ScrollViewElement[M]].request_focus(
                      scroll_element(e.axis, e.constraints, child, e.scroll))
                  message(event)
                    EventResult[M, ScrollViewElement[M]].message(
                      ElementMessage(
                        message = event.message,
                        element = scroll_view_child(e, event.element)))
                  not_handled
                    amount = e.axis %(horizontal delta.x vertical delta.y)
                    next =
                      scroll_element(
                        e.axis, e.constraints, e.child, e.scroll + amount)
                    if next.scroll == e.scroll
                      EventResult[M, ScrollViewElement[M]].not_handled
                      EventResult[M, ScrollViewElement[M]].handled(next)),
            focus = \ e: ScrollViewElement[M] ->
              e.child.focus().map(\ child: Element[M] -> scroll_view_child(e, child)),
            unfocus = \ e: ScrollViewElement[M] -> scroll_view_child(e, e.child.unfocus()),
            key_pressed = \ e: ScrollViewElement[M], key: KeyPressed ->
              e.child.key_pressed(key)
              . map(\ child: Element[M] -> scroll_view_child(e, child)),
            char_entered = \ e: ScrollViewElement[M], char: CharEntered ->
              e.child.char_entered(char)
              . map(\ child: Element[M] -> scroll_view_child(e, child)),
            render = \ e: ScrollViewElement[M] ->
              viewport = e.child.size.clamp(e.constraints)
              Drawing(
                size = viewport,
                draw = draw_clipped(
                  path().move_to(0.0, 0.0)
                    .line_to(viewport.width, 0.0)
                    .line_to(viewport.width, viewport.height)
                    .line_to(0.0, viewport.height),
                  draw_transformed(
                    transform_translate(offset(e.axis, 0.0 - e.scroll, 0.0)),
                    e.child.drawing.draw))))
        scroll_view[M](axis: Axis, child: Widget[M]) Widget[M] =
          widget(scroll_view_impl[M](), ScrollViewWidget(axis, child))
    chapter Align
      text
        Alignment coordinates range from -1 (left or top) to 1 (right or
        bottom). A zero coordinate centers the child on that axis. Bounded axes
        expand to their maximum; unbounded axes follow the child size.
      code
        AlignWidget[M] = struct { bias: Vec2[Float], child: Widget[M] }
        AlignElement[M] = struct {
          bias: Vec2[Float], child: Element[M], constraints: Constraints
        }
        aligned_size(child: Size, constraints: Constraints) Size =
          size(
            constraints.width.max or child.width,
            constraints.height.max or child.height,
          ).clamp(constraints)
        alignment_offset(
          bias: Vec2[Float], parent: Size, child: Size
        ) Offset =
          offset(
            {parent.width - child.width} * {bias.x + 1.0} / 2.0,
            {parent.height - child.height} * {bias.y + 1.0} / 2.0)
        align_child[M](
          e: AlignElement[M], child: Element[M]) AlignElement[M] =
          AlignElement(bias = e.bias, constraints = e.constraints, child)
        align_impl[M]() WidgetImpl[M, AlignWidget[M], AlignElement[M]] =
          WidgetImpl(
            new = \ w: AlignWidget[M], constraints: Constraints ->
              AlignElement(
                bias = w.bias,
                child = w.child.create_element(constraints.loosen_min()),
                constraints),
            update = \ e: AlignElement[M], w: AlignWidget[M] ->
              UpdateResult[AlignElement[M]].handled(
                AlignElement(
                  bias = w.bias,
                  child = e.child.updated(w.child),
                  constraints = e.constraints)),
            new_constraints = \ e: AlignElement[M], next: Constraints ->
              AlignElement(
                bias = e.bias,
                child = e.child.new_constraints(next.loosen_min()),
                constraints = next),
            hover = \ e: AlignElement[M], pos: Position ->
              e.child.hover(pos - alignment_offset(e.bias,
                aligned_size(e.child.size, e.constraints), e.child.size))
              . map(\ child: Element[M] -> align_child(e, child)),
            unhover = \ e: AlignElement[M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> align_child(e, child)),
            mouse_pressed = \ e: AlignElement[M], pos: Position ->
              shift =
                alignment_offset(
                  e.bias,
                  aligned_size(e.child.size, e.constraints), e.child.size)
              e.child.mouse_pressed(pos - shift)
              . map(\ child: Element[M] -> align_child(e, child)),
            mouse_released = \ e: AlignElement[M], pos: Position ->
              shift =
                alignment_offset(
                  e.bias,
                  aligned_size(e.child.size, e.constraints), e.child.size)
              e.child.mouse_released(pos - shift)
              . map(\ child: Element[M] -> align_child(e, child)),
            mouse_scrolled =
              \ e: AlignElement[M], pos: Position, delta: Offset ->
                shift =
                  alignment_offset(
                    e.bias,
                    aligned_size(e.child.size, e.constraints),
                    e.child.size)
                e.child.mouse_scrolled(pos - shift, delta)
                . map(\ child: Element[M] -> align_child(e, child)),
            focus =
              \ e: AlignElement[M] ->
                e.child.focus()
                . map(\ child: Element[M] -> align_child(e, child)),
            unfocus =
              \ e: AlignElement[M] -> align_child(e, e.child.unfocus()),
            key_pressed = \ e: AlignElement[M], key: KeyPressed ->
              e.child.key_pressed(key)
              . map(\ child: Element[M] -> align_child(e, child)),
            char_entered = \ e: AlignElement[M], char: CharEntered ->
              e.child.char_entered(char)
              . map(\ child: Element[M] -> align_child(e, child)),
            render = \ e: AlignElement[M] ->
              space = aligned_size(e.child.size, e.constraints)
              Drawing(
                draw = draw_transformed(
                  transform_translate(
                    alignment_offset(e.bias, space, e.child.size)),
                  e.child.drawing.draw),
                size = space))
        align[M](
          horizontal: Float, vertical: Float, child: Widget[M]) Widget[M] =
          widget(
            align_impl[M](),
            AlignWidget(bias = vec(horizontal, vertical), child))
        center[M](child: Widget[M]) Widget[M] = align(0.0, 0.0, child)
    chapter StatefulWidget
      text
        Stateful widgets turn internal child messages into either new state or
        an external message for their parent. bubble_up_and_focus rebuilds local
        state and traverses to a neighboring focus target before emitting its
        external message.
      code
        StatefulWidget[S, M, N] = struct {
          initial_state: S,
          handle: fun(S, N) StatefulResult[S, M],
          builder: fun(S) Widget[N]}
        StatefulElement[S, M, N] = struct {
          state: S,
          handle: fun(S, N) StatefulResult[S, M],
          builder: fun(S) Widget[N],
          child: Element[N]}
        StatefulFocusMessage[S, M] = struct { state: S, message: M, step: Int }
        StatefulResult[S, M] = enum {
          new_state: S, bubble_up: M,
          bubble_up_and_focus: StatefulFocusMessage[S, M] }
      code
        new_state[S, M](state: S) StatefulResult[S, M] =
          StatefulResult[S, M].new_state(state)
        bubble_up[S, M](message: M) StatefulResult[S, M] =
          StatefulResult[S, M].bubble_up(message)
        bubble_up_and_focus[S, M](state: S, message: M, step: Int) StatefulResult[S, M] =
          StatefulResult[S, M].bubble_up_and_focus(StatefulFocusMessage(state, message, step))
      code
        stateful_child[S, M, N](
          e: StatefulElement[S, M, N], child: Element[N]
        ) StatefulElement[S, M, N] =
          StatefulElement(
            state = e.state, handle = e.handle, builder = e.builder, child)
        stateful_event[S, M, N](
          e: StatefulElement[S, M, N], result: EventResult[N, Element[N]]
        ) EventResult[M, StatefulElement[S, M, N]] =
          result %(
            not_handled EventResult[M, StatefulElement[S, M, N]].not_handled
            handled(child)
              EventResult[M, StatefulElement[S, M, N]].handled(
                stateful_child(e, child))
            focus_next(child)
              EventResult[M, StatefulElement[S, M, N]].focus_next(stateful_child(e, child))
            focus_previous(child)
              EventResult[M, StatefulElement[S, M, N]].focus_previous(stateful_child(e, child))
            request_focus(child)
              EventResult[M, StatefulElement[S, M, N]].request_focus(
                stateful_child(e, child))
            message(event) stateful_message(e, event.element, event.message))
        stateful_message[S, M, N](
          e: StatefulElement[S, M, N], child: Element[N], value: N
          ) EventResult[M, StatefulElement[S, M, N]] =
          e.handle(e.state, value) %(
            new_state(state)
              EventResult[M, StatefulElement[S, M, N]].handled(
                StatefulElement(
                  state, handle = e.handle, builder = e.builder,
                  child = child.updated(e.builder(state))))
            bubble_up(message)
              EventResult[M, StatefulElement[S, M, N]].message(ElementMessage(
                element = stateful_child(e, child), message))
            bubble_up_and_focus(event)
              updated = child.updated(e.builder(event.state))
              # Use the same traversal as Tab after rebuilding local state,
              # before the owner applies the emitted document change.
              result = updated.key_pressed(KeyPressed(
                keycode = 258, control = false, shift = event.step < 0, alt = false))
              next = result %(
                handled(value) value
                request_focus(value) value
                focus_next(value) value
                focus_previous(value) value
                default updated)
              EventResult[M, StatefulElement[S, M, N]].message(ElementMessage(
                element = StatefulElement(state = event.state,
                  handle = e.handle, builder = e.builder, child = next),
                message = event.message)))
        stateful_impl[S, M, N](
        ) WidgetImpl[M, StatefulWidget[S, M, N], StatefulElement[S, M, N]] =
          WidgetImpl(
            new = \ w: StatefulWidget[S, M, N], constraints: Constraints ->
              StatefulElement(
                state = w.initial_state,
                handle = w.handle,
                builder = w.builder,
                child =
                  w.builder(w.initial_state).create_element(constraints)),
            update =
              \ e: StatefulElement[S, M, N], w: StatefulWidget[S, M, N] ->
                UpdateResult[StatefulElement[S, M, N]].handled(
                  StatefulElement(
                    state = e.state,
                    handle = w.handle,
                    builder = w.builder,
                    child = e.child.updated(w.builder(e.state)))),
            new_constraints =
              \ e: StatefulElement[S, M, N], constraints: Constraints ->
                stateful_child(e, e.child.new_constraints(constraints)),
            hover = \ e: StatefulElement[S, M, N], pos: Position ->
              stateful_event(e, e.child.hover(pos)),
            unhover = \ e: StatefulElement[S, M, N] ->
              stateful_event(e, e.child.unhover()),
            mouse_pressed =
              \ e: StatefulElement[S, M, N], position: Position ->
                stateful_event(e, e.child.mouse_pressed(position)),
            mouse_released =
              \ e: StatefulElement[S, M, N], position: Position ->
                stateful_event(e, e.child.mouse_released(position)),
            mouse_scrolled =
              \ e: StatefulElement[S, M, N], position: Position, delta: Offset
                ->
                stateful_event(e, e.child.mouse_scrolled(position, delta)),
            focus =
              \ e: StatefulElement[S, M, N] ->
                e.child.focus()
                . map(\ child: Element[N] -> stateful_child(e, child)),
            unfocus =
              \ e: StatefulElement[S, M, N] ->
                stateful_child(e, e.child.unfocus()),
            key_pressed =
              \ e: StatefulElement[S, M, N], key: KeyPressed ->
                stateful_event(e, e.child.key_pressed(key)),
            char_entered =
              \ e: StatefulElement[S, M, N], char: CharEntered ->
                stateful_event(e, e.child.char_entered(char)),
            render = \ e: StatefulElement[S, M, N] -> e.child.drawing)
        stateful[S, M, N](
          initial_state: S,
          handle: fun(S, N) StatefulResult[S, M],
          builder: fun(S) Widget[N],
          ) Widget[M] =
          widget(
            stateful_impl[S, M, N](),
            StatefulWidget(initial_state, handle, builder))
    chapter OnClick
      text
        Emits a message on mouse press. Use button for release activation with
        hover feedback and cancellation on unhover.
      code
        OnClickWidget[M] = struct { message: M, child: Widget[M] }
        OnClickElement[M] = struct { message: M, child: Element[M] }
        on_click_child[M](
          e: OnClickElement[M], child: Element[M]) OnClickElement[M] =
          OnClickElement(message = e.message, child)
        on_click_impl[M](
        ) WidgetImpl[M, OnClickWidget[M], OnClickElement[M]] =
          WidgetImpl(
            new = \ w: OnClickWidget[M], constraints: Constraints ->
              OnClickElement(
                message = w.message,
                child = w.child.create_element(constraints)),
            update = \ e: OnClickElement[M], w: OnClickWidget[M] ->
              UpdateResult[OnClickElement[M]].handled(
                OnClickElement(
                  message = w.message, child = e.child.updated(w.child))),
            new_constraints =
              \ e: OnClickElement[M], constraints: Constraints ->
                OnClickElement(
                  message = e.message,
                  child = e.child.new_constraints(constraints)),
            hover = \ e: OnClickElement[M], pos: Position ->
              e.child.hover(pos)
              . map(\ child: Element[M] -> on_click_child(e, child)),
            unhover = \ e: OnClickElement[M] ->
              e.child.unhover()
              . map(\ child: Element[M] -> on_click_child(e, child)),
            mouse_pressed = \ e: OnClickElement[M], pos: Position ->
              result = e.child.mouse_pressed(pos)
              result %(
                not_handled
                  EventResult[M, OnClickElement[M]].message(ElementMessage(
                    element = e, message = e.message))
                default
                  result.map(\ child: Element[M] -> on_click_child(e, child))),
            mouse_released = \ e: OnClickElement[M], pos: Position ->
              e.child.mouse_released(pos)
              . map(\ child: Element[M] -> on_click_child(e, child)),
            mouse_scrolled =
              \ e: OnClickElement[M], pos: Position, delta: Offset ->
                e.child.mouse_scrolled(pos, delta)
                . map(\ child: Element[M] -> on_click_child(e, child)),
            focus = \ e: OnClickElement[M] ->
              e.child.focus()
              . map(\ child: Element[M] -> on_click_child(e, child)),
            unfocus =
              \ e: OnClickElement[M] -> on_click_child(e, e.child.unfocus()),
            key_pressed =
              \ e: OnClickElement[M], key: KeyPressed ->
                e.child.key_pressed(key)
                . map(\ child: Element[M] -> on_click_child(e, child)),
            char_entered =
              \ e: OnClickElement[M], char: CharEntered ->
                e.child.char_entered(char)
                . map(\ child: Element[M] -> on_click_child(e, child)),
            render = \ e: OnClickElement[M] -> e.child.drawing)
        on_click[M](message: M, child: Widget[M]) Widget[M] =
          widget(on_click_impl[M](), OnClickWidget(message, child))
    chapter EditableText
      text
        Editable text is... an editable text. The widget emits the complete new
        string after each edit.
      text
        The cursor contains these pieces of state:
      text
        - anchor: an offset in the char list
      text
        - active: an offset in the char list
      text
        - desired_x: the cursor's desired x position in pixels
      text
        If the cursor is not selecting something, the anchor and active offset
        are the same. If the cursor is selecting something, the anchor and
        active offset differ – anchor is the part where you started the
        selection and active is the part that moves on shift+left/right.
      text
        The desired x position is updated when the cursor moves left or right,
        but not when it's moved up or down. This allows to cursor to remember
        where it wants to be: If you move up several lines, the cursor will not
        slowly drift afar, but stay roughly where it was. Even when a much
        shorter (or empty) line is in between, it will just jump back to its
        original x position on the next line.
      code
        TextCursor = struct { anchor: Int, active: Int, desired_x: Float }
      text
        A selection can run in either direction. start and end put its offsets
        in order so replacement and drawing can use the same range.
      code
        start(cursor: TextCursor) Int = min(cursor.anchor, cursor.active)
        end(cursor: TextCursor) Int = max(cursor.anchor, cursor.active)
      text
        The element caches the string, its chars, glyph layout, and cursor
        positions. Text edits and width changes rebuild these together. Cursor,
        selection, and focus changes reuse the caches; they do not decode or lay
        out the text again.
      code
        EditableTextElement = struct {
          value: String,
          chars: List[Char],
          layout: TextLayout,
          positions: List[Position],
          cursor: TextCursor,
          active: Bool,
          constraints: Constraints }
      text
        Cursor offsets count chars, but clicks and drawings use pixels.
        text_cursor_positions maps every insertion offset to a position,
        including offsets after newlines. text_cursor_pick finds the nearest
        line first, then the nearest horizontal position on that line.
      code
        TextCursorLayout = struct {
          glyph_index: Int, position: Position, positions: List[Position] }
        text_cursor_positions(chars: List[Char], layout: TextLayout
          ) List[Position] =
          glyphs = layout.glyphs
          chars.iter().fold(
            TextCursorLayout(
              glyph_index = 0, position = position(0.0, 0.0),
              positions = list(position(0.0, 0.0))),
            \ state: TextCursorLayout, character: Char ->
              code = character.codepoint
              next = if code == 10
                position(0.0, state.position.y + text_line_height)
                identity(
                  glyph = glyphs.get(state.glyph_index)
                  position(glyph.position.x + glyph.glyph.width + 1.0,
                    glyph.position.y))
              TextCursorLayout(
                glyph_index = state.glyph_index + if code == 10 0 1,
                position = next, positions = state.positions.push(next)))
            . positions
        text_cursor_pick(positions: List[Position], target: Position) Int =
          positions.iter().indexed()
          . fold(
              0,
              \ best: Int, item: Indexed[Position] ->
                previous = positions.get(best)
                dy = abs(item.item.y - target.y)
                best_dy = abs(previous.y - target.y)
                if dy < best_dy or
                  {dy == best_dy
                    and abs(item.item.x - target.x)
                      < abs(previous.x - target.x)}
                  item.index best)
      text
        update_chars rebuilds the text-dependent data together so every cached
        position agrees with the chars and glyphs. update_cursor and
        update_focus copy these caches without doing any text work.
      code
        editable_build(
          chars: List[Char], cursor: TextCursor, active: Bool,
          constraints: Constraints) EditableTextElement =
          layout = layout_text(chars, constraints.width.max)
          positions = text_cursor_positions(chars, layout)
          offset = max(0, min(cursor.active, chars.length()))
          EditableTextElement(
            value = string(chars),
            chars,
            layout,
            positions,
            active,
            constraints,
            cursor = TextCursor(
              anchor = max(0, min(cursor.anchor, chars.length())),
              active = offset,
              desired_x =
                if offset == cursor.active
                  cursor.desired_x
                  positions.get(offset).x))
        editable_local_state(
          e: EditableTextElement, cursor: TextCursor, active: Bool
          ) EditableTextElement =
          EditableTextElement(
            value = e.value,
            chars = e.chars,
            layout = e.layout,
            positions = e.positions,
            constraints = e.constraints,
            cursor,
            active)
        update_chars(
          e: EditableTextElement, chars: List[Char], cursor: TextCursor
          ) EditableTextElement =
          editable_build(chars, cursor, e.active, e.constraints)
        update_cursor(
          e: EditableTextElement, cursor: TextCursor) EditableTextElement =
          editable_local_state(e, cursor, e.active)
        update_focus(
          e: EditableTextElement, active: Bool) EditableTextElement =
          editable_local_state(e, e.cursor, active)
      text
        Moving the cursor clamps its offset to the char list and remembers its
        horizontal position. Extending a selection preserves the anchor; an
        ordinary move places both ends at the new offset.
      code
        text_cursor_at(
          e: EditableTextElement, offset: Int, extend: Bool
          ) EditableTextElement =
          positions = e.positions
          active = max(0, min(offset, positions.length() - 1))
          e.update_cursor(
            TextCursor(
              anchor = if extend e.cursor.anchor active,
              active,
              desired_x = positions.get(active).x))
      text
        Typing, deletion, and replacing a selection all replace a range of
        chars. editable_replace splices the list, rebuilds the caches, and
        places the cursor after the inserted chars. The parent receives the
        resulting string along with the updated element.
      code
        editable_replace(
          e: EditableTextElement, start: Int, end: Int, inserted: List[Char]
          ) EventResult[String, EditableTextElement] =
          chars =
            e.chars.first(start).push_all(inserted)
            . push_all(e.chars.without_first(end))
          next =
            text_cursor_at(
              e.update_chars(chars, e.cursor),
              start + inserted.length(),
              false)
          EventResult.message(
            ElementMessage(message = next.value, element = next))
      text
        Control with an arrow or deletion key moves across groups of word
        characters and punctuation, skipping leading spaces. Home and End
        instead find a newline boundary in the string, independently of how the
        text wraps on screen.
      code
        is_text_word_char(character: Char) Bool =
          code = character.codepoint
          {code >= 65 and code <= 90} or {code >= 97 and code <= 122}
            or {code >= 48 and code <= 57} or code == 95 or code >= 128
        text_word_skip(chars: List[Char], index: Int, direction: Int, kind: Int) Int =
          if index < 0 or index >= chars.length() 0
            identity(
              code = chars.get(index).codepoint
              current =
                if code == 32 0 if chars.get(index).is_text_word_char() 1 2
              if current != kind 0
                1 + text_word_skip(chars, index + direction, direction, kind))
        text_word_distance(chars: List[Char], index: Int, direction: Int) Int =
          if index < 0 or index >= chars.length() 0
            identity(
              code = chars.get(index).codepoint
              if code == 32
                1 + text_word_distance(chars, index + direction, direction)
                if chars.get(index).is_text_word_char()
                  text_word_skip(chars, index, direction, 1)
                  identity(
                    punctuation = text_word_skip(chars, index, direction, 2)
                    if punctuation > 1
                      punctuation
                      1 + text_word_skip(chars, index + direction, direction, 1)))
        text_line_boundary(chars: List[Char], offset: Int, direction: Int) Int =
          index = if direction < 0 offset - 1 offset
          if index < 0 or index >= chars.length() offset
            if chars.get(index).codepoint == 10 offset
              text_line_boundary(chars, offset + direction, direction)
      text
        Key presses use these keycodes to identify keys. Character input arrives
        separately, so typing text does not depend on keycodes.
      code
        key_a = 65
        key_escape = 256
        key_tab = 258
        key_enter = 257
        key_backspace = 259
        key_delete = 261
        key_arrow_right = 262
        key_arrow_left = 263
        key_arrow_down = 264
        key_arrow_up = 265
        key_home = 268
        key_end = 269
      text
        Keyboard handling combines these operations. Shift extends a selection,
        ordinary left/right movement collapses it, and up/down movement keeps
        the desired horizontal position across short lines. Cursor-only changes
        update the element; edits also notify the parent.
      code
        editable_key(e: EditableTextElement, key: KeyPressed
          ) EventResult[String, EditableTextElement] =
          chars = e.chars
          start = e.cursor.start()
          end = e.cursor.end()
          selected = start != end
          code = key.keycode
          if key.alt EventResult[String, EditableTextElement].not_handled
          if key.control and code == key_a
            EventResult[String, EditableTextElement].handled(
              text_cursor_at(text_cursor_at(e, 0, false), chars.length(), true))
          if code == key_enter and not(key.shift)
            identity(
              offset = text_line_boundary(chars, e.cursor.active, 1)
              if key.control editable_replace(e, offset, offset, list(char(10)))
                editable_replace(e, start, end, list(char(10))))
          if {code == key_backspace or code == key_delete} and not(key.shift)
            identity(
              from = if selected start
                if code == key_backspace
                  if key.control
                    e.cursor.active
                      - text_word_distance(chars, e.cursor.active - 1, -1)
                    max(0, e.cursor.active - 1)
                  e.cursor.active
              to = if selected end
                if code == key_delete
                  if key.control
                    e.cursor.active
                      + text_word_distance(chars, e.cursor.active, 1)
                    min(chars.length(), e.cursor.active + 1)
                  e.cursor.active
              if from == to EventResult[String, EditableTextElement].handled(e)
                editable_replace(e, from, to, list[Char]()))
          if code == key_arrow_right or code == key_arrow_left
            identity(
              right = code == key_arrow_right
              offset =
                if key.control
                  if right
                    e.cursor.active
                      + text_word_distance(chars, e.cursor.active, 1)
                    e.cursor.active
                      - text_word_distance(chars, e.cursor.active - 1, -1)
                  if selected and not(key.shift) {if right end start}
                    e.cursor.active + if right 1 {0 - 1}
              EventResult[String, EditableTextElement].handled(
                text_cursor_at(e, offset, key.shift)))
          if code == key_home or code == key_end
            identity(
              offset = if key.control {if code == key_home 0 chars.length()}
                text_line_boundary(
                  chars, e.cursor.active, if code == key_home {0 - 1} 1)
              EventResult[String, EditableTextElement].handled(
                text_cursor_at(e, offset, key.shift)))
          if {code == key_arrow_down or code == key_arrow_up}
              and not(key.control)
            identity(
              positions = e.positions
              current = positions.get(e.cursor.active)
              y =
                current.y
                  + if code == key_arrow_down
                      text_line_height
                      0.0 - text_line_height
              offset = if y < 0.0 0
                if y > positions.get(positions.length() - 1).y chars.length()
                  text_cursor_pick(positions, position(e.cursor.desired_x, y))
              next = text_cursor_at(e, offset, key.shift)
              EventResult[String, EditableTextElement].handled(
                e.update_cursor(TextCursor(
                  anchor = next.cursor.anchor,
                  active = next.cursor.active,
                  desired_x = e.cursor.desired_x))))
          EventResult[String, EditableTextElement].not_handled
      text
        A collapsed selection is drawn as a narrow caret. A selection highlights
        its glyphs and fills the rest of a line when it crosses a newline or
        wrap. The widget draws this highlight behind the text.
      code
        TextSelectionLayout = struct {
          glyph_index: Int, draws: List[DrawCommand] }
        editable_highlight(pos: Position, width: Float) DrawCommand =
          draw_transformed(
            transform_translate(pos.to_vec().to_offset()),
            draw_colored_rect(
              size(max(1.0, width), text_line_height),
              color("#ffcb10")))
        editable_cursor_draw(e: EditableTextElement) DrawCommand =
          positions = e.positions
          start = start(e.cursor)
          end = end(e.cursor)
          if start == end editable_highlight(positions.get(start), 2.0)
            identity(
              layout = e.layout
              width = e.constraints.width.max or {layout.size.width + 2.0}
              selection = e.chars.iter().indexed().fold(
                TextSelectionLayout(
                  glyph_index = 0,
                  draws = list[DrawCommand]()),
                  \ state: TextSelectionLayout, item: Indexed[Char] ->
                    newline = item.item.codepoint == 10
                    draw =
                      if item.index < start or item.index >= end
                        draw_nothing()
                        identity(
                          before = positions.get(item.index)
                          if newline
                            editable_highlight(before, width - before.x)
                            identity(
                              glyph = layout.glyphs.get(state.glyph_index)
                              draw_all(list(
                                if glyph.position.y > before.y
                                  editable_highlight(before, width - before.x)
                                  draw_nothing(),
                                editable_highlight(
                                  glyph.position, glyph.glyph.width + 1.0)))))
                    TextSelectionLayout(
                      glyph_index = state.glyph_index + if newline 0 1,
                      draws = state.draws.push(draw)))
              draw_all(selection.draws))
      text
        The widget connects editing to the element lifecycle. Clicking positions
        the cursor and requests focus; focus controls whether the cursor is
        visible. Parent updates replace the chars and clamp both selection
        endpoints, while preserving the remaining local state.
      code
        editable_text_impl(
          ) WidgetImpl[String, List[Char], EditableTextElement] =
          WidgetImpl(
            new = \ chars: List[Char], constraints: Constraints ->
              editable_build(
                chars,
                TextCursor(anchor = 0, active = 0, desired_x = 0.0),
                false,
                constraints),
            update = \ e: EditableTextElement, chars: List[Char] ->
              same = e.chars.length() == chars.length() and
                zip(e.chars.iter(), chars.iter()).all(
                  \ pair: Tuple2[Char, Char] -> pair.a == pair.b)
              if same UpdateResult[EditableTextElement].not_handled
                UpdateResult[EditableTextElement].handled(e.update_chars(chars, e.cursor)),
            new_constraints =
              \ e: EditableTextElement, constraints: Constraints ->
                if constraints.width == e.constraints.width
                  EditableTextElement(
                    value = e.value,
                    chars = e.chars,
                    layout = e.layout,
                    positions = e.positions,
                    cursor = e.cursor,
                    active = e.active,
                    constraints)
                  editable_build(e.chars, e.cursor, e.active, constraints),
            hover = \ e: EditableTextElement, pos: Position ->
              EventResult[String, EditableTextElement].not_handled,
            unhover = \ e: EditableTextElement ->
              EventResult[String, EditableTextElement].not_handled,
            mouse_pressed =
              \ e: EditableTextElement, pos: Position ->
                EventResult[String, EditableTextElement].request_focus(
                  text_cursor_at(
                    e, text_cursor_pick(e.positions, pos), false)),
            mouse_released = \ e: EditableTextElement, pos: Position ->
              EventResult[String, EditableTextElement].not_handled,
            mouse_scrolled =
              \ e: EditableTextElement, pos: Position, delta: Offset ->
                EventResult[String, EditableTextElement].not_handled,
            focus = \ e: EditableTextElement -> some(e.update_focus(true)),
            unfocus = \ e: EditableTextElement -> e.update_focus(false),
            key_pressed =
              \ e: EditableTextElement, key: KeyPressed ->
                editable_key(e, key),
            char_entered =
              \ e: EditableTextElement, event: CharEntered ->
                code = event.codepoint
                if
                  code < 32
                    or code == 127
                    or code > 1114111
                    or {code >= 55296 and code <= 57343}
                  EventResult[String, EditableTextElement].not_handled
                  editable_replace(
                    e, start(e.cursor), end(e.cursor), list(char(code))),
            render = \ e: EditableTextElement ->
              drawing = e.layout.draw_text(color("#000000"))
              Drawing(
                size =
                  size(
                    max(2.0, drawing.size.width + 2.0),
                    max(text_line_height, drawing.size.height))
                  . clamp(e.constraints),
                draw = draw_all(list(
                  if e.active editable_cursor_draw(e) draw_nothing(),
                  drawing.draw))))
        editable_text(chars: List[Char]) Widget[String] =
          widget(editable_text_impl(), chars)
        editable_text(value: String) Widget[String] =
          editable_text(value.chars())
    chapter Keysink
      text
        Click a keysink to focus it. It displays key presses as bracketed names,
        including modifiers.
      code
        key_name(key: KeyPressed) String =
          code = key.keycode
          if code == 32 "space"
            if code >= 65 and code <= 90
              string(list({if key.shift code code + 32}.to_byte()))
              if code >= 32 and code <= 126
                if key.shift
                  identity(
                    plain = "1234567890-=[]\\;',./`".bytes()
                    shifted = "!@#$%^&*()_+\{\}|:\"<>?~".bytes()
                    index = plain.iter()
                      . fold(
                          0,
                          none[Int](),
                          \ index: Int, found: Maybe[Int], byte: Byte ->
                            tuple(
                              index + 1,
                              if byte.to_int() == code some(index) found))
                      . b
                    string(list(
                      index %(some(i) shifted.get(i) none code.to_byte()))))
                  string(list(code.to_byte()))
                if code >= 290 and code <= 314 "f" + {code - 289}.format()
                  if code >= 256 and code <= 269
                    list(
                      "escape", "enter", "tab", "backspace", "insert",
                      "delete", "right", "left", "down", "up", "page up",
                      "page down", "home", "end")
                    . get(code - 256)
                    "key " + code.format()
        format(key: KeyPressed) String =
          "[" + {if key.control "ctrl " ""}
            + {if key.alt "alt " ""}
            + {if key.shift
                and {key.keycode < 32 or key.keycode > 126} "shift " ""}
            + key.key_name() + "]"
        KeysinkElement = struct {
          value: String, active: Bool, constraints: Constraints }
        keysink_impl() WidgetImpl[Never, Nothing, KeysinkElement] =
          WidgetImpl(
            new =
              \ w: Nothing, constraints: Constraints ->
                KeysinkElement(value = "", active = false, constraints),
            update =
              \ e: KeysinkElement, w: Nothing ->
                UpdateResult[KeysinkElement].not_handled,
            new_constraints =
              \ e: KeysinkElement, constraints: Constraints ->
                KeysinkElement(
                  value = e.value, active = e.active, constraints),
            focus =
              \ e: KeysinkElement ->
                some(KeysinkElement(
                  value = e.value,
                  active = true,
                  constraints = e.constraints)),
            unfocus =
              \ e: KeysinkElement ->
                KeysinkElement(
                  value = e.value,
                  active = false,
                  constraints = e.constraints),
            hover = \ e: KeysinkElement, pos: Position ->
              EventResult[Never, KeysinkElement].not_handled,
            unhover = \ e: KeysinkElement ->
              EventResult[Never, KeysinkElement].not_handled,
            mouse_pressed =
              \ e: KeysinkElement, pos: Position ->
                EventResult[Never, KeysinkElement].request_focus(
                  KeysinkElement(
                    value = e.value,
                    active = true,
                    constraints = e.constraints)),
            mouse_released = \ e: KeysinkElement, pos: Position ->
              EventResult[Never, KeysinkElement].not_handled,
            mouse_scrolled =
              \ e: KeysinkElement, pos: Position, delta: Offset ->
                EventResult[Never, KeysinkElement].not_handled,
            key_pressed =
              \ e: KeysinkElement, key: KeyPressed ->
                if key.keycode >= 340 and key.keycode <= 348
                  EventResult[Never, KeysinkElement].not_handled
                  EventResult[Never, KeysinkElement].handled(
                    KeysinkElement(
                      value = e.value + key.format(),
                      active = e.active,
                      constraints = e.constraints)),
            char_entered =
              \ e: KeysinkElement, char: CharEntered ->
                EventResult[Never, KeysinkElement].not_handled,
            render = \ e: KeysinkElement ->
              colored(color(if e.active "#d0e8ff" "#eeeeee"),
                padding(6.0,
                  text(
                    if e.value.bytes().length() == 0
                      "Click here, then type"
                      e.value)))
                .create_element(e.constraints).drawing)
        keysink() Widget[Never] = widget(keysink_impl(), Nothing())
    chapter Button
      text
        Buttons are widgets you can click. They have hover and press effects so
        it seems like the child sinks into the screen when you click on it.
      code
        ButtonWidget[M] = struct {
          message: M, color: Color, child: Widget[M] }
        ButtonElement[M] = struct {
          message: M,
          color: Color,
          child: Element[M],
          hovered: Bool,
          pressed: Bool }
        button_shade(base: Color, factor: Float) Color =
          color(
            {base.r.to_int().to_float() * factor}.to_int().to_byte(),
            {base.g.to_int().to_float() * factor}.to_int().to_byte(),
            {base.b.to_int().to_float() * factor}.to_int().to_byte())
        button_child[M](
          e: ButtonElement[M], child: Element[M]) ButtonElement[M] =
          ButtonElement(
            message = e.message,
            color = e.color,
            child,
            hovered = e.hovered,
            pressed = e.pressed)
        button_state[M](
          e: ButtonElement[M], hovered: Bool, pressed: Bool
          ) ButtonElement[M] =
          ButtonElement(
            message = e.message,
            color = e.color,
            child = e.child,
            hovered,
            pressed)
        button_contains[M](e: ButtonElement[M], pos: Position) Bool =
          rectangle(position(0.0, 0.0), e.child.size).contains(pos)
            and rounded_rect_contains(6.0, e.child.size, pos)
        button_hover[M](e: ButtonElement[M], pos: Maybe[Position]
          ) EventResult[M, ButtonElement[M]] =
          inside = pos %(none false some(point) button_contains(e, point))
          next = button_state(e, inside, inside and e.pressed)
          result = pos %(
            some(point) if inside e.child.hover(point) e.child.unhover()
            none e.child.unhover())
          mapped = result.map(\ child: Element[M] -> button_child(next, child))
          if {mapped is not_handled}
            and {{next.hovered != e.hovered} or {next.pressed != e.pressed}}
            EventResult[M, ButtonElement[M]].handled(next)
            mapped
        button_impl[M]() WidgetImpl[M, ButtonWidget[M], ButtonElement[M]] =
          WidgetImpl(
            new = \ w: ButtonWidget[M], constraints: Constraints ->
              ButtonElement(
                message = w.message,
                color = w.color,
                child = w.child.create_element(constraints),
                hovered = false,
                pressed = false),
            update = \ e: ButtonElement[M], w: ButtonWidget[M] ->
              UpdateResult[ButtonElement[M]].handled(
                ButtonElement(message = w.message, color = w.color,
                  child = e.child.updated(w.child),
                  hovered = e.hovered,
                  pressed = e.pressed)),
            new_constraints =
              \ e: ButtonElement[M], constraints: Constraints ->
                button_child(e, e.child.new_constraints(constraints)),
            hover = \ e: ButtonElement[M], pos: Position ->
              button_hover(e, some(pos)),
            unhover = \ e: ButtonElement[M] ->
              button_hover(e, none[Position]()),
            mouse_pressed = \ e: ButtonElement[M], pos: Position ->
              if button_contains(e, pos)
                identity(
                  result = e.child.mouse_pressed(pos)
                  result %(
                    not_handled
                      EventResult[M, ButtonElement[M]].request_focus(
                        button_state(e, true, true))
                    default
                      result
                      . map(\ child: Element[M] -> button_child(e, child))))
                EventResult[M, ButtonElement[M]].not_handled,
            mouse_released = \ e: ButtonElement[M], pos: Position ->
              if e.pressed and button_contains(e, pos)
                EventResult[M, ButtonElement[M]].message(ElementMessage(
                  element = button_state(e, e.hovered, false),
                  message = e.message))
                e.child.mouse_released(pos)
                . map(\ child: Element[M] -> button_child(e, child)),
            mouse_scrolled =
              \ e: ButtonElement[M], pos: Position, delta: Offset ->
                e.child.mouse_scrolled(pos, delta)
                . map(\ child: Element[M] -> button_child(e, child)),
            focus = \ e: ButtonElement[M] -> some(e),
            unfocus = \ e: ButtonElement[M] ->
              button_child(
                button_state(e, e.hovered, false), e.child.unfocus()),
            key_pressed = \ e: ButtonElement[M], key: KeyPressed ->
              e.child.key_pressed(key)
              . map(\ child: Element[M] -> button_child(e, child)),
            char_entered = \ e: ButtonElement[M], char: CharEntered ->
              e.child.char_entered(char)
              . map(\ child: Element[M] -> button_child(e, child)),
            render = \ e: ButtonElement[M] ->
              Drawing(size = e.child.size,
                draw = draw_clipped(rounded_rect_path(6.0, e.child.size),
                  draw_all(list(
                    draw_colored_rect(e.child.size,
                      button_shade(
                        e.color, if e.pressed 0.90 if e.hovered 0.96 1.0)),
                    if e.pressed
                      draw_colored_rect(
                        size(e.child.size.width, 2.0),
                        button_shade(e.color, 0.70))
                      draw_nothing(),
                    draw_transformed(
                      transform_translate(offset(0.0, if e.pressed 2.0 0.0)),
                      e.child.drawing.draw))))))
        button[M](message: M, color: Color, child: Widget[M]) Widget[M] =
          widget(button_impl[M](), ButtonWidget(message, color, child))
    chapter Focus node
      text
        A focus node can focus its child or select the whole item. Its builder
        draws the selection highlight. Optional activation, move, and escape
        messages let cells, titles, and breadcrumbs share keyboard handling.
        Escape first leaves the editor; when already selected, it emits the
        escape message if one is provided.
      code
        FocusNodeWidget[M] = struct {
          builder: fun(Bool) Widget[M], activate: Maybe[M],
          move: Maybe[fun(Int) M], escape: Maybe[M] }
        FocusNodeElement[M] = struct {
          widget: FocusNodeWidget[M], child: Element[M], selected: Bool }
        focus_node_child[M](e: FocusNodeElement[M], child: Element[M]
          ) FocusNodeElement[M] =
          FocusNodeElement(widget = e.widget, child, selected = e.selected)
        focus_node_selected[M](e: FocusNodeElement[M], selected: Bool
          ) FocusNodeElement[M] =
          child = if selected e.child.unfocus() e.child
          FocusNodeElement(widget = e.widget, selected,
            child = child.updated(e.widget.builder(selected)))
      chapter Keyboard selection
        code
          focus_node_key[M](e: FocusNodeElement[M], key: KeyPressed
            ) EventResult[M, FocusNodeElement[M]] =
            code = key.keycode
            if code == key_escape
              if e.selected
                e.widget.escape %(
                  some(message)
                    EventResult[M, FocusNodeElement[M]].message(ElementMessage(element = e, message))
                  none EventResult[M, FocusNodeElement[M]].not_handled)
                EventResult[M, FocusNodeElement[M]].handled(focus_node_selected(e, true))
            if e.selected and key.alt and not(key.control) and
                {code == key_arrow_up or code == key_arrow_down}
              e.widget.move %(
                none EventResult[M, FocusNodeElement[M]].handled(e)
                some(move)
                  EventResult[M, FocusNodeElement[M]].message(ElementMessage(
                    element = e, message = move(if code == key_arrow_up {0 - 1} 1))))
            if not(key.alt) and not(key.control) and
                {code == key_tab or
                  {e.selected and {code == key_arrow_down or code == key_arrow_up}}}
              if {code == key_tab and key.shift} or code == key_arrow_up
                EventResult[M, FocusNodeElement[M]].focus_previous(e)
                EventResult[M, FocusNodeElement[M]].focus_next(e)
            if e.selected and code == key_enter and not(key.alt) and not(key.control)
              identity(
                next = focus_node_selected(e, false)
                next.child.focus() %(
                  some(child)
                    EventResult[M, FocusNodeElement[M]].handled(focus_node_child(next, child))
                  none
                    e.widget.activate %(
                      some(message)
                        EventResult[M, FocusNodeElement[M]].message(ElementMessage(element = e, message))
                      none EventResult[M, FocusNodeElement[M]].handled(e))))
            if e.selected EventResult[M, FocusNodeElement[M]].not_handled
              e.child.key_pressed(key)
                . map(\ child: Element[M] -> focus_node_child(e, child))
      chapter Selection lifecycle
        code
          focus_node_impl[M](
            ) WidgetImpl[M, FocusNodeWidget[M], FocusNodeElement[M]] =
            WidgetImpl(
              new = \ w: FocusNodeWidget[M], constraints: Constraints ->
                FocusNodeElement(widget = w, selected = false,
                  child = w.builder(false).create_element(constraints)),
              update = \ e: FocusNodeElement[M], w: FocusNodeWidget[M] ->
                UpdateResult[FocusNodeElement[M]].handled(
                  FocusNodeElement(widget = w, selected = e.selected,
                    child = e.child.updated(w.builder(e.selected)))),
              new_constraints = \ e: FocusNodeElement[M], constraints: Constraints ->
                focus_node_child(e, e.child.new_constraints(constraints)),
              hover = \ e: FocusNodeElement[M], pos: Position ->
                e.child.hover(pos).map(\ child: Element[M] -> focus_node_child(e, child)),
              unhover = \ e: FocusNodeElement[M] ->
                e.child.unhover().map(\ child: Element[M] -> focus_node_child(e, child)),
              mouse_pressed = \ e: FocusNodeElement[M], pos: Position ->
                next = focus_node_selected(e, false)
                result = next.child.mouse_pressed(pos)
                result %(
                  not_handled
                    EventResult[M, FocusNodeElement[M]].request_focus(focus_node_selected(e, true))
                  default
                    result.map(\ child: Element[M] -> focus_node_child(next, child))),
              mouse_released = \ e: FocusNodeElement[M], pos: Position ->
                e.child.mouse_released(pos).map(\ child: Element[M] -> focus_node_child(e, child)),
              mouse_scrolled = \ e: FocusNodeElement[M], pos: Position, delta: Offset ->
                e.child.mouse_scrolled(pos, delta).map(\ child: Element[M] -> focus_node_child(e, child)),
              focus = \ e: FocusNodeElement[M] ->
                some(if e.child.focused e focus_node_selected(e, true)),
              unfocus = \ e: FocusNodeElement[M] ->
                focus_node_selected(focus_node_child(e, e.child.unfocus()), false),
              key_pressed = \ e: FocusNodeElement[M], key: KeyPressed -> focus_node_key(e, key),
              char_entered = \ e: FocusNodeElement[M], char: CharEntered ->
                e.child.char_entered(char).map(\ child: Element[M] -> focus_node_child(e, child)),
              render = \ e: FocusNodeElement[M] -> e.child.drawing)
          focus_node[M](builder: fun(Bool) Widget[M], activate: Maybe[M],
            move: Maybe[fun(Int) M], escape: Maybe[M]) Widget[M] =
            widget(focus_node_impl[M](), FocusNodeWidget(builder, activate, move, escape))
          focus_node[M](builder: fun(Bool) Widget[M], activate: Maybe[M],
            move: Maybe[fun(Int) M]) Widget[M] =
            focus_node(builder, activate, move, none[M]())
          focus_node[M](builder: fun(Bool) Widget[M], activate: Maybe[M]) Widget[M] =
            focus_node(builder, activate, none[fun(Int) M]())
    chapter Counter example
      code
        counter() Widget[Never] =
          stateful[Int, Never, Int](
            0,
            \ state: Int, change: Int ->
              new_state[Int, Never](state + change),
            \ state: Int ->
              row(list(
                button(-1, color("#e0b040"),
                  padding(6.0, text("decrement")).cast_message[Int]()),
                sized_box(40.0,
                  text_line_height + 12.0, center(text(state.format())))
                . cast_message[Int](),
                button(1, color("#30a080"),
                  padding(6.0, text("increment")).cast_message[Int]()))))
  chapter Notebook
    text
      The notebook widgets browse and edit the document supplied by the host.
      Paths locate the visible chapter; cell and chapter widgets handle editing
      and navigation, while the app sends explicit save commands.
    chapter Notebook paths
      text
        Paths locate a chapter in the tree using a list of cell indices.
      code
        NotebookPath = struct { indices: List[Int] }
      code
        notebook_path() NotebookPath =
          NotebookPath(indices = list[Int]())
      code
        is_empty(path: NotebookPath) Bool = path.indices.is_empty()
      code
        first(path: NotebookPath) Int = path.indices.first()
      code
        without_first(path: NotebookPath) NotebookPath =
          NotebookPath(indices = path.indices.without_first())
      code
        push(path: NotebookPath, index: Int) NotebookPath =
          NotebookPath(indices = path.indices.push(index))
      code
        parent(path: NotebookPath) Maybe[NotebookPath] =
          if path.is_empty() none[NotebookPath]()
            some(NotebookPath(indices = path.indices.without_last()))
      code
        ==(a: NotebookPath, b: NotebookPath) Bool =
          a.indices.length() == b.indices.length() and
            zip(a.indices.iter(), b.indices.iter())
            . all(\ pair: Tuple2[Int, Int] -> pair.a == pair.b)
      code
        get(root: Chapter, path: NotebookPath) Chapter =
          if path.is_empty()
            root
            root.children.get(path.first()) %(
              chapter(child) child.get(path.without_first())
              default crash("Chapter path points to a non-chapter cell."))
      code
        replace_chapter(
          root: Chapter, path: NotebookPath, updated: Chapter) Chapter =
          if path.is_empty()
            updated
            identity(
              index = path.first()
              child = root.children.get(index) %(
                chapter(child) child
                default crash("Chapter path points to a non-chapter cell."))
              Chapter(
                title = root.title,
                children =
                  root.children.set(
                    index,
                    Cell.chapter(child.replace_chapter(
                      path.without_first(), updated)))))
    chapter Cell widget
      text
        A cell can focus its editor or select its entire contents. Clicking text
        enters the editor; Escape selects the cell, and a second Escape opens
        the parent chapter when one exists. Selected cells have a darker
        background. Tab and arrows navigate; Enter returns to editing (or opens
        a chapter), and Alt+Up/Down asks the parent to move the cell.
      code
        CellMessage = enum {
          changed: Cell, navigate: NotebookPath, move: Int }
      chapter Cell contents
        code
          cell_content(cell: Cell, path: NotebookPath, focused: Bool
            ) Widget[CellMessage] =
            cell %(
              text(value)
                rounded_rect(8.0,
                  colored(color(if focused "#e5e5e5" "#ffffff"),
                    width_box(10000.0,
                      padding(8.0, 0.0, 8.0, 0.0,
                        editable_text(value)
                        . map_message(\ updated: String ->
                            CellMessage.changed(Cell.text(updated)))))))
              code(value)
                rounded_rect(8.0,
                  colored(color(if focused "#e4c8b2" "#f9dec8"),
                    width_box(10000.0,
                      padding(8.0,
                        editable_text(value)
                        . map_message(\ updated: String ->
                            CellMessage.changed(Cell.code(updated)))))))
              chapter(child)
                on_click(CellMessage.navigate(path),
                  rounded_rect(8.0,
                    colored(color(if focused "#bfd5b3" "#d8edcc"),
                      width_box(10000.0, padding(8.0, text(child.title)))))
                    . cast_message[CellMessage]()))
      code
        cell_kind(cell: Cell) Int =
          cell %(text 0 code 1 chapter 2)
        cell_widget(cell: Cell, path: NotebookPath, revision: Int) Widget[CellMessage] =
          escape = path.parent() %(
            none none[CellMessage]()
            some(chapter_path)
              chapter_path.parent().map(\ destination: NotebookPath -> CellMessage.navigate(destination)))
          focus_node(
            \ focused: Bool ->
              key_widget(revision,
                key_widget(cell_kind(cell), cell_content(cell, path, focused))),
            some(CellMessage.navigate(path)),
            some(\ step: Int -> CellMessage.move(step)), escape)
        cell_widget(cell: Cell, path: NotebookPath) Widget[CellMessage] =
          cell_widget(cell, path, 0)
    chapter Chapter widget
      text
        Next, chapters.
      code
        ChapterMessage = enum { changed: Chapter, navigate: NotebookPath }
      chapter Cell list
        text
          The list is a column of cell widgets. Swapping changes the document
          and selects the neighboring slot. A revision resets cell contents on
          each swap; editor state does not travel between cells.
        code
          chapter_cells(chapter: Chapter, path: NotebookPath) Widget[ChapterMessage] =
            stateful[Int, ChapterMessage, Indexed[CellMessage]](
              0,
              \ revision: Int, event: Indexed[CellMessage] ->
                index = event.index
                event.item %(
                  navigate(path)
                    bubble_up[Int, ChapterMessage](ChapterMessage.navigate(path))
                  changed(cell)
                    bubble_up[Int, ChapterMessage](ChapterMessage.changed(Chapter(
                      title = chapter.title, children = chapter.children.set(index, cell))))
                  move(step)
                    target = index + step
                    if target < 0 or target >= chapter.children.length()
                      new_state[Int, ChapterMessage](revision)
                      bubble_up_and_focus(
                        revision + 1,
                        ChapterMessage.changed(Chapter(title = chapter.title,
                          children = chapter.children.swap(index, target))), step)),
              \ revision: Int ->
                column(chapter.children.iter().map_indexed(
                  \ index: Int, cell: Cell ->
                    padding(0.0, 8.0, 0.0, 0.0,
                      cell_widget(cell, path.push(index), revision)
                      . map_message(\ message: CellMessage -> Indexed(index, item = message))))
                  . to_list()))
      code
        ChapterBreadcrumb = struct { title: String, path: NotebookPath }
      code
        chapter_breadcrumbs(
          root: Chapter, path: NotebookPath, prefix: NotebookPath
          ) List[ChapterBreadcrumb] =
          current = list(ChapterBreadcrumb(title = root.title, path = prefix))
          if path.is_empty()
            current
            identity(
              child = root.children.get(path.first()) %(
                chapter(child) child
                default crash("Chapter path points to a non-chapter cell."))
              current.push_all(chapter_breadcrumbs(
                child, path.without_first(), prefix.push(path.first()))))
      text
        Titles stay on one header line. Strip line breaks around the editor,
        leaving editable_text itself usable for multiline text and code.
      code
        single_line_title(title: String) String =
          string(title.chars().iter().filter(\ character: Char ->
            character.codepoint != 10 and character.codepoint != 13).to_list())
      code
        chapter_widget(
          chapter: Chapter, breadcrumbs: List[ChapterBreadcrumb]
          ) Widget[ChapterMessage] =
          path = breadcrumbs.last().path
          escape = path.parent().map(\ destination: NotebookPath -> ChapterMessage.navigate(destination))
          scroll_view(Axis.vertical,
            center(
              width_box(400.0,
                column(list(
                  height_box(8.0).cast_message[ChapterMessage](),
                  padding(8.0, 0.0, 8.0, 0.0,
                    column(
                      breadcrumbs.without_last().iter()
                      . map_indexed(\ index: Int, crumb: ChapterBreadcrumb ->
                          focus_node(
                            \ focused: Bool ->
                              on_click(ChapterMessage.navigate(crumb.path),
                                rounded_rect(4.0,
                                  colored(color(if focused "#e5e5e5" "#ffffff"),
                                    padding(2.0, text(crumb.title, 10.0))))
                                  . cast_message[ChapterMessage]()),
                            some(ChapterMessage.navigate(crumb.path)),
                            none[fun(Int) ChapterMessage](), escape))
                      . to_list())),
                  height_box(8.0).cast_message[ChapterMessage](),
                  focus_node(
                    \ focused: Bool ->
                      rounded_rect(8.0,
                        colored(color(if focused "#e5e5e5" "#ffffff"),
                          padding(8.0, 0.0, 8.0, 0.0,
                            scale_widget(24.0 / text_line_height,
                              editable_text(chapter.title)))))
                      . map_message(\ title: String ->
                          ChapterMessage.changed(Chapter(
                            title = single_line_title(title), children = chapter.children))),
                    none[ChapterMessage](), none[fun(Int) ChapterMessage](), escape),
                  chapter_cells(chapter, path),
                  height_box(8.0).cast_message[ChapterMessage]())))))
    chapter Notebook widget
      text
        Next, the entire notebook. It keeps all the navigation state local and
        only emits updated notebooks.
      code
        notebook_widget(notebook: Chapter, path: NotebookPath) Widget[Chapter] =
          stateful[NotebookPath, Chapter, ChapterMessage](
            path,
            \ current_path: NotebookPath, result: ChapterMessage ->
              result %(
                changed(updated)
                  bubble_up[NotebookPath, Chapter](replace_chapter(
                    notebook, current_path, updated))
                navigate(destination)
                  new_state[NotebookPath, Chapter](destination)),
            \ current_path: NotebookPath ->
              key_widget(
                current_path,
                \ a: NotebookPath, b: NotebookPath -> a == b,
                chapter_widget(
                  notebook.get(current_path),
                  chapter_breadcrumbs(
                    notebook, current_path, notebook_path()))))
        notebook_widget(notebook: Chapter) Widget[Chapter] =
          notebook_widget(notebook, notebook_path())
      text
        The host loads the source at launch and passes it to main. The document
        owner supplies the current notebook to Ctrl+S and handles new versions
        from the widget. Normal edits never issue a save command. Zig serializes
        the document and replaces the source file atomically, then reports
        save_completed or save_failed and prints the result in the terminal.
      code
        notebook_app(
          notebook: Chapter,
          element: Element[Chapter],
          pointer: Maybe[Position]
          ) AppResult =
          refresh_app(element, pointer, AppDriver[Chapter](
            message =
              \ updated: Chapter,
                element: Element[Chapter],
                pointer: Maybe[Position]
                ->
                notebook_app(updated, element.updated(notebook_widget(updated)), pointer),
            shortcut = \ key: KeyPressed ->
              if key.control and not(key.alt) and key.keycode == 83
                some(AppCommand.save_notebook(notebook))
                none[AppCommand]()))
      code
        main(notebook: Chapter) App =
          notebook_app(
            notebook,
            notebook_widget(notebook)
            . create_element(tight_constraints(size(0.0, 0.0))),
            none[Position]())
          . app
    text
      Running the app (Ctrl+S saves the current document): The source path
      defaults to the .objects path without its final suffix. Use --notebook
      source.yam to load and save a different file. soil
      ../../martinaise/martinaise.soil compile src/yam.mar soil src/yam.soil
      src/notebook.yam src/notebook.yam.objects zig build run -- --ui
      src/notebook.yam.objects

            .push(pixel_glyph(6, "|||MMMMMM|    MM|   MM|  MM| MM|MM|MMMMMM|"))
            .push(pixel_glyph(4, "  MM| MM| MM| MM| MM|MM| MM| MM| MM| MM|  MM|"))
            .push(pixel_glyph(2, "MM|MM|MM|MM|MM|MM|MM|MM|MM|MM|MM|"))

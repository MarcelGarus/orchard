      code
        CounterMsg = enum { decrement, increment }
        counter() Widget[Never] =
          stateful[Int, Never, CounterMsg](0,
            \ state: Int, message: CounterMsg ->
              new_state[Int, Never](message %(
                decrement state - 1
                increment state + 1)),
            \ state: Int ->
              row(list(
                on_click(CounterMsg.decrement,
                  colored(color("#e0b040"), padding(6.0, text("decrement")))
                    .cast_message[CounterMsg]()),
                sized_box(40.0, text_line_height + 12.0, center(text(state.format())))
                  .cast_message[CounterMsg](),
                on_click(CounterMsg.increment,
                  colored(color("#30a080"), padding(6.0, text("increment")))
                    .cast_message[CounterMsg]()))))

    chapter Panicking
      text
        Panicking stops evaluation with a message.
      code
        fun panic(message: String): Never { ... }
        fun panic(): Never { panic("panicked") }
      code
        fun unreachable(): Never { panic("unreachable") }
      code
        fun todo(): Never { panic("todo") }
    chapter Assert
      code
        fun assert(condition: Bool, message: String) {
          if not(condition) then panic(message)
        }
        fun assert(condition: Bool) { assert(condition, "assert failed") }
    chapter Maybe
      text
        Represents optional values. Like Option in Rust, but with the cooler
        Haskell name.
      code
        type Maybe[T] = enum { some: T, none }
      code
        fun some[T](value: T): Maybe[T] { Maybe.some(value) }
        fun none[T](): Maybe[T] { Maybe[T].none }
      code
        fun or[T](maybe: Maybe[T]): ControlFlow[T, Nothing] {
          if maybe is some(t)
          then ControlFlow[T, Nothing].short_circuit(t)
          else ControlFlow[T, Nothing].evaluate_alternative
        }
      code
        fun flatten[T](maybe: Maybe[Maybe[T]]): Maybe[T] { maybe or none[T]() }
        fun unwrap[T](maybe: Maybe[T], message: String): T {
          maybe or panic(message)
        }
        fun unwrap[T](maybe: Maybe[T]): T {
          maybe.unwrap("called none.unwrap")
        }
    chapter Result
      text
        The result of something that can either work or fail.
      code
        type Result[O, E] = enum { ok: O, error: E }
      code
        fun ok[O, E](o: O): Result[O, E] { Result[O, E].ok(o) }
        fun error[O, E](e: E): Result[O, E] { Result[O, E].error(e) }
      code
        fun or[O, E](result: Result[O, E]): ControlFlow[O, E] {
          result switch {
            ok(o) ControlFlow[O, E].short_circuit(o)
            error(e) ControlFlow[O, E].evaluate_alternative(e)
          }
        }
      code
        fun unwrap[O, E](result: Result[O, E], message: String): O {
          result switch { ok(o) o error panic(message) }
        }
        fun unwrap[O, E](result: Result[O, E]): O {
          result switch { ok(o) o error(e) panic("called error.unwrap") }
        }
    chapter Ordering
      text
        You should implement the spaceship operator <=>(T, T): Ordering for
        types that can be compared.
      code
        type Ordering = enum { less, equal, greater }
      code
        fun ==(a: Ordering, b: Ordering): Bool {
          a switch { less b is less equal b is equal greater b is greater }
        }
    chapter Int
      text
        If you write a number such as 42 in the code, it's an Int.
      code
        type Int = ...
      code
        fun +(left: Int, right: Int): Int { ... }
        fun -(left: Int, right: Int): Int { ... }
        fun *(left: Int, right: Int): Int { ... }
        fun /(left: Int, right: Int): Int { ... }
        fun %(left: Int, right: Int): Int { ... }
        fun &(left: Int, right: Int): Int { ... }
        fun |(left: Int, right: Int): Int { ... }
        fun ^(left: Int, right: Int): Int { ... }
        fun <=>(left: Int, right: Int): Ordering { ... }
        fun ==(a: Int, b: Int): Bool { a <=> b is equal }
        fun <(a: Int, b: Int): Bool { a <=> b is less }
        fun >(a: Int, b: Int): Bool { a <=> b is greater }
        fun !=(a: Int, b: Int): Bool { not(a <=> b is equal) }
        fun >=(a: Int, b: Int): Bool { not(a <=> b is less) }
        fun <=(a: Int, b: Int): Bool { not(a <=> b is greater) }
        fun abs(value: Int): Int { if value >= 0 then value else 0 - value }
        fun round_up_to_multiple_of(number: Int, factor: Int): Int {
          {number + factor - 1} / factor * factor
        }
      code
        var min_int = -9223372036854775808
        var max_int = 9223372036854775807
    chapter ByteOperations
      text
        Byte arithmetic wraps into the range 0 to 255.
      code
        fun lower_byte(value: Int): Byte { ... }
        fun to_int(value: Byte): Int { ... }
        fun +(left: Byte, right: Byte): Byte { ... }
        fun -(left: Byte, right: Byte): Byte { ... }
        fun *(left: Byte, right: Byte): Byte { ... }
        fun /(left: Byte, right: Byte): Byte { ... }
        fun %(left: Byte, right: Byte): Byte { ... }
        fun &(left: Byte, right: Byte): Byte { ... }
        fun |(left: Byte, right: Byte): Byte { ... }
        fun ^(left: Byte, right: Byte): Byte { ... }
        fun <=>(left: Byte, right: Byte): Ordering { ... }
      code
        var min_byte = lower_byte(0)
        var max_byte = lower_byte(255)
    chapter Range
      text
        Ranges have an inclusive start and an exclusive end.
        All operators have the same precedence and associate from left to right.
      code
        type Range[T] = struct { start: T, end: T }
        fun ..[T](start: T, end: T): Range[T] { Range { start, end } }
        fun ..=(start: Int, end: Int): Range[Int] { start .. {end + 1} }
        fun ..+(start: Int, length: Int): Range[Int] { start .. {start + length} }
        fun ..+=(start: Int, length: Int): Range[Int] { start .. {start + length + 1} }
        fun +-(mid: Int, distance: Int): Range[Int] { {mid - distance} .. {mid + distance + 1} }
        fun length(range: Range[Int]): Int { range.end - range.start }
        fun contains(range: Range[Int], value: Int): Bool {
          value >= range.start and value < range.end
        }
        fun is_empty(range: Range[Int]): Bool { range.start >= range.end }
        fun is_not_empty(range: Range[Int]): Bool { not(range.is_empty()) }
    chapter List
      text
        List[T] is an immutable array.
      code
        type List[T] = ...
        fun list[T](): List[T] { ... }
        fun length[T](list: List[T]): Int { ... }
        fun get[T](list: List[T], index: Int): T { ... }
        fun filled_list[T](length: Int, fill: T): List[T] { ... }
        fun push[T](list: List[T], item: T): List[T] { ... }
        fun push_all[T](list: List[T], items: List[T]): List[T] { ... }
        fun slice[T](list: List[T], range: Range[Int]): List[T] { ... }
        fun set[T](list: List[T], index: Int, item: T): List[T] { ... }
        fun reversed[T](list: List[T]): List[T] { ... }
        fun sum(list: List[Int]): Int { ... }
      code
        fun is_empty[T](list: List[T]): Bool { list.length() == 0 }
        fun is_not_empty[T](list: List[T]): Bool { not(list.is_empty()) }
        fun get_maybe[T](list: List[T], index: Int): Maybe[T] {
          if {0..list.length()}.contains(index)
          then some(list.get(index)) else none[T]()
        }
        fun list[T](a: T): List[T] { list[T]().push(a) }
        fun list[T](a: T, b: T): List[T] { list[T]().push(a).push(b) }
        fun list[T](a: T, b: T, c: T): List[T] {
          list[T]().push(a).push(b).push(c)
        }
        fun list[T](a: T, b: T, c: T, d: T): List[T] {
          list[T]().push(a).push(b).push(c).push(d)
        }
        fun list[T](a: T, b: T, c: T, d: T, e: T): List[T] {
          list[T]().push(a).push(b).push(c).push(d).push(e)
        }
        fun list[T](a: T, b: T, c: T, d: T, e: T, f: T): List[T] {
          list[T]().push(a).push(b).push(c).push(d).push(e).push(f)
        }
        fun list[T](a: T, b: T, c: T, d: T, e: T, f: T, g: T): List[T] {
          list[T]().push(a).push(b).push(c).push(d).push(e).push(f).push(g)
        }
        fun list[T](a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T): List[T] {
          list[T]().push(a).push(b).push(c).push(d).push(e).push(f).push(g)
            .push(h)
        }
        fun list[T](
          a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T, i: T
        ): List[T] {
          list[T]().push(a).push(b).push(c).push(d).push(e).push(f).push(g)
            .push(h).push(i)
        }
        fun list[T](
          a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T, i: T, j: T
        ): List[T] {
          list[T]().push(a).push(b).push(c).push(d).push(e).push(f).push(g)
            .push(h).push(i).push(j)
        }
      code
        fun first[T](list: List[T]): T { list.get(0) }
        fun last[T](list: List[T]): T { list.get(list.length() - 1) }
        fun first[T](list: List[T], amount: Int): List[T] {
          list.slice(0..amount)
        }
        fun last[T](list: List[T], amount: Int): List[T] {
          assert(
            amount >= 0 and amount <= list.length(),
            "List amount out of bounds.",
          )
          list.slice({list.length() - amount}..list.length())
        }
        fun without_first[T](list: List[T], amount: Int): List[T] {
          list.slice(amount..list.length())
        }
        fun without_first[T](list: List[T]): List[T] { list.without_first(1) }
        fun without_last[T](list: List[T], amount: Int): List[T] {
          assert(
            amount >= 0 and amount <= list.length(),
            "List amount out of bounds.",
          )
          list.slice(0..{list.length() - amount})
        }
        fun without_last[T](list: List[T]): List[T] { list.without_last(1) }
        fun pop[T](list: List[T]): List[T] {
          assert(list.is_not_empty(), "Cannot pop an empty list.")
          list.without_last()
        }
        fun first_maybe[T](list: List[T]): Maybe[T] { list.get_maybe(0) }
        fun last_maybe[T](list: List[T]): Maybe[T] {
          list.get_maybe(list.length() - 1)
        }
        fun insert[T](list: List[T], index: Int, item: T): List[T] {
          list.first(index).push(item).push_all(list.without_first(index))
        }
        fun remove[T](list: List[T], range: Range[Int]): List[T] {
          assert(
            0 <= range.start and range.start <= range.end and range.end <= list.length(),
            "List range out of bounds.",
          )
          list.first(range.start).push_all(list.without_first(range.end))
        }

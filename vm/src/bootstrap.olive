# "Olive: Optimizable Lisp Implementing Various Expressions

   This file contains the Olive compiler and optimizer, followed by a
   compiler for Yam notebooks. compile_olive parses Olive source, lowers it
   to VM expressions, optimizes them, and executes each definition.
   compile_yam checks a document and returns an entry point which receives
   that document at run time. Both compilers and their generated functions
   live in the same VM heap.

   The first helpers construct VM expression trees. Their percent-prefixed
   names make building a computation distinct from executing it. A raw VM
   function is [parameter names, body]; generated Yam functions keep
   reflected metadata and captured values around that executable function."

%word (\ (w) (# "word" w))
%object (\ (o) (# "object" o))
%name (\ (n) (# "name" n))
%let (\ (name def body) (# "let" name def body))
%also (\ (ignored value) (# "also" ignored value))
%add (\ (a b) (# "add" a b))
%subtract (\ (a b) (# "subtract" a b))
%multiply (\ (a b) (# "multiply" a b))
%divide (\ (a b) (# "divide" a b))
%modulo (\ (a b) (# "modulo" a b))
%shift-right (\ (a b) (# "shift-right" a b))
%shift-left (\ (a b) (# "shift-left" a b))
%and (\ (a b) (# "and" a b))
%or (\ (a b) (# "or" a b))
%xor (\ (a b) (# "xor" a b))
%compare (\ (a b) (# "compare" a b))
%f-add (\ (a b) (# "f-add" a b))
%f-subtract (\ (a b) (# "f-subtract" a b))
%f-multiply (\ (a b) (# "f-multiply" a b))
%f-divide (\ (a b) (# "f-divide" a b))
%f-compare (\ (a b) (# "f-compare" a b))
%int-to-float (\ (a) (# "int-to-float" a))
%float-to-int (\ (a) (# "float-to-int" a))
%f-is-finite (\ (a) (# "f-is-finite" a))
%if (\ (condition then else) (# "if" condition then else))
%new-leaf (\ (words) (# "new-leaf" words))
%new-inner (\ (words) (# "new-inner" words))
%flatten-to-leaf (\ (object) (# "flatten-to-leaf" object))
%flatten-to-inner (\ (object) (# "flatten-to-inner" object))
%points (\ (object) (# "points" object))
%size (\ (object) (# "size" object))
%load (\ (object index) (# "load" object index))
%obj-equals (\ (a b) (# "obj-equals" a b))
%call (\ (fun args) (# "call" fun args))
%call-indirect (\ (fun args) (# "call-indirect" fun args))
%rec (\ (args) (# "rec" args))
%collect-garbage (\ (body) (# "collect-garbage" body))
%sandbox (\ (fuel body) (# "sandbox" fuel body))
%use-fuel (\ (amount child) (# "use-fuel" amount child))
%crash (\ (error) (# "crash" error))
%unreachable (\ () (# "unreachable"))

%load-0 (\ (obj) (%load obj (%word 0)))
%load-1 (\ (obj) (%load obj (%word 1)))
%load-2 (\ (obj) (%load obj (%word 2)))
%load-3 (\ (obj) (%load obj (%word 3)))

also (\ (a b) b)

+ (# (# "a" "b")
 (%new-leaf (# (%add (%load-0 (%name "a")) (%load-0 (%name "b"))))))

- (# (# "a" "b")
 (%new-leaf (# (%subtract (%load-0 (%name "a")) (%load-0 (%name "b"))))))

* (# (# "a" "b")
 (%new-leaf (# (%multiply (%load-0 (%name "a")) (%load-0 (%name "b"))))))

/ (# (# "a" "b")
 (%new-leaf (# (%divide (%load-0 (%name "a")) (%load-0 (%name "b"))))))

mod (# (# "a" "b")
 (%new-leaf (# (%modulo (%load-0 (%name "a")) (%load-0 (%name "b"))))))

>> (# (# "a" "b")
 (%new-leaf (# (%shift-right (%load-0 (%name "a")) (%load-0 (%name "b"))))))

<< (# (# "a" "b")
 (%new-leaf (# (%shift-left (%load-0 (%name "a")) (%load-0 (%name "b"))))))

and (# (# "a" "b")
 (%new-leaf (# (%and (%load-0 (%name "a")) (%load-0 (%name "b"))))))

or (# (# "a" "b")
 (%new-leaf (# (%or (%load-0 (%name "a")) (%load-0 (%name "b"))))))

xor (# (# "a" "b")
 (%new-leaf (# (%xor (%load-0 (%name "a")) (%load-0 (%name "b"))))))

int->float (# (# "n") (%new-leaf (# (%int-to-float (%load-0 (%name "n"))))))

f+ (# (# "a" "b")
 (%new-leaf (# (%f-add (%load-0 (%name "a")) (%load-0 (%name "b"))))))

f- (# (# "a" "b")
 (%new-leaf (# (%f-subtract (%load-0 (%name "a")) (%load-0 (%name "b"))))))

f* (# (# "a" "b")
 (%new-leaf (# (%f-multiply (%load-0 (%name "a")) (%load-0 (%name "b"))))))

f/ (# (# "a" "b")
 (%new-leaf (# (%f-divide (%load-0 (%name "a")) (%load-0 (%name "b"))))))

crash (# (# "error") (%crash (%name "error")))

false 0

true 1

and-3 (\ (a b c) (and (and a b) c))
and-4 (\ (a b c d) (and (and-3 a b c) d))
and-5 (\ (a b c d e) (and (and-4 a b c d) e))

or-3 (\ (a b c) (or (or a b) c))
or-4 (\ (a b c d) (or (or-3 a b c) d))
not (\ (a) (- 1 a))

compare (# (# "a" "b")
 (%new-leaf (# (%compare (%load-0 (%name "a")) (%load-0 (%name "b"))))))

= (# (# "a" "b")
 (%new-leaf
  (# (%and (%compare (%load-0 (%name "a")) (%load-0 (%name "b"))) (%word 1)))))

> (# (# "a" "b")
 (%new-leaf
  (#
   (%and
    (%shift-right (%compare (%load-0 (%name "a")) (%load-0 (%name "b")))
     (%word 1))
    (%word 1)))))

< (# (# "a" "b")
 (%new-leaf
  (#
   (%and
    (%shift-right (%compare (%load-0 (%name "a")) (%load-0 (%name "b")))
     (%word 2))
    (%word 1)))))

!= (\ (a b) (not (= a b)))
>= (\ (a b) (not (< a b)))
<= (\ (a b) (not (> a b)))

odd? (\ (a) (and a 1))
even? (\ (a) (not (odd? a)))

size (# (# "object") (%new-leaf (# (%size (%name "object")))))
inner? (# (# "object") (%new-leaf (# (%points (%name "object")))))
. (# (# "index" "object") (%load (%name "object") (%load-0 (%name "index"))))
.0 (# (# "object") (%load-0 (%name "object")))
.1 (# (# "object") (%load-1 (%name "object")))
.2 (# (# "object") (%load-2 (%name "object")))
.3 (# (# "object") (%load-3 (%name "object")))

load-word (# (# "object" "index")
 (%new-leaf (# (%load (%name "object") (%load-0 (%name "index"))))))

nil (#)

assert (\ (check error) (if check nil (crash error)))

nil? (\ (obj) (= 0 (size obj)))
not-nil? (\ (obj) (!= 0 (size obj)))

flatten-to-leaf (# (# "obj") (%flatten-to-leaf (%name "obj")))
flatten-to-inner (# (# "obj") (%flatten-to-inner (%name "obj")))

array-to-list-rec
 (\ (array i) (if (= i (size array)) nil (# (. i array) (rec array (+ i 1)))))

array-to-list (\ (array) (array-to-list-rec array 0))

str=-rec (\ (a b i limit)
 (if (= i limit) true
  (if (= (load-word a i) (load-word b i)) (rec a b (+ i 1) limit) false)))

str= (\ (a b) (if (= (size a) (size b)) (str=-rec a b 0 (size a)) false))

str=1word (\ (a b)
 (if (= (size b) 1)
  (if (= (size a) 1) (= (load-word a 0) (load-word b 0)) false)
  (crash (# "bad str=1word" b))))

str=2words (\ (a b)
 (if (= (size b) 2)
  (if (= (size a) 2)
   (and (= (load-word a 0) (load-word b 0)) (= (load-word a 1) (load-word b 1)))
   false)
  (crash (# "bad str=2words" b))))

str=1 (\ (a b) (str=1word a b))
str=2 (\ (a b) (str=1word a b))
str=3 (\ (a b) (str=1word a b))
str=4 (\ (a b) (str=1word a b))
str=5 (\ (a b) (str=1word a b))
str=6 (\ (a b) (str=1word a b))
str=7 (\ (a b) (str=1word a b))
str=8 (\ (a b) (str=1word a b))
str=9 (\ (a b) (str=2words a b))
str=10 (\ (a b) (str=2words a b))
str=11 (\ (a b) (str=2words a b))
str=12 (\ (a b) (str=2words a b))
str=13 (\ (a b) (str=2words a b))
str=15 (\ (a b) (str=2words a b))
str=16 (\ (a b) (str=2words a b))

str-get
 (\ (string i) (and 255 (>> (load-word string (>> i 3)) (* 8 (and i 7)))))

first-char (\ (string) (and 255 (load-word string 0)))

chars-to-str-pack-rec (\ (chars shift acc)
 (if (>= shift 64) (# acc chars)
  (if (nil? chars) (# acc chars)
   (rec (.1 chars) (+ shift 8) (+ acc (* (.0 chars) (<< 1 shift)))))))

chars-to-str-rec (\ (chars)
 (if (nil? chars) nil
  (: r (chars-to-str-pack-rec chars 0 0) (# (.0 r) (rec (.1 r))))))

chars-to-str (\ (chars) (flatten-to-leaf (chars-to-str-rec chars)))

# "The source reader uses tail recursion so document size does not consume
   one VM stack frame per word."

reverse-list (\ (input result)
 (if (nil? input) result (rec (.1 input) (# (.0 input) result))))

str-to-chars-rec (\ (string index result)
 (if (< index 0) result
  (: char (and (>> (load-word string (/ index 8)) (* (mod index 8) 8)) 255)
   (rec string (- index 1) (if (= char 0) result (# char result))))))

str-to-chars-inner
 (\ (string) (str-to-chars-rec string (- (* (size string) 8) 1) nil))

str-to-chars (# (# "string")
 (%collect-garbage (%call (%object str-to-chars-inner) (# (%name "string")))))

list-concat (\ (a b) (if (nil? a) b (# (.0 a) (rec (.1 a) b))))

list-contains (\ (list string)
 (if (nil? list) false (if (str= (.0 list) string) true (rec (.1 list) string)))
)

str-concat
 (\ (a b) (chars-to-str (list-concat (str-to-chars a) (str-to-chars b))))

str-concat-3 (\ (a b c)
 (chars-to-str
  (list-concat (str-to-chars a) (list-concat (str-to-chars b) (str-to-chars c)))
 ))

ascii-newline 10

ascii-space 32

ascii-quote 34

ascii-open-paren 40

ascii-close-paren 41

ascii-dot 46

ascii-0 48

ascii-9 57

ascii-backslash 92

ascii-n 110

# "Optimize IR"

word? (\ (ir) (str=4 (.0 ir) "word"))
object? (\ (ir) (str=6 (.0 ir) "object"))
name? (\ (ir) (str=4 (.0 ir) "name"))
let? (\ (ir) (str=3 (.0 ir) "let"))
also? (\ (ir) (str=4 (.0 ir) "also"))
add? (\ (ir) (str=3 (.0 ir) "add"))
subtract? (\ (ir) (str=8 (.0 ir) "subtract"))
multiply? (\ (ir) (str=8 (.0 ir) "multiply"))
divide? (\ (ir) (str=6 (.0 ir) "divide"))
modulo? (\ (ir) (str=6 (.0 ir) "modulo"))
shift-right? (\ (ir) (str=11 (.0 ir) "shift-right"))
shift-left? (\ (ir) (str=10 (.0 ir) "shift-left"))
and? (\ (ir) (str=3 (.0 ir) "and"))
or? (\ (ir) (str=2 (.0 ir) "or"))
xor? (\ (ir) (str=3 (.0 ir) "xor"))
compare? (\ (ir) (str=7 (.0 ir) "compare"))
f-add? (\ (ir) (str=5 (.0 ir) "f-add"))
f-subtract? (\ (ir) (str=10 (.0 ir) "f-subtract"))
f-multiply? (\ (ir) (str=10 (.0 ir) "f-multiply"))
f-divide? (\ (ir) (str=8 (.0 ir) "f-divide"))
f-compare? (\ (ir) (str=9 (.0 ir) "f-compare"))
int-to-float? (\ (ir) (str=12 (.0 ir) "int-to-float"))
float-to-int? (\ (ir) (str=12 (.0 ir) "float-to-int"))
f-is-finite? (\ (ir) (str=11 (.0 ir) "f-is-finite"))
if? (\ (ir) (str=2 (.0 ir) "if"))
new-leaf? (\ (ir) (str=8 (.0 ir) "new-leaf"))
new-inner? (\ (ir) (str=9 (.0 ir) "new-inner"))
flatten-to-leaf? (\ (ir) (str=15 (.0 ir) "flatten-to-leaf"))
flatten-to-inner? (\ (ir) (str=16 (.0 ir) "flatten-to-inner"))
points? (\ (ir) (str=6 (.0 ir) "points"))
size? (\ (ir) (str=4 (.0 ir) "size"))
load? (\ (ir) (str=4 (.0 ir) "load"))
obj-equals? (\ (ir) (str=10 (.0 ir) "obj-equals"))
call? (\ (ir) (str=4 (.0 ir) "call"))
call-indirect? (\ (ir) (str=13 (.0 ir) "call-indirect"))
rec? (\ (ir) (str=3 (.0 ir) "rec"))
collect-garbage? (\ (ir) (str=15 (.0 ir) "collect-garbage"))
sandbox? (\ (ir) (str=7 (.0 ir) "sandbox"))
use-fuel? (\ (ir) (str=8 (.0 ir) "use-fuel"))
crash? (\ (ir) (str=5 (.0 ir) "crash"))
unreachable? (\ (ir) (str=11 (.0 ir) "unreachable"))

# "Several Olive tree walkers use a mode argument. One recursive function
   handles an expression, a function, or a sequence by changing modes, so
   these walkers need neither forward declarations nor mutually recursive
   bindings."

:fun "fun"

:expr "expr"

:shallow "shallow"

:list "list"

:cases "cases"

else true

# "Before inlining a function, find out whether its body refers to itself.
   Traversal modes let the same recursive walker handle expressions and their
   lists without needing mutually recursive Olive declarations."

has-rec (\ (mode ir)
 (cond (= mode :expr)
  (cond (word? ir) false (object? ir) false (name? ir) false (let? ir)
   (if (rec :expr (.2 ir)) true (rec :expr (.3 ir)))
   (also? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (add? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (subtract? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (multiply? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (divide? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (modulo? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (shift-left? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (shift-right? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (and? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (or? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (xor? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (compare? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (f-add? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (f-subtract? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (f-multiply? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (f-divide? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (f-compare? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (int-to-float? ir)
   (rec :expr (.1 ir))
   (float-to-int? ir)
   (rec :expr (.1 ir))
   (f-is-finite? ir)
   (rec :expr (.1 ir))
   (load? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (obj-equals? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (if? ir)
   (if (rec :expr (.1 ir)) true
    (if (rec :expr (.2 ir)) true (rec :expr (.3 ir))))
   (new-leaf? ir)
   (rec :list (array-to-list (.1 ir)))
   (new-inner? ir)
   (rec :list (array-to-list (.1 ir)))
   (flatten-to-leaf? ir)
   (rec :expr (.1 ir))
   (flatten-to-inner? ir)
   (rec :expr (.1 ir))
   (points? ir)
   (rec :expr (.1 ir))
   (size? ir)
   (rec :expr (.1 ir))
   (collect-garbage? ir)
   (rec :expr (.1 ir))
   (crash? ir)
   (rec :expr (.1 ir))
   (call? ir)
   (if (rec :expr (.1 ir)) true (rec :list (array-to-list (.2 ir))))
   (call-indirect? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (rec? ir)
   true (sandbox? ir) (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (use-fuel? ir)
   (if (rec :expr (.1 ir)) true (rec :expr (.2 ir)))
   (unreachable? ir)
   false else (crash (# "unknown node in has-rec" (.0 ir))))
  (= mode :fun)
  (rec :expr (.1 ir))
  (= mode :list)
  (if (nil? ir) false (if (rec :expr (.0 ir)) true (rec :list (.1 ir))))
  else (crash "unknown has-rec mode")))

wrap-lets (\ (params args body)
 (if (nil? params) body
  (%let (.0 params) (.0 args) (rec (.1 params) (.1 args) body))))

all-words?
 (\ (irs) (if (nil? irs) true (if (word? (.0 irs)) (rec (.1 irs)) false)))

unwrap-words (\ (irs) (if (nil? irs) nil (# (.1 (.0 irs)) (rec (.1 irs)))))

all-objects?
 (\ (irs) (if (nil? irs) true (if (object? (.0 irs)) (rec (.1 irs)) false)))

unwrap-objects (\ (irs) (if (nil? irs) nil (# (.1 (.0 irs)) (rec (.1 irs)))))

bind (\ (mode name val ir)
 (cond (= mode :expr)
  (cond (word? ir) ir (object? ir) ir (name? ir)
   (if (str= (.1 ir) name) val ir)
   (let? ir)
   (: def (rec :expr name val (.2 ir))
    (if (str= (.1 ir) name) (%let (.1 ir) def (.3 ir))
     (%let (.1 ir) def (rec :expr name val (.3 ir)))))
   (also? ir)
   (%also (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (add? ir)
   (%add (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (subtract? ir)
   (%subtract (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (multiply? ir)
   (%multiply (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (divide? ir)
   (%divide (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (modulo? ir)
   (%modulo (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (shift-left? ir)
   (%shift-left (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (shift-right? ir)
   (%shift-right (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (and? ir)
   (%and (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (or? ir)
   (%or (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (xor? ir)
   (%xor (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (compare? ir)
   (%compare (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (f-add? ir)
   (%f-add (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (f-subtract? ir)
   (%f-subtract (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (f-multiply? ir)
   (%f-multiply (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (f-divide? ir)
   (%f-divide (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (f-compare? ir)
   (%f-compare (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (int-to-float? ir)
   (%int-to-float (rec :expr name val (.1 ir)))
   (float-to-int? ir)
   (%float-to-int (rec :expr name val (.1 ir)))
   (f-is-finite? ir)
   (%f-is-finite (rec :expr name val (.1 ir)))
   (load? ir)
   (%load (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (obj-equals? ir)
   (%obj-equals (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (if? ir)
   (%if (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir))
    (rec :expr name val (.3 ir)))
   (new-leaf? ir)
   (%new-leaf (flatten-to-inner (rec :list name val (array-to-list (.1 ir)))))
   (new-inner? ir)
   (%new-inner (flatten-to-inner (rec :list name val (array-to-list (.1 ir)))))
   (flatten-to-leaf? ir)
   (%flatten-to-leaf (rec :expr name val (.1 ir)))
   (flatten-to-inner? ir)
   (%flatten-to-inner (rec :expr name val (.1 ir)))
   (points? ir)
   (%points (rec :expr name val (.1 ir)))
   (size? ir)
   (%size (rec :expr name val (.1 ir)))
   (collect-garbage? ir)
   (%collect-garbage (rec :expr name val (.1 ir)))
   (crash? ir)
   (%crash (rec :expr name val (.1 ir)))
   (call? ir)
   (%call (rec :expr name val (.1 ir))
    (flatten-to-inner (rec :list name val (array-to-list (.2 ir)))))
   (call-indirect? ir)
   (%call-indirect (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (rec? ir)
   (%rec (flatten-to-inner (rec :list name val (array-to-list (.1 ir)))))
   (sandbox? ir)
   (%sandbox (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (use-fuel? ir)
   (%use-fuel (rec :expr name val (.1 ir)) (rec :expr name val (.2 ir)))
   (unreachable? ir)
   ir else (crash (# "unknown node in bind" ir)))
  (= mode :list)
  (if (nil? ir) nil
   (# (rec :expr name val (.0 ir)) (rec :list name val (.1 ir))))
  else (crash "bad mode in bind")))

num-usages (\ (mode name ir)
 (cond (= mode :expr)
  (cond (word? ir) 0 (object? ir) 0 (name? ir) (if (str= (.1 ir) name) 1 0)
   (let? ir)
   (+ (rec :expr name (.2 ir))
    (if (str= (.1 ir) name) 0 (rec :expr name (.3 ir))))
   (also? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (add? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (subtract? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (multiply? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (divide? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (modulo? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (shift-left? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (shift-right? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (and? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (or? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (xor? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (compare? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (f-add? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (f-subtract? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (f-multiply? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (f-divide? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (f-compare? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (int-to-float? ir)
   (rec :expr name (.1 ir))
   (float-to-int? ir)
   (rec :expr name (.1 ir))
   (f-is-finite? ir)
   (rec :expr name (.1 ir))
   (load? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (obj-equals? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (if? ir)
   (+ (rec :expr name (.1 ir))
    (+ (rec :expr name (.2 ir)) (rec :expr name (.3 ir))))
   (new-leaf? ir)
   (rec :list name (array-to-list (.1 ir)))
   (new-inner? ir)
   (rec :list name (array-to-list (.1 ir)))
   (flatten-to-leaf? ir)
   (rec :expr name (.1 ir))
   (flatten-to-inner? ir)
   (rec :expr name (.1 ir))
   (points? ir)
   (rec :expr name (.1 ir))
   (size? ir)
   (rec :expr name (.1 ir))
   (collect-garbage? ir)
   (rec :expr name (.1 ir))
   (call? ir)
   (+ (rec :expr name (.1 ir)) (rec :list name (array-to-list (.2 ir))))
   (call-indirect? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (rec? ir)
   (rec :list name (array-to-list (.1 ir)))
   (sandbox? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (use-fuel? ir)
   (+ (rec :expr name (.1 ir)) (rec :expr name (.2 ir)))
   (crash? ir)
   (rec :expr name (.1 ir))
   (unreachable? ir)
   0 else (crash (# "unknown node in bind" ir)))
  (= mode :list)
  (if (nil? ir) 0 (+ (rec :expr name (.0 ir)) (rec :list name (.1 ir))))
  else (crash "bad mode in num-usages")))

pure? (\ (mode ir)
 (cond (= mode :expr)
  (cond (word? ir) true (object? ir) true (name? ir) true (let? ir)
   (and (rec :expr (.2 ir)) (rec :expr (.3 ir)))
   (also? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (add? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (subtract? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (multiply? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (divide? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (modulo? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (shift-left? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (shift-right? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (and? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (or? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (xor? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (compare? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-add? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-subtract? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-multiply? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-divide? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-compare? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (int-to-float? ir)
   (rec :expr (.1 ir))
   (float-to-int? ir)
   (rec :expr (.1 ir))
   (f-is-finite? ir)
   (rec :expr (.1 ir))
   (load? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (obj-equals? ir)
   (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (if? ir)
   (and-3 (rec :expr (.1 ir)) (rec :expr (.2 ir)) (rec :expr (.3 ir)))
   (new-leaf? ir)
   (rec :list (array-to-list (.1 ir)))
   (new-inner? ir)
   (rec :list (array-to-list (.1 ir)))
   (flatten-to-leaf? ir)
   (rec :expr (.1 ir))
   (flatten-to-inner? ir)
   (rec :expr (.1 ir))
   (points? ir)
   (rec :expr (.1 ir))
   (size? ir)
   (rec :expr (.1 ir))
   (collect-garbage? ir)
   false (call? ir) false (call-indirect? ir) false (rec? ir) false
   (sandbox? ir)
   false (use-fuel? ir) (and (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (crash? ir)
   false (unreachable? ir) true else (crash (# "unknown node in pure?" ir)))
  (= mode :list)
  (if (nil? ir) true (and (rec :expr (.0 ir)) (rec :list (.1 ir))))
  else (crash "bad mode in pure?")))

wrap-also
 (\ (list inner) (if (nil? list) inner (%also (.0 list) (rec (.1 list) inner))))

split-list-at (\ (list n)
 (if (= n 0) (# (#) (.0 list) (.1 list))
  (: rest (rec (.1 list) (- n 1))
   (# (# (.0 list) (.0 rest)) (.1 rest) (.2 rest)))))

list-append
 (\ (list item)
  (if (nil? list) (# item nil) (# (.0 list) (rec (.1 list) item))))

str-append-tick (\ (s) (chars-to-str (list-append (str-to-chars s) 39)))

all-names (\ (mode ir)
 (cond (= mode :expr)
  (cond (word? ir) nil (object? ir) nil (name? ir) (# (.1 ir) nil) (let? ir)
   (list-concat (rec :expr (.2 ir)) (rec :expr (.3 ir)))
   (also? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (add? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (subtract? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (multiply? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (divide? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (modulo? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (shift-left? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (shift-right? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (and? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (or? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (xor? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (compare? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-add? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-subtract? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-multiply? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-divide? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (f-compare? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (int-to-float? ir)
   (rec :expr (.1 ir))
   (float-to-int? ir)
   (rec :expr (.1 ir))
   (f-is-finite? ir)
   (rec :expr (.1 ir))
   (load? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (obj-equals? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (if? ir)
   (list-concat (rec :expr (.1 ir))
    (list-concat (rec :expr (.2 ir)) (rec :expr (.3 ir))))
   (new-leaf? ir)
   (rec :list (array-to-list (.1 ir)))
   (new-inner? ir)
   (rec :list (array-to-list (.1 ir)))
   (flatten-to-leaf? ir)
   (rec :expr (.1 ir))
   (flatten-to-inner? ir)
   (rec :expr (.1 ir))
   (points? ir)
   (rec :expr (.1 ir))
   (size? ir)
   (rec :expr (.1 ir))
   (collect-garbage? ir)
   (rec :expr (.1 ir))
   (call? ir)
   (list-concat (rec :expr (.1 ir)) (rec :list (array-to-list (.2 ir))))
   (call-indirect? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (rec? ir)
   (rec :list (array-to-list (.1 ir)))
   (sandbox? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (use-fuel? ir)
   (list-concat (rec :expr (.1 ir)) (rec :expr (.2 ir)))
   (crash? ir)
   (rec :expr (.1 ir))
   (unreachable? ir)
   nil else (crash (# "unknown node in all-names" ir)))
  (= mode :list)
  (if (nil? ir) nil (list-concat (rec :expr (.0 ir)) (rec :list (.1 ir))))
  else (crash "bad mode in all-names")))

fresh-name (\ (name forbidden)
 (if (list-contains forbidden name) (rec (str-append-tick name) forbidden) name)
)

rename-for-capture (\ (params body forbidden)
 (if (nil? params) (# nil body)
  (: p (.0 params)
   (if (list-contains forbidden p)
    (: p2 (fresh-name p (list-concat (all-names :expr body) forbidden))
     (: body2 (bind :expr p (# "name" p2) body)
      (: rest (rec (.1 params) body2 forbidden) (# (# p2 (.0 rest)) (.1 rest))))
    )
    (: rest (rec (.1 params) body forbidden) (# (# p (.0 rest)) (.1 rest)))))))

ensure-not-capturing (\ (mode ir forbidden)
 (cond (= mode :expr)
  (cond (word? ir) ir (object? ir) ir (name? ir) ir (let? ir)
   (: name (.1 ir)
    (: def (rec :expr (.2 ir) forbidden)
     (if (list-contains forbidden name)
      (: new-name
       (fresh-name name (list-concat (all-names :expr (.3 ir)) forbidden))
       (: body (bind :expr name (# "name" new-name) (.3 ir))
        (%let new-name def (rec :expr body forbidden))))
      (%let name def (rec :expr (.3 ir) forbidden)))))
   (also? ir)
   (%also (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (add? ir)
   (%add (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (subtract? ir)
   (%subtract (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (multiply? ir)
   (%multiply (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (divide? ir)
   (%divide (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (modulo? ir)
   (%modulo (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (shift-left? ir)
   (%shift-left (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (shift-right? ir)
   (%shift-right (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (and? ir)
   (%and (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (or? ir)
   (%or (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (xor? ir)
   (%xor (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (compare? ir)
   (%compare (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (f-add? ir)
   (%f-add (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (f-subtract? ir)
   (%f-subtract (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (f-multiply? ir)
   (%f-multiply (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (f-divide? ir)
   (%f-divide (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (f-compare? ir)
   (%f-compare (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (int-to-float? ir)
   (%int-to-float (rec :expr (.1 ir) forbidden))
   (float-to-int? ir)
   (%float-to-int (rec :expr (.1 ir) forbidden))
   (f-is-finite? ir)
   (%f-is-finite (rec :expr (.1 ir) forbidden))
   (obj-equals? ir)
   (%obj-equals (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (load? ir)
   (%load (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (if? ir)
   (%if (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden)
    (rec :expr (.3 ir) forbidden))
   (new-leaf? ir)
   (%new-leaf (flatten-to-inner (rec :list (array-to-list (.1 ir)) forbidden)))
   (new-inner? ir)
   (%new-inner (flatten-to-inner (rec :list (array-to-list (.1 ir)) forbidden)))
   (flatten-to-leaf? ir)
   (%flatten-to-leaf (rec :expr (.1 ir) forbidden))
   (flatten-to-inner? ir)
   (%flatten-to-inner (rec :expr (.1 ir) forbidden))
   (points? ir)
   (%points (rec :expr (.1 ir) forbidden))
   (size? ir)
   (%size (rec :expr (.1 ir) forbidden))
   (collect-garbage? ir)
   (%collect-garbage (rec :expr (.1 ir) forbidden))
   (crash? ir)
   (%crash (rec :expr (.1 ir) forbidden))
   (call? ir)
   (%call (rec :expr (.1 ir) forbidden)
    (flatten-to-inner (rec :list (array-to-list (.2 ir)) forbidden)))
   (call-indirect? ir)
   (%call-indirect (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (rec? ir)
   (%rec (flatten-to-inner (rec :list (array-to-list (.1 ir)) forbidden)))
   (sandbox? ir)
   (%sandbox (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (use-fuel? ir)
   (%use-fuel (rec :expr (.1 ir) forbidden) (rec :expr (.2 ir) forbidden))
   (unreachable? ir)
   ir else (crash (# "unknown node in ensure-not-capturing" ir)))
  (= mode :list)
  (if (nil? ir) nil
   (# (rec :expr (.0 ir) forbidden) (rec :list (.1 ir) forbidden)))
  else (crash "bad mode in ensure-not-capturing")))

# "Helpers for fuel-aware optimization. Each optimize :expr result is either
   a plain core node or a (%use-fuel (%word k) core) wrapper. fuel-of/core-of
   read both forms; with-fuel produces the wrapper only when there is fuel,
   so code with no fuel (Olive) is left untouched."

fuel-of (\ (opt) (if (use-fuel? opt) (.1 (.1 opt)) 0))
core-of (\ (opt) (if (use-fuel? opt) (.2 opt) opt))
with-fuel (\ (k core) (if (= k 0) core (%use-fuel (%word k) core)))
list-fuel (\ (opts) (if (nil? opts) 0 (+ (fuel-of (.0 opts)) (rec (.1 opts)))))

list-cores
 (\ (opts) (if (nil? opts) nil (# (core-of (.0 opts)) (rec (.1 opts)))))

# "The optimizer. `optimize :expr` traverses the tree, rebuilding each node
   from its optimized children, then hands the rebuilt node to `optimize
   :shallow`, which assumes the children are already optimized and only
   optimizes the node itself. A shallow result is canonical: a plain core
   node, or a (%use-fuel (%word k) core) wrapper. The shallow cases peel fuel
   out of always-executed children one wrapper at a time and re-run
   themselves; inlining cases hand the rewritten tree back to :expr for a
   full re-optimization."

optimize (\ (mode ir)
 (cond (= mode :shallow)
  (cond (word? ir) ir (object? ir) ir (name? ir) ir (also? ir)
   (: ignore (.1 ir)
    (: value (.2 ir)
     (cond (use-fuel? ignore)
      (rec :shallow
       (%use-fuel (.1 ignore) (rec :shallow (%also (.2 ignore) value))))
      (use-fuel? value)
      (rec :shallow
       (%use-fuel (.1 value) (rec :shallow (%also ignore (.2 value)))))
      (pure? :expr ignore)
      value else (%also ignore value))))
   (add? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%add (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%add l (.2 r)))))
      (and (word? l) (word? r))
      (%word (+ (.1 l) (.1 r)))
      else (%add l r))))
   (subtract? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%subtract (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%subtract l (.2 r)))))
      (and (word? l) (word? r))
      (%word (- (.1 l) (.1 r)))
      else (%subtract l r))))
   (multiply? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%multiply (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%multiply l (.2 r)))))
      (and (word? l) (word? r))
      (%word (* (.1 l) (.1 r)))
      else (%multiply l r))))
   (divide? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%divide (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%divide l (.2 r)))))
      else (%divide l r))))
   (modulo? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%modulo (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%modulo l (.2 r)))))
      else (%modulo l r))))
   (shift-left? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%shift-left (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%shift-left l (.2 r)))))
      else (%shift-left l r))))
   (shift-right? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%shift-right (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%shift-right l (.2 r)))))
      (and (word? l) (word? r))
      (%word (>> (.1 l) (.1 r)))
      else (%shift-right l r))))
   (and? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%and (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%and l (.2 r)))))
      (and (word? l) (word? r))
      (%word (and (.1 l) (.1 r)))
      else (%and l r))))
   (or? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%or (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%or l (.2 r)))))
      else (%or l r))))
   (xor? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%xor (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%xor l (.2 r)))))
      else (%xor l r))))
   (compare? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%compare (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%compare l (.2 r)))))
      (and (word? l) (word? r))
      (%word (compare (.1 l) (.1 r)))
      else (%compare l r))))
   (f-add? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%f-add (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%f-add l (.2 r)))))
      else (%f-add l r))))
   (f-subtract? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%f-subtract (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%f-subtract l (.2 r)))))
      else (%f-subtract l r))))
   (f-multiply? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%f-multiply (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%f-multiply l (.2 r)))))
      else (%f-multiply l r))))
   (f-divide? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%f-divide (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%f-divide l (.2 r)))))
      else (%f-divide l r))))
   (f-compare? ir)
   (: l (.1 ir)
    (: r (.2 ir)
     (cond (use-fuel? l)
      (rec :shallow (%use-fuel (.1 l) (rec :shallow (%f-compare (.2 l) r))))
      (use-fuel? r)
      (rec :shallow (%use-fuel (.1 r) (rec :shallow (%f-compare l (.2 r)))))
      else (%f-compare l r))))
   (int-to-float? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%int-to-float (.2 a)))))
     (%int-to-float a)))
   (float-to-int? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%float-to-int (.2 a)))))
     (%float-to-int a)))
   (f-is-finite? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%f-is-finite (.2 a)))))
     (%f-is-finite a)))
   (if? ir)
   (: c (.1 ir)
    (: t (.2 ir)
     (: e (.3 ir)
      (cond (use-fuel? c)
       (rec :shallow (%use-fuel (.1 c) (rec :shallow (%if (.2 c) t e))))
       (word? c)
       (if (.1 c) t e)
       else (%if c t e)))))
   (new-leaf? ir)
   (: opts (array-to-list (.1 ir))
    (: cores (list-cores opts)
     (with-fuel (list-fuel opts)
      (if (all-words? cores) (%object (flatten-to-leaf (unwrap-words cores)))
       (%new-leaf (flatten-to-inner cores))))))
   (new-inner? ir)
   (: opts (array-to-list (.1 ir))
    (: cores (list-cores opts)
     (with-fuel (list-fuel opts)
      (if (all-objects? cores)
       (%object (flatten-to-inner (unwrap-objects cores)))
       (%new-inner (flatten-to-inner cores))))))
   (flatten-to-leaf? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%flatten-to-leaf (.2 a)))))
     (%flatten-to-leaf a)))
   (flatten-to-inner? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%flatten-to-inner (.2 a)))))
     (%flatten-to-inner a)))
   (points? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%points (.2 a)))))
     (%points a)))
   (size? ir)
   (: a (.1 ir)
    (cond (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%size (.2 a)))))
     (object? a)
     (%word (size (.1 a)))
     else (%size a)))
   (obj-equals? ir)
   (%obj-equals (.1 ir) (.2 ir))
   (load? ir)
   (: o (.1 ir)
    (: i (.2 ir)
     (cond (use-fuel? o)
      (rec :shallow (%use-fuel (.1 o) (rec :shallow (%load (.2 o) i))))
      (use-fuel? i)
      (rec :shallow (%use-fuel (.1 i) (rec :shallow (%load o (.2 i)))))
      (and (object? o) (word? i))
      (: obj (.1 o)
       (: idx (.1 i)
        (if (>= idx (size obj))
         (%crash (%object "unreachable load index out of bounds"))
         (if (inner? obj) (%object (. idx obj)) (%word (load-word obj idx))))))
      (and (or (new-leaf? o) (new-inner? o)) (word? i))
      (: children (.1 o)
       (: n (.1 i)
        (if (>= n (size children))
         (%crash (%object "unreachable load index out of bounds"))
         (: split (split-list-at (array-to-list children) n)
          (: fresh (fresh-name "loaded" (all-names :list (.2 split)))
           (rec :expr
            (wrap-also (.0 split)
             (%let fresh (.1 split) (wrap-also (.2 split) (%name fresh))))))))))
      else (%load o i))))
   (call? ir)
   (: fun (.1 ir)
    (: args (array-to-list (.2 ir))
     (if (use-fuel? fun)
      (rec :shallow
       (%use-fuel (.1 fun)
        (rec :shallow (%call (.2 fun) (flatten-to-inner args)))))
      (: cargs (list-cores args)
       (if (object? fun)
        (: fn (.1 fun)
         (if (= (size fn) 2)
          (if (!= (size (.2 ir)) (size (.0 fn)))
           (with-fuel (list-fuel args)
            (%crash (%object (# "unreachable num args doesn't match" ir fn))))
           (if (has-rec :fun fn)
            (with-fuel (list-fuel args)
             (%call (%object fn) (flatten-to-inner cargs)))
            (: renamed
             (rename-for-capture (array-to-list (.0 fn)) (.1 fn)
              (all-names :list args))
             (: r (rec :expr (wrap-lets (.0 renamed) cargs (.1 renamed)))
              (with-fuel (+ (list-fuel args) (fuel-of r)) (core-of r))))))
          (with-fuel (list-fuel args) (%crash "unreachable fun is not a fun"))))
        (with-fuel (list-fuel args) (%call fun (flatten-to-inner cargs))))))))
   (call-indirect? ir)
   (: f (.1 ir)
    (: a (.2 ir)
     (cond (use-fuel? f)
      (rec :shallow (%use-fuel (.1 f) (rec :shallow (%call-indirect (.2 f) a))))
      (use-fuel? a)
      (rec :shallow (%use-fuel (.1 a) (rec :shallow (%call-indirect f (.2 a)))))
      else (%call-indirect f a))))
   (rec? ir)
   (: opts (array-to-list (.1 ir))
    (with-fuel (list-fuel opts) (%rec (flatten-to-inner (list-cores opts)))))
   (collect-garbage? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%collect-garbage (.2 a)))))
     (%collect-garbage a)))
   (sandbox? ir)
   (: f (.1 ir)
    (: body (.2 ir)
     (if (use-fuel? f)
      (rec :shallow (%use-fuel (.1 f) (rec :shallow (%sandbox (.2 f) body))))
      (%sandbox f body))))
   (use-fuel? ir)
   (: amount (.1 ir)
    (: child (.2 ir)
     (cond (= (.1 amount) 0) child (use-fuel? child)
      (%use-fuel (%word (+ (.1 amount) (.1 (.1 child)))) (.2 child))
      else ir)))
   (crash? ir)
   (: a (.1 ir)
    (if (use-fuel? a)
     (rec :shallow (%use-fuel (.1 a) (rec :shallow (%crash (.2 a)))))
     (%crash a)))
   (unreachable? ir)
   ir else (# "unknown node in optimize-shallow" (.0 ir)))
  (= mode :expr)
  (cond (word? ir) ir (object? ir) ir (name? ir) ir (let? ir)
   (: name (.1 ir)
    (: defopt (rec :expr (.2 ir))
     (cond (use-fuel? defopt)
      (rec :expr (%use-fuel (.1 defopt) (%let name (.2 defopt) (.3 ir))))
      (or (object? defopt) (word? defopt))
      (rec :expr (bind :expr name defopt (.3 ir)))
      (name? defopt)
      (if (str= name (.1 defopt)) (rec :expr (.3 ir))
       (rec :expr
        (bind :expr name defopt
         (ensure-not-capturing :expr (.3 ir) (# (.1 defopt) nil)))))
      else
      (: n (num-usages :expr name (.3 ir))
       (cond (= n 0)
        (if (pure? :expr defopt) (rec :expr (.3 ir))
         (rec :shallow (%also defopt (rec :expr (.3 ir)))))
        (and (= n 1) (pure? :expr defopt))
        (rec :expr
         (bind :expr name defopt
          (ensure-not-capturing :expr (.3 ir) (all-names :expr defopt))))
        else (%let name defopt (rec :expr (.3 ir))))))))
   (also? ir)
   (rec :shallow (%also (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (add? ir)
   (rec :shallow (%add (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (subtract? ir)
   (rec :shallow (%subtract (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (multiply? ir)
   (rec :shallow (%multiply (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (divide? ir)
   (rec :shallow (%divide (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (modulo? ir)
   (rec :shallow (%modulo (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (shift-left? ir)
   (rec :shallow (%shift-left (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (shift-right? ir)
   (rec :shallow (%shift-right (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (and? ir)
   (rec :shallow (%and (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (or? ir)
   (rec :shallow (%or (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (xor? ir)
   (rec :shallow (%xor (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (compare? ir)
   (rec :shallow (%compare (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (f-add? ir)
   (rec :shallow (%f-add (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (f-subtract? ir)
   (rec :shallow (%f-subtract (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (f-multiply? ir)
   (rec :shallow (%f-multiply (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (f-divide? ir)
   (rec :shallow (%f-divide (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (f-compare? ir)
   (rec :shallow (%f-compare (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (int-to-float? ir)
   (rec :shallow (%int-to-float (rec :expr (.1 ir))))
   (float-to-int? ir)
   (rec :shallow (%float-to-int (rec :expr (.1 ir))))
   (f-is-finite? ir)
   (rec :shallow (%f-is-finite (rec :expr (.1 ir))))
   (if? ir)
   (rec :shallow
    (%if (rec :expr (.1 ir)) (rec :expr (.2 ir)) (rec :expr (.3 ir))))
   (new-leaf? ir)
   (rec :shallow
    (%new-leaf (flatten-to-inner (rec :list (array-to-list (.1 ir))))))
   (new-inner? ir)
   (rec :shallow
    (%new-inner (flatten-to-inner (rec :list (array-to-list (.1 ir))))))
   (flatten-to-leaf? ir)
   (rec :shallow (%flatten-to-leaf (rec :expr (.1 ir))))
   (flatten-to-inner? ir)
   (rec :shallow (%flatten-to-inner (rec :expr (.1 ir))))
   (points? ir)
   (rec :shallow (%points (rec :expr (.1 ir))))
   (size? ir)
   (rec :shallow (%size (rec :expr (.1 ir))))
   (load? ir)
   (rec :shallow (%load (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (obj-equals? ir)
   (rec :shallow (%obj-equals (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (call? ir)
   (rec :shallow
    (%call (rec :expr (.1 ir))
     (flatten-to-inner (rec :list (array-to-list (.2 ir))))))
   (call-indirect? ir)
   (rec :shallow (%call-indirect (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (rec? ir)
   (rec :shallow (%rec (flatten-to-inner (rec :list (array-to-list (.1 ir))))))
   (collect-garbage? ir)
   (rec :shallow (%collect-garbage (rec :expr (.1 ir))))
   (sandbox? ir)
   (rec :shallow (%sandbox (rec :expr (.1 ir)) (rec :expr (.2 ir))))
   (use-fuel? ir)
   (rec :shallow (%use-fuel (.1 ir) (rec :expr (.2 ir))))
   (crash? ir)
   (rec :shallow (%crash (rec :expr (.1 ir))))
   (unreachable? ir)
   ir else (# "unknown node in optimize" (.0 ir)))
  (= mode :fun)
  (# (.0 ir) (rec :expr (.1 ir)))
  (= mode :list)
  (if (nil? ir) nil (# (rec :expr (.0 ir)) (rec :list (.1 ir))))
  else (crash "bad mode in optimize")))

# "Next up is code that can compile this Olive file. This makes Olive
   self-hosted. More important, unlike the Olive compiler written in raw
   objects (bootstrap.objects), this compiler is optimizing, so it can
   compile itself into a faster compiler."

# "Parsing"

is-digit (\ (char) (and (>= char ascii-0) (<= char ascii-9)))

is-name (\ (char)
 (and-5 (!= char ascii-newline) (!= char ascii-space)
  (!= char ascii-open-paren)
  (!= char ascii-close-paren)
  (!= char ascii-quote)))

consume-whitespace (\ (input)
 (if (nil? input) nil
  (: c (.0 input)
   (if (or (= c ascii-newline) (= c ascii-space)) (rec (.1 input)) input))))

parse-string-rec (\ (input)
 (if (nil? input) (crash "string doesn't end")
  (: c (.0 input)
   (cond (= c ascii-quote) (# (.1 input) nil) (= c ascii-backslash)
    (: t (.1 input)
     (if (nil? t) (crash "expected escape char")
      (: escaped (.0 t)
       (: escaped
        (cond (= escaped ascii-backslash) ascii-backslash
         (= escaped ascii-quote)
         ascii-quote (= escaped ascii-n) ascii-newline else
         (crash "unknown escape sequence"))
        (: res (rec (.1 t)) (# (.0 res) (# escaped (.1 res))))))))
    else (: res (rec (.1 input)) (# (.0 res) (# c (.1 res))))))))

parse-int-rec (\ (input num)
 (if (nil? input) (# nil num)
  (: c (.0 input)
   (if (is-digit c) (rec (.1 input) (+ (* num 10) (- c ascii-0))) (# input num))
  )))

parse-frac-rec (\ (input frac-int n-digits)
 (if (nil? input) (# nil frac-int n-digits)
  (: c (.0 input)
   (if (is-digit c)
    (rec (.1 input) (+ (* frac-int 10) (- c ascii-0)) (+ n-digits 1))
    (# input frac-int n-digits)))))

pow10-float
 (\ (n) (if (= n 0) (int->float 1) (f* (int->float 10) (rec (- n 1)))))

finish-float (\ (input int-part)
 (: r (parse-frac-rec input 0 0)
  (: float-val
   (f+ (int->float int-part) (f/ (int->float (.1 r)) (pow10-float (.2 r))))
   (# (.0 r) (# "float" float-val)))))

parse-name-rec (\ (input)
 (if (nil? input) (# nil nil)
  (: c (.0 input)
   (if (is-name c) (: r (rec (.1 input)) (# (.0 r) (# c (.1 r)))) (# input nil))
  )))

parse (\ (mode input)
 (if (= mode :list)
  (: r (rec :expr input)
   (if (nil? r) (# input nil)
    (: rest (rec :list (.0 r)) (# (.0 rest) (# (.1 r) (.1 rest))))))
  (: input (consume-whitespace input)
   (if (nil? input) nil
    (: c (.0 input)
     (cond (= c ascii-close-paren) nil (is-digit c)
      (: r (parse-int-rec input 0)
       (: rest (.0 r)
        (if (nil? rest) (# rest (# "int" (.1 r)))
         (if (= (.0 rest) ascii-dot) (finish-float (.1 rest) (.1 r))
          (# rest (# "int" (.1 r)))))))
      (= c ascii-quote)
      (: r (parse-string-rec (.1 input))
       (# (.0 r) (# "string" (chars-to-str (.1 r)))))
      (= c ascii-open-paren)
      (: group-res (rec :list (.1 input))
       (: input (consume-whitespace (.0 group-res))
        (if (= (.0 input) ascii-close-paren)
         (# (.1 input) (# "group" (flatten-to-inner (.1 group-res))))
         (crash "expected closing paren"))))
      else
      (: name (parse-name-rec input)
       (# (.0 name) (# "name" (chars-to-str (.1 name)))))))))))

int? (\ (ast) (str=3 (.0 ast) "int"))
float? (\ (ast) (str=5 (.0 ast) "float"))
string? (\ (ast) (str=6 (.0 ast) "string"))
group? (\ (ast) (str=5 (.0 ast) "group"))

# "Note that name? is already defined for the IR, and it also works on ASTs."

# "Olive Semantics"

extract-args (\ (asts)
 (if (nil? asts) nil
  (# (: name (.0 asts) (if (name? name) (.1 name) (crash "bad arg")))
   (rec (.1 asts)))))

list-has? (\ (list name)
 (if (nil? list) false (if (str= (.0 list) name) true (rec (.1 list) name))))

globals-lookup (# (# "globals" "name")
 (%if (%size (%name "globals"))
  (%let "entry" (%load (%name "globals") (%word 0))
   (%if (%obj-equals (%load (%name "entry") (%word 0)) (%name "name"))
    (%load (%name "entry") (%word 1))
    (%rec (# (%load (%name "globals") (%word 1)) (%name "name")))))
  (%crash (%new-inner (# (%object "unknown name") (%name "name"))))))

compile-olive-expr (\ (mode locals globals ast)
 (cond (= mode :expr)
  (cond (name? ast)
   (: name (.1 ast)
    (if (list-has? locals name) (%name name)
     (%object (globals-lookup globals name))))
   (group? ast)
   (: children (.1 ast)
    (if (= (size children) 0) (crash "empty group")
     (if (name? (.0 children))
      (: name (.1 (.0 children))
       (cond (str=1 name ":")
        (if (!= (size children) 4) (crash "bad let")
         (: name
          (: name-ast (.1 children)
           (if (str= (.0 name-ast) "name") (.1 name-ast) (crash "bad let")))
          (%let name (rec :expr locals globals (.2 children))
           (rec :expr (# name locals) globals (.3 children)))))
        (str=2 name "if")
        (if (!= (size children) 4) (crash "bad if")
         (%if (%load-0 (rec :expr locals globals (.1 children)))
          (rec :expr locals globals (.2 children))
          (rec :expr locals globals (.3 children))))
        (str=4 name "cond")
        (if (even? (size children)) (crash "bad cond")
         (rec :cases locals globals (.1 (array-to-list children))))
        (str=1 name "#")
        (%new-inner
         (flatten-to-inner
          (rec :list locals globals (.1 (array-to-list children)))))
        (str=1 name "\\")
        (%object
         (: args
          (: args-ast (.1 children)
           (if (str= (.0 args-ast) "group")
            (extract-args (array-to-list (.1 args-ast)))
            (crash "bad args")))
          (optimize :fun
           (# (flatten-to-inner args) (rec :expr args globals (.2 children))))))
        (str=3 name "rec")
        (%rec
         (flatten-to-inner
          (rec :list locals globals (.1 (array-to-list children)))))
        true
        (%call (rec :expr locals globals (.0 children))
         (flatten-to-inner
          (rec :list locals globals (.1 (array-to-list children)))))))
      (%call (rec :expr locals globals (.0 children))
       (flatten-to-inner
        (rec :list locals globals (.1 (array-to-list children))))))))
   (int? ast)
   (%object (.1 ast))
   (float? ast)
   (%object (.1 ast))
   (string? ast)
   (%object (.1 ast))
   else (crash (# "unknown node" ast)))
  (= mode :list)
  (if (nil? ast) nil
   (# (rec :expr locals globals (.0 ast)) (rec :list locals globals (.1 ast))))
  (= mode :cases)
  (if (nil? ast) (%crash (%object "Reached end of cond."))
   (%if (%load-0 (rec :expr locals globals (.0 ast)))
    (rec :expr locals globals (.0 (.1 ast)))
    (rec :cases locals globals (.1 (.1 ast)))))))

# "Compiling an Olive definition constructs its optimized VM expression and
   executes it behind a collection checkpoint. Existing globals and syntax
   predate the checkpoint; the resulting value retains everything it needs."

compile-olive-definition-inner
 (\ (globals ast)
  (: ir (compile-olive-expr :expr nil globals ast) ((# (#) ir))))

compile-olive-definition (# (# "globals" "ast")
 (%collect-garbage
  (%call (%object compile-olive-definition-inner)
   (# (%name "globals") (%name "ast")))))

# "The source entry compiles one definition at a time, keeping parser and
   optimizer temporaries out of the retained compiler heap."

compile-olive-step-inner (\ (globals input)
 (: name-result (parse :expr input)
  (: name-ast (.1 name-result)
   (: value-result (parse :expr (.0 name-result))
    (: name
     (if (name? name-ast) (.1 name-ast) (crash "expected definition name"))
     (: value (compile-olive-definition globals (.1 value-result))
      (# (.0 value-result) (# (# name value) globals))))))))

compile-olive-step (# (# "globals" "input")
 (%collect-garbage
  (%call (%object compile-olive-step-inner)
   (# (%name "globals") (%name "input")))))

compile-olive-stream (\ (globals input)
 (: input (consume-whitespace input)
  (if (nil? input) (globals-lookup globals "export")
   (: step (compile-olive-step globals input) (rec (.1 step) (.0 step))))))

# "A notebook is a tree of chapters containing text, definitions, and
   examples. The host reads that document for us. This compiler walks the
   tree in reading order: a code cell introduces definitions that later cells
   can use; text and eval cells do not contribute definitions during
   bootstrap compilation.

   The compilation pipeline works like this:
   - We parse code into a tree of expressions and declarations.
   - We check types and names of that tree.
   - For every constant and the exported main function, we monomorphize the
     called (potentially generic) functions for concrete types.
   - We lower the monomorphized tree into VM code.

   This compiler itself is already running in the VM. Generated expressions
   can therefore refer directly to compiler helpers. Pretty neat!"

# "Keeping earlier definitions available

   Compiling a cell extends the environment: it gives names to types,
   functions, and global values. Functions declared earlier must keep the
   environment they were checked against. We use persistent maps so extending
   the environment leaves those earlier snapshots available without copying
   the whole map.

   Each map is an immutable search tree ordered by the content hash of its
   key. Updating one name rebuilds the path to that name and shares the other
   paths. Different keys can have the same hash, so each branch keeps a small
   bucket whose entries compare full keys. Looking up a name returns its
   entry or the empty object; a missing entry is distinct from an entry with
   an empty value.

   A branch is [hash, entries, left, right], and an entry is [key, value]."

# "Two small VM operations support the rest of the implementation. Structural
   equality compares values while skipping shared subtrees; it does not
   expose object identity. A fuel charge lets loops and runtime compiler
   routines participate in the same resource budget as generated functions."

yam-use-fuel (# (#) (%use-fuel (%word 1) (%object (#))))

yam-equal? (# (# "left" "right")
 (%new-leaf (# (%obj-equals (%name "left") (%name "right")))))

yam-key-hash-loop (\ (key index hash)
 (if (= index (size key)) hash
  (rec key (+ index 1) (+ (* hash 33) (load-word key index)))))

yam-key-hash (\ (key) (yam-key-hash-loop key 0 5381))

yam-bucket-entry (\ (entries key)
 (cond (nil? entries) nil (yam-equal? (.0 (.0 entries)) key) (.0 entries) true
  (rec (.1 entries) key)))

yam-map-entry-at (\ (tree hash key)
 (cond (nil? tree) nil (< hash (.0 tree)) (rec (.2 tree) hash key)
  (> hash (.0 tree))
  (rec (.3 tree) hash key)
  true (yam-bucket-entry (.1 tree) key)))

yam-map-entry (\ (tree key) (yam-map-entry-at tree (yam-key-hash key) key))

yam-map-get (\ (tree key)
 (: entry (yam-map-entry tree key)
  (if (nil? entry) (crash (# "Unknown name" key)) (.1 entry))))

yam-bucket-put (\ (entries key value)
 (cond (nil? entries) (# (# key value) nil) (yam-equal? (.0 (.0 entries)) key)
  (# (# key value) (.1 entries))
  true (# (.0 entries) (rec (.1 entries) key value))))

yam-map-put-at (\ (tree hash key value)
 (cond (nil? tree) (# hash (# (# key value) nil) nil nil) (< hash (.0 tree))
  (# (.0 tree) (.1 tree) (rec (.2 tree) hash key value) (.3 tree))
  (> hash (.0 tree))
  (# (.0 tree) (.1 tree) (.2 tree) (rec (.3 tree) hash key value))
  true (# hash (yam-bucket-put (.1 tree) key value) (.2 tree) (.3 tree))))

yam-map-put
 (\ (tree key value) (yam-map-put-at tree (yam-key-hash key) key value))

# "Source types are [name, arguments]. Unlike reflected Type handles, these
   describe source syntax: a name may still be a parameter or a function
   alias. The type checker resolves aliases and substitutes parameters before
   lowering. Arguments are flat arrays, matching the notebook's SourceType
   representation."

yam-type (\ (name arguments) (# name arguments))
yam-type-name (\ (type) (.0 type))
yam-type-arguments (\ (type) (.1 type))
yam-named-type (\ (name) (yam-type name (#)))

yam-type-nothing (yam-named-type "Nothing")

yam-type-never (yam-named-type "Never")

# "An empty block has type Nothing. An expression that never returns has type
   Never, which is acceptable wherever a value is expected: that value cannot
   actually reach its caller. Branches agree when their types match, or when
   only one of them can return."

yam-type-accepts? (\ (expected actual)
 (if (yam-equal? actual yam-type-never) true (yam-equal? expected actual)))

yam-type-join (\ (left right)
 (cond (yam-equal? left yam-type-never) right (yam-equal? right yam-type-never)
  left (yam-equal? left right) left true
  (crash (# "Incompatible branch types" left right))))

# "Reading a code cell

   The document reader has already separated text cells from code cells.
   Within one code cell, spaces and line breaks have the same meaning: they
   separate tokens. The lexer first turns packed source text into
   identifiers, literals, and punctuation. The parser then builds trees for
   declarations and expressions.

   A token is [kind, value]. Punctuation uses its spelling for both fields;
   identifiers and literals have a kind such as name, int, float, or string.
   Tokens form a linked list. Its remaining suffix is our immutable cursor,
   so trying an optional construct does not require copying or undoing
   mutations."

yam-array-has-list? (\ (items value)
 (cond (nil? items) false (yam-equal? (.0 items) value) true true
  (rec (.1 items) value)))

yam-array-has?
 (\ (items value) (yam-array-has-list? (array-to-list items) value))

yam-ascii-letter?
 (\ (c) (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))))

yam-ascii-digit? (\ (c) (and (>= c 48) (<= c 57)))

yam-identifier-char?
 (\ (c) (or-3 (yam-ascii-letter? c) (yam-ascii-digit? c) (= c 95)))

yam-operator-char?
 (\ (c)
  (yam-array-has? (# 33 126 64 94 96 47 38 124 42 43 36 45 60 62 61 46) c))

yam-lex-until (\ (mode input chars)
 (if (nil? input) (# input (chars-to-str (reverse-list chars nil)))
  (: c (.0 input)
   (if
    (cond (str= mode "identifier") (yam-identifier-char? c)
     (str= mode "operator")
     (yam-operator-char? c)
     (str= mode "dots")
     (= c 46)
     true (!= c 10))
    (rec mode (.1 input) (# c chars))
    (# input (chars-to-str (reverse-list chars nil)))))))

yam-string-after-newline (\ (input)
 (cond (nil? input) input (= (.0 input) 32) (rec (.1 input)) true input))

yam-lex-string (\ (input chars)
 (if (nil? input) (crash "Unterminated Yam string")
  (: c (.0 input)
   (cond (= c 34) (# (.1 input) (chars-to-str (reverse-list chars nil)))
    (= c 92)
    (if (nil? (.1 input)) (crash "Unterminated string escape")
     (: escaped (.0 (.1 input))
      (also
       (assert (yam-array-has? (# 92 34 123 125 110) escaped)
        "Unknown string escape")
       (rec (.1 (.1 input)) (# (if (= escaped 110) 10 escaped) chars)))))
    (= c 10)
    (: after (yam-string-after-newline (.1 input))
     (if (and (not-nil? after) (= (.0 after) 39)) (rec (.1 after) chars)
      (crash "A continued Yam string needs a leading apostrophe")))
    (= c 123)
    (crash "String interpolation is not supported")
    true (rec (.1 input) (# c chars))))))

yam-lex-digits (\ (input value count)
 (if (nil? input) (# input value count)
  (: c (.0 input)
   (cond (yam-ascii-digit? c)
    (rec (.1 input) (+ (* value 10) (- c 48)) (+ count 1))
    (= c 95)
    (rec (.1 input) value count)
    true (# input value count)))))

yam-fraction-follows? (\ (input)
 (cond (nil? input) false (!= (.0 input) 46) false (nil? (.1 input)) false true
  (yam-ascii-digit? (.0 (.1 input)))))

yam-lex-yam (\ (input)
 (if (nil? input) nil
  (: c (.0 input)
   (cond (<= c 32) (rec (.1 input)) (= c 35)
    (rec (.0 (yam-lex-until "comment" (.1 input) nil)))
    (= c 46)
    (: parsed (yam-lex-until "operator" input nil)
     (# (# (.1 parsed) (.1 parsed)) (rec (.0 parsed))))
    (= c 34)
    (: parsed (yam-lex-string (.1 input) nil)
     (# (# "string" (.1 parsed)) (rec (.0 parsed))))
    (or (yam-ascii-letter? c) (= c 95))
    (: parsed (yam-lex-until "identifier" input nil)
     (# (# "name" (.1 parsed)) (rec (.0 parsed))))
    (yam-ascii-digit? c)
    (: integer (yam-lex-digits input 0 0)
     (: rest (.0 integer)
      (if (yam-fraction-follows? rest)
       (: fraction (yam-lex-digits (.1 rest) 0 0)
        (#
         (# "float"
          (f+ (int->float (.1 integer))
           (f/ (int->float (.1 fraction)) (pow10-float (.2 fraction)))))
         (rec (.0 fraction))))
       (# (# "int" (.1 integer)) (rec rest)))))
    (yam-operator-char? c)
    (: parsed (yam-lex-until "operator" input nil)
     (# (# (.1 parsed) (.1 parsed)) (rec (.0 parsed))))
    true
    (: spelling (chars-to-str (# c nil))
     (# (# spelling spelling) (rec (.1 input))))))))

# "Parsing has two possible results. An empty object means this optional
   construct did not match; otherwise [remaining_tokens, syntax] tells the
   caller both what was read and where to continue. Once an opening delimiter
   commits us to a construct, a missing required part is an error."

yam-token? (\ (input spelling)
 (cond (nil? input) false (str= (.0 (.0 input)) "name")
  (str= (.1 (.0 input)) spelling)
  true (str= (.0 (.0 input)) spelling)))

yam-kind? (\ (input kind) (if (nil? input) false (str= (.0 (.0 input)) kind)))

yam-expect (\ (input spelling)
 (if (yam-token? input spelling) (.1 input)
  (crash (# "Expected" spelling "near" input))))

yam-name? (\ (input uppercase)
 (if (yam-kind? input "name")
  (: first (first-char (.1 (.0 input)))
   (if uppercase (and (>= first 65) (<= first 90))
    (or (and (>= first 97) (<= first 122)) (= first 95))))
  false))

yam-empty-block (# "block" nil)

# "Expressions contain calls; calls contain argument expressions. Lambdas,
   blocks, and switches introduce the same mutual recursion. Olive functions
   receive a shared parser group explicitly. That group is one flat inner
   object with one slot per implementation. The named entry functions below
   describe the slots and hide those positions from the actual grammar.

   Every call, including a call to the same parser, passes the same group.
   These are ordinary VM function values: no special recursive-function
   object or cyclic heap structure is needed."

yam-apply (# (# "function" "arguments")
 (%call-indirect (%name "function") (%name "arguments")))

yam-read-type
 (\ (group input context) (yam-apply (. 0 group) (# group input context)))

yam-read-types
 (\ (group input context) (yam-apply (. 1 group) (# group input context)))

yam-read-parameters
 (\ (group input context) (yam-apply (. 2 group) (# group input context)))

yam-read-fields
 (\ (group input context) (yam-apply (. 3 group) (# group input context)))

yam-read-expressions
 (\ (group input context) (yam-apply (. 4 group) (# group input context)))

yam-read-block
 (\ (group input context) (yam-apply (. 5 group) (# group input context)))

yam-read-arguments
 (\ (group input context) (yam-apply (. 6 group) (# group input context)))

yam-read-cases
 (\ (group input context) (yam-apply (. 7 group) (# group input context)))

yam-read-lambda
 (\ (group input context) (yam-apply (. 8 group) (# group input context)))

yam-read-atom
 (\ (group input context) (yam-apply (. 9 group) (# group input context)))

yam-read-expression
 (\ (group input context) (yam-apply (. 10 group) (# group input context)))

yam-read-suffix
 (\ (group input context) (yam-apply (. 11 group) (# group input context)))

yam-read-definitions
 (\ (group input context) (yam-apply (. 12 group) (# group input context)))

# "A type starts with an uppercase name, a parameter placeholder, or fun.
   Function types keep their return type after the argument types."

# "A missing optional construct is different from an incomplete required one.
   The grammar uses need-parse after committing to an operand or a body, so a
   partially edited cell produces a diagnostic before any syntax field is
   read."

yam-need-parse (\ (parsed message) (if (nil? parsed) (crash message) parsed))

yam-operator-definition? (\ (group input)
 (: after
  (if (yam-token? input "[") (.0 (yam-read-parameters group (.1 input) nil))
   input)
  (yam-token? after "(")))

yam-read-type-body (\ (group input context)
 (cond (yam-token? input "fun")
  (: arguments (yam-read-types group (yam-expect (.1 input) "(") ")")
   (: returns (yam-read-type group (.0 arguments) nil)
    (if (nil? returns) (crash "Expected a return type")
     (# (.0 returns)
      (yam-type "fun"
       (flatten-to-inner (list-concat (.1 arguments) (# (.1 returns) nil))))))))
  (yam-token? input "_")
  (# (.1 input) (yam-named-type "_"))
  (yam-name? input true)
  (: name (.1 (.0 input))
   (: arguments
    (if (yam-token? (.1 input) "[") (yam-read-types group (.1 (.1 input)) "]")
     (# (.1 input) nil))
    (# (.0 arguments) (yam-type name (flatten-to-inner (.1 arguments))))))
  true nil))

# "Type argument lists and function signatures share delimiter handling.
   Parameter names in a function type are documentation, not part of its
   type."

yam-read-types-body (\ (group input context)
 (if (yam-token? input context) (# (.1 input) nil)
  (: named
   (if (if (yam-name? input false) (yam-token? (.1 input) ":") false)
    (.1 (.1 input))
    input)
   (: item (yam-read-type group named nil)
    (cond (nil? item) (crash "Expected a type") (yam-token? (.0 item) ",")
     (: rest (yam-read-types group (.1 (.0 item)) context)
      (# (.0 rest) (# (.1 item) (.1 rest))))
     true (# (yam-expect (.0 item) context) (# (.1 item) nil)))))))

# "A generic declaration introduces names rather than concrete types. Its
   parameter list is kept separate until type checking binds those names."

yam-read-parameters-body (\ (group input context)
 (cond (yam-token? input "]") (# (.1 input) nil) (yam-name? input true)
  (: name (.1 (.0 input))
   (if (yam-token? (.1 input) ",")
    (: rest (yam-read-parameters group (.1 (.1 input)) nil)
     (# (.0 rest) (# name (.1 rest))))
    (# (yam-expect (.1 input) "]") (# name nil))))
  true (crash "Expected a type parameter")))

# "A declaration records fields in source order. This order later becomes
   their memory layout, so checking and construction must both preserve it."

yam-read-fields-body (\ (group input context)
 (cond (yam-token? input context) (# (.1 input) nil) (yam-name? input false)
  (: name (.1 (.0 input))
   (: type
    (if (yam-token? (.1 input) ":") (yam-read-type group (.1 (.1 input)) nil)
     (# (.1 input) yam-type-nothing))
    (if (nil? type) (crash "Expected a field type")
     (: rest
      (if (yam-token? (.0 type) ",")
       (yam-read-fields group (.1 (.0 type)) context)
       (# (yam-expect (.0 type) context) nil))
      (# (.0 rest) (# (# name (.1 type)) (.1 rest)))))))
  true (crash "Expected a field name")))

# "Calls parse comma-separated expressions. Delimiters belong to the
   enclosing construct; an empty argument list is a successful parse."

yam-read-expressions-body (\ (group input context)
 (if (yam-token? input context) (# (.1 input) nil)
  (: value
   (yam-need-parse (yam-read-expression group input (- 0 1))
    "Expected an expression")
   (if (nil? value) (crash "Expected an expression")
    (: rest
     (if (yam-token? (.0 value) ",")
      (yam-read-expressions group (.1 (.0 value)) context)
      (# (yam-expect (.0 value) context) nil))
     (# (.0 rest) (# (.1 value) (.1 rest))))))))

# "A block is a sequence of expressions ending at its closing brace. The
   checker will introduce a local scope and carry bindings along this
   sequence."

yam-read-block-body (\ (group input context)
 (if (yam-token? input "}") (# (.1 input) yam-empty-block)
  (: value
   (yam-need-parse (yam-read-expression group input (- 0 1))
    "Expected an expression")
   (if (nil? value) (crash "Expected an expression or closing brace")
    (: rest (yam-read-block group (.0 value) nil)
     (# (.0 rest) (# "block" (# (.1 value) (.1 (.1 rest))))))))))

# "A record constructor names its fields. A bare field name is shorthand for
   reading the local variable with that same name."

yam-read-arguments-body (\ (group input context)
 (cond (yam-token? input ")") (# (.1 input) nil) (yam-name? input false)
  (: name (.1 (.0 input))
   (: value
    (if (yam-token? (.1 input) "=")
     (yam-need-parse (yam-read-expression group (.1 (.1 input)) (- 0 1))
      "Expected an expression")
     (# (.1 input) (# "name" name)))
    (: rest
     (if (yam-token? (.0 value) ",")
      (yam-read-arguments group (.1 (.0 value)) nil)
      (# (yam-expect (.0 value) ")") nil))
     (# (.0 rest) (# (# name (.1 value)) (.1 rest))))))
  true (crash "Expected a named field")))

# "Switch arms name variants and may bind their payload. A default arm
   supplies the result when none of the named variants matches."

yam-read-cases-body (\ (group input context)
 (cond (yam-token? input ")") (# (.1 input) (# nil nil))
  (yam-token? input "default")
  (: value
   (yam-need-parse (yam-read-expression group (.1 input) (- 0 1))
    "Expected an expression")
   (# (yam-expect (.0 value) ")") (# nil (# (.1 value) nil))))
  true
  (if (yam-name? input false)
   (: name (.1 (.0 input))
    (: binding
     (if (yam-token? (.1 input) "(")
      (also
       (assert (yam-name? (.1 (.1 input)) false)
        "Expected a payload binding name")
       (# (yam-expect (.1 (.1 (.1 input))) ")")
        (# (.1 (.0 (.1 (.1 input)))) nil)))
      (# (.1 input) nil))
     (: value
      (yam-need-parse (yam-read-expression group (.0 binding) (- 0 1))
       "Expected an expression")
      (: rest (yam-read-cases group (.0 value) nil)
       (# (.0 rest)
        (# (# (# name (.1 binding) (.1 value)) (.0 (.1 rest))) (.1 (.1 rest)))))
     )))
   (crash "Expected a switch case"))))

# "A lambda declares typed parameters followed by one result expression.
   Leading bindings are expressions too, so they use the same parser as a
   block."

yam-read-lambda-body (\ (group input context)
 (if (yam-token? input "->")
  (: body
   (yam-need-parse (yam-read-expression group (.1 input) (- 0 1))
    "Expected an expression")
   (# (.0 body) (# "lambda" nil (.1 body))))
  (also (assert (yam-name? input false) "Expected a lambda parameter or ->")
   (: name (.1 (.0 input))
    (: type (yam-read-type group (yam-expect (.1 input) ":") nil)
     (: rest
      (yam-read-lambda group
       (if (yam-token? (.0 type) ",") (.1 (.0 type)) (.0 type))
       nil)
      (# (.0 rest)
       (# "lambda" (# (# name (.1 type)) (.1 (.1 rest))) (.2 (.1 rest))))))))))

# "Atomic expressions establish the left operand before any suffix is read.
   Record and enum constructors start with a type; calls start with
   expressions."

yam-read-atom-body (\ (group input context)
 (cond (nil? input) nil (yam-token? input "_")
  (crash "The discard binding _ cannot be read")
  (or-3 (yam-kind? input "int") (yam-kind? input "float")
   (yam-kind? input "string"))
  (# (.1 input) (.0 input))
  (yam-token? input "-")
  (: number (.0 (.1 input))
   (cond (str= (.0 number) "int")
    (# (.1 (.1 input)) (# "int" (- 0 (.1 number))))
    (str= (.0 number) "float")
    (# (.1 (.1 input)) (# "float" (f* (int->float (- 0 1)) (.1 number))))
    true (crash "Expected a number after minus")))
  (yam-token? input "\\")
  (yam-read-lambda group (.1 input) nil)
  (yam-token? input "{")
  (yam-read-block group (.1 input) nil)
  (yam-token? input "if")
  (: condition
   (yam-need-parse (yam-read-expression group (.1 input) (- 0 1))
    "Expected an expression")
   (: yes
    (yam-need-parse (yam-read-expression group (.0 condition) (- 0 1))
     "Expected an expression")
    (: no
     (yam-need-parse (yam-read-expression group (.0 yes) (- 0 1))
      "Expected an expression")
     (# (.0 no)
      (# "switch" (.1 condition) (# (# "true" nil (.1 yes)) nil)
       (# (.1 no) nil))))))
  (yam-name? input true)
  (: type (yam-read-type group input nil)
   (if (yam-token? (.0 type) "(")
    (: fields (yam-read-arguments group (.1 (.0 type)) nil)
     (# (.0 fields) (# "struct" (.1 type) (.1 fields))))
    (: after (yam-expect (.0 type) ".")
     (: variant (.1 (.0 after))
      (: value
       (if (yam-token? (.1 after) "(")
        (: value
         (yam-need-parse (yam-read-expression group (.1 (.1 after)) (- 0 1))
          "Expected an expression")
         (# (yam-expect (.0 value) ")") (.1 value)))
        (# (.1 after) yam-empty-block))
       (# (.0 value) (# "enum" (.1 type) variant (.1 value))))))))
  (yam-name? input false)
  (# (.1 input) (# "name" (.1 (.0 input))))
  true nil))

# "A leading binding extends the sequence that follows it. Otherwise we parse
   an atomic expression, then let suffixes wrap it from the outside."

yam-read-expression-body (\ (group input context)
 (if (if (yam-name? input false) (yam-token? (.1 input) "=") false)
  (: name (.1 (.0 input))
   (: value
    (yam-need-parse (yam-read-expression group (.1 (.1 input)) (- 0 1))
     "Expected an expression")
    (: rest (yam-read-expression group (.0 value) context)
     (if (nil? rest)
      (# (.0 value) (# "block" (# (# "binding" name (.1 value)) nil)))
      (# (.0 rest)
       (# "block" (# (# "binding" name (.1 value)) (# (.1 rest) nil))))))))
  (: atom (yam-read-atom group input nil)
   (if (nil? atom) nil (yam-read-suffix group (.0 atom) (# (.1 atom) context))))
 ))

# "Member access and calls bind most tightly. Operators, short-circuiting
   and/or, variant tests, and switches then wrap that result in precedence
   order. Short-circuiting forms become switches, keeping their alternatives
   lazy."

yam-read-suffix-body (\ (group input context)
 (: left (.0 context)
  (: precedence (.1 context)
   (cond (yam-token? input ".")
    (if (yam-name? (.1 input) false)
     (yam-read-suffix group (.1 (.1 input))
      (# (# "member" left (.1 (.0 (.1 input)))) precedence))
     (# input left))
    (or (yam-token? input "(") (yam-token? input "["))
    (: types
     (if (yam-token? input "[")
      (: types (yam-read-types group (.1 input) "]")
       (# (.0 types) (# (.1 types) nil)))
      (# input nil))
     (: args (yam-read-expressions group (yam-expect (.0 types) "(") ")")
      (yam-read-suffix group (.0 args)
       (# (# "call" left (.1 types) (.1 args)) precedence))))
    (and (<= precedence (- 0 1)) (yam-token? input "%"))
    (: cases (yam-read-cases group (yam-expect (.1 input) "(") nil)
     (yam-read-suffix group (.0 cases)
      (# (# "switch" left (.0 (.1 cases)) (.1 (.1 cases))) precedence)))
    (and (<= precedence 0) (yam-token? input "is"))
    (yam-read-suffix group (.1 (.1 input))
     (#
      (# "switch" left (# (# (.1 (.0 (.1 input))) nil (# "name" "true")) nil)
       (# (# "name" "false") nil))
      precedence))
    (and (<= precedence 1) (yam-token? input "or"))
    (: right
     (yam-need-parse (yam-read-expression group (.1 input) 1)
      "Expected an expression")
     (yam-read-suffix group (.0 right)
      (#
       (# "switch" (# "call" (# "member" left "or") nil nil)
        (# (# "short_circuit" (# "$primary" nil) (# "name" "$primary"))
         (# (# "evaluate_alternative" nil (.1 right)) nil))
        nil)
       precedence)))
    (and (<= precedence 2) (yam-token? input "and"))
    (: right
     (yam-need-parse (yam-read-expression group (.1 input) 2)
      "Expected an expression")
     (yam-read-suffix group (.0 right)
      (#
       (# "switch" (# "call" (# "member" left "and") nil nil)
        (# (# "short_circuit" (# "$primary" nil) (# "name" "$primary"))
         (# (# "evaluate_alternative" nil (.1 right)) nil))
        nil)
       precedence)))
    (cond (or (nil? input) (> precedence 3)) false
     (yam-equal? (.0 (.0 input)) (.1 (.0 input)))
     (yam-operator-char? (first-char (.0 (.0 input))))
     true false)
    (: operator (.1 (.0 input))
     (if (or (str= operator "=") (yam-operator-definition? group (.1 input)))
      (# input left)
      (: right
       (yam-need-parse (yam-read-expression group (.1 input) 4)
        "Expected an expression")
       (if (nil? right) (# input left)
        (yam-read-suffix group (.0 right)
         (# (# "call" (# "name" operator) nil (# left (# (.1 right) nil)))
          precedence))))))
    true (# input left)))))

# "A code cell contains declarations. Types, functions, and globals remain
   distinct syntax nodes because checking handles each in a different phase.
   A function body is absent for a builtin declaration."

yam-read-definitions-body (\ (group input context)
 (if (nil? input) nil
  (: name (.1 (.0 input))
   (: parameters
    (if (yam-token? (.1 input) "[")
     (yam-read-parameters group (.1 (.1 input)) nil)
     (# (.1 input) nil))
    (: after (.0 parameters)
     (: parsed
      (cond (yam-name? input true)
       (: after (yam-expect after "=")
        (cond (yam-token? after "...")
         (# (.1 after) (# "builtin-type" name (.1 parameters)))
         (or (yam-token? after "struct") (yam-token? after "enum"))
         (: fields (yam-read-fields group (yam-expect (.1 after) "{") "}")
          (# (.0 fields) (# (.1 (.0 after)) name (.1 parameters) (.1 fields))))
         true
         (: type
          (yam-need-parse (yam-read-type group after nil)
           "Expected struct, enum, fun, or ... after =")
          (also
           (assert (nil? (.1 parameters))
            "Function aliases cannot declare parameters")
           (also
            (assert (str= (yam-type-name (.1 type)) "fun")
             "Only function aliases are supported")
            (# (.0 type) (# "alias" name (.1 type))))))))
       (yam-token? after "=")
       (: value
        (yam-need-parse (yam-read-expression group (.1 after) (- 0 1))
         "Expected an expression")
        (# (.0 value) (# "global" name (.1 value))))
       true
       (: arguments (yam-read-fields group (yam-expect after "(") ")")
        (: returns (yam-read-type group (.0 arguments) nil)
         (: body-start
          (yam-expect (if (nil? returns) (.0 arguments) (.0 returns)) "=")
          (: body
           (if (yam-token? body-start "...") (# (.1 body-start) nil)
            (yam-need-parse (yam-read-expression group body-start (- 0 1))
             "Expected an expression"))
           (# (.0 body)
            (# "function" name (.1 parameters) (.1 arguments)
             (if (nil? returns) yam-type-nothing (.1 returns))
             (.1 body))))))))
      (# (.1 parsed) (yam-read-definitions group (.0 parsed) nil))))))))

yam-parser-group
 (# yam-read-type-body yam-read-types-body yam-read-parameters-body
  yam-read-fields-body yam-read-expressions-body yam-read-block-body
  yam-read-arguments-body yam-read-cases-body yam-read-lambda-body
  yam-read-atom-body yam-read-expression-body yam-read-suffix-body
  yam-read-definitions-body)

yam-parse-code (\ (source)
 (yam-read-definitions yam-parser-group (yam-lex-yam (str-to-chars source)) nil)
)

# "Substituting generic arguments

   Parsing preserves names such as T. Once a call determines that T means
   Int, specialization replaces that parameter wherever it occurs in a source
   type. Other names keep their identity and specialize their arguments
   recursively.

   Types contain argument lists, and those lists contain types, so the
   traversal uses the same explicit function-group technique as the parser.
   Substitution maps are persistent values: specializing one call leaves
   other calls alone."

yam-substitute-type (\ (group type substitutions)
 (yam-apply (.0 group) (# group type substitutions)))

yam-substitute-arguments (\ (group arguments substitutions)
 (yam-apply (.1 group) (# group arguments substitutions)))

yam-substitute-type-body (\ (group type substitutions)
 (: found (yam-map-entry substitutions (yam-type-name type))
  (cond (nil? found)
   (yam-type (yam-type-name type)
    (flatten-to-inner
     (yam-substitute-arguments group (array-to-list (yam-type-arguments type))
      substitutions)))
   (nil? (yam-type-arguments type))
   (.1 found)
   true (crash (# "A type parameter cannot have arguments" type)))))

yam-substitute-arguments-body (\ (group arguments substitutions)
 (if (nil? arguments) nil
  (# (yam-substitute-type group (.0 arguments) substitutions)
   (yam-substitute-arguments group (.1 arguments) substitutions))))

yam-substitution-group
 (# yam-substitute-type-body yam-substitute-arguments-body)

yam-specialize (\ (type substitutions)
 (yam-substitute-type yam-substitution-group type substitutions))

# "Resolving a type name

   Parsing a type does not prove that it exists. A declaration environment
   gives meaning to its name: it may be a primitive, a record, an enum, or a
   function alias. A generic parameter is different again: its definition
   comes from the function being checked, not from the notebook's global type
   declarations.

   Type declarations are [kind, parameters, fields] for records and enums,
   [alias, target] for aliases, and [kind] for primitives. A field is [name,
   type]. Resolving a type checks its arity, resolves aliases, and
   recursively resolves its arguments. The environment is [types, functions,
   function_names, globals]. The first map gives each type name its
   declaration; the remaining fields will be used when checking expressions
   and declaration groups.

   The alias path detects aliases that refer back to themselves; ordinary
   recursive records and enums are valid and are not expanded here."

yam-types (\ (environment) (.0 environment))
yam-functions (\ (environment) (.1 environment))
yam-function-names (\ (environment) (.2 environment))
yam-globals (\ (environment) (.3 environment))

yam-environment
 (\ (types functions names globals) (# types functions names globals))

yam-type-parameter-map (\ (names index result)
 (if (= index (size names)) result
  (: name (. index names)
   (also
    (assert (nil? (yam-map-entry result name))
     (# "Duplicate type parameter" name))
    (rec names (+ index 1) (yam-map-put result name true))))))

yam-type-substitutions (\ (names arguments index result)
 (also
  (assert (= (size names) (size arguments)) "Wrong number of type arguments")
  (if (= index (size names)) result
   (rec names arguments (+ index 1)
    (yam-map-put result (. index names) (. index arguments))))))

yam-resolve (\ (group environment type parameters aliases)
 (yam-apply (.0 group) (# group environment type parameters aliases)))

yam-resolve-arguments (\ (group environment arguments parameters aliases)
 (yam-apply (.1 group) (# group environment arguments parameters aliases)))

yam-resolve-body (\ (group environment type parameters aliases)
 (: name (yam-type-name type)
  (: arguments (yam-type-arguments type)
   (cond (not-nil? (yam-map-entry parameters name))
    (also
     (assert (nil? arguments) (# "A type parameter cannot have arguments" name))
     type)
    (str= name "fun")
    (also (assert (not-nil? arguments) "A function type needs a return type")
     (yam-type name
      (yam-resolve-arguments group environment arguments parameters aliases)))
    true
    (: definition (yam-map-get (yam-types environment) name)
     (if (str= (.0 definition) "alias")
      (also
       (assert (nil? arguments) "Function aliases cannot take type arguments")
       (also
        (assert (nil? (yam-map-entry aliases name))
         (# "Cyclic function alias" name))
        (yam-resolve group environment (.1 definition) parameters
         (yam-map-put aliases name true))))
      (: arity
       (cond (or (str= (.0 definition) "struct") (str= (.0 definition) "enum"))
        (size (.1 definition))
        (str= (.0 definition) "list")
        1 true 0)
       (also
        (assert (= (size arguments) arity)
         (# "Wrong number of type arguments for" name))
        (yam-type name
         (yam-resolve-arguments group environment arguments parameters aliases))
       ))))))))

yam-resolve-arguments-list
 (\ (group environment arguments index parameters aliases)
  (if (= index (size arguments)) nil
   (# (yam-resolve group environment (. index arguments) parameters aliases)
    (rec group environment arguments (+ index 1) parameters aliases))))

yam-resolve-arguments-body (\ (group environment arguments parameters aliases)
 (flatten-to-inner
  (yam-resolve-arguments-list group environment arguments 0 parameters aliases))
)

yam-resolver-group (# yam-resolve-body yam-resolve-arguments-body)

yam-resolved-type (\ (environment type parameters)
 (yam-resolve yam-resolver-group environment type parameters nil))

# "Inferring generic arguments

   Calling identity(42) gives the checker two types to compare: the declared
   pattern T and the actual type Int. It records T = Int, then uses that same
   substitution when checking further arguments and determining the result.
   Repeated occurrences of T must agree. Never is accepted wherever a value
   is expected because evaluating that expression cannot reach the call.

   Inference can fail without making the program invalid: another overload
   may match. Its result is therefore [matched, substitutions], rather than a
   crash. Only the caller reports an error after all overloads have been
   considered."

yam-infer (\ (group pattern actual parameters substitutions)
 (yam-apply (.0 group) (# group pattern actual parameters substitutions)))

yam-infer-arguments (\ (group patterns actuals parameters substitutions index)
 (yam-apply (.1 group)
  (# group patterns actuals parameters substitutions index)))

yam-infer-body (\ (group pattern actual parameters substitutions)
 (cond (not-nil? (yam-map-entry parameters (yam-type-name pattern)))
  (if (not-nil? (yam-type-arguments pattern)) (# false substitutions)
   (: previous (yam-map-entry substitutions (yam-type-name pattern))
    (if (nil? previous)
     (# true (yam-map-put substitutions (yam-type-name pattern) actual))
     (# (yam-type-accepts? (.1 previous) actual) substitutions))))
  (yam-equal? actual yam-type-never)
  (# true substitutions)
  (and (str= (yam-type-name pattern) (yam-type-name actual))
   (= (size (yam-type-arguments pattern)) (size (yam-type-arguments actual))))
  (yam-infer-arguments group (yam-type-arguments pattern)
   (yam-type-arguments actual)
   parameters substitutions 0)
  true (# false substitutions)))

yam-infer-arguments-body
 (\ (group patterns actuals parameters substitutions index)
  (if (= index (size patterns)) (# true substitutions)
   (: result
    (yam-infer group (. index patterns) (. index actuals) parameters
     substitutions)
    (if (.0 result)
     (yam-infer-arguments group patterns actuals parameters (.1 result)
      (+ index 1))
     result))))

yam-inference-group (# yam-infer-body yam-infer-arguments-body)

yam-infer-type (\ (pattern actual parameters substitutions)
 (yam-infer yam-inference-group pattern actual parameters substitutions))

# "Giving expressions a meaning

   Syntax alone cannot tell whether x names a local, a global value, or a
   function. A checking context supplies the declaration environment, the
   local variables, and the current generic parameters. Globals have unique
   binding keys: the name selects the binding, and its key later selects the
   actual value. Rebinding a source name cannot change what an earlier
   function refers to. A checked expression records its type together with an
   operation whose names have already been resolved.

   Checked expressions are [type, kind, payload]. In particular, a named call
   records a function index and inferred substitutions, a field access
   records a field index, and a switch arm records a variant index. Lowering
   can then work with values and positions rather than repeating name lookup."

yam-context
 (\ (environment locals parameters) (# environment locals parameters))

yam-context-environment (\ (context) (.0 context))
yam-context-locals (\ (context) (.1 context))
yam-context-parameters (\ (context) (.2 context))

yam-context-with-locals (\ (context locals)
 (yam-context (yam-context-environment context) locals
  (yam-context-parameters context)))

yam-checked (\ (type kind payload) (# type kind payload))
yam-checked-type (\ (expression) (.0 expression))
yam-checked-kind (\ (expression) (.1 expression))
yam-checked-payload (\ (expression) (.2 expression))

yam-require-type (\ (expected value)
 (also
  (assert (yam-type-accepts? expected (yam-checked-type value))
   (# "Expected" expected "got" (yam-checked-type value)))
  value))

yam-fields-index (\ (fields name index)
 (cond (= index (size fields)) (crash (# "Unknown field or variant" name))
  (str= (.0 (. index fields)) name)
  index true (rec fields name (+ index 1))))

yam-field-definition (\ (environment type kind)
 (: definition (yam-map-get (yam-types environment) (yam-type-name type))
  (also (assert (str= (.0 definition) kind) (# "Expected" kind "got" type))
   definition)))

yam-declared-field-type (\ (environment type parameters definition index)
 (: substitutions
  (yam-type-substitutions (.1 definition) (yam-type-arguments type) 0 nil)
  (yam-resolved-type environment
   (yam-specialize (.1 (. index (.2 definition))) substitutions)
   parameters)))

# "A function declaration is [name, parameters, arguments, returns, body,
   globals]. Arguments are [name, type] entries. Keeping its global snapshot
   here ensures that specialization cannot see a later variable with the same
   name. The function index is stable while its body is being checked, which
   lets functions in the same cell refer to one another."

yam-function-name (\ (function) (.0 function))
yam-function-parameters (\ (function) (.1 function))
yam-function-arguments (\ (function) (.2 function))
yam-function-returns (\ (function) (.3 function))
yam-function-body (\ (function) (. 4 function))
yam-function-globals (\ (function) (. 5 function))

yam-typed-types-list (\ (values index)
 (if (= index (size values)) nil
  (# (yam-checked-type (. index values)) (rec values (+ index 1)))))

yam-typed-types (\ (values) (flatten-to-inner (yam-typed-types-list values 0)))

yam-field-types-list (\ (fields index)
 (if (= index (size fields)) nil
  (# (.1 (. index fields)) (rec fields (+ index 1)))))

yam-field-types (\ (fields) (flatten-to-inner (yam-field-types-list fields 0)))

yam-types-bottom? (\ (types index)
 (cond (= index (size types)) false (yam-equal? (. index types) yam-type-never)
  true true (rec types (+ index 1))))

yam-bind-fields (\ (fields index locals)
 (if (= index (size fields)) locals
  (: field (. index fields)
   (rec fields (+ index 1) (yam-map-put locals (.0 field) (.1 field))))))

yam-fields-find (\ (fields name index)
 (cond (= index (size fields)) nil (str= (.0 (. index fields)) name) (# index)
  true (rec fields name (+ index 1))))

yam-parameters-complete? (\ (parameters substitutions index)
 (cond (= index (size parameters)) true
  (nil? (yam-map-entry substitutions (. index parameters)))
  false true (rec parameters substitutions (+ index 1))))

yam-resolve-source-types (\ (environment types parameters)
 (if (nil? types) nil
  (# (yam-resolved-type environment (.0 types) parameters)
   (rec environment (.1 types) parameters))))

yam-check (\ (group context expression)
 (yam-apply (.0 group) (# group context expression)))

yam-check-sequence (\ (group context expressions reversed result stopped)
 (yam-apply (.1 group) (# group context expressions reversed result stopped)))

yam-check-many (\ (group context expressions)
 (yam-apply (.2 group) (# group context expressions)))

yam-check-field (\ (group context value name)
 (yam-apply (.3 group) (# group context value name)))

yam-check-lambda (\ (group context fields body)
 (yam-apply (. 4 group) (# group context fields body)))

yam-check-call
 (\ (group context source) (yam-apply (. 5 group) (# group context source)))

yam-check-invoke (\ (group context callee arguments)
 (yam-apply (. 6 group) (# group context callee arguments)))

yam-check-overloads (\ (group context candidates arguments explicit selected)
 (yam-apply (. 7 group)
  (# group context candidates arguments explicit selected)))

yam-check-struct
 (\ (group context source) (yam-apply (. 8 group) (# group context source)))

yam-check-struct-values (\ (group context fields values)
 (yam-apply (. 9 group) (# group context fields values)))

yam-check-enum
 (\ (group context source) (yam-apply (. 10 group) (# group context source)))

yam-check-switch
 (\ (group context source) (yam-apply (. 11 group) (# group context source)))

yam-check-cases (\ (group context type definition cases used result values)
 (yam-apply (. 12 group)
  (# group context type definition cases used result values)))

# "Checking dispatches on the syntax node, but delegates the substantial
   cases to separate functions. Literal nodes introduce primitive types;
   local reads use the current scope. A global read records the actual value
   from the environment so the eventual program can refer to it directly."

yam-check-literal (\ (environment type kind value)
 (: definition (yam-map-get (yam-types environment) type)
  (also
   (assert (str= (.0 definition) kind)
    (# "Literals require a builtin type" type))
   (yam-checked (yam-named-type type) "value" value))))

yam-check-function-value (\ (environment name)
 (: entry (yam-map-entry (yam-function-names environment) name)
  (: _ (assert (not-nil? entry) (# "Unknown name" name))
   (: candidates (. 1 entry)
    (: _ (assert (nil? (. 1 candidates)) (# "Ambiguous function value" name))
     (: index (. 0 candidates)
      (: function (. index (yam-functions environment))
       (: _
        (assert (nil? (yam-function-parameters function))
         "Function value needs concrete type arguments")
        (: type
         (yam-type "fun"
          (flatten-to-inner
           (list-concat
            (array-to-list (yam-field-types (yam-function-arguments function)))
            (# (yam-function-returns function) nil))))
         (yam-checked type "function-ref" (# index nil)))))))))))

yam-check-body (\ (group context expression)
 (: kind (.0 expression)
  (: environment (yam-context-environment context)
   (cond (str= kind "int")
    (yam-check-literal environment "Int" "int" (.1 expression))
    (str= kind "float")
    (yam-check-literal environment "Float" "float" (.1 expression))
    (str= kind "string")
    (yam-check-literal environment "String" "string" (.1 expression))
    (str= kind "name")
    (: local (yam-map-entry (yam-context-locals context) (.1 expression))
     (if (not-nil? local) (yam-checked (.1 local) "name" (.1 expression))
      (: global (yam-map-entry (yam-globals environment) (.1 expression))
       (if (nil? global) (yam-check-function-value environment (.1 expression))
        (yam-checked (.0 (.1 global)) "global" (.1 (.1 global)))))))
    (str= kind "block")
    (yam-check-sequence group context (.1 expression) nil
     (yam-named-type "Nothing")
     false)
    (str= kind "binding")
    (: value (yam-check group context (.2 expression))
     (yam-checked
      (if (yam-equal? (yam-checked-type value) yam-type-never) yam-type-never
       yam-type-nothing)
      "binding" (# (.1 expression) value)))
    (str= kind "member")
    (yam-check-field group context (yam-check group context (.1 expression))
     (.2 expression))
    (str= kind "lambda")
    (yam-check-lambda group context (.1 expression) (.2 expression))
    (str= kind "call")
    (yam-check-call group context expression)
    (str= kind "struct")
    (yam-check-struct group context expression)
    (str= kind "enum")
    (yam-check-enum group context expression)
    (str= kind "switch")
    (yam-check-switch group context expression)
    true (crash (# "Unknown expression" kind))))))

# "A block owns a scope. Each binding is checked against the preceding scope,
   then makes its type available to the rest of that block. Nested blocks get
   the persistent map as their starting point, so their additions stay local.
   Once a statement never returns, the whole sequence has type Never."

yam-check-sequence-body (\ (group context expressions reversed result stopped)
 (if (nil? expressions)
  (yam-checked (if stopped yam-type-never result) "block"
   (flatten-to-inner (reverse-list reversed nil)))
  (: expression (yam-check group context (.0 expressions))
   (: locals
    (if (str= (yam-checked-kind expression) "binding")
     (: binding (yam-checked-payload expression)
      (if (str= (.0 binding) "_") (yam-context-locals context)
       (yam-map-put (yam-context-locals context) (.0 binding)
        (yam-checked-type (.1 binding)))))
     (yam-context-locals context))
    (yam-check-sequence group (yam-context-with-locals context locals)
     (.1 expressions)
     (# expression reversed)
     (yam-checked-type expression)
     (if stopped true (yam-equal? (yam-checked-type expression) yam-type-never))
    )))))

yam-check-many-body (\ (group context expressions)
 (if (nil? expressions) nil
  (# (yam-check group context (.0 expressions))
   (yam-check-many group context (.1 expressions)))))

# "Field access first checks its receiver. Its concrete record arguments
   specialize the declared field type; the checked node only needs the final
   field position. Calling a field with a function type uses this same access
   before checking the call, whereas a method call inserts the receiver as
   the first argument of a named function."

yam-check-field-body (\ (group context value name)
 (: environment (yam-context-environment context)
  (: type (yam-checked-type value)
   (: definition (yam-field-definition environment type "struct")
    (: index (yam-fields-index (.2 definition) name 0)
     (yam-checked
      (yam-declared-field-type environment type
       (yam-context-parameters context)
       definition index)
      "field" (# value index)))))))

yam-resolve-argument-fields (\ (environment fields parameters names)
 (if (nil? fields) nil
  (: field (.0 fields)
   (also
    (assert (nil? (yam-map-entry names (.0 field)))
     (# "Duplicate parameter" (.0 field)))
    (# (# (.0 field) (yam-resolved-type environment (.1 field) parameters))
     (rec environment (.1 fields) parameters
      (yam-map-put names (.0 field) true)))))))

yam-check-lambda-body (\ (group context fields body)
 (: arguments
  (flatten-to-inner
   (yam-resolve-argument-fields (yam-context-environment context) fields
    (yam-context-parameters context)
    nil))
  (: checked
   (yam-check group
    (yam-context-with-locals context
     (yam-bind-fields arguments 0 (yam-context-locals context)))
    body)
   (yam-checked
    (yam-type "fun"
     (flatten-to-inner
      (list-concat (array-to-list (yam-field-types arguments))
       (# (yam-checked-type checked) nil))))
    "lambda" (# arguments checked (yam-context-locals context))))))

# "A call is either an invocation of a function value or an overload lookup.
   All argument expressions are checked before selecting an overload. A match
   infers every generic parameter and must be unique; return types do not
   take part in that selection. Explicit type arguments initialize the same
   inference."

yam-check-call-body (\ (group context source)
 (: callee (.1 source)
  (: environment (yam-context-environment context)
   (: name (if (str= (.0 callee) "name") (.1 callee) "")
    (: member (str= (.0 callee) "member")
     (: receiver (if member (yam-check group context (.1 callee)) nil)
      (: field
       (if member
        (: declared
         (yam-map-entry (yam-types environment)
          (yam-type-name (yam-checked-type receiver)))
         (cond (nil? declared) nil (str= (.0 (.1 declared)) "struct")
          (yam-fields-find (.2 (.1 declared)) (.2 callee) 0)
          true nil))
        nil)
       (if
        (or-4 (not-nil? field) (str= name "")
         (not-nil? (yam-map-entry (yam-context-locals context) name))
         (not-nil? (yam-map-entry (yam-globals environment) name)))
        (if (and member (nil? field))
         (yam-check-overloads group context
          (yam-map-get (yam-function-names environment) (.2 callee))
          (flatten-to-inner
           (# receiver (yam-check-many group context (.3 source))))
          (.2 source)
          nil)
         (also
          (assert (nil? (.2 source))
           "Function values cannot take type arguments")
          (yam-check-invoke group context
           (if (not-nil? field)
            (yam-check-field group context receiver (.2 callee))
            (yam-check group context callee))
           (.3 source))))
        (yam-check-overloads group context
         (yam-map-get (yam-function-names environment) name)
         (flatten-to-inner (yam-check-many group context (.3 source)))
         (.2 source)
         nil)))))))))

yam-check-invoke-arguments (\ (types arguments index)
 (if (= index (size arguments)) nil
  (also (yam-require-type (. index types) (. index arguments))
   (rec types arguments (+ index 1)))))

yam-check-invoke-body (\ (group context callee source-arguments)
 (: arguments
  (flatten-to-inner (yam-check-many group context source-arguments))
  (: signature (yam-checked-type callee)
   (also
    (assert (str= (yam-type-name signature) "fun") (# "Cannot call" signature))
    (: types (yam-type-arguments signature)
     (also
      (assert (= (size arguments) (- (size types) 1))
       "Wrong number of function arguments")
      (also (yam-check-invoke-arguments types arguments 0)
       (yam-checked
        (if (yam-types-bottom? (yam-typed-types arguments) 0) yam-type-never
         (. (- (size types) 1) types))
        "invoke" (# callee arguments)))))))))

yam-check-overloads-body
 (\ (group context candidates arguments explicit selected)
  (: environment (yam-context-environment context)
   (if (nil? candidates)
    (also
     (assert (not-nil? selected)
      (# "No matching function for argument types" (yam-typed-types arguments)))
     (: function (. (.0 selected) (yam-functions environment))
      (: returns (yam-specialize (yam-function-returns function) (.1 selected))
       (yam-checked
        (if (yam-types-bottom? (yam-typed-types arguments) 0) yam-type-never
         returns)
        "call" (# (.0 selected) (.1 selected) arguments)))))
    (: index (.0 candidates)
     (: function (. index (yam-functions environment))
      (: parameters (yam-function-parameters function)
       (: expected (yam-function-arguments function)
        (: substitutions
         (if (nil? explicit) (# true nil)
          (: types
           (flatten-to-inner
            (yam-resolve-source-types environment (.0 explicit)
             (yam-context-parameters context)))
           (if (= (size types) (size parameters))
            (# true (yam-type-substitutions parameters types 0 nil))
            (# false nil))))
         (: match
          (if (and (= (size expected) (size arguments)) (.0 substitutions))
           (yam-infer-arguments yam-inference-group (yam-field-types expected)
            (yam-typed-types arguments)
            (yam-type-parameter-map parameters 0 nil)
            (.1 substitutions)
            0)
           (# false nil))
          (: matches
           (if (.0 match)
            (if
             (and (= (size parameters) 1)
              (or-3 (str= (yam-function-name function) "name")
               (str= (yam-function-name function) "code")
               (str= (yam-function-name function) "arguments")))
             (and (= (size arguments) 1)
              (or
               (str= (yam-type-name (yam-checked-type (. 0 arguments))) "fun")
               (str= (yam-type-name (yam-checked-type (. 0 arguments)))
                "Dynamic")))
             (yam-parameters-complete? parameters (.1 match) 0))
            false)
           (also
            (assert (not (and matches (not-nil? selected)))
             "Ambiguous function call")
            (yam-check-overloads group context (.1 candidates) arguments
             explicit (if matches (# index (.1 match)) selected)))))))))))))

# "Record construction is checked by field name, but stored by declaration
   order. That permits readable named arguments without making the memory
   layout depend on their spelling order at the call site. Omitted generic
   arguments are inferred from all fields together before their concrete
   types are checked. Enum construction follows the same rule for its one
   variant payload."

yam-inferred-type-arguments (\ (parameters substitutions index)
 (if (= index (size parameters)) nil
  (# (yam-map-get substitutions (. index parameters))
   (rec parameters substitutions (+ index 1)))))

yam-constructor-type (\ (environment type definition substitutions parameters)
 (yam-resolved-type environment
  (if (and (nil? (yam-type-arguments type)) (not-nil? (.1 definition)))
   (yam-type (yam-type-name type)
    (flatten-to-inner
     (yam-inferred-type-arguments (.1 definition) substitutions 0)))
   type)
  parameters))

yam-infer-record-fields (\ (environment definition values index substitutions)
 (if (= index (size (.2 definition))) substitutions
  (: field (. index (.2 definition))
   (: actual (yam-map-get values (.0 field))
    (: parameters (yam-type-parameter-map (.1 definition) 0 nil)
     (: result
      (yam-infer-type (yam-resolved-type environment (.1 field) parameters)
       (yam-checked-type actual)
       parameters substitutions)
      (also (assert (.0 result) (# "Cannot infer a field type" (.0 field)))
       (rec environment definition values (+ index 1) (.1 result)))))))))

yam-ordered-record-values
 (\ (environment definition type parameters values index)
  (if (= index (size (.2 definition))) nil
   (: field (. index (.2 definition))
    (#
     (yam-require-type
      (yam-declared-field-type environment type parameters definition index)
      (yam-map-get values (.0 field)))
     (rec environment definition type parameters values (+ index 1))))))

yam-check-struct-values-body (\ (group context fields values)
 (if (nil? fields) values
  (: field (.0 fields)
   (also
    (assert (nil? (yam-map-entry values (.0 field)))
     (# "Duplicate field" (.0 field)))
    (yam-check-struct-values group context (.1 fields)
     (yam-map-put values (.0 field) (yam-check group context (.1 field))))))))

yam-check-known-record-fields (\ (definition source-fields)
 (if (nil? source-fields) nil
  (also (yam-fields-index (.2 definition) (.0 (.0 source-fields)) 0)
   (rec definition (.1 source-fields)))))

yam-check-struct-body (\ (group context source)
 (: environment (yam-context-environment context)
  (: original (.1 source)
   (: definition (yam-field-definition environment original "struct")
    (: values (yam-check-struct-values group context (.2 source) nil)
     (also (yam-check-known-record-fields definition (.2 source))
      (: inferred
       (if (nil? (yam-type-arguments original))
        (yam-infer-record-fields environment definition values 0 nil)
        nil)
       (: type
        (yam-constructor-type environment original definition inferred
         (yam-context-parameters context))
        (: fields
         (flatten-to-inner
          (yam-ordered-record-values environment definition type
           (yam-context-parameters context)
           values 0))
         (yam-checked
          (if (yam-types-bottom? (yam-typed-types fields) 0) yam-type-never
           type)
          "struct" fields))))))))))

yam-check-enum-body (\ (group context source)
 (: environment (yam-context-environment context)
  (: original (.1 source)
   (: definition (yam-field-definition environment original "enum")
    (: index (yam-fields-index (.2 definition) (.2 source) 0)
     (: value (yam-check group context (.3 source))
      (: inferred
       (if
        (and (nil? (yam-type-arguments original)) (not-nil? (.1 definition)))
        (: parameters (yam-type-parameter-map (.1 definition) 0 nil)
         (: result
          (yam-infer-type
           (yam-resolved-type environment (.1 (. index (.2 definition)))
            parameters)
           (yam-checked-type value)
           parameters nil)
          (also (assert (.0 result) "Cannot infer enum type arguments")
           (.1 result))))
        nil)
       (: type
        (yam-constructor-type environment original definition inferred
         (yam-context-parameters context))
        (also
         (yam-require-type
          (yam-declared-field-type environment type
           (yam-context-parameters context)
           definition index)
          value)
         (yam-checked
          (if (yam-equal? (yam-checked-type value) yam-type-never)
           yam-type-never type)
          "enum" (# index value)))))))))))

# "Each switch arm gets its own scope. A payload binding has the declared
   variant's specialized type. The result is the common type of the arms,
   treating Never as compatible with whichever branch can return. Tracking
   used variant positions detects duplicates and proves exhaustiveness when
   there is no default arm."

yam-check-cases-body (\ (group context type definition cases used result values)
 (if (nil? cases) (# used result (flatten-to-inner (reverse-list values nil)))
  (: arm (.0 cases)
   (: index (yam-fields-index (.2 definition) (.0 arm) 0)
    (also
     (assert (nil? (yam-map-entry used (.0 arm)))
      (# "Duplicate switch case" (.0 arm)))
     (: scope
      (if (nil? (.1 arm)) context
       (yam-context-with-locals context
        (yam-map-put (yam-context-locals context) (.0 (.1 arm))
         (yam-declared-field-type (yam-context-environment context) type
          (yam-context-parameters context)
          definition index))))
      (: value (yam-check group scope (.2 arm))
       (yam-check-cases group context type definition (.1 cases)
        (yam-map-put used (.0 arm) true)
        (yam-type-join result (yam-checked-type value))
        (# (# index (.1 arm) value) values)))))))))

yam-count-list
 (\ (items count) (if (nil? items) count (rec (.1 items) (+ count 1))))

yam-check-unreachable-cases (\ (group context cases result)
 (if (nil? cases) result
  (: arm (.0 cases)
   (: scope
    (if (nil? (.1 arm)) context
     (yam-context-with-locals context
      (yam-map-put (yam-context-locals context) (.0 (.1 arm)) yam-type-never)))
    (: value (yam-check group scope (.2 arm))
     (rec group context (.1 cases)
      (yam-type-join result (yam-checked-type value))))))))

yam-check-switch-body (\ (group context source)
 (: value (yam-check group context (.1 source))
  (: type (yam-checked-type value)
   (: other
    (if (nil? (.3 source)) nil (# (yam-check group context (.0 (.3 source)))))
    (if (yam-equal? type yam-type-never)
     (also
      (yam-check-unreachable-cases group context (.2 source)
       (if (nil? other) yam-type-never (yam-checked-type (.0 other))))
      (yam-checked yam-type-never "block" (# value)))
     (: definition
      (yam-field-definition (yam-context-environment context) type "enum")
      (: checked
       (yam-check-cases group context type definition (.2 source) nil
        (if (nil? other) yam-type-never (yam-checked-type (.0 other)))
        nil)
       (also
        (assert
         (if (nil? other)
          (= (yam-count-list (.2 source) 0) (size (.2 definition)))
          true)
         (# "Non-exhaustive switch" type))
        (yam-checked (.1 checked) "switch" (# value (.2 checked) other))))))))))

yam-checker-group (# yam-check-body yam-check-sequence-body yam-check-many-body
 yam-check-field-body yam-check-lambda-body yam-check-call-body
 yam-check-invoke-body yam-check-overloads-body yam-check-struct-body
 yam-check-struct-values-body yam-check-enum-body yam-check-switch-body
 yam-check-cases-body)

# "A cell is a declaration group

   Two declarations in the same cell can mention one another. We therefore
   register all type names first, validate their fields second, register all
   function signatures third, and only then check the function bodies. Global
   initializers come last and see earlier global values in reading order.

   The environment is [types, functions, function_names, globals]. Function
   names index overload lists whose entries are stable positions in the
   function array. Keeping these separate makes overload lookup local to one
   name."

yam-array-append-steps (\ (array index value)
 (also (yam-use-fuel)
  (if (= index (size array)) (# value nil)
   (# (. index array) (rec array (+ index 1) value)))))

yam-array-append
 (\ (array value) (flatten-to-inner (yam-array-append-steps array 0 value)))

yam-array-set-list (\ (array index value current)
 (also (yam-use-fuel)
  (if (= current (size array)) nil
   (# (if (= current index) value (. current array))
    (rec array index value (+ current 1))))))

yam-array-set (\ (array index value)
 (flatten-to-inner (yam-array-set-list array index value 0)))

yam-primitive-kind (\ (name)
 (cond (str= name "Int") "int" (str= name "Float") "float" (str= name "Byte")
  "byte" (str= name "String") "string" (str= name "List") "list"
  (or (str= name "Type") (str= name "Dynamic"))
  "opaque" true (crash (# "Unknown builtin type" name))))

yam-register-types (\ (environment definitions)
 (if (nil? definitions) environment
  (: definition (.0 definitions)
   (: kind (.0 definition)
    (: types (yam-types environment)
     (: updated
      (cond (str= kind "builtin-type")
       (: primitive (yam-primitive-kind (.1 definition))
        (also
         (assert
          (= (yam-count-list (.2 definition) 0)
           (if (str= primitive "list") 1 0))
          (# "Wrong builtin arity" (.1 definition)))
         (yam-map-put types (.1 definition) (# primitive))))
       (or (str= kind "struct") (str= kind "enum"))
       (yam-map-put types (.1 definition)
        (# kind (flatten-to-inner (.2 definition))
         (flatten-to-inner (.3 definition))))
       (str= kind "alias")
       (yam-map-put types (.1 definition) (# "alias" (.2 definition)))
       true types)
      (also
       (assert
        (if
         (or-4 (str= kind "builtin-type") (str= kind "struct")
          (str= kind "enum")
          (str= kind "alias"))
         (nil? (yam-map-entry types (.1 definition)))
         true)
        (# "Duplicate type" (.1 definition)))
       (rec
        (yam-environment updated (yam-functions environment)
         (yam-function-names environment)
         (yam-globals environment))
        (.1 definitions)))))))))

yam-validate-fields (\ (environment fields parameters names index)
 (if (= index (size fields)) nil
  (: field (. index fields)
   (also
    (assert (nil? (yam-map-entry names (.0 field)))
     (# "Duplicate field or variant" (.0 field)))
    (also (yam-resolved-type environment (.1 field) parameters)
     (rec environment fields parameters (yam-map-put names (.0 field) true)
      (+ index 1)))))))

yam-validate-parameters (\ (environment parameters index)
 (if (= index (size parameters)) nil
  (also
   (assert (nil? (yam-map-entry (yam-types environment) (. index parameters)))
    (# "Type parameter conflicts with an existing type" (. index parameters)))
   (rec environment parameters (+ index 1)))))

yam-validate-types (\ (environment definitions)
 (if (nil? definitions) nil
  (: source (.0 definitions)
   (also
    (cond (str= (.0 source) "alias")
     (yam-resolved-type environment (.2 source) nil)
     (or (str= (.0 source) "struct") (str= (.0 source) "enum"))
     (: definition (yam-map-get (yam-types environment) (.1 source))
      (also (yam-validate-parameters environment (.1 definition) 0)
       (yam-validate-fields environment (.2 definition)
        (yam-type-parameter-map (.1 definition) 0 nil)
        nil 0)))
     true nil)
    (rec environment (.1 definitions))))))

yam-signature-substitutions (\ (parameters index result)
 (if (= index (size parameters)) result
  (rec parameters (+ index 1)
   (yam-map-put result (. index parameters) (yam-type index (#))))))

yam-function-key (\ (function)
 (# (size (yam-function-parameters function))
  (yam-specialize
   (yam-type "arguments" (yam-field-types (yam-function-arguments function)))
   (yam-signature-substitutions (yam-function-parameters function) 0 nil))))

yam-check-duplicate-function (\ (functions indices function)
 (if (nil? indices) nil
  (also
   (assert
    (not
     (yam-equal? (yam-function-key (. (.0 indices) functions))
      (yam-function-key function)))
    (# "Duplicate function signature" (yam-function-name function)))
   (rec functions (.1 indices) function))))

yam-register-functions (\ (environment definitions)
 (if (nil? definitions) environment
  (: source (.0 definitions)
   (if (str= (.0 source) "function")
    (: parameters (flatten-to-inner (.2 source))
     (: parameter-map (yam-type-parameter-map parameters 0 nil)
      (: arguments
       (flatten-to-inner
        (yam-resolve-argument-fields environment (.3 source) parameter-map nil))
       (: returns (yam-resolved-type environment (. 4 source) parameter-map)
        (: function
         (# (.1 source) parameters arguments returns (. 5 source)
          (yam-globals environment))
         (: previous
          (yam-map-entry (yam-function-names environment) (.1 source))
          (: indices (if (nil? previous) nil (.1 previous))
           (also (yam-validate-parameters environment parameters 0)
            (also
             (yam-check-duplicate-function (yam-functions environment) indices
              function)
             (rec
              (yam-environment (yam-types environment)
               (yam-array-append (yam-functions environment) function)
               (yam-map-put (yam-function-names environment) (.1 source)
                (# (size (yam-functions environment)) indices))
               (yam-globals environment))
              (.1 definitions)))))))))))
    (rec environment (.1 definitions))))))

yam-check-function-bodies (\ (environment index)
 (if (= index (size (yam-functions environment))) environment
  (: function (. index (yam-functions environment))
   (: body (yam-function-body function)
    (if (nil? body) (rec environment (+ index 1))
     (: context
      (yam-context
       (yam-environment (yam-types environment) (yam-functions environment)
        (yam-function-names environment)
        (yam-function-globals function))
       (yam-bind-fields (yam-function-arguments function) 0 nil)
       (yam-type-parameter-map (yam-function-parameters function) 0 nil))
      (: checked
       (yam-require-type (yam-function-returns function)
        (yam-check yam-checker-group context body))
       (: replacement
        (# (yam-function-name function) (yam-function-parameters function)
         (yam-function-arguments function)
         (yam-function-returns function)
         checked (yam-function-globals function))
        (rec
         (yam-environment (yam-types environment)
          (yam-array-set (yam-functions environment) index replacement)
          (yam-function-names environment)
          (yam-globals environment))
         (+ index 1))))))))))

# "Runtime services are compiler functions too

   Type reflection and checked expression compilation remain available while
   a program runs. Their implementations are ordinary functions in this
   compiler. Generated calls embed those function values and pass the shared
   group explicitly; exported programs retain the helpers they reach in the
   same heap graph.

   The private routines below operate on raw objects. Only checked builtins
   can reach them from Yam, so this untyped implementation surface is not
   part of the notebook API. Their shared layouts are checked against the
   notebook's declarations before any cell initializer runs; the ABI section
   below spells out that contract. Public Type handles remain opaque, and
   Dynamic casts still check their recorded type before returning a value.

   First come small operations on arrays and packed strings. Runtime strings
   preserve zero bytes inside the text; only trailing padding is ignored."

yam-string-length-trim (\ (string length)
 (cond (= length 0) 0 (= (str-get string (- length 1)) 0)
  (rec string (- length 1))
  true length))

yam-string-length
 (\ (string) (yam-string-length-trim string (* (size string) 8)))

yam-string-chars-reversed (\ (string index result)
 (also (yam-use-fuel)
  (if (< index 0) result
   (rec string (- index 1) (# (str-get string index) result)))))

yam-string-chars (\ (string)
 (yam-string-chars-reversed string (- (yam-string-length string) 1) nil))

yam-string-bytes (\ (string) (flatten-to-inner (yam-string-chars string)))

yam-array-items (\ (array index)
 (also (yam-use-fuel)
  (if (= index (size array)) nil (# (. index array) (rec array (+ index 1))))))

yam-pack-bytes (\ (bytes) (chars-to-str (yam-array-items bytes 0)))

yam-string-concat (\ (left right)
 (chars-to-str (list-concat (yam-string-chars left) (yam-string-chars right))))

yam-array-range-list (\ (array start end)
 (also (yam-use-fuel)
  (if (= start end) nil (# (. start array) (rec array (+ start 1) end)))))

yam-array-range (\ (array start end)
 (also
  (assert (and-3 (>= start 0) (<= start end) (<= end (size array)))
   "List range out of bounds")
  (flatten-to-inner (yam-array-range-list array start end))))

yam-array-concat-steps (\ (left right index)
 (also (yam-use-fuel)
  (cond (< index (size left)) (# (. index left) (rec left right (+ index 1)))
   (= (- index (size left)) (size right))
   nil true (# (. (- index (size left)) right) (rec left right (+ index 1))))))

yam-array-concat
 (\ (left right) (flatten-to-inner (yam-array-concat-steps left right 0)))

yam-array-find-entry (\ (entries key index)
 (also (yam-use-fuel)
  (cond (= index (size entries)) (- 0 1)
   (yam-equal? (.0 (. index entries)) key)
   index true (rec entries key (+ index 1)))))

yam-abi-fields (\ (fields index)
 (if (= index (size fields)) nil
  (: field (. index fields)
   (#
    (# (.0 field)
     (.1
      (yam-read-type yam-parser-group (yam-lex-yam (str-to-chars (.1 field)))
       nil)))
    (rec fields (+ index 1))))))

yam-abi-layout (\ (name kind arity fields)
 (# name kind arity (flatten-to-inner (yam-abi-fields fields 0))))

yam-abi-layouts
 (# (yam-abi-layout "Int" "int" 0 (#)) (yam-abi-layout "Float" "float" 0 (#))
  (yam-abi-layout "Byte" "byte" 0 (#))
  (yam-abi-layout "String" "string" 0 (#))
  (yam-abi-layout "List" "list" 1 (#))
  (yam-abi-layout "Type" "opaque" 0 (#))
  (yam-abi-layout "Dynamic" "opaque" 0 (#))
  (yam-abi-layout "Nothing" "struct" 0 (#))
  (yam-abi-layout "Never" "enum" 0 (#))
  (yam-abi-layout "Maybe" "enum" 1 (# (# "some" "T") (# "none" "Nothing")))
  (yam-abi-layout "Execution" "enum" 1
   (# (# "returned" "T") (# "crashed" "String") (# "out_of_fuel" "Nothing")))
  (yam-abi-layout "Range" "struct" 1 (# (# "start" "T") (# "end" "T")))
  (yam-abi-layout "Iter" "struct" 1 (# (# "next" "fun() Maybe[Next[T]]")))
  (yam-abi-layout "Next" "struct" 1 (# (# "item" "T") (# "rest" "Iter[T]")))
  (yam-abi-layout "Ordering" "enum" 0
   (# (# "less" "Nothing") (# "equal" "Nothing") (# "greater" "Nothing")))
  (yam-abi-layout "Bool" "enum" 0
   (# (# "false" "Nothing") (# "true" "Nothing")))
  (yam-abi-layout "FieldType" "struct" 0
   (# (# "name" "String") (# "type" "Type")))
  (yam-abi-layout "StructType" "struct" 0 (# (# "fields" "List[FieldType]")))
  (yam-abi-layout "EnumType" "struct" 0 (# (# "variants" "List[FieldType]")))
  (yam-abi-layout "FunctionType" "struct" 0
   (# (# "arguments" "List[Type]") (# "returns" "Type")))
  (yam-abi-layout "TypeInfo" "enum" 0
   (# (# "int" "Nothing") (# "float" "Nothing") (# "byte" "Nothing")
    (# "string" "Nothing")
    (# "list" "Type")
    (# "dynamic" "Nothing")
    (# "type" "Nothing")
    (# "struct" "StructType")
    (# "enum" "EnumType")
    (# "function" "FunctionType")
    (# "opaque" "Nothing")))
  (yam-abi-layout "TypeFieldDefinition" "struct" 0
   (# (# "name" "String") (# "type" "String")))
  (yam-abi-layout "FunctionTypeDefinition" "struct" 0
   (# (# "arguments" "List[String]") (# "returns" "String")))
  (yam-abi-layout "TypeDefinition" "struct" 0
   (# (# "name" "String") (# "shape" "TypeShape")))
  (yam-abi-layout "TypeShape" "enum" 0
   (# (# "int" "Nothing") (# "float" "Nothing") (# "byte" "Nothing")
    (# "string" "Nothing")
    (# "list" "String")
    (# "dynamic" "Nothing")
    (# "type" "Nothing")
    (# "struct" "List[TypeFieldDefinition]")
    (# "enum" "List[TypeFieldDefinition]")
    (# "function" "FunctionTypeDefinition")
    (# "opaque" "Nothing")))
  (yam-abi-layout "Function" "struct" 0
   (# (# "arguments" "List[FieldType]") (# "body" "Expr")))
  (yam-abi-layout "Op" "enum" 0
   (# (# "equals" "Nothing") (# "type_info" "Nothing")
    (# "type_lookup" "Nothing")
    (# "type_equals" "Nothing")
    (# "type_name" "Nothing")
    (# "dynamic_type" "Nothing")
    (# "type_snapshot" "Nothing")
    (# "run" "Nothing")
    (# "garbage_collect" "Nothing")
    (# "try" "Nothing")
    (# "iterator_to_list" "Nothing")
    (# "string_equals" "Nothing")
    (# "string_bytes" "Nothing")
    (# "string_from_bytes" "Nothing")
    (# "string_concat" "Nothing")
    (# "crash" "Nothing")
    (# "bitcast_int_to_float" "Nothing")
    (# "bitcast_float_to_int" "Nothing")
    (# "int_to_float" "Nothing")
    (# "float_to_int" "Nothing")
    (# "float_add" "Nothing")
    (# "float_subtract" "Nothing")
    (# "float_multiply" "Nothing")
    (# "float_divide" "Nothing")
    (# "float_equals" "Nothing")
    (# "float_less" "Nothing")
    (# "float_greater" "Nothing")
    (# "float_less_equal" "Nothing")
    (# "float_greater_equal" "Nothing")
    (# "float_compare" "Nothing")
    (# "int_to_byte" "Nothing")
    (# "byte_to_int" "Nothing")
    (# "int_add" "Nothing")
    (# "int_subtract" "Nothing")
    (# "int_multiply" "Nothing")
    (# "int_divide" "Nothing")
    (# "int_modulo" "Nothing")
    (# "int_remainder" "Nothing")
    (# "byte_remainder" "Nothing")
    (# "int_and" "Nothing")
    (# "int_or" "Nothing")
    (# "int_xor" "Nothing")
    (# "int_compare" "Nothing")
    (# "byte_add" "Nothing")
    (# "byte_subtract" "Nothing")
    (# "byte_multiply" "Nothing")
    (# "byte_divide" "Nothing")
    (# "byte_modulo" "Nothing")
    (# "byte_and" "Nothing")
    (# "byte_or" "Nothing")
    (# "byte_xor" "Nothing")
    (# "byte_compare" "Nothing")
    (# "list_length" "Nothing")
    (# "list_get" "Nothing")
    (# "list_filled" "Nothing")
    (# "list_push" "Nothing")
    (# "list_push_all" "Nothing")
    (# "list_slice" "Nothing")
    (# "list_set" "Nothing")
    (# "list_reversed" "Nothing")
    (# "list_sum" "Nothing")
    (# "to_dynamic" "Nothing")
    (# "compile" "Nothing")
    (# "function_code" "Nothing")
    (# "function_name" "Nothing")
    (# "function_arguments" "Nothing")))
  (yam-abi-layout "OpExpr" "struct" 0 (# (# "op" "Op") (# "args" "List[Expr]")))
  (yam-abi-layout "Expr" "enum" 0
   (# (# "value" "Dynamic") (# "name" "FieldType") (# "binding" "BindingExpr")
    (# "if_" "If")
    (# "function" "Function")
    (# "call" "CallExpr")
    (# "struct" "StructExpr")
    (# "enum" "EnumExpr")
    (# "field" "FieldExpr")
    (# "switch" "Switch")
    (# "block" "List[Expr]")
    (# "expected" "ExpectedExpr")
    (# "functions" "FunctionsExpr")
    (# "op" "OpExpr")
    (# "list" "Type")
    (# "type" "Type")
    (# "to_static" "TypedUnaryExpr")))
  (yam-abi-layout "FunctionBinding" "struct" 0
   (# (# "name" "String") (# "type" "Type") (# "function" "Function")))
  (yam-abi-layout "FunctionsExpr" "struct" 0
   (# (# "bindings" "List[FunctionBinding]") (# "body" "Expr")))
  (yam-abi-layout "TypedUnaryExpr" "struct" 0
   (# (# "type" "Type") (# "value" "Expr")))
  (yam-abi-layout "BindingExpr" "struct" 0
   (# (# "name" "String") (# "value" "Expr") (# "body" "Expr")))
  (yam-abi-layout "If" "struct" 0
   (# (# "condition" "Expr") (# "then" "Expr") (# "otherwise" "Expr")))
  (yam-abi-layout "CallExpr" "struct" 0
   (# (# "function" "Expr") (# "arguments" "List[Expr]")))
  (yam-abi-layout "StructExpr" "struct" 0
   (# (# "type" "Type") (# "fields" "List[Expr]")))
  (yam-abi-layout "EnumExpr" "struct" 0
   (# (# "type" "Type") (# "variant" "String") (# "value" "Expr")))
  (yam-abi-layout "FieldExpr" "struct" 0
   (# (# "value" "Expr") (# "name" "String")))
  (yam-abi-layout "Switch" "struct" 0
   (# (# "value" "Expr") (# "cases" "List[CaseExpr]")
    (# "otherwise" "Maybe[Expr]")))
  (yam-abi-layout "ExpectedExpr" "struct" 0
   (# (# "type" "Type") (# "value" "Expr")))
  (yam-abi-layout "CaseExpr" "struct" 0
   (# (# "variant" "String") (# "binding" "Maybe[String]") (# "body" "Expr")))
  (yam-abi-layout "Chapter" "struct" 0
   (# (# "title" "String") (# "children" "List[Cell]")))
  (yam-abi-layout "Cell" "enum" 0
   (# (# "text" "String") (# "code" "String") (# "chapter" "Chapter")
    (# "eval" "String")))
  (yam-abi-layout "Color" "struct" 0
   (# (# "r" "Byte") (# "g" "Byte") (# "b" "Byte")))
  (yam-abi-layout "Position" "struct" 0 (# (# "x" "Float") (# "y" "Float")))
  (yam-abi-layout "Offset" "struct" 0 (# (# "x" "Float") (# "y" "Float")))
  (yam-abi-layout "Size" "struct" 0
   (# (# "width" "Float") (# "height" "Float")))
  (yam-abi-layout "Rectangle" "struct" 0
   (# (# "left" "Float") (# "top" "Float") (# "right" "Float")
    (# "bottom" "Float")))
  (yam-abi-layout "TransformationMatrix" "struct" 0
   (# (# "a" "Float") (# "b" "Float") (# "c" "Float") (# "d" "Float")
    (# "e" "Float")
    (# "f" "Float")))
  (yam-abi-layout "BezierTo" "struct" 0
   (# (# "control1" "Position") (# "control2" "Position") (# "to" "Position")))
  (yam-abi-layout "PathSegment" "enum" 0
   (# (# "move_to" "Position") (# "line_to" "Position")
    (# "bezier_to" "BezierTo")))
  (yam-abi-layout "Path" "struct" 0 (# (# "segments" "List[PathSegment]")))
  (yam-abi-layout "FillPath" "struct" 0
   (# (# "path" "Path") (# "color" "Color")))
  (yam-abi-layout "Transform" "struct" 0
   (# (# "by" "TransformationMatrix") (# "what" "DrawCommand")))
  (yam-abi-layout "Clip" "struct" 0
   (# (# "path" "Path") (# "what" "DrawCommand")))
  (yam-abi-layout "DrawCommand" "enum" 0
   (# (# "nothing" "Nothing") (# "fill_path" "FillPath")
    (# "transform" "Transform")
    (# "all" "List[DrawCommand]")
    (# "clip" "Clip")))
  (yam-abi-layout "Drawing" "struct" 0
   (# (# "draw" "DrawCommand") (# "size" "Size")))
  (yam-abi-layout "KeyPressed" "struct" 0
   (# (# "keycode" "Int") (# "control" "Bool") (# "shift" "Bool")
    (# "alt" "Bool")))
  (yam-abi-layout "CharEntered" "struct" 0 (# (# "codepoint" "Int")))
  (yam-abi-layout "MouseScrolled" "struct" 0
   (# (# "position" "Position") (# "delta" "Offset")))
  (yam-abi-layout "Event" "enum" 0
   (# (# "window_resized" "Size") (# "key_pressed" "KeyPressed")
    (# "char_entered" "CharEntered")
    (# "mouse_pressed" "Position")
    (# "mouse_moved" "Position")
    (# "mouse_scrolled" "MouseScrolled")
    (# "mouse_released" "Position")
    (# "mouse_left" "Nothing")
    (# "save_completed" "Nothing")
    (# "save_failed" "String")))
  (yam-abi-layout "AppCommand" "enum" 0 (# (# "save_notebook" "Chapter")))
  (yam-abi-layout "AppResult" "struct" 0
   (# (# "app" "App") (# "commands" "List[AppCommand]")))
  (yam-abi-layout "App" "struct" 0
   (# (# "render" "fun(Size) DrawCommand") (# "handle" "fun(Event) AppResult")))
 )

# "The runtime group holds the mutually recursive operations on reflected
   types and expressions. Named entry functions below describe its slots.
   Every implementation receives that same group as its last parameter,
   including calls to itself. Generated expressions can embed one of these
   ordinary function values alongside the group, using the same calling
   convention."

yam-primitive-type (\ (text)
 (. 1 (yam-read-type yam-parser-group (yam-lex-yam (str-to-chars text)) nil)))

yam-primitive-template (\ (layout)
 (: name (. 0 layout)
  (: kind (. 1 layout)
   (# name (if (= (. 2 layout) 0) (#) (# "T"))
    (#
     (cond (str= name "Type") "type" (str= name "Dynamic") "dynamic" true kind)
     (cond (str= name "List") (yam-named-type "T")
      (or (str= kind "struct") (str= kind "enum"))
      (. 3 layout)
      true (#)))))))

yam-primitive-templates-at (\ (index)
 (if (= index (size yam-abi-layouts)) nil
  (# (yam-primitive-template (. index yam-abi-layouts)) (rec (+ index 1)))))

yam-primitive-templates (flatten-to-inner (yam-primitive-templates-at 0))

yam-runtime-both (\ (x y group) (yam-apply (. 0 group) (# x y group)))
yam-runtime-tag (\ (x group) (yam-apply (. 1 group) (# x group)))
yam-runtime-kind-name (\ (index group) (yam-apply (. 2 group) (# index group)))
yam-runtime-child (\ (t key group) (yam-apply (. 3 group) (# t key group)))
yam-runtime-chr (\ (n group) (yam-apply (. 4 group) (# n group)))
yam-runtime-num (\ (n group) (yam-apply (. 5 group) (# n group)))
yam-runtime-logical (\ (key group) (yam-apply (. 6 group) (# key group)))
yam-runtime-colon (\ (data i group) (yam-apply (. 7 group) (# data i group)))

yam-runtime-cut-string
 (\ (value start group) (yam-apply (. 8 group) (# value start group)))

yam-runtime-require
 (\ (test message group) (yam-apply (. 9 group) (# test message group)))

yam-runtime-depth (\ (n group) (yam-apply (. 10 group) (# n group)))

yam-runtime-find
 (\ (entries key i group) (yam-apply (. 11 group) (# entries key i group)))

yam-runtime-lookup
 (\ (entries key group) (yam-apply (. 12 group) (# entries key group)))

yam-runtime-put (\ (entries key value group)
 (yam-apply (. 13 group) (# entries key value group)))


# "The recursive checker receives its primitive catalog alongside its
   functions. The catalog contains compiler-owned type patterns and
   implementations; public Expr values contain only operation tags and
   operands. No builtin handles cross the notebook boundary, and code can
   construct any primitive directly."

yam-runtime-group (yam-array-concat yam-runtime-base-group
 (# yam-runtime-check-primitive-body yam-primitive-specifications
  yam-runtime-check-functions-body yam-runtime-reflect-expression-body
  yam-runtime-reflect-many-body yam-runtime-reflect-function-body
  yam-runtime-reflect-bindings-body))

yam-builtin-lookup (\ (signature index)
 (if (= index (size yam-builtin-table)) (crash (# "Unknown builtin" signature))
  (: entry (. index yam-builtin-table)
   (if (str= (.0 entry) signature) entry (rec signature (+ index 1))))))

yam-builtin-description (\ (function)
 (: signature (yam-builtin-signature function)
  (: actual
   (yam-specialize (yam-function-returns function)
    (yam-builtin-parameter-substitutions function))
   (: description (yam-builtin-lookup signature 0)
    (: _
     (assert (yam-equal? actual (. 1 description))
      (# "Invalid builtin return type" signature actual))
     description)))))

yam-builtin-argument-code (\ (arguments index)
 (if (= index (size arguments)) nil
  (# (%name (.0 (. index arguments))) (rec arguments (+ index 1)))))

yam-builtin-body (\ (environment function substitutions)
 (: description (yam-builtin-description function)
  (: name (yam-function-name function)
   (: arguments
    (flatten-to-inner
     (yam-builtin-argument-code (yam-function-arguments function) 0))
    (cond (str= name "type")
     (%object
      (yam-reflect environment
       (yam-map-get substitutions (.0 (yam-function-parameters function)))))
     (str= name "to_dynamic")
     (%new-inner
      (#
       (%object
        (yam-reflect environment
         (yam-map-get substitutions (.0 (yam-function-parameters function)))))
       (.0 arguments)))
     (str= name "to_static")
     (%call (%object yam-builtin-cast)
      (# (.0 arguments)
       (%object
        (yam-reflect environment
         (yam-map-get substitutions (.0 (yam-function-parameters function)))))
       (%object yam-runtime-group)))
     true
     (%call (%object (.2 description))
      (yam-array-append
       (if
        (and
         (or-3 (str= name "code") (str= name "name") (str= name "arguments"))
         (if (nil? (yam-function-parameters function)) false
          (str=
           (yam-type-name
            (yam-map-get substitutions (. 0 (yam-function-parameters function)))
           )
           "Dynamic")))
        (#
         (%call (%object yam-function-unbox)
          (# (. 0 arguments) (%object yam-runtime-group))))
        arguments)
       (%object yam-runtime-group))))))))

# "Lowering checked expressions

   Checking resolved names and proved that operations are well typed.
   Lowering now constructs ordinary VM expression objects. A literal can
   embed its value directly; a global read can embed the value its binding
   denotes. Neither requires allocating an object in a separate target heap.

   Function calls need one extra piece of state: the specializations
   discovered so far. A request is [function_index, substitutions]. Requests
   get stable positions in one flat function group. Lowering a call reserves
   its position before lowering the callee body, so mutual recursion
   terminates discovery. Each top-level function receives that group as its
   last argument; nested lambdas obtain it through their captured values."

# "A function body mentions many values of the same types. Build one finite
   reflection table for the whole body and let every typed node share it.
   Without this step, retaining source meaning would repeatedly copy large
   snapshots such as Expr itself. The table is immutable and local to this
   specialization."

yam-map-entries (\ (tree)
 (if (nil? tree) nil
  (list-concat (rec (. 2 tree)) (list-concat (. 1 tree) (rec (. 3 tree))))))

yam-reflection-pending (\ (values index rest)
 (if (= index (size values)) rest
  (rec values (+ index 1) (# (. index values) rest))))

yam-reflection-local-types (\ (entries rest)
 (if (nil? entries) rest
  (rec (. 1 entries) (# (yam-checked (. 1 (. 0 entries)) "value" (#)) rest))))

yam-reflection-case-bodies (\ (cases index rest)
 (if (= index (size cases)) rest
  (rec cases (+ index 1) (# (. 2 (. index cases)) rest))))

yam-reflection-children (\ (environment expression pending)
 (: kind (yam-checked-kind expression)
  (: p (yam-checked-payload expression)
   (cond (or (str= kind "struct") (str= kind "block"))
    (yam-reflection-pending p 0 pending)
    (or (str= kind "enum") (str= kind "binding"))
    (# (. 1 p) pending)
    (str= kind "field")
    (# (. 0 p) pending)
    (str= kind "lambda")
    (yam-reflection-local-types (yam-map-entries (. 2 p)) (# (. 1 p) pending))
    (str= kind "invoke")
    (# (. 0 p) (yam-reflection-pending (. 1 p) 0 pending))
    (or (str= kind "call") (str= kind "function-ref"))
    (: function (. (. 0 p) (yam-functions environment))
     (: signature
      (yam-specialize
       (yam-type "fun"
        (yam-array-append (yam-field-types (yam-function-arguments function))
         (yam-function-returns function)))
       (. 1 p))
      (# (yam-checked signature "value" (#))
       (if (str= kind "call") (yam-reflection-pending (. 2 p) 0 pending)
        pending))))
    (str= kind "switch")
    (# (. 0 p)
     (yam-reflection-case-bodies (. 1 p) 0
      (if (nil? (. 2 p)) pending (# (. 0 (. 2 p)) pending))))
    true pending))))

yam-reflection-body-table (\ (environment substitutions pending state)
 (if (nil? pending)
  (flatten-to-inner (yam-reflection-entries (. 0 state) (. 1 state)))
  (: expression (. 0 pending)
   (: type (yam-specialize (yam-checked-type expression) substitutions)
    (: result (yam-reflect-key yam-reflection-group environment type state)
     (rec environment substitutions
      (yam-reflection-children environment expression (. 1 pending))
      (. 1 result)))))))

yam-context-with-reflections (\ (context expression parameters)
 (: initial
  (yam-reflection-local-types (array-to-list parameters) (# expression nil))
  (: table
   (yam-reflection-body-table (. 0 context) (. 2 context) initial
    (yam-reflection-state nil nil 0))
   (# (. 0 context) (. 1 context) (. 2 context) table))))

yam-lowering-context (\ (environment globals substitutions)
 (# environment globals substitutions (#)))

yam-lowering-environment (\ (context) (.0 context))
yam-lowering-globals (\ (context) (.1 context))
yam-lowering-substitutions (\ (context) (.2 context))

yam-code-state (\ (requests slots) (# requests slots))
yam-code-requests (\ (state) (.0 state))
yam-code-slots (\ (state) (.1 state))

yam-specialized-parameters (\ (parameters substitutions outer index)
 (if (= index (size parameters)) nil
  (#
   (: concrete
    (yam-specialize (yam-map-get substitutions (. index parameters)) outer)
    (also (yam-type-budget concrete) concrete))
   (rec parameters substitutions outer (+ index 1)))))

yam-request-function (\ (context index substitutions state)
 (also
  (assert (< (size (yam-code-requests state)) 8192)
   "Too many function specializations")
  (: function (. index (yam-functions (yam-lowering-environment context)))
   (: parameters (yam-function-parameters function)
    (: arguments
     (flatten-to-inner
      (yam-specialized-parameters parameters substitutions
       (yam-lowering-substitutions context)
       0))
     (: previous (yam-map-entry (yam-code-slots state) index)
      (: entries (if (nil? previous) nil (.1 previous))
       (: found (yam-bucket-entry entries arguments)
        (if (not-nil? found) (# (.1 found) state)
         (: slot (size (yam-code-requests state))
          (# slot
           (yam-code-state
            (yam-array-append (yam-code-requests state)
             (# index (yam-type-substitutions parameters arguments 0 nil)))
            (yam-map-put (yam-code-slots state) index
             (# (# arguments slot) entries))))))))))))))

yam-code-function (\ (names body) (# names (%use-fuel (%word 1) body)))

yam-code-unit (%new-inner (#))

yam-function-argument-names (\ (arguments index)
 (if (= index (size arguments)) nil
  (# (.0 (. index arguments)) (rec arguments (+ index 1)))))

yam-bucket-keys
 (\ (entries) (if (nil? entries) nil (# (.0 (.0 entries)) (rec (.1 entries)))))

yam-local-names (\ (tree)
 (if (nil? tree) nil
  (list-concat (rec (.2 tree))
   (list-concat (yam-bucket-keys (.1 tree)) (rec (.3 tree))))))

yam-capture-names (\ (names parameters)
 (cond (nil? names) nil (yam-array-has? parameters (.0 names))
  (rec (.1 names) parameters)
  true (# (.0 names) (rec (.1 names) parameters))))

yam-code-name-list
 (\ (names) (if (nil? names) nil (# (%name (.0 names)) (rec (.1 names)))))

yam-code-capture-bindings (\ (names index body)
 (if (nil? names) body
  (%let (.0 names) (%load (%name "$captures") (%word index))
   (rec (.1 names) (+ index 1) body))))

yam-lower (\ (group context expression state)
 (yam-apply (.0 group) (# group context expression state)))

yam-lower-many (\ (group context expressions index state reversed)
 (yam-apply (.1 group) (# group context expressions index state reversed)))

yam-lower-block (\ (group context expressions index state)
 (yam-apply (.2 group) (# group context expressions index state)))

yam-lower-lambda (\ (group context payload state)
 (yam-apply (.3 group) (# group context payload state)))

yam-lower-call (\ (group context payload state)
 (yam-apply (. 4 group) (# group context payload state)))

yam-lower-switch (\ (group context payload state)
 (yam-apply (. 5 group) (# group context payload state)))

yam-lower-cases (\ (group context cases index otherwise state)
 (yam-apply (. 6 group) (# group context cases index otherwise state)))

yam-describe (\ (group context expression state)
 (yam-apply (. 7 group) (# group context expression state)))

yam-describe-many (\ (group context expressions state index)
 (yam-apply (. 8 group) (# group context expressions state index)))

yam-describe-block (\ (group context expressions state index)
 (yam-apply (. 9 group) (# group context expressions state index)))

yam-describe-cases (\ (group context cases fields state index)
 (yam-apply (. 10 group) (# group context cases fields state index)))

yam-lower-body (\ (group context expression state)
 (: kind (yam-checked-kind expression)
  (: payload (yam-checked-payload expression)
   (cond (str= kind "value") (# (%object payload) state) (str= kind "global")
    (# (%object (yam-map-get (yam-lowering-globals context) payload)) state)
    (str= kind "name")
    (# (%name payload) state)
    (str= kind "function-ref")
    (: request (yam-request-function context (. 0 payload) (. 1 payload) state)
     (#
      (%new-inner
       (# (%load (%name "$functions") (%word (. 0 request)))
        (%name "$functions")))
      (. 1 request)))
    (str= kind "struct")
    (: fields (yam-lower-many group context payload 0 state nil)
     (# (%new-inner (.0 fields)) (.1 fields)))
    (str= kind "enum")
    (: value (yam-lower group context (.1 payload) state)
     (# (%new-inner (# (%object (.0 payload)) (.0 value))) (.1 value)))
    (str= kind "field")
    (: value (yam-lower group context (.0 payload) state)
     (# (%load (.0 value) (%word (.1 payload))) (.1 value)))
    (str= kind "block")
    (yam-lower-block group context payload 0 state)
    (str= kind "lambda")
    (yam-lower-lambda group context payload state)
    (str= kind "call")
    (yam-lower-call group context payload state)
    (str= kind "invoke")
    (: callee (yam-lower group context (.0 payload) state)
     (: arguments (yam-lower-many group context (.1 payload) 0 (.1 callee) nil)
      (#
       (%let "$callee" (.0 callee)
        (%call (%load (%load (%name "$callee") (%word 0)) (%word 4))
         (yam-array-append (.0 arguments) (%load (%name "$callee") (%word 1)))))
       (.1 arguments))))
    (str= kind "switch")
    (yam-lower-switch group context payload state)
    true (crash (# "Cannot lower checked expression" kind))))))

yam-lower-many-body (\ (group context expressions index state reversed)
 (if (= index (size expressions))
  (# (flatten-to-inner (reverse-list reversed nil)) state)
  (: value (yam-lower group context (. index expressions) state)
   (yam-lower-many group context expressions (+ index 1) (.1 value)
    (# (.0 value) reversed)))))

yam-lower-block-body (\ (group context expressions index state)
 (if (= index (size expressions)) (# yam-code-unit state)
  (: expression (. index expressions)
   (if (str= (yam-checked-kind expression) "binding")
    (: payload (yam-checked-payload expression)
     (: value (yam-lower group context (.1 payload) state)
      (: rest
       (yam-lower-block group context expressions (+ index 1) (.1 value))
       (#
        (if (str= (.0 payload) "_") (%also (.0 value) (.0 rest))
         (%let (.0 payload) (.0 value) (.0 rest)))
        (.1 rest)))))
    (: value (yam-lower group context expression state)
     (if (= (+ index 1) (size expressions)) value
      (: rest
       (yam-lower-block group context expressions (+ index 1) (.1 value))
       (# (%also (.0 value) (.0 rest)) (.1 rest)))))))))

# "A lambda captures local values, not the whole compiler environment. Its
   raw function has an extra captures parameter. The closure pairs that
   function with the captured values, including the current function group.
   This is the same two-field representation used by checked runtime
   compilation."

# "Keeping source meaning beside executable expressions

   Lowering also retains a value-level description of each monomorphized
   body. Most nodes already have the public Expr layout. A call to a
   top-level function uses one private node containing its group slot and
   checked function Type. Resolving that node is deliberately delayed until
   code is inspected.

   This pass never copies a callee body. A recursive call is one small
   reference, and different function values can share all the raw descriptors
   in the group."

yam-describe-type (\ (context type)
 (: concrete (yam-specialize type (yam-lowering-substitutions context))
  (: key (yam-type-name-text concrete)
   (: table (. 3 context)
    (: entry (yam-array-find-entry table key 0)
     (if (< entry 0) (yam-reflect (yam-lowering-environment context) concrete)
      (# table key)))))))

yam-describe-parameters (\ (context parameters index)
 (if (= index (size parameters)) nil
  (: p (. index parameters)
   (# (# (. 0 p) (yam-describe-type context (. 1 p)))
    (rec context parameters (+ index 1))))))

yam-describe-captures (\ (context names locals)
 (if (nil? names) nil
  (#
   (# (. 0 names) (yam-describe-type context (yam-map-get locals (. 0 names))))
   (rec context (. 1 names) locals))))

yam-describe-parameter-expressions (\ (fields index)
 (if (= index (size fields)) (#)
  (yam-array-concat (# (# 1 (. index fields))) (rec fields (+ index 1)))))

yam-describe-many-body (\ (group context expressions state index)
 (if (= index (size expressions)) (#)
  (yam-array-concat
   (# (yam-describe group context (. index expressions) state))
   (yam-describe-many group context expressions state (+ index 1)))))

yam-describe-block-body (\ (group context expressions state index)
 (cond (= index (size expressions)) (# 10 (#))
  (= (+ index 1) (size expressions))
  (yam-describe group context (. index expressions) state)
  true
  (: expression (. index expressions)
   (: payload (yam-checked-payload expression)
    (: rest (yam-describe-block group context expressions state (+ index 1))
     (if (str= (yam-checked-kind expression) "binding")
      (# 2
       (# (. 0 payload) (yam-describe group context (. 1 payload) state) rest))
      (# 10 (# (yam-describe group context expression state) rest))))))))

yam-describe-cases-body (\ (group context cases fields state index)
 (if (= index (size cases)) (#)
  (: arm (. index cases)
   (: name (. 0 (. (. 0 arm) fields))
    (: binding (if (nil? (. 1 arm)) (# 1 (#)) (# 0 (. 0 (. 1 arm))))
     (: body (yam-describe group context (. 2 arm) state)
      (yam-array-concat (# (# name binding body))
       (yam-describe-cases group context cases fields state (+ index 1)))))))))

yam-describe-call (\ (group context payload state)
 (: request (yam-request-function context (. 0 payload) (. 1 payload) state)
  (: source
   (. (. 0 payload) (yam-functions (yam-lowering-environment context)))
   (: substitutions (. 1 (. (. 0 request) (yam-code-requests (. 1 request))))
    (: type
     (yam-type "fun"
      (yam-array-append (yam-field-types (yam-function-arguments source))
       (yam-function-returns source)))
     (: snapshot
      (yam-describe-type context (yam-specialize type substitutions))
      (: callee (# (- 0 1) (# (. 0 request) snapshot))
       (# 5 (# callee (yam-describe-many group context (. 2 payload) state 0))))
     ))))))

yam-describe-body (\ (group context expression state)
 (: kind (yam-checked-kind expression)
  (: p (yam-checked-payload expression)
   (: type (yam-checked-type expression)
    (cond (str= kind "value") (# 0 (# (yam-describe-type context type) p))
     (str= kind "global")
     (# 0
      (# (yam-describe-type context type)
       (yam-map-get (yam-lowering-globals context) p)))
     (str= kind "function-ref")
     (: request (yam-request-function context (. 0 p) (. 1 p) state)
      (# (- 0 1) (# (. 0 request) (yam-describe-type context type))))
     (str= kind "name")
     (# 1 (# p (yam-describe-type context type)))
     (str= kind "struct")
     (if (str= (yam-type-name type) "Never")
      (# 10 (yam-describe-many group context p state 0))
      (# 6
       (# (yam-describe-type context type)
        (yam-describe-many group context p state 0))))
     (str= kind "enum")
     (if (str= (yam-type-name type) "Never")
      (yam-describe group context (. 1 p) state)
      (: definition
       (yam-field-definition (yam-lowering-environment context) type "enum")
       (# 7
        (# (yam-describe-type context type) (. 0 (. (. 0 p) (. 2 definition)))
         (yam-describe group context (. 1 p) state)))))
     (str= kind "field")
     (: definition
      (yam-field-definition (yam-lowering-environment context)
       (yam-checked-type (. 0 p))
       "struct")
      (# 8
       (# (yam-describe group context (. 0 p) state)
        (. 0 (. (. 1 p) (. 2 definition))))))
     (str= kind "block")
     (yam-describe-block group context p state 0)
     (str= kind "lambda")
     (# 4
      (# (flatten-to-inner (yam-describe-parameters context (. 0 p) 0))
       (yam-describe group context (. 1 p) state)))
     (str= kind "call")
     (yam-describe-call group context p state)
     (str= kind "invoke")
     (# 5
      (# (yam-describe group context (. 0 p) state)
       (yam-describe-many group context (. 1 p) state 0)))
     (str= kind "switch")
     (: definition
      (yam-field-definition (yam-lowering-environment context)
       (yam-checked-type (. 0 p))
       "enum")
      (# 9
       (# (yam-describe group context (. 0 p) state)
        (yam-describe-cases group context (. 1 p) (. 2 definition) state 0)
        (if (nil? (. 2 p)) (# 1 (#))
         (# 0 (yam-describe group context (. 0 (. 2 p)) state))))))
     true (crash (# "Cannot describe expression" kind)))))))

yam-describe-primitive (\ (index types values)
 (cond (= index 52) (# 14 (. 0 types)) (= index 62) (# 15 (. 0 types))
  (= index 64)
  (# 16 (# (. 0 types) (. 0 values)))
  true (# 13 (# (# (. index yam-primitive-op-tags) (#)) values))))

yam-describe-builtin (\ (context function)
 (: description (yam-builtin-description function)
  (: index (. 3 description)
   (: parameters (yam-function-parameters function)
    (: types
     (if (nil? parameters) (#)
      (#
       (yam-describe-type context
        (yam-map-get (yam-lowering-substitutions context) (. 0 parameters)))))
     (: fields
      (flatten-to-inner
       (yam-describe-parameters context (yam-function-arguments function) 0))
      (: names (yam-describe-parameter-expressions fields 0)
       (yam-describe-primitive index types names))))))))

yam-lower-lambda-body (\ (group context payload state)
 (: parameters (flatten-to-inner (yam-function-argument-names (. 0 payload) 0))
  (: names (yam-capture-names (yam-local-names (. 2 payload)) parameters)
   (: body (yam-lower group context (. 1 payload) state)
    (: bound
     (yam-code-capture-bindings names 0
      (%let "$functions"
       (%load (%name "$captures") (%word (yam-count-list names 0)))
       (. 0 body)))
     (: code
      (yam-code-function (yam-array-append parameters "$captures") bound)
      (: raw
       (# "\\"
        (flatten-to-inner (yam-describe-captures context names (. 2 payload)))
        (flatten-to-inner (yam-describe-parameters context (. 0 payload) 0))
        (yam-describe group context (. 1 payload) (. 1 body))
        code (yam-count-list names 0) (#) 0)
       (#
        (%new-inner
         (# (%object raw)
          (%new-inner
           (flatten-to-inner
            (list-concat (yam-code-name-list names)
             (# (%name "$functions") nil))))))
        (. 1 body)))))))))

yam-lower-call-body (\ (group context payload state)
 (: request (yam-request-function context (.0 payload) (.1 payload) state)
  (: arguments (yam-lower-many group context (.2 payload) 0 (.1 request) nil)
   (#
    (%call (%load (%load (%name "$functions") (%word (.0 request))) (%word 4))
     (yam-array-append (.0 arguments) (%name "$functions")))
    (.1 arguments)))))

yam-lower-switch-body (\ (group context payload state)
 (: value (yam-lower group context (.0 payload) state)
  (: other
   (if (nil? (.2 payload)) (# (%unreachable) (.1 value))
    (yam-lower group context (.0 (.2 payload)) (.1 value)))
   (: cases
    (yam-lower-cases group context (.1 payload) 0 (.0 other) (.1 other))
    (# (%let "$switch" (.0 value) (.0 cases)) (.1 cases))))))

yam-lower-cases-body (\ (group context cases index otherwise state)
 (if (= index (size cases)) (# otherwise state)
  (: arm (. index cases)
   (: branch (yam-lower group context (.2 arm) state)
    (: rest
     (yam-lower-cases group context cases (+ index 1) otherwise (.1 branch))
     (: body
      (if (nil? (.1 arm)) (.0 branch)
       (%let (.0 (.1 arm)) (%load (%name "$switch") (%word 1)) (.0 branch)))
      (#
       (%if
        (%and
         (%compare (%load (%load (%name "$switch") (%word 0)) (%word 0))
          (%word (.0 arm)))
         (%word 1))
        body (.0 rest))
       (.1 rest))))))))

yam-lowering-group (# yam-lower-body yam-lower-many-body yam-lower-block-body
 yam-lower-lambda-body yam-lower-call-body yam-lower-switch-body
 yam-lower-cases-body yam-describe-body yam-describe-many-body
 yam-describe-block-body yam-describe-cases-body)

# "Finishing the function group

   Lowering an expression discovers its callees. Lowering those callees may
   discover more specializations, so we consume the request array until no
   new request remains. Bodies receive the group at runtime rather than
   containing the group as a constant; that is what keeps this heap graph
   finite.

   The per-function checkpoint keeps the emitted body and newly discovered
   requests, and discards temporary lowering structures. The completed array
   can then be passed to any of its functions or embedded in a public
   closure."

yam-lower-request-inner (\ (environment globals request state)
 (: function (. (. 0 request) (yam-functions environment))
  (: context
   (yam-context-with-reflections
    (yam-lowering-context environment globals (. 1 request))
    (if (nil? (yam-function-body function))
     (yam-checked (yam-function-returns function) "value" (#))
     (yam-function-body function))
    (yam-function-arguments function))
   (: result
    (if (nil? (yam-function-body function))
     (# (yam-builtin-body environment function (. 1 request)) state)
     (yam-lower yam-lowering-group context (yam-function-body function) state))
    (: code
     (yam-code-function
      (flatten-to-inner
       (list-concat
        (yam-function-argument-names (yam-function-arguments function) 0)
        (# "$functions" nil)))
      (. 0 result))
     (: body
      (if (nil? (yam-function-body function))
       (yam-describe-builtin context function)
       (yam-describe yam-lowering-group context (yam-function-body function)
        (. 1 result)))
      (: parameters
       (flatten-to-inner
        (yam-describe-parameters context (yam-function-arguments function) 0))
       (: types
        (yam-specialized-parameters (yam-function-parameters function)
         (. 1 request)
         nil 0)
        (: label
         (str-concat-3 (yam-function-name function)
          (if (nil? types) ""
           (str-concat-3 "["
            (yam-type-text-arguments yam-type-text-group
             (flatten-to-inner types)
             0 (yam-count-list types 0))
            "]"))
          (str-concat-3 "("
           (yam-type-text-arguments yam-type-text-group
            (yam-type-arguments
             (yam-specialize
              (yam-type "arguments"
               (yam-field-types (yam-function-arguments function)))
              (.1 request)))
            0 (size parameters))
           ")"))
         (# (# label (#) parameters body code (- 0 1) (#) 0) (. 1 result))))))))
  )))

yam-lower-request (# (# "environment" "globals" "request" "state")
 (%collect-garbage
  (%call (%object yam-lower-request-inner)
   (# (%name "environment") (%name "globals") (%name "request") (%name "state"))
  )))

yam-finish-group (\ (environment globals state index reversed)
 (if (= index (size (yam-code-requests state)))
  (flatten-to-inner (reverse-list reversed nil))
  (: result
   (yam-lower-request environment globals (. index (yam-code-requests state))
    state)
   (rec environment globals (.1 result) (+ index 1) (# (.0 result) reversed)))))

yam-compile-expression (\ (environment globals expression)
 (: lowered
  (yam-lower yam-lowering-group (yam-lowering-context environment globals nil)
   expression (yam-code-state (#) nil))
  (: functions (yam-finish-group environment globals (.1 lowered) 0 nil)
   (# (.0 lowered) functions))))

yam-execute-entry (# (# "entry" "functions")
 (yam-code-sandbox (%object 1000000)
  (%call (%name "entry") (# (%name "functions")))))

yam-execute-expression (\ (environment globals expression)
 (: program (yam-compile-expression environment globals expression)
  (: entry (yam-code-function (# "$functions") (.0 program))
   (: execution (yam-execute-entry entry (.1 program))
    (cond (= (.0 execution) 0) (.1 execution) (= (.0 execution) 1)
     (crash (.1 execution))
     true (crash "Global initializer ran out of fuel"))))))

# "Checking the boundary with the notebook and host

   Most records are entirely described by the source and may use any layout.
   Some values cross a boundary whose reader already knows their
   representation: Chapter and Cell come from the host. Drawings and app
   events cross that same boundary. Type, Dynamic, and Expr are shared with
   checked compilation.

   Those declarations form a fixed ABI. We validate names, type parameters,
   field types, and declaration order, rather than adding layout metadata to
   each value. Validation happens before executing a cell's initializers, so
   a changed builtin representation cannot cause a helper to read the wrong
   field.

   The table spells out the contract in source terms. T is the canonical name
   for a declaration's first parameter; its spelling in the notebook may
   differ."

yam-abi-canonical-substitutions (\ (parameters index substitutions)
 (if (= index (size parameters)) substitutions
  (rec parameters (+ index 1)
   (yam-map-put substitutions (. index parameters) (yam-named-type "T")))))

yam-abi-check-fields
 (\ (environment actual expected parameters substitutions index)
  (if (= index (size expected)) nil
   (: field (. index actual)
    (: contract (. index expected)
     (also
      (assert (str= (.0 field) (.0 contract))
       (# "ABI field order mismatch" (.0 contract)))
      (also
       (assert
        (yam-equal?
         (yam-specialize (yam-resolved-type environment (.1 field) parameters)
          substitutions)
         (.1 contract))
        (# "ABI field type mismatch" (.0 contract)))
       (rec environment actual expected parameters substitutions (+ index 1)))))
   )))

yam-abi-check-layout (\ (environment layout)
 (: present (yam-map-entry (yam-types environment) (.0 layout))
  (if (nil? present) nil
   (: definition (.1 present)
    (: kind (.0 definition)
     (also (assert (str= kind (.1 layout)) (# "ABI kind mismatch" (.0 layout)))
      (if (or (str= kind "struct") (str= kind "enum"))
       (: parameters (.1 definition)
        (also
         (assert (= (size parameters) (.2 layout))
          (# "ABI parameter mismatch" (.0 layout)))
         (also
          (assert (= (size (.2 definition)) (size (.3 layout)))
           (# "ABI field count mismatch" (.0 layout)))
          (yam-abi-check-fields environment (.2 definition) (.3 layout)
           (yam-type-parameter-map parameters 0 nil)
           (yam-abi-canonical-substitutions parameters 0 nil)
           0))))
       nil)))))))

yam-validate-abi (\ (environment index)
 (if (= index (size yam-abi-layouts)) nil
  (also (yam-abi-check-layout environment (. index yam-abi-layouts))
   (rec environment (+ index 1)))))

# "Compiling the notebook in reading order

   A compilation state owns the current declaration environment and the
   values of global bindings. No parsed-cell cache is exported to the
   program. Global bindings get unique integer keys. A checked global read
   records that key, so rebinding the same source name later cannot change an
   earlier function.

   A cell first registers and checks declarations. Its initializers then run
   in order and extend the value environment. The local collection checkpoint
   keeps the resulting state and discards parser cursors, inference maps, and
   other temporary work that is no longer reachable. Text and eval cells are
   skipped."

yam-compilation (\ (environment values next) (# environment values next))
yam-compilation-environment (\ (state) (.0 state))
yam-compilation-values (\ (state) (.1 state))
yam-compilation-next (\ (state) (.2 state))

yam-validate-builtin-functions (\ (environment index)
 (if (= index (size (yam-functions environment))) nil
  (: function (. index (yam-functions environment))
   (also
    (if (nil? (yam-function-body function)) (yam-builtin-description function)
     nil)
    (rec environment (+ index 1))))))

yam-compile-globals (\ (state definitions)
 (if (nil? definitions) state
  (: definition (.0 definitions)
   (if (str= (.0 definition) "global")
    (: environment (yam-compilation-environment state)
     (: expression
      (yam-check yam-checker-group (yam-context environment nil nil)
       (.2 definition))
      (: value
       (yam-execute-expression environment (yam-compilation-values state)
        expression)
       (if (str= (.1 definition) "_") (rec state (.1 definitions))
        (: index (yam-compilation-next state)
         (: binding (# (yam-checked-type expression) index)
          (rec
           (yam-compilation
            (yam-environment (yam-types environment)
             (yam-functions environment)
             (yam-function-names environment)
             (yam-map-put (yam-globals environment) (.1 definition) binding))
            (yam-map-put (yam-compilation-values state) index value)
            (+ index 1))
           (.1 definitions))))))))
    (rec state (.1 definitions))))))

yam-compile-cell-inner (\ (state source)
 (: before (yam-compilation-environment state)
  (: start (size (yam-functions before))
   (: definitions (yam-parse-code source)
    (: types (yam-register-types before definitions)
     (also (yam-validate-types types definitions)
      (also (yam-validate-abi types 0)
       (: declared (yam-register-functions types definitions)
        (also (yam-validate-builtin-functions declared start)
         (: environment (yam-check-function-bodies declared start)
          (yam-compile-globals
           (yam-compilation environment (yam-compilation-values state)
            (yam-compilation-next state))
           definitions)))))))))))

yam-compile-cell (# (# "state" "source")
 (%collect-garbage
  (%call (%object yam-compile-cell-inner) (# (%name "state") (%name "source"))))
)

yam-compile-children (\ (state children index)
 (if (= index (size children)) state
  (: cell (. index children)
   (: kind (.0 cell)
    (cond (= kind 1)
     (rec (yam-compile-cell state (.1 cell)) children (+ index 1))
     (= kind 2)
     (: nested (rec state (.1 (.1 cell)) 0) (rec nested children (+ index 1)))
     true (rec state children (+ index 1)))))))

yam-compile-document (\ (chapter)
 (yam-compile-children
  (yam-compilation (yam-environment nil (#) nil nil) nil 0)
  (.1 chapter)
  0))

# "The entry point

   The host supplies the current Chapter when it runs a compiled notebook.
   main receives only that document. Its live compiler, if any, starts from
   the document rather than a private bootstrap context.

   We request the selected function and follow its specialization
   dependencies. The resulting VM entry supplies the completed function group
   and the current document. It can run immediately or be exported with its
   reachable objects."

yam-select-main (\ (environment candidates)
 (if (nil? candidates) (crash "Expected main(Chapter)")
  (: index (.0 candidates)
   (: function (. index (yam-functions environment))
    (: arguments (yam-function-arguments function)
     (if
      (if
       (and (nil? (yam-function-parameters function)) (= (size arguments) 1))
       (yam-equal? (.1 (.0 arguments)) (yam-named-type "Chapter"))
       false)
      index (rec environment (.1 candidates))))))))

yam-compile-notebook-inner (\ (notebook)
 (: state (yam-compile-document notebook)
  (: environment (yam-compilation-environment state)
   (: values (yam-compilation-values state)
    (: selected
     (yam-select-main environment
      (yam-map-get (yam-function-names environment) "main"))
     (: request
      (yam-request-function (yam-lowering-context environment values nil)
       selected nil (yam-code-state (#) nil))
      (: compiled (yam-finish-group environment values (.1 request) 0 nil)
       (: functions compiled
        (yam-code-function (# "$notebook")
         (%call (%object (. 4 (. (.0 request) functions)))
          (# (%name "$notebook") (%object functions))))))))))))

yam-compile-notebook (# (# "notebook")
 (%collect-garbage
  (%call (%object yam-compile-notebook-inner) (# (%name "notebook")))))

# "Compiler exports are ordinary named function values.

   The host loads this small library once. Olive source uses the same parser
   and optimizer that built it; a Yam document enters through compile_yam and
   leaves as a normal function value. Exporting either result only walks the
   reachable heap graph, including any shared compiler helpers it references."

export (#
 (# "compile_olive" (\ (code) (compile-olive-stream nil (str-to-chars code))))
 (# "compile_yam" yam-compile-notebook))

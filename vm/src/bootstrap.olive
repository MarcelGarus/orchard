# "The representation at the notebook boundary

   Integers and predicates are boxed words here; arrays are inner objects and
   strings are packed leaves. Public enums pair a numeric tag with their
   payload. Internal type descriptors use readable string tags instead. Child
   Type handles share their parent's definition table and change only the
   referenced key."

yam-runtime-both-body (\ (x y group) (also (yam-use-fuel) (if x y false)))
yam-runtime-tag-body (\ (x group) (also (yam-use-fuel) (load-word (. 0 x) 0)))

yam-runtime-kind-name-body (\ (index group)
 (also (yam-use-fuel)
  (cond (= index 0) "int" (= index 1) "float" (= index 2) "byte" (= index 3)
   "string" (= index 4) "list" (= index 5) "dynamic" (= index 6) "type"
   (= index 7)
   "struct" (= index 8) "enum" (= index 9) "function" (= index 10) "opaque"
   true (crash "Unknown type kind"))))

yam-runtime-child-body (\ (t key group) (also (yam-use-fuel) (# (. 0 t) key)))
yam-runtime-chr-body (\ (n group) (also (yam-use-fuel) (yam-pack-bytes (# n))))

yam-runtime-num-body (\ (n group)
 (also (yam-use-fuel)
  (: digit (yam-runtime-chr (+ 48 (mod n 10)) group)
   (if (< n 10) digit
    (yam-string-concat (yam-runtime-num (/ n 10) group) digit)))))

# "A reflected type is a snapshot

   Runtime-generated definitions may have the same public name as an earlier
   definition. Private keys distinguish those versions inside one finite
   table. Logical names strip only that private prefix; structural
   comparisons still follow the original keys so changed definitions do not
   become equal."

yam-runtime-logical-body (\ (key group)
 (also (yam-use-fuel)
  (cond (= (size key) 0) key (!= (str-get key 0) 1) key true
   (: data (yam-string-bytes key)
    (yam-runtime-logical
     (yam-runtime-cut-string key (+ (yam-runtime-colon data 0 group) 1) group)
     group)))))

yam-runtime-colon-body (\ (data i group)
 (also (yam-use-fuel)
  (: _ (yam-runtime-require (< i (size data)) "Invalid private type key" group)
   (if (= (load-word (. i data) 0) 58) i (yam-runtime-colon data (+ i 1) group))
  )))

yam-runtime-cut-string-body (\ (value start group)
 (also (yam-use-fuel)
  (: data (yam-string-bytes value)
   (yam-pack-bytes (yam-array-range data start (size data))))))

yam-runtime-require-body
 (\ (test message group) (also (yam-use-fuel) (if test (#) (crash message))))

yam-runtime-depth-body (\ (n group)
 (also (yam-use-fuel)
  (yam-runtime-require (<= n 512) "Runtime compiler depth limit" group)))

yam-runtime-find-body (\ (entries key i group)
 (also (yam-use-fuel) (yam-array-find-entry entries key i)))

yam-runtime-lookup-body (\ (entries key group)
 (also (yam-use-fuel)
  (: i (yam-runtime-find entries key 0 group)
   (: _
    (yam-runtime-require (>= i 0)
     (yam-string-concat "Unknown type or name: " key)
     group)
    (. 1 (. i entries))))))

yam-runtime-put-body (\ (entries key value group)
 (also (yam-use-fuel)
  (: i (yam-runtime-find entries key 0 group)
   (if (< i 0) (yam-array-append entries (# key value))
    (yam-array-set entries i (# key value))))))

yam-runtime-definition-body
 (\ (t group) (also (yam-use-fuel) (yam-runtime-lookup (. 0 t) (. 1 t) group)))

yam-runtime-bottom-body (\ (t group)
 (also (yam-use-fuel)
  (: d (yam-runtime-definition t group)
   (if (= (. 0 d) "enum") (= (size (. 1 d)) 0) false))))

yam-runtime-primitive-body
 (\ (name kind group) (also (yam-use-fuel) (# (# (# name (# kind (#)))) name)))

yam-runtime-nothing-body (\ (group)
 (also (yam-use-fuel) (yam-runtime-primitive "Nothing" "struct" group)))

yam-runtime-never-body
 (\ (group) (also (yam-use-fuel) (yam-runtime-primitive "Never" "enum" group)))

yam-runtime-boolean-body (\ (group)
 (also (yam-use-fuel)
  (#
   (# (# "Nothing" (# "struct" (#)))
    (# "Bool" (# "enum" (# (# "false" "Nothing") (# "true" "Nothing")))))
   "Bool")))

# "Comparing recursive types

   Comparing type names is insufficient after a definition changes. We follow
   corresponding descriptors and compare their fields and dependencies too.
   Recursive type references require a visited set of key pairs to terminate.
   This is separate from object equality, which exposes no object identity."

yam-runtime-equal-body (\ (l r group)
 (also (yam-use-fuel) (yam-runtime-equal-loop (# (# l r) (#)) (#) group)))

yam-runtime-seen-hash-body (\ (l r group)
 (also (yam-use-fuel) (+ (* (yam-key-hash (. 1 l)) 33) (yam-key-hash (. 1 r)))))

yam-runtime-seen-pair-body (\ (seen l r group)
 (also (yam-use-fuel)
  (if (= (size seen) 0) false
   (yam-runtime-seen-contains seen (yam-runtime-seen-hash l r group)
    (# (. 1 l) (. 1 r))
    group))))

yam-runtime-seen-contains-body (\ (seen hash key group)
 (also (yam-use-fuel)
  (cond (= (size seen) 0) false (< hash (. 0 seen))
   (yam-runtime-seen-contains (. 2 seen) hash key group)
   (> hash (. 0 seen))
   (yam-runtime-seen-contains (. 3 seen) hash key group)
   true (>= (yam-runtime-find (. 1 seen) key 0 group) 0))))

yam-runtime-seen-add-body (\ (seen l r group)
 (also (yam-use-fuel)
  (yam-runtime-seen-put seen (yam-runtime-seen-hash l r group)
   (# (. 1 l) (. 1 r))
   group)))

yam-runtime-seen-put-body (\ (seen hash key group)
 (also (yam-use-fuel)
  (cond (= (size seen) 0) (# hash (# (# key (#))) (#) (#)) (< hash (. 0 seen))
   (# (. 0 seen) (. 1 seen) (yam-runtime-seen-put (. 2 seen) hash key group)
    (. 3 seen))
   (> hash (. 0 seen))
   (# (. 0 seen) (. 1 seen) (. 2 seen)
    (yam-runtime-seen-put (. 3 seen) hash key group))
   true
   (# hash (yam-array-append (. 1 seen) (# key (#))) (. 2 seen) (. 3 seen)))))

yam-runtime-equal-loop-body (\ (pending seen group)
 (also (yam-use-fuel)
  (if (= (size pending) 0) true
   (: pair (. 0 pending)
    (: rest (. 1 pending)
     (: l (. 0 pair)
      (: r (. 1 pair)
       (cond (yam-equal? l r) (yam-runtime-equal-loop rest seen group)
        (yam-runtime-not
         (str= (yam-runtime-logical (. 1 l) group)
          (yam-runtime-logical (. 1 r) group))
         group)
        false
        (yam-runtime-both (yam-equal? (. 0 l) (. 0 r)) (str= (. 1 l) (. 1 r))
         group)
        (yam-runtime-equal-loop rest seen group)
        (yam-runtime-seen-pair seen l r group)
        (yam-runtime-equal-loop rest seen group)
        true
        (: ld (yam-runtime-definition l group)
         (: rd (yam-runtime-definition r group)
          (: k (. 0 ld)
           (: lp (. 1 ld)
            (: rp (. 1 rd)
             (if (yam-runtime-not (str= k (. 0 rd)) group) false
              (: next (yam-runtime-seen-add seen l r group)
               (cond (= k "list")
                (yam-runtime-equal-loop
                 (#
                  (# (yam-runtime-child l lp group)
                   (yam-runtime-child r rp group))
                  rest)
                 next group)
                (= k "struct")
                (yam-runtime-equal-fields l r lp rp rest next group)
                (= k "enum")
                (yam-runtime-equal-fields l r lp rp rest next group)
                (= k "function")
                (if (!= (size (. 0 lp)) (size (. 0 rp))) false
                 (yam-runtime-equal-loop
                  (yam-runtime-equal-keys l r (. 0 lp) (. 0 rp) 0
                   (#
                    (# (yam-runtime-child l (. 1 lp) group)
                     (yam-runtime-child r (. 1 rp) group))
                    rest)
                   group)
                  next group))
                true (yam-runtime-equal-loop rest next group)))))))))))))))))

yam-runtime-not-body
 (\ (value group) (also (yam-use-fuel) (if value false true)))

yam-runtime-equal-keys-body (\ (l r lk rk i pending group)
 (also (yam-use-fuel)
  (if (= i (size lk)) pending
   (yam-runtime-equal-keys l r lk rk (+ i 1)
    (#
     (# (yam-runtime-child l (. i lk) group)
      (yam-runtime-child r (. i rk) group))
     pending)
    group))))

yam-runtime-equal-fields-body (\ (l r lf rf pending seen group)
 (also (yam-use-fuel)
  (if (!= (size lf) (size rf)) false
   (yam-runtime-equal-fields-loop l r lf rf 0 pending seen group))))

yam-runtime-equal-fields-loop-body (\ (l r lf rf i pending seen group)
 (also (yam-use-fuel)
  (cond (= i (size lf)) (yam-runtime-equal-loop pending seen group)
   (yam-runtime-not (str= (. 0 (. i lf)) (. 0 (. i rf))) group)
   false true
   (yam-runtime-equal-fields-loop l r lf rf (+ i 1)
    (#
     (# (yam-runtime-child l (. 1 (. i lf)) group)
      (yam-runtime-child r (. 1 (. i rf)) group))
     pending)
    seen group))))

yam-runtime-expect-body (\ (expected actual group)
 (also (yam-use-fuel)
  (if (yam-runtime-bottom actual group) (#)
   (yam-runtime-require (yam-runtime-equal expected actual group)
    "type mismatch" group))))

yam-runtime-join-type-body (\ (l r group)
 (also (yam-use-fuel)
  (if (yam-runtime-bottom l group) r (: _ (yam-runtime-expect l r group) l))))

yam-runtime-info-keys-body (\ (t keys i result group)
 (also (yam-use-fuel)
  (if (= i (size keys)) result
   (yam-runtime-info-keys t keys (+ i 1)
    (yam-array-append result (yam-runtime-child t (. i keys) group))
    group))))

# "Constructing types from definitions

   type_snapshot accepts a finite collection of named definitions. It
   validates the shape of every definition and every reference before
   returning an opaque Type. Describing a type does not attach it to an
   existing value; only checked construction and compilation can produce
   values with that recorded type."

yam-runtime-snapshot-body (\ (table key group)
 (also (yam-use-fuel)
  (: _
   (yam-runtime-require (<= (size table) 20000) "Type snapshot is too large"
    group)
   (: normalized (yam-runtime-validate-definitions table 0 (#) (#) group)
    (: t (# normalized key) (: _ (yam-runtime-definition t group) t))))))

yam-runtime-validate-definitions-body (\ (table i names normalized group)
 (also (yam-use-fuel)
  (if (= i (size table)) normalized
   (: entry (. i table)
    (: name (. 0 entry)
     (: data (yam-string-bytes name)
      (: _ (yam-runtime-require (> (size data) 0) "Empty type name" group)
       (: _
        (yam-runtime-require (!= (load-word (. 0 data) 0) 1)
         "Reserved type name" group)
        (: _
         (yam-runtime-require (< (yam-runtime-find names name 0 group) 0)
          "Duplicate type name" group)
         (: d (. 1 entry)
          (: k (yam-runtime-kind-name (yam-runtime-tag d group) group)
           (: p (. 1 d)
            (: _
             (cond (= k "list") (yam-runtime-lookup table p group)
              (= k "struct")
              (yam-runtime-validate-fields table p 0 (#) group)
              (= k "enum")
              (yam-runtime-validate-fields table p 0 (#) group)
              (= k "function")
              (: _ (yam-runtime-validate-keys table (. 0 p) 0 group)
               (: _ (yam-runtime-lookup table (. 1 p) group) (#)))
              true
              (yam-runtime-require (= (size p) 0)
               "Invalid primitive descriptor" group))
             (: definition
              (# k
               (cond (= k "list") p (= k "struct") p (= k "enum") p
                (= k "function")
                p true (#)))
              (yam-runtime-validate-definitions table (+ i 1)
               (yam-array-append names (# name (#)))
               (yam-array-append normalized (# name definition))
               group)))))))))))))))

yam-runtime-validate-fields-body (\ (table fields i names group)
 (also (yam-use-fuel)
  (if (= i (size fields)) (#)
   (: f (. i fields)
    (: _
     (yam-runtime-require (< (yam-runtime-find names (. 0 f) 0 group) 0)
      "Duplicate field or variant" group)
     (: _ (yam-runtime-lookup table (. 1 f) group)
      (yam-runtime-validate-fields table fields (+ i 1)
       (yam-array-append names (# (. 0 f) (#)))
       group)))))))

yam-runtime-validate-keys-body (\ (table keys i group)
 (also (yam-use-fuel)
  (if (= i (size keys)) (#)
   (: _ (yam-runtime-lookup table (. i keys) group)
    (yam-runtime-validate-keys table keys (+ i 1) group)))))

yam-runtime-import-find-body (\ (tree t group)
 (also (yam-use-fuel)
  (yam-runtime-import-lookup tree
   (yam-key-hash (yam-runtime-logical (. 1 t) group))
   t group)))

yam-runtime-import-lookup-body (\ (tree hash t group)
 (also (yam-use-fuel)
  (cond (= (size tree) 0) (#) (< hash (. 0 tree))
   (yam-runtime-import-lookup (. 2 tree) hash t group)
   (> hash (. 0 tree))
   (yam-runtime-import-lookup (. 3 tree) hash t group)
   true (yam-runtime-import-bucket (. 1 tree) t 0 group))))

yam-runtime-import-bucket-body (\ (entries t i group)
 (also (yam-use-fuel)
  (cond (= i (size entries)) (#)
   (yam-runtime-equal (. 0 (. i entries)) t group)
   (# (. 1 (. i entries)))
   true (yam-runtime-import-bucket entries t (+ i 1) group))))

yam-runtime-import-add-body (\ (tree t key group)
 (also (yam-use-fuel)
  (yam-runtime-import-put tree
   (yam-key-hash (yam-runtime-logical (. 1 t) group))
   (# t key)
   group)))

yam-runtime-import-put-body (\ (tree hash entry group)
 (also (yam-use-fuel)
  (cond (= (size tree) 0) (# hash (# entry) (#) (#)) (< hash (. 0 tree))
   (# (. 0 tree) (. 1 tree)
    (yam-runtime-import-put (. 2 tree) hash entry group)
    (. 3 tree))
   (> hash (. 0 tree))
   (# (. 0 tree) (. 1 tree) (. 2 tree)
    (yam-runtime-import-put (. 3 tree) hash entry group))
   true (# hash (yam-array-append (. 1 tree) entry) (. 2 tree) (. 3 tree)))))

# "Combining type snapshots

   A generated function can mention types from several snapshots. Importing a
   type registers its destination key before importing its children, so
   recursive references resolve without constructing cyclic objects. The
   index preserves distinct versions of the same nominal type; completed
   entries form one table."

yam-runtime-import-type-body (\ (t state level group)
 (also (yam-use-fuel)
  (: _ (yam-runtime-depth level group)
   (: old (yam-runtime-import-find (. 0 state) t group)
    (if (> (size old) 0) (# (. 0 old) state)
     (: index (. 2 state)
      (: key
       (yam-string-concat (yam-runtime-chr 1 group)
        (yam-string-concat (yam-runtime-num index group)
         (yam-string-concat ":" (yam-runtime-logical (. 1 t) group))))
       (: start
        (# (yam-runtime-import-add (. 0 state) t key group) (. 1 state)
         (+ index 1))
        (: d (yam-runtime-definition t group)
         (: k (. 0 d)
          (: p (. 1 d)
           (: imported
            (cond (= k "list")
             (yam-runtime-import-type (yam-runtime-child t p group) start
              (+ level 1)
              group)
             (= k "struct")
             (yam-runtime-import-fields t p 0 start (#) (+ level 1) group)
             (= k "enum")
             (yam-runtime-import-fields t p 0 start (#) (+ level 1) group)
             (= k "function")
             (yam-runtime-import-signature t p start (+ level 1) group)
             true (# (#) start))
            (: next (. 1 imported)
             (: defs (# (# key (# k (. 0 imported))) (. 1 next))

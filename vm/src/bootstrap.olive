 (: binding (yam-runtime-env-lookup env (. 0 p) (- (size env) 1) group)
  (: _
   (yam-runtime-require (yam-runtime-equal (. 1 p) (. 1 binding) group)
    "type mismatch in name expression" group)
   (yam-runtime-checked (. 1 p) (. 2 binding) group))))


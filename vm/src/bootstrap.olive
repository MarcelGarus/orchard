       (: code
        (# (yam-array-append (. 2 arguments) "$captures")
         (# "use-fuel" (yam-runtime-lit 1 group) (. 1 body)))
        (: raw
         (# (. 0 f) (yam-runtime-capture-parameters outer 0 (#)) args (. 2 f)
          code 0 (yam-runtime-group-parameters outer 0 (#)) 1)
         (# t raw (. 1 copied) (yam-runtime-captured-group outer)))))))))))

yam-runtime-expected-function-body (\ (t args returns group)
 (also (yam-use-fuel)
  (: d (yam-runtime-definition t group)
   (: _
    (yam-runtime-require (= (. 0 d) "function") "Expected a function type"
     group)
    (: _ (yam-runtime-check-arguments args t (. 0 (. 1 d)) 0 group)
     (: ret (yam-runtime-child t (. 1 (. 1 d)) group)
      (: _ (yam-runtime-expect ret returns group)
       (: label
        (yam-string-concat (yam-runtime-function-label args 0 "fun(" group)
         (yam-string-concat ") " (yam-runtime-logical (. 1 ret) group)))
        (: _
         (yam-runtime-require (str= (yam-runtime-logical (. 1 t) group) label)
          "Function type name mismatch" group)
         t)))))))))

yam-runtime-function-label-body (\ (args i label group)
 (also (yam-use-fuel)
  (if (= i (size args)) label
   (yam-runtime-function-label args (+ i 1)
    (yam-string-concat label
     (yam-string-concat (if (= i 0) "" ", ")
      (yam-runtime-logical (. 1 (. i args)) group)))
    group))))

yam-runtime-capture-bindings-body (\ (outer i env captures group)
 (if (= i (size outer)) (# env captures)
  (: binding (. i outer)
   (: copy
    (if (. 3 binding)
     (# (. 0 binding) (. 1 binding)
      (yam-runtime-group-reference
       (yam-runtime-load (yam-runtime-name "$captures" group) 0 group)
       (. 5 binding)
       group)
      true (yam-runtime-load (yam-runtime-name "$captures" group) 0 group)
      (. 5 binding))
     (# (. 0 binding) (. 1 binding)
      (yam-runtime-load (yam-runtime-name "$captures" group)
       (+ (size captures) 1)
       group)
      false (#) 0))
    (yam-runtime-capture-bindings outer (+ i 1) (yam-array-append env copy)
     (if (. 3 binding) captures (yam-array-append captures (. 2 binding)))
     group)))))

yam-runtime-bind-arguments-body (\ (args i env types names seen group)
 (also (yam-use-fuel)
  (if (= i (size args)) (# env types names)
   (: arg (. i args)
    (: key (. 0 arg)
     (: _
      (yam-runtime-require (< (yam-runtime-find seen key 0 group) 0)
       "Duplicate function argument" group)
      (: _ (yam-runtime-definition (. 1 arg) group)
       (: param (yam-string-concat "$p" (yam-runtime-num i group))
        (yam-runtime-bind-arguments args (+ i 1)
         (yam-array-append env
          (yam-runtime-bind key (. 1 arg) (yam-runtime-name param group) group))
         (yam-array-append types (. 1 arg))
         (yam-array-append names param)
         (yam-array-append seen (# key (#)))
         group)))))))))

# "Checking expressions from the bottom up

   An Expr does not carry a trusted cached type. Values reveal their recorded
   type; names are checked against the lexical scope; compound expressions
   check their children before their own operation. The result contains the
   inferred type and VM expression. Values retain their checked types
   throughout this traversal."

yam-runtime-check-body (\ (e env level path group)
 (also (yam-use-fuel)
  (: _ (yam-runtime-depth level group)
   (: k (yam-runtime-tag e group)
    (: p (. 1 e)
     (cond (= k 0)
      (: _ (yam-runtime-definition (. 0 p) group)
       (yam-runtime-checked (. 0 p) (yam-runtime-obj (. 1 p) group) group))
      (= k 1)
      (yam-runtime-check-name p env group)
      (= k 2)
      (: v
       (yam-runtime-check (. 1 p) env (+ level 1) (yam-string-concat path "v")
        group)
       (: n (yam-runtime-local "let" path group)
        (: b
         (yam-runtime-check (. 2 p)
          (yam-array-append env
           (yam-runtime-bind (. 0 p) (. 0 v) (yam-runtime-name n group) group))
          (+ level 1)
          (yam-string-concat path "b")
          group)
         (yam-runtime-checked
          (if (yam-runtime-bottom (. 0 v) group) (. 0 v) (. 0 b))
          (# "let" n (. 1 v) (. 1 b))
          group))))
      (= k 3)
      (: condition
       (yam-runtime-check (. 0 p) env (+ level 1) (yam-string-concat path "c")
        group)
       (: _
        (yam-runtime-expect (yam-runtime-boolean group) (. 0 condition) group)
        (: yes
         (yam-runtime-check (. 1 p) env (+ level 1)
          (yam-string-concat path "y")
          group)
         (: no
          (yam-runtime-check (. 2 p) env (+ level 1)
           (yam-string-concat path "n")
           group)
          (yam-runtime-checked
           (if (yam-runtime-bottom (. 0 condition) group) (. 0 condition)
            (yam-runtime-join-type (. 0 yes) (. 0 no) group))
           (# "if"
            (# "load" (yam-runtime-load (. 1 condition) 0 group)
             (yam-runtime-lit 0 group))
            (. 1 yes)
            (. 1 no))
           group)))))
      (= k 4)
      (: f
       (yam-runtime-check-function (# "\\" (. 0 p) (. 1 p)) env (+ level 1)
        (yam-string-concat path "l")
        group)
       (yam-runtime-checked (. 0 f)
        (yam-runtime-new
         (# (yam-runtime-obj (. 1 f) group)
          (yam-runtime-new (yam-array-concat (# (. 3 f)) (. 2 f)) group))
         group)
        group))
      (= k 5)
      (yam-runtime-check-call p env level path group)
      (= k 6)
      (yam-runtime-check-struct p env level path group)
      (= k 7)
      (yam-runtime-check-enum p env level path group)
      (= k 8)
      (: v
       (yam-runtime-check (. 0 p) env (+ level 1) (yam-string-concat path "o")
        group)
       (: d (yam-runtime-definition (. 0 v) group)
        (: _
         (yam-runtime-require (= (. 0 d) "struct") "Field access on non-struct"
          group)
         (: i (yam-runtime-find (. 1 d) (. 1 p) 0 group)
          (: _ (yam-runtime-require (>= i 0) "Unknown field" group)
           (yam-runtime-checked
            (yam-runtime-child (. 0 v) (. 1 (. i (. 1 d))) group)
            (yam-runtime-load (. 1 v) i group)
            group))))))
      (= k 9)
      (yam-runtime-check-switch p env level path group)
      (= k 10)
      (yam-runtime-check-block p env level path 0
       (yam-runtime-checked (yam-runtime-nothing group)
        (yam-runtime-new (#) group)
        group)
       false group)
      (= k 11)
      (: _ (yam-runtime-definition (. 0 p) group)
       (: v
        (yam-runtime-check (. 1 p) env (+ level 1) (yam-string-concat path "e")
         group)
        (: _ (yam-runtime-expect (. 0 p) (. 0 v) group)
         (yam-runtime-checked (. 0 p) (. 1 v) group))))
      (= k 12)
      (yam-runtime-check-functions p env level path group)
      true (yam-runtime-check-primitive e env level path group)))))))

yam-runtime-check-call-body (\ (p env level path group)
 (also (yam-use-fuel)
  (: callee
   (yam-runtime-check (. 0 p) env (+ level 1) (yam-string-concat path "f")
    group)
   (: t (. 0 callee)
    (: d (yam-runtime-definition t group)
     (: _
      (yam-runtime-require (= (. 0 d) "function") "Calling a non-function"
       group)
      (: args (. 1 p)
       (: keys (. 0 (. 1 d))
        (: _
         (yam-runtime-require (= (size args) (size keys))
          "Wrong argument count" group)
         (: values
          (yam-runtime-check-values args t keys env level path 0 (#) false
           false group)
          (: n (yam-runtime-local "callee" path group)
           (: invocation
            (# "call"
             (yam-runtime-load
              (yam-runtime-load (yam-runtime-name n group) 0 group)
              4 group)
             (yam-array-append (. 0 values)
              (yam-runtime-load (yam-runtime-name n group) 1 group)))
            (yam-runtime-checked
             (if (. 1 values) (yam-runtime-never group)
              (yam-runtime-child t (. 1 (. 1 d)) group))
             (# "let" n (. 1 callee) invocation)
             group)))))))))))))

yam-runtime-check-values-body
 (\ (values t expected env level path i codes stopped fields group)
  (also (yam-use-fuel)
   (if (= i (size values)) (# codes stopped)
    (: v
     (yam-runtime-check (. i values) env (+ level 1)
      (yam-string-concat path (yam-string-concat "a" (yam-runtime-num i group)))
      group)
     (: key (if fields (. 1 (. i expected)) (. i expected))
      (: _ (yam-runtime-expect (yam-runtime-child t key group) (. 0 v) group)
       (yam-runtime-check-values values t expected env level path (+ i 1)
        (yam-array-append codes (. 1 v))
        (if stopped true (yam-runtime-bottom (. 0 v) group))
        fields group)))))))

yam-runtime-check-struct-body (\ (p env level path group)
 (also (yam-use-fuel)
  (: t (. 0 p)
   (: d (yam-runtime-definition t group)
    (: _
     (yam-runtime-require (= (. 0 d) "struct") "Constructing a non-struct"
      group)
     (: fields (. 1 d)
      (: _
       (yam-runtime-require (= (size fields) (size (. 1 p)))
        "Wrong struct field count" group)
       (: values
        (yam-runtime-check-values (. 1 p) t fields env level path 0 (#) false
         true group)
        (yam-runtime-checked (if (. 1 values) (yam-runtime-never group) t)
         (yam-runtime-new (. 0 values) group)
         group)))))))))

yam-runtime-check-enum-body (\ (p env level path group)
 (also (yam-use-fuel)
  (: t (. 0 p)
   (: d (yam-runtime-definition t group)
    (: _
     (yam-runtime-require (= (. 0 d) "enum") "Constructing a non-enum" group)
     (: i (yam-runtime-find (. 1 d) (. 1 p) 0 group)
      (: _ (yam-runtime-require (>= i 0) "Unknown variant" group)
       (: v
        (yam-runtime-check (. 2 p) env (+ level 1) (yam-string-concat path "p")
         group)
        (: _
         (yam-runtime-expect (yam-runtime-child t (. 1 (. i (. 1 d))) group)
          (. 0 v)
          group)
         (yam-runtime-checked (if (yam-runtime-bottom (. 0 v) group) (. 0 v) t)
          (yam-runtime-new (# (yam-runtime-obj i group) (. 1 v)) group)
          group))))))))))

yam-runtime-check-block-body (\ (values env level path i result stopped group)
 (also (yam-use-fuel)
  (if (= i (size values))
   (yam-runtime-checked (if stopped (yam-runtime-never group) (. 0 result))
    (. 1 result)
    group)
   (: v
    (yam-runtime-check (. i values) env (+ level 1)
     (yam-string-concat path (yam-string-concat "b" (yam-runtime-num i group)))
     group)
    (: code (if (= i 0) (. 1 v) (# "also" (. 1 result) (. 1 v)))
     (yam-runtime-check-block values env level path (+ i 1)
      (yam-runtime-checked (. 0 v) code group)
      (if stopped true (yam-runtime-bottom (. 0 v) group))
      group))))))

yam-runtime-check-switch-body (\ (p env level path group)
 (also (yam-use-fuel)
  (: v
   (yam-runtime-check (. 0 p) env (+ level 1) (yam-string-concat path "m")
    group)
   (: d (yam-runtime-definition (. 0 v) group)
    (: _ (yam-runtime-require (= (. 0 d) "enum") "Switch on non-enum" group)
     (: other (. 2 p)
      (: default
       (if (= (yam-runtime-tag other group) 0)
        (yam-runtime-check (. 1 other) env (+ level 1)
         (yam-string-concat path "d")
         group)
        (yam-runtime-checked (yam-runtime-never group) (# "unreachable") group))
       (: n (yam-runtime-local "match" path group)
        (: cases
         (yam-runtime-check-cases (. 1 p) (size (. 1 p)) (. 0 v) (. 1 d) env
          level path n default (#) group)
         (: _
          (if (= (yam-runtime-tag other group) 0) (#)
           (yam-runtime-require (= (size (. 1 cases)) (size (. 1 d)))
            "Non-exhaustive switch" group))
          (: result (. 0 cases)
           (yam-runtime-checked
            (if (yam-runtime-bottom (. 0 v) group) (. 0 v) (. 0 result))
            (# "let" n (. 1 v) (. 1 result))
            group))))))))))))

yam-runtime-check-cases-body
 (\ (cases count t fields env level path n result seen group)
  (also (yam-use-fuel)
   (if (= count 0) (# result seen)
    (: arm (. (- count 1) cases)
     (: i (yam-runtime-find fields (. 0 arm) 0 group)
      (: _ (yam-runtime-require (>= i 0) "Unknown switch variant" group)
       (: _
        (yam-runtime-require (< (yam-runtime-find seen (. 0 arm) 0 group) 0)
         "Duplicate switch variant" group)
        (: scope
         (if (= (yam-runtime-tag (. 1 arm) group) 0)
          (yam-array-append env
           (yam-runtime-bind (. 1 (. 1 arm))
            (yam-runtime-child t (. 1 (. i fields)) group)
            (yam-runtime-load (yam-runtime-name n group) 1 group)
            group))
          env)
         (: b
          (yam-runtime-check (. 2 arm) scope (+ level 1)
           (yam-string-concat path
            (yam-string-concat "m" (yam-runtime-num count group)))
           group)
          (: test
           (# "and"
            (# "compare"
             (# "load" (yam-runtime-load (yam-runtime-name n group) 0 group)
              (yam-runtime-lit 0 group))
             (yam-runtime-lit i group))
            (yam-runtime-lit 1 group))
           (: combined
            (yam-runtime-checked
             (yam-runtime-join-type (. 0 result) (. 0 b) group)
             (# "if" test (. 1 b) (. 1 result))
             group)
            (yam-runtime-check-cases cases (- count 1) t fields env level path
             n combined (yam-array-append seen (# (. 0 arm) (#))) group)))))))))
   )))

# "From a checked body to an ordinary function value

   Once checking succeeds, the raw descriptor and its capture object form the
   same closure representation as a compiled lambda. Returning it as Dynamic
   records the checked function type. There is no special runtime-function
   type and no boundary between these functions and other code."

yam-runtime-compile-body (\ (f group)
 (: result (yam-runtime-check-function f (#) 0 "root" group)
  (# (. 0 result) (# (. 1 result) (# (#))))))

yam-runtime-merge-types-body (\ (types params i entries origins subs group)
 (also (yam-use-fuel)
  (if (= i (size types)) (# entries origins subs)
   (: t (. i types)
    (: _ (yam-runtime-definition t group)
     (: merged (yam-runtime-merge-table t 0 entries origins group)
      (yam-runtime-merge-types types params (+ i 1) (. 0 merged) (. 1 merged)
       (yam-runtime-put subs (. i params) (. 1 t) group)
       group)))))))

yam-runtime-merge-table-body (\ (t i entries origins group)
 (also (yam-use-fuel)
  (: table (. 0 t)
   (if (= i (size table)) (# entries origins)
    (: entry (. i table)
     (: key (. 0 entry)
      (: old (yam-runtime-find origins key 0 group)
       (if (>= old 0)
        (: _
         (yam-runtime-require
          (yam-runtime-equal (. 1 (. old origins))
           (yam-runtime-child t key group)
           group)
          "Incompatible type arguments" group)
         (yam-runtime-merge-table t (+ i 1) entries origins group))
        (yam-runtime-merge-table t (+ i 1)
         (yam-runtime-put entries key (. 1 entry) group)
         (yam-runtime-put origins key (yam-runtime-child t key group) group)
         group)))))))))

yam-runtime-keys-text-body (\ (keys i result group)
 (also (yam-use-fuel)
  (if (= i (size keys)) result
   (yam-runtime-keys-text keys (+ i 1)
    (yam-string-concat result
     (yam-string-concat (if (= i 0) "" ", ")
      (yam-runtime-logical (. i keys) group)))
    group))))

yam-runtime-pattern-name-body (\ (n keys group)
 (also (yam-use-fuel)
  (cond (str= n "fun")
   (: _
    (yam-runtime-require (> (size keys) 0) "Function type needs a result" group)
    (yam-string-concat "fun("
     (yam-string-concat
      (yam-runtime-keys-text (yam-array-range keys 0 (- (size keys) 1)) 0 ""
       group)
      (yam-string-concat ") "
       (yam-runtime-logical (. (- (size keys) 1) keys) group)))))
   (= (size keys) 0)
   n true
   (yam-string-concat n
    (yam-string-concat "["
     (yam-string-concat (yam-runtime-keys-text keys 0 "" group) "]"))))))

yam-runtime-patterns-body
 (\ (values templates subs entries seen level i keys group)
  (also (yam-use-fuel)
   (if (= i (size values)) (# keys entries seen)
    (: value
     (yam-runtime-pattern (. i values) templates subs entries seen (+ level 1)
      group)
     (yam-runtime-patterns values templates subs (. 1 value) (. 2 value) level
      (+ i 1)
      (yam-array-append keys (. 0 value))
      group)))))

yam-runtime-pattern-body (\ (p templates subs entries seen level group)
 (also (yam-use-fuel)
  (: _ (yam-runtime-depth level group)
   (: n (. 0 p)
    (: arguments (. 1 p)
     (: param (yam-runtime-find subs n 0 group)
      (if (>= param 0)
       (: _
        (yam-runtime-require (= (size arguments) 0)
         "Type parameter has arguments" group)
        (# (. 1 (. param subs)) entries seen))
       (: children
        (yam-runtime-patterns arguments templates subs entries seen level 0 (#)
         group)
        (: keys (. 0 children)
         (: key (yam-runtime-pattern-name n keys group)
          (: existing (. 1 children)
           (: visited (. 2 children)
            (if (>= (yam-runtime-find visited key 0 group) 0)
             (# key existing visited)
             (: next (yam-array-append visited (# key (#)))
              (: start
               (if (>= (yam-runtime-find existing key 0 group) 0) existing
                (yam-array-append existing (# key (#))))
               (if (str= n "fun")
                (# key
                 (yam-runtime-put start key
                  (# "function"
                   (# (yam-array-range keys 0 (- (size keys) 1))
                    (. (- (size keys) 1) keys)))
                  group)
                 next)
                (: index (yam-runtime-find templates n 0 group)
                 (: _
                  (yam-runtime-require (>= index 0)
                   (yam-string-concat "Unknown builtin type: " n)
                   group)
                  (: template (. index templates)
                   (: params (. 1 template)
                    (: _
                     (yam-runtime-require (= (size params) (size keys))
                      "Builtin type arity mismatch" group)
                     (: scope
                      (yam-runtime-bind-patterns params keys subs 0 group)
                      (: source (. 2 template)
                       (: k (. 0 source)
                        (: payload (. 1 source)
                         (: value
                          (cond (= k "list")
                           (yam-runtime-pattern payload templates scope start
                            next (+ level 1) group)
                           (= k "struct")
                           (yam-runtime-pattern-fields payload templates scope
                            start next level 0 (#) group)
                           (= k "enum")
                           (yam-runtime-pattern-fields payload templates scope
                            start next level 0 (#) group)
                           true (# (#) start next))
                          (# key
                           (yam-runtime-put (. 1 value) key (# k (. 0 value))
                            group)
                           (. 2 value))))))))))))))))))))))))))))

yam-runtime-bind-patterns-body (\ (params keys subs i group)
 (also (yam-use-fuel)
  (if (= i (size params)) subs
   (yam-runtime-bind-patterns params keys
    (yam-runtime-put subs (. i params) (. i keys) group)
    (+ i 1)
    group))))

yam-runtime-pattern-fields-body
 (\ (fields templates subs entries seen level i values group)
  (also (yam-use-fuel)
   (if (= i (size fields)) (# values entries seen)
    (: f (. i fields)
     (: p
      (yam-runtime-pattern (. 1 f) templates subs entries seen (+ level 1)
       group)
      (yam-runtime-pattern-fields fields templates subs (. 1 p) (. 2 p) level
       (+ i 1)
       (yam-array-append values (# (. 0 f) (. 0 p)))
       group))))))

yam-runtime-verify-origins-body (\ (table origins seen i group)
 (also (yam-use-fuel)
  (if (= i (size seen)) (#)
   (: key (. 0 (. i seen))
    (: index (yam-runtime-find origins key 0 group)
     (: _
      (if (< index 0) (#)
       (yam-runtime-require
        (yam-runtime-equal (. 1 (. index origins)) (# table key) group)
        "Incompatible builtin type snapshot" group))
      (yam-runtime-verify-origins table origins seen (+ i 1) group)))))))

yam-runtime-parameters-body (\ (keys i names values group)
 (also (yam-use-fuel)
  (if (= i (size keys)) (# names values)
   (: n (yam-string-concat "$p" (yam-runtime-num i group))
    (yam-runtime-parameters keys (+ i 1) (yam-array-append names n)
     (yam-array-append values (yam-runtime-name n group))
     group)))))

# "Executing with a resource limit

   Before run invokes a Dynamic function, it checks the argument count and
   each recorded argument type against the function signature. It then
   supplies the closure captures and the checked result type to the small
   sandbox wrapper."

yam-runtime-prepare-call-body (\ (f args group)
 (also (yam-use-fuel)
  (: t (. 0 f)
   (: d (yam-runtime-definition t group)
    (: _
     (yam-runtime-require (= (. 0 d) "function") "Calling a non-function" group)
     (: keys (. 0 (. 1 d))
      (: _
       (yam-runtime-require (= (size args) (size keys))
        "Function argument count mismatch" group)
       (: values (yam-runtime-call-values t keys args 0 (#) group)
        (: closure (. 1 f)
         (# (. 4 (. 0 closure)) (yam-array-append values (. 1 closure))
          (yam-runtime-child t (. 1 (. 1 d)) group)))))))))))

yam-runtime-call-values-body (\ (t keys args i values group)
 (also (yam-use-fuel)
  (if (= i (size args)) values
   (: arg (. i args)
    (: _
     (yam-runtime-require
      (yam-runtime-equal (. 0 arg) (yam-runtime-child t (. i keys) group) group)
      "type mismatch" group)
     (yam-runtime-call-values t keys args (+ i 1)
      (yam-array-append values (. 1 arg))
      group))))))

yam-runtime-lookup-type-body (\ (t label group)
 (also (yam-use-fuel) (yam-runtime-lookup-type-loop t label 0 (# 1 (#)) group)))

yam-runtime-lookup-type-loop-body (\ (t label i found group)
 (also (yam-use-fuel)
  (: table (. 0 t)
   (if (= i (size table)) found
    (: key (. 0 (. i table))
     (if (str= (yam-runtime-logical key group) label)
      (: candidate (yam-runtime-child t key group)
       (if (= (yam-runtime-tag found group) 0)
        (if (yam-runtime-equal (. 1 found) candidate group)
         (yam-runtime-lookup-type-loop t label (+ i 1) found group)
         (# 1 (#)))
        (yam-runtime-lookup-type-loop t label (+ i 1) (# 0 candidate) group)))
      (yam-runtime-lookup-type-loop t label (+ i 1) found group)))))))

# "The runtime group's shared operations

   Every checked operation receives this group explicitly. Generated calls
   refer directly to these ordinary compiler functions. Exporting a program
   retains the helpers it reaches in the same object graph; there is no
   separate runtime image or host dispatcher. The closed primitive catalog
   is attached after its implementations have been introduced."

yam-runtime-base-group
 (# yam-runtime-both-body yam-runtime-tag-body yam-runtime-kind-name-body
  yam-runtime-child-body yam-runtime-chr-body yam-runtime-num-body
  yam-runtime-logical-body yam-runtime-colon-body yam-runtime-cut-string-body
  yam-runtime-require-body yam-runtime-depth-body yam-runtime-find-body
  yam-runtime-lookup-body yam-runtime-put-body yam-runtime-definition-body
  yam-runtime-bottom-body yam-runtime-primitive-body yam-runtime-nothing-body
  yam-runtime-never-body yam-runtime-boolean-body yam-runtime-equal-body
  yam-runtime-seen-hash-body yam-runtime-seen-pair-body
  yam-runtime-seen-contains-body yam-runtime-seen-add-body
  yam-runtime-seen-put-body yam-runtime-equal-loop-body yam-runtime-not-body
  yam-runtime-equal-keys-body yam-runtime-equal-fields-body
  yam-runtime-equal-fields-loop-body yam-runtime-expect-body
  yam-runtime-join-type-body yam-runtime-info-keys-body
  yam-runtime-snapshot-body yam-runtime-validate-definitions-body
  yam-runtime-validate-fields-body yam-runtime-validate-keys-body
  yam-runtime-import-find-body yam-runtime-import-lookup-body
  yam-runtime-import-bucket-body yam-runtime-import-add-body
  yam-runtime-import-put-body yam-runtime-import-type-body
  yam-runtime-reverse-body yam-runtime-import-fields-body
  yam-runtime-import-keys-body yam-runtime-import-signature-body
  yam-runtime-function-type-body yam-runtime-import-arguments-body
  yam-runtime-obj-body yam-runtime-lit-body yam-runtime-name-body
  yam-runtime-load-body yam-runtime-new-body yam-runtime-local-body
  yam-runtime-checked-body yam-runtime-bind-body yam-runtime-env-lookup-body
  yam-runtime-check-name-body yam-runtime-check-arguments-body
  yam-runtime-check-function-body yam-runtime-check-function-expected-body
  yam-runtime-expected-function-body yam-runtime-function-label-body
  yam-runtime-capture-bindings-body yam-runtime-bind-arguments-body
  yam-runtime-check-body yam-runtime-check-call-body
  yam-runtime-check-values-body yam-runtime-check-struct-body
  yam-runtime-check-enum-body yam-runtime-check-block-body
  yam-runtime-check-switch-body yam-runtime-check-cases-body
  yam-runtime-compile-body yam-runtime-merge-types-body
  yam-runtime-merge-table-body yam-runtime-keys-text-body
  yam-runtime-pattern-name-body yam-runtime-patterns-body
  yam-runtime-pattern-body yam-runtime-bind-patterns-body
  yam-runtime-pattern-fields-body yam-runtime-verify-origins-body
  yam-runtime-parameters-body yam-runtime-call-values-body
  yam-runtime-lookup-type-body yam-runtime-lookup-type-loop-body)

# "Representing a type as a value

   A reflected Type is a finite snapshot, [definitions, key]. Definitions map
   concrete type names to [kind, payload] descriptors. Field and variant
   types are string references into that same table. This lets an enum such
   as a linked list refer to itself without constructing a cyclic heap
   object.

   Reflection reserves a key before following its dependencies. Encountering
   it again means we have found a recursive reference, not more work to
   expand. The descriptor is filled after its children have been visited.
   Every public child Type can then reuse the table and change only its key.

   Concrete names are also useful for diagnostics and specialization.
   Function type names include their argument types and result; generic
   record names include their concrete arguments. Aliases have already been
   resolved by checking. Private descriptor kinds are strings such as struct,
   enum, and function. Each fits in one leaf word; numeric enum tags appear
   only at the public ABI."

yam-type-text (\ (group type) (yam-apply (.0 group) (# group type)))

yam-type-text-arguments
 (\ (group types start end) (yam-apply (.1 group) (# group types start end)))

yam-join-text (\ (strings separator)
 (cond (nil? strings) "" (nil? (.1 strings)) (.0 strings) true
  (str-concat-3 (.0 strings) separator (rec (.1 strings) separator))))

yam-type-text-body (\ (group type)
 (: name (yam-type-name type)
  (: arguments (yam-type-arguments type)
   (cond (str= name "fun")
    (str-concat-3 "fun("
     (yam-type-text-arguments group arguments 0 (- (size arguments) 1))
     (str-concat-3 ") "
      (yam-type-text group (. (- (size arguments) 1) arguments))
      ""))
    (nil? arguments)
    name true
    (str-concat-3 name "["
     (str-concat (yam-type-text-arguments group arguments 0 (size arguments))
      "]"))))))

yam-type-text-list (\ (group types index end)
 (if (= index end) nil
  (# (yam-type-text group (. index types)) (rec group types (+ index 1) end))))

yam-type-text-arguments-body (\ (group types start end)
 (yam-join-text (yam-type-text-list group types start end) ", "))

yam-type-text-group (# yam-type-text-body yam-type-text-arguments-body)

yam-type-name-text (\ (type) (yam-type-text yam-type-text-group type))

# "Not every recursive generic describes a finite set of concrete types. A
   field such as Foo[List[T]] inside Foo[T] keeps growing its arguments.
   Bound structural expansion so reflection and specialization report a
   diagnostic rather than exhausting the VM on that kind of definition."

yam-type-budget-arguments (\ (arguments index depth pending)
 (if (= index (size arguments)) pending
  (rec arguments (+ index 1) depth (# (# (. index arguments) depth) pending))))

yam-type-budget-steps (\ (pending count)
 (if (nil? pending) (#)
  (: entry (.0 pending)
   (also
    (assert (and (<= (.1 entry) 64) (< count 4096))
     "Type arguments expand beyond the compiler limit")
    (rec
     (yam-type-budget-arguments (yam-type-arguments (.0 entry)) 0
      (+ (.1 entry) 1)
      (.1 pending))
     (+ count 1))))))

yam-type-budget (\ (type) (yam-type-budget-steps (# (# type 0) nil) 0))

yam-reflection-state (\ (entries keys count) (# entries keys count))

yam-reflect-key (\ (group environment type state)
 (yam-apply (.0 group) (# group environment type state)))

yam-reflect-fields
 (\ (group environment fields substitutions index state reversed)
  (yam-apply (.1 group)
   (# group environment fields substitutions index state reversed)))

yam-reflect-arguments (\ (group environment arguments index state reversed)
 (yam-apply (.2 group) (# group environment arguments index state reversed)))

yam-reflect-key-body (\ (group environment source state)
 (also (assert (< (.2 state) 4096) "Too many reflected type definitions")
  (: type (yam-resolved-type environment source nil)
   (: key (also (yam-type-budget type) (yam-type-name-text type))
    (if (not-nil? (yam-map-entry (.0 state) key)) (# key state)
     (: reserved
      (yam-reflection-state (yam-map-put (.0 state) key nil) (# key (.1 state))
       (+ (.2 state) 1))
      (: name (yam-type-name type)
       (: definition
        (if (str= name "fun") (# "function")
         (yam-map-get (yam-types environment) name))
        (: kind (.0 definition)
         (: result
          (cond (str= kind "list")
           (: child
            (yam-reflect-key group environment (.0 (yam-type-arguments type))
             reserved)
            (# (# "list" (.0 child)) (.1 child)))
           (str= kind "function")
           (: children
            (yam-reflect-arguments group environment (yam-type-arguments type)
             0 reserved nil)
            (: keys (.0 children)
             (#
              (# "function"
               (# (yam-array-range keys 0 (- (size keys) 1))
                (. (- (size keys) 1) keys)))
              (.1 children))))
           (or (str= kind "struct") (str= kind "enum"))
           (: substitutions
            (yam-type-substitutions (.1 definition) (yam-type-arguments type) 0
             nil)
            (: fields
             (yam-reflect-fields group environment (.2 definition)
              substitutions 0 reserved nil)
             (# (# kind (.0 fields)) (.1 fields))))
           true
           (#
            (#
             (cond (str= name "Dynamic") "dynamic" (str= name "Type") "type"
              true kind)
             (#))
            reserved))
          (: completed (.1 result)
           (# key
            (yam-reflection-state (yam-map-put (.0 completed) key (.0 result))
             (.1 completed)
             (.2 completed))))))))))))))

yam-reflect-fields-body
 (\ (group environment fields substitutions index state reversed)
  (if (= index (size fields))
   (# (flatten-to-inner (reverse-list reversed nil)) state)
   (: field (. index fields)
    (: child
     (yam-reflect-key group environment
      (yam-specialize (.1 field) substitutions)
      state)
     (yam-reflect-fields group environment fields substitutions (+ index 1)
      (.1 child)
      (# (# (.0 field) (.0 child)) reversed))))))

yam-reflect-arguments-body (\ (group environment arguments index state reversed)
 (if (= index (size arguments))
  (# (flatten-to-inner (reverse-list reversed nil)) state)
  (: child (yam-reflect-key group environment (. index arguments) state)
   (yam-reflect-arguments group environment arguments (+ index 1) (.1 child)
    (# (.0 child) reversed)))))

yam-reflection-group
 (# yam-reflect-key-body yam-reflect-fields-body yam-reflect-arguments-body)

yam-reflection-entries (\ (entries keys)
 (if (nil? keys) nil
  (# (# (.0 keys) (yam-map-get entries (.0 keys))) (rec entries (.1 keys)))))

yam-reflect (\ (environment type)
 (: result
  (yam-reflect-key yam-reflection-group environment type
   (yam-reflection-state nil nil 0))
  (: state (.1 result)
   (# (flatten-to-inner (yam-reflection-entries (.0 state) (.1 state)))
    (.0 result)))))

# "Inspecting a snapshot is deliberately shallow. info returns the descriptor
   for one key and wraps its references as new Type handles sharing the same
   table. Looking at an enum does not eagerly expand every variant's type."

yam-array-index (\ (array value index)
 (cond (= index (size array)) (crash (# "Unknown entry" value))
  (yam-equal? (. index array) value)
  index true (rec array value (+ index 1))))

yam-info-fields (\ (table fields index)
 (if (= index (size fields)) nil
  (: field (. index fields)
   (# (# (.0 field) (# table (.1 field))) (rec table fields (+ index 1))))))

yam-info-arguments (\ (table keys index)
 (if (= index (size keys)) nil
  (# (# table (. index keys)) (rec table keys (+ index 1)))))

yam-info (\ (type group)
 (: descriptor (yam-runtime-definition type group)
  (: kind (.0 descriptor)
   (: payload (.1 descriptor)
    (: kinds
     (# "int" "float" "byte" "string" "list" "dynamic" "type" "struct" "enum"
      "function" "opaque")
     (: index (yam-array-index kinds kind 0)
      (# index
       (cond (str= kind "list") (# (.0 type) payload)
        (or (str= kind "struct") (str= kind "enum"))
        (# (flatten-to-inner (yam-info-fields (.0 type) payload 0)))
        (str= kind "function")
        (# (flatten-to-inner (yam-info-arguments (.0 type) (.0 payload) 0))
         (# (.0 type) (.1 payload)))
        true (#)))))))))

# "Builtins connect typed Yam signatures to ordinary functions

   A builtin declaration does not grant arbitrary access to the VM. The
   compiler recognizes its complete argument signature and checks its result
   type. The table below pairs those checked signatures with functions
   already running in the compiler. Lowering emits calls to those same
   function values.

   Most helpers are straightforward value operations. Those that build a list
   or string charge fuel for each step, just as generated Yam functions do.
   Division and conversion helpers check exceptional inputs before reaching a
   machine instruction that could otherwise trap."

yam-identity (\ (value) value)
yam-bool (\ (condition) (# (if condition 1 0) (#)))
yam-object-equals (\ (left right) (yam-bool (yam-equal? left right)))
yam-string-equals (\ (left right) (yam-bool (str= left right)))

yam-ordering (\ (flags) (# (cond (and flags 1) 1 (and flags 2) 2 true 0) (#)))
yam-int-ordering (\ (left right) (yam-ordering (compare left right)))

yam-int-divide (\ (left right)
 (also (assert (!= right 0) "Integer division by zero")
  (if (and (= left 9223372036854775808) (= right (- 0 1))) left (/ left right)))
)

yam-int-modulo (\ (left right)
 (also (assert (!= right 0) "Integer modulo by zero")
  (if (and (= left 9223372036854775808) (= right (- 0 1))) 0 (mod left right))))

yam-int-remainder
 (\ (left right) (- left (* (yam-int-divide left right) right)))

yam-byte (\ (value) (and value 255))
yam-byte-add (\ (left right) (yam-byte (+ left right)))
yam-byte-subtract (\ (left right) (yam-byte (- left right)))
yam-byte-multiply (\ (left right) (yam-byte (* left right)))
yam-byte-divide (\ (left right) (yam-byte (yam-int-divide left right)))

yam-float-flags-raw (# (# "left" "right")
 (%new-leaf (# (%f-compare (%load-0 (%name "left")) (%load-0 (%name "right")))))
)

yam-float-nan?
 (\ (value) (> (and value 9223372036854775807) 9218868437227405312))

yam-float-flags (\ (left right)
 (if (or (yam-float-nan? left) (yam-float-nan? right)) 0
  (yam-float-flags-raw left right)))

yam-float-equals
 (\ (left right) (yam-bool (and (yam-float-flags left right) 1)))

yam-float-less (\ (left right) (yam-bool (and (yam-float-flags left right) 4)))

yam-float-greater
 (\ (left right) (yam-bool (and (yam-float-flags left right) 2)))

yam-float-less-equal
 (\ (left right) (yam-bool (and (yam-float-flags left right) 5)))

yam-float-greater-equal
 (\ (left right) (yam-bool (and (yam-float-flags left right) 3)))

yam-float-ordering (\ (left right)
 (: flags (yam-float-flags left right)
  (also (assert flags "Cannot order NaN") (yam-ordering flags))))

yam-float-to-int-raw
 (# (# "value") (%new-leaf (# (%float-to-int (%load-0 (%name "value"))))))

yam-float-to-int (\ (value)
 (: high (int->float 9223372036854775807)
  (: low (f- (int->float 0) high)
   (also
    (assert
     (if (and (yam-float-flags value low) 3)
      (and (yam-float-flags value high) 4)
      false)
     "Float to Int conversion out of range")
    (yam-float-to-int-raw value)))))

yam-list-empty (\ () (#))

yam-list-get (\ (values index)
 (also
  (assert (and (>= index 0) (< index (size values))) "List index out of bounds")
  (. index values)))

yam-list-filled-steps (\ (length value)
 (also (yam-use-fuel) (if (= length 0) nil (# value (rec (- length 1) value)))))

yam-list-filled (\ (length value)
 (also (assert (>= length 0) "List length must be nonnegative")
  (flatten-to-inner (yam-list-filled-steps length value))))

yam-list-range (\ (values range) (yam-array-range values (.0 range) (.1 range)))

yam-list-set (\ (values index value)
 (also
  (assert (and (>= index 0) (< index (size values))) "List index out of bounds")
  (yam-array-set values index value)))

yam-list-reverse-steps (\ (values index result)
 (also (yam-use-fuel)
  (if (= index (size values)) result
   (rec values (+ index 1) (# (. index values) result)))))

yam-list-reversed
 (\ (values) (flatten-to-inner (yam-list-reverse-steps values 0 nil)))

yam-list-sum-steps (\ (values index sum)
 (also (yam-use-fuel)
  (if (= index (size values)) sum
   (rec values (+ index 1) (+ sum (. index values))))))

yam-list-sum (\ (values) (yam-list-sum-steps values 0 0))

yam-iterator-list-steps (\ (iterator)
 (also (yam-use-fuel)
  (: closure (.0 iterator)
   (: next ((. 4 (.0 closure)) (.1 closure))
    (if (= (.0 next) 1) nil (# (.0 (.1 next)) (rec (.1 (.1 next)))))))))

yam-iterator-list
 (\ (iterator) (flatten-to-inner (yam-iterator-list-steps iterator)))

yam-builtin-type-equals
 (\ (left right group) (yam-bool (yam-runtime-equal left right group)))

yam-builtin-type-name (\ (type group) (yam-runtime-logical (. 1 type) group))

yam-builtin-type-lookup
 (\ (type name group) (yam-runtime-lookup-type type name group))

yam-builtin-type-snapshot
 (\ (definitions root group) (yam-runtime-snapshot definitions root group))

yam-builtin-dynamic-type (\ (value) (.0 value))

yam-builtin-cast (\ (value type group)
 (also (assert (yam-runtime-equal (. 0 value) type group) "type mismatch")
  (. 1 value)))

yam-builtin-compile (\ (name arguments body group)
 (yam-runtime-compile (# name arguments body) group))

# "The control-flow builtins need small VM-expression wrappers.
   garbage_collect creates a collection checkpoint around invoking a closure,
   not around constructing the closure. try and run sandbox execution and
   normalize the VM's bare out-of-fuel sentinel to the public Execution
   enum's two-field representation. Their argument and result values still
   use the ordinary closure ABI."

yam-code-checked-fuel (\ (fuel)
 (%if (%and (%compare (%load-0 fuel) (%word 0)) (%word 4)) (%word 0)
  (%load-0 fuel)))

yam-code-sandbox (\ (fuel body)
 (%let "$execution" (%sandbox (yam-code-checked-fuel fuel) body)
  (%if
   (%and (%compare (%load-0 (%load-0 (%name "$execution"))) (%word 2))
    (%word 1))
   (%new-inner (# (%object 2) (%object (#))))
   (%name "$execution"))))

yam-builtin-garbage-collect (# (# "action" "$runtime")
 (%collect-garbage
  (%call (%load (%load-0 (%name "action")) (%word 4))
   (# (%load-1 (%name "action"))))))

yam-builtin-try (# (# "action" "fuel" "$runtime")
 (yam-code-sandbox (%name "fuel")
  (%call (%load (%load-0 (%name "action")) (%word 4))
   (# (%load-1 (%name "action"))))))

yam-builtin-run (# (# "function" "arguments" "fuel" "$runtime")
 (yam-code-sandbox (%name "fuel")
  (%let "$plan"
   (%call (%object yam-runtime-prepare-call-body)
    (# (%name "function") (%name "arguments") (%name "$runtime")))
   (%new-inner
    (# (%load (%name "$plan") (%word 2))
     (%call-indirect (%load-0 (%name "$plan")) (%load-1 (%name "$plan"))))))))

# "Builtin selection uses canonical signatures. Generic parameter spelling
   does not matter: a one-parameter builtin is compared using T. The table
   also names the expected result type, so a source declaration cannot
   reinterpret a helper's value as another type merely by choosing a
   different return annotation."

yam-builtin-parameter-substitutions (\ (function)
 (: parameters (yam-function-parameters function)
  (if (nil? parameters) nil
   (also (assert (= (size parameters) 1) "Unknown builtin type parameters")
    (yam-map-put nil (.0 parameters) (yam-named-type "T"))))))

yam-builtin-argument-text (\ (arguments substitutions index)
 (if (= index (size arguments)) nil
  (#
   (yam-type-name-text (yam-specialize (.1 (. index arguments)) substitutions))
   (rec arguments substitutions (+ index 1)))))

yam-builtin-signature (\ (function)
 (: substitutions (yam-builtin-parameter-substitutions function)
  (str-concat-3 (yam-function-name function)
   (if (nil? (yam-function-parameters function)) "(" "[T](")
   (str-concat
    (yam-join-text
     (yam-builtin-argument-text (yam-function-arguments function) substitutions
      0)
     ", ")
    ")"))))

yam-function-name-value (\ (function group) (. 0 (. 0 function)))
yam-function-arguments-value (\ (function group) (. 2 (. 0 function)))

yam-function-code (\ (function group)
 (: raw (. 0 function)
  (: values (. 1 function)
   (: group-values
    (if (= (. 5 raw) (- 0 1)) values
     (if (= (. 7 raw) 0) (. (. 5 raw) values) (#)))
    (: captures (yam-function-capture-values raw values 0 (#))
     (: scope (yam-function-group-values (. 6 raw) (. 0 values) 0 captures)
      (yam-runtime-reflect-expression (. 3 raw) scope group-values
       (yam-function-bound-names (. 2 raw) 0 (#))
       group)))))))

yam-code-parameter-values (\ (names index)
 (if (= index (size names)) nil
  (# (%name (. index names)) (rec names (+ index 1)))))

yam-normalize-primitive (\ (helper names aware)
 (: parameters (yam-array-append names "$runtime")
  (: values (flatten-to-inner (yam-code-parameter-values names 0))
   (# parameters
    (%call (%object helper)
     (if aware (yam-array-append values (%name "$runtime")) values))))))

yam-builtin-entry (\ (signature returns helper index)
 (# signature (yam-primitive-type returns) helper index))

yam-builtin-table (#
 (yam-builtin-entry "equals[T](T, T)" "Bool"
  (yam-normalize-primitive yam-object-equals (# "$a0" "$a1") false)
  0)
 (yam-builtin-entry "info(Type)" "TypeInfo"
  (yam-normalize-primitive yam-info (# "$a0") true)
  1)
 (yam-builtin-entry "lookup_type(Type, String)" "Maybe[Type]"
  (yam-normalize-primitive yam-builtin-type-lookup (# "$a0" "$a1") true)
  2)
 (yam-builtin-entry "==(Type, Type)" "Bool"
  (yam-normalize-primitive yam-builtin-type-equals (# "$a0" "$a1") true)
  3)
 (yam-builtin-entry "name(Type)" "String"
  (yam-normalize-primitive yam-builtin-type-name (# "$a0") true)
  4)
 (yam-builtin-entry "dynamic_type(Dynamic)" "Type"
  (yam-normalize-primitive yam-builtin-dynamic-type (# "$a0") false)
  5)
 (yam-builtin-entry "type_snapshot(List[TypeDefinition], String)" "Type"
  (yam-normalize-primitive yam-builtin-type-snapshot (# "$a0" "$a1") true)
  6)
 (yam-builtin-entry "run(Dynamic, List[Dynamic], Int)" "Execution[Dynamic]"
  (yam-normalize-primitive yam-builtin-run (# "$a0" "$a1" "$a2") true)
  7)
 (yam-builtin-entry "garbage_collect[T](fun() T)" "T"
  (yam-normalize-primitive yam-builtin-garbage-collect (# "$a0") true)
  8)
 (yam-builtin-entry "try[T](fun() T, Int)" "Execution[T]"
  (yam-normalize-primitive yam-builtin-try (# "$a0" "$a1") true)
  9)
 (yam-builtin-entry "to_list[T](Iter[T])" "List[T]"
  (yam-normalize-primitive yam-iterator-list (# "$a0") false)
  10)
 (yam-builtin-entry "==(String, String)" "Bool"
  (yam-normalize-primitive yam-string-equals (# "$a0" "$a1") false)
  11)
 (yam-builtin-entry "bytes(String)" "List[Byte]"
  (yam-normalize-primitive yam-string-bytes (# "$a0") false)
  12)
 (yam-builtin-entry "string(List[Byte])" "String"
  (yam-normalize-primitive yam-pack-bytes (# "$a0") false)
  13)
 (yam-builtin-entry "concat(String, String)" "String"
  (yam-normalize-primitive yam-string-concat (# "$a0" "$a1") false)
  14)
 (yam-builtin-entry "crash(String)" "Never"
  (yam-normalize-primitive crash (# "$a0") false)
  15)
 (yam-builtin-entry "bitcast_int_to_float(Int)" "Float"
  (yam-normalize-primitive yam-identity (# "$a0") false)
  16)
 (yam-builtin-entry "bitcast_float_to_int(Float)" "Int"
  (yam-normalize-primitive yam-identity (# "$a0") false)
  17)
 (yam-builtin-entry "to_float(Int)" "Float"
  (yam-normalize-primitive int->float (# "$a0") false)
  18)
 (yam-builtin-entry "to_int(Float)" "Int"
  (yam-normalize-primitive yam-float-to-int (# "$a0") false)
  19)
 (yam-builtin-entry "+(Float, Float)" "Float"
  (yam-normalize-primitive f+ (# "$a0" "$a1") false)
  20)
 (yam-builtin-entry "-(Float, Float)" "Float"
  (yam-normalize-primitive f- (# "$a0" "$a1") false)
  21)
 (yam-builtin-entry "*(Float, Float)" "Float"
  (yam-normalize-primitive f* (# "$a0" "$a1") false)
  22)
 (yam-builtin-entry "/(Float, Float)" "Float"
  (yam-normalize-primitive f/ (# "$a0" "$a1") false)
  23)
 (yam-builtin-entry "==(Float, Float)" "Bool"
  (yam-normalize-primitive yam-float-equals (# "$a0" "$a1") false)
  24)
 (yam-builtin-entry "<(Float, Float)" "Bool"
  (yam-normalize-primitive yam-float-less (# "$a0" "$a1") false)
  25)
 (yam-builtin-entry ">(Float, Float)" "Bool"
  (yam-normalize-primitive yam-float-greater (# "$a0" "$a1") false)
  26)
 (yam-builtin-entry "<=(Float, Float)" "Bool"
  (yam-normalize-primitive yam-float-less-equal (# "$a0" "$a1") false)
  27)
 (yam-builtin-entry ">=(Float, Float)" "Bool"
  (yam-normalize-primitive yam-float-greater-equal (# "$a0" "$a1") false)
  28)
 (yam-builtin-entry "<=>(Float, Float)" "Ordering"
  (yam-normalize-primitive yam-float-ordering (# "$a0" "$a1") false)
  29)
 (yam-builtin-entry "lower_byte(Int)" "Byte"
  (yam-normalize-primitive yam-byte (# "$a0") false)
  30)
 (yam-builtin-entry "to_int(Byte)" "Int"
  (yam-normalize-primitive yam-identity (# "$a0") false)
  31)
 (yam-builtin-entry "+(Int, Int)" "Int"
  (yam-normalize-primitive + (# "$a0" "$a1") false)
  32)
 (yam-builtin-entry "-(Int, Int)" "Int"
  (yam-normalize-primitive - (# "$a0" "$a1") false)
  33)
 (yam-builtin-entry "*(Int, Int)" "Int"
  (yam-normalize-primitive * (# "$a0" "$a1") false)
  34)
 (yam-builtin-entry "/(Int, Int)" "Int"
  (yam-normalize-primitive yam-int-divide (# "$a0" "$a1") false)
  35)
 (yam-builtin-entry "mod(Int, Int)" "Int"
  (yam-normalize-primitive yam-int-modulo (# "$a0" "$a1") false)
  36)
